---
const title = "How to Choose the Right Knitting Machine (Without Regret)";
const description =
  "A practical, beginner-friendly reference for choosing a knitting machine: gauge, plastic vs metal bed, buying used, and a clear FAQ.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Optional: basic sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
