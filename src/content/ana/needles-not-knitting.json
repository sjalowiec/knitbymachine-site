cture';\n      iframe.allowFullscreen = true;\n\n      // Add whatever player params you prefer:\n      // - title/byline/portrait off keeps it cleaner\n      iframe.src = `https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0`;\n      return iframe;\n    }\n\n    document.querySelectorAll('.kbm-video-trigger').forEach((btn) => {\n      btn.addEventListener('click', () => {\n        const card = btn.closest('.kbm-video-card');\n        const playerWrap = card.querySelector('.kbm-video-player');\n        const vimeoId = btn.getAttribute('data-vimeo-id');\n\n        const isOpen = btn.getAttribute('aria-expanded') === 'true';\n\n        // Toggle behavior: click again to close\n        if (isOpen) {\n          btn.setAttribute('aria-expanded', 'false');\n          playerWrap.hidden = true;\n          playerWrap.innerHTML = ''; // remove iframe\n          return;\n        }\n\n        // Optional: close other open videos (keeps page calm)\n        document.querySelectorAll('.kbm-video-trigger[aria-expanded=\"true\"]').forEach((openBtn) => {\n          openBtn.setAttribute('aria-expanded', 'false');\n          const openCard = openBtn.closest('.kbm-video-card');\n          const openWrap = openCard.querySelector('.kbm-video-player');\n          openWrap.hidden = true;\n          openWrap.innerHTML = '';\n        });\n\n        btn.setAttribute('aria-expanded', 'true');\n        playerWrap.hidden = false;\n        playerWrap.innerHTML = '';\n        playerWrap.appendChild(createIframe(vimeoId));\n      });\n    });\n  })();\n</script>\n",
