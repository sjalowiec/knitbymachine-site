---
interface Props {
  category?: string;
  wizardClass?: string;
  classes?: string[];
  linkClass?: string;
}

const { category, wizardClass, classes, linkClass = 'back-link' } = Astro.props;

const normalizedCategory = (category || '').toLowerCase().trim();
const normalizedClass = (wizardClass || '').toLowerCase().trim();
const normalizedClasses = (classes || []).map(c => c.toLowerCase().trim());

const isSmartGuide = 
  normalizedClass === 'smart guide' || 
  normalizedClasses.includes('smart guide') || 
  normalizedCategory === 'smart guide' ||
  normalizedCategory === 'smart guides';

const isTool = normalizedCategory === 'tool' || normalizedCategory === 'tools';

let href = '/wizards-catalog';
let text = '← Back to Wizards Catalog';

if (isSmartGuide) {
  href = '/smart-guides';
  text = '← Back to Project Planners';
} else if (isTool) {
  href = '/tools';
  text = '← Back to Tools';
}
---

<a href={href} class={linkClass} data-testid="link-back-catalog">{text}</a>
