---
import AvailabilityBadge from './AvailabilityBadge.astro';
import type { Machine } from '../../lib/machines/getMachineById';

interface Props {
  machine: Machine;
}

const { machine } = Astro.props;
---

<article 
  class="machine-card bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow"
  data-gauge={machine.gaugeName}
  data-availability={machine.availabilityStatus}
>
  <a href={`/machines/${machine.id}`} class="block">
    <div class="aspect-square bg-gray-100 relative overflow-hidden">
      {machine.imageMain ? (
        <img 
          src={machine.imageMain} 
          alt={machine.imageAlt || machine.displayName}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gray-200">
          <span class="text-gray-400 text-sm">Image coming soon</span>
        </div>
      )}
    </div>
    
    <div class="p-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded">
          {machine.gaugeLabel} {machine.gaugeName}
        </span>
        <AvailabilityBadge status={machine.availabilityStatus} size="sm" />
      </div>
      
      <h3 class="text-lg font-semibold text-[var(--kbm-green)] mb-2">
        {machine.displayName}
      </h3>
      
      <p class="text-sm text-gray-600 line-clamp-2 mb-4">
        {machine.bestFor}
      </p>
      
      <span class="inline-flex items-center text-sm font-medium text-[var(--kbm-green)] hover:underline">
        View details
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
