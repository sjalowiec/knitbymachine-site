---
import AvailabilityBadge from './AvailabilityBadge.astro';
import type { BundleOption } from '../../lib/machines/getMachineById';

interface Props {
  bundle: BundleOption;
}

const { bundle } = Astro.props;
---

<div class="bundle-card bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between gap-3 mb-3">
    <h4 class="text-lg font-semibold text-[var(--kbm-green)]">
      {bundle.bundleName}
    </h4>
    <AvailabilityBadge 
      status={bundle.bundleAvailabilityStatus} 
      leadTimeMinWeeks={bundle.bundleLeadTimeMinWeeks}
      leadTimeMaxWeeks={bundle.bundleLeadTimeMaxWeeks}
      size="sm" 
    />
  </div>
  
  <p class="text-gray-600 text-sm mb-4">
    {bundle.bundleShortDescription}
  </p>
  
  {bundle.bundleIncludes && bundle.bundleIncludes.length > 0 && (
    <div class="mt-3">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Includes:</p>
      <ul class="space-y-1">
        {bundle.bundleIncludes.map((item) => (
          <li class="flex items-start gap-2 text-sm text-gray-700">
            <svg class="w-4 h-4 text-[var(--kbm-green-2)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
