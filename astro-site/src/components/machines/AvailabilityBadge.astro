---
import { getAvailabilityInfo, type AvailabilityStatus } from '../../lib/machines/availability';

interface Props {
  status: string;
  leadTimeMinWeeks?: number | null;
  leadTimeMaxWeeks?: number | null;
  showMessage?: boolean;
  size?: 'sm' | 'md';
}

const { 
  status, 
  leadTimeMinWeeks, 
  leadTimeMaxWeeks, 
  showMessage = false,
  size = 'md'
} = Astro.props;

const info = getAvailabilityInfo(
  status as AvailabilityStatus, 
  leadTimeMinWeeks, 
  leadTimeMaxWeeks
);

const sizeClasses = size === 'sm' 
  ? 'text-xs px-2 py-0.5' 
  : 'text-sm px-3 py-1';
---

<div class="availability-badge-wrapper">
  <span 
    class:list={[
      'inline-block rounded-full font-medium border',
      info.colorClass,
      sizeClasses
    ]}
  >
    {info.label}
  </span>
  {showMessage && (
    <p class="text-sm text-gray-600 mt-1">{info.message}</p>
  )}
</div>
