---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tooltip from "../../components/Tooltip.astro";
import WhyUseThisToolTooltip from "../../components/common/WhyUseThisToolTooltip.astro";
import PrintFooter from "../../components/common/PrintFooter.astro";
import ActionBar from "../../components/wizards/ActionBar.astro";

const pageTitle = "Magic Formula – Stitches & Rows | Knit by Machine";
const pageDescription = "Turn stitch counts and rows into clear shaping instructions — no spreadsheet required. Calculate your increase or decrease spacing instantly.";
const pageUrl = "https://knitbymachine.com/wizards/magic-formula-stitches-rows";

// Fetch wizard metadata at build time
const wizardSlug = 'magic-formula-stitches-rows';
let whyUseThisTool = '';

try {
  const response = await fetch(`https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/astro-site/src/content/wizards/${wizardSlug}.json`);
  if (response.ok) {
    const fileData = await response.json();
    // Use download_url to get raw JSON directly (avoids base64 decoding)
    const contentResponse = await fetch(fileData.download_url);
    if (contentResponse.ok) {
      const wizardData = await contentResponse.json();
      whyUseThisTool = wizardData.whyUseThisTool || '';
    }
  }
} catch (e) {
  // Silently fail - tooltip just won't show
}
---

<BaseLayout title={pageTitle} description={pageDescription}>

<style>
.wizard-page {
  padding-top: 120px;
  padding-bottom: 2rem;
  min-height: 100vh;
  background: var(--page-bg);
}

.page-header {
  max-width: 800px;
  margin: 0 auto 1.25rem;
  padding: 0 1rem;
}

.page-header-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}

@media (max-width: 640px) {
  .page-header-title {
    flex-direction: column;
    gap: 0.75rem;
  }
}

.page-header h1 {
  color: var(--kbm-green);
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
}

.page-header p {
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
  text-align: center;
}

.video-button {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  background: #e5e7eb;
  color: #374151;
  text-decoration: none;
  font-weight: 600;
  border-radius: 6px;
  transition: all 0.2s;
  border: 1px solid #d1d5db;
  cursor: pointer;
  font-size: 0.9rem;
  white-space: nowrap;
}

.video-button:hover {
  background: #d1d5db;
  transform: translateY(-1px);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.wizard-container {
  max-width: 700px;
  margin: 0 auto;
  background: white;
  padding: 1.5rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

@media (max-width: 640px) {
  .wizard-container {
    padding: 1.25rem 1rem;
    margin: 0 1rem;
  }
}

.toggle-group {
  display: flex;
  gap: 1rem;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.25rem;
}

.units-toggle {
  display: flex;
  gap: 0.5rem;
  padding: 4px;
  background: #f3f4f6;
  border-radius: 8px;
}

.unit-btn {
  padding: 0.5rem 1.5rem;
  border: none;
  background: transparent;
  color: #6b7280;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
  font-size: 0.95rem;
}

.unit-btn.active {
  background: var(--kbm-green);
  color: white;
}

.form-grid {
  display: grid;
  gap: 0.75rem;
}

.form-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-row-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1rem;
}

@media (max-width: 768px) {
  .form-row-3 {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 480px) {
  .form-row-2,
  .form-row-3 {
    grid-template-columns: 1fr;
  }
}

.floating-input {
  position: relative;
  width: 100%;
}

.floating-input input {
  width: 100%;
  padding: 1.25rem 0.875rem 0.5rem;
  border: 1px solid #d0d5cc;
  border-radius: 6px;
  font-family: var(--font);
  font-size: 1rem;
  color: var(--text-dark);
  background: white;
  transition: border-color 0.2s, box-shadow 0.2s;
  -moz-appearance: textfield;
}

.floating-input input::-webkit-outer-spin-button,
.floating-input input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.floating-input input:focus {
  outline: none;
  border-color: var(--kbm-green);
  box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
}

.floating-input input.error {
  border-color: #dc3545;
}

.floating-input label {
  position: absolute;
  left: 0.875rem;
  top: 50%;
  transform: translateY(-50%);
  font-size: 0.95rem;
  color: #6b7280;
  pointer-events: none;
  transition: all 0.2s ease;
  background: transparent;
  padding: 0 2px;
}

.floating-input input:focus ~ label,
.floating-input input:not(:placeholder-shown) ~ label {
  top: 0.5rem;
  transform: translateY(0);
  font-size: 0.75rem;
  color: var(--kbm-green);
  font-weight: 500;
}

.floating-input input.error ~ label {
  color: #dc3545;
}

.floating-input input::placeholder {
  color: transparent;
}

.floating-input input:focus::placeholder {
  color: #9ca3af;
}

.error-text {
  color: #dc3545;
  font-size: 0.8rem;
  margin-top: 0.35rem;
  display: none;
}

.error-text.show {
  display: block;
}

.section-divider {
  border: none;
  border-top: 1px solid #e5e7eb;
  margin: 1rem 0;
}

.section-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--kbm-green);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.75rem;
}

.icon-toggle-group {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
}

.icon-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}

.icon-toggle-box {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--kbm-green);
  border-radius: 8px;
  background: white;
  transition: all 0.2s ease;
}

.icon-toggle-box img {
  width: 32px;
  height: 32px;
  transition: filter 0.2s ease;
}

.icon-toggle.active .icon-toggle-box {
  background: var(--kbm-green);
  border-color: var(--kbm-green);
}

.icon-toggle.active .icon-toggle-box img {
  filter: brightness(0) invert(1);
}

.icon-toggle:hover:not(.active) .icon-toggle-box {
  background: rgba(82, 104, 45, 0.08);
}

.icon-toggle-label {
  font-size: 0.75rem;
  color: #6b7280;
  font-weight: 400;
  transition: color 0.2s ease;
}

.icon-toggle.active .icon-toggle-label {
  color: #4b5563;
  font-weight: 500;
}

.calculate-btn {
  width: 100%;
  padding: 1rem;
  background: var(--kbm-green);
  color: white;
  border: none;
  border-radius: 6px;
  font-family: var(--font);
  font-size: 1.05rem;
  font-weight: 600;
  cursor: pointer;
  margin-top: 1rem;
  transition: background 0.2s, transform 0.1s;
}

.calculate-btn:hover {
  background: #445626;
}

.calculate-btn:active {
  transform: scale(0.99);
}

.results {
  display: none;
  margin-top: 1.5rem;
  padding: 1.25rem 1.5rem;
  background: #ffffff;
  border-radius: 12px;
  border: 2px solid var(--kbm-green);
  box-shadow: 0 2px 8px rgba(82, 104, 45, 0.08);
}

.results.show {
  display: block;
}

.results h2 {
  color: var(--kbm-green);
  font-size: 1.15rem;
  font-weight: 600;
  margin: 0 0 0.75rem 0;
}

.results p {
  margin: 0.5rem 0;
  line-height: 1.5;
}

.results-section-label {
  font-weight: 600;
  color: #374151;
  margin-top: 0.75rem;
  margin-bottom: 0.25rem;
}

.note {
  margin-top: 1rem;
  padding: 1rem;
  background: #fff3cd;
  border-left: 3px solid #ffc107;
  border-radius: 4px;
  font-size: 0.9rem;
}

.note.info {
  background: #e8f4fd;
  border-left-color: #0d6efd;
}

.note.error {
  background: #f8d7da;
  border-left-color: #dc3545;
}

.copy-btn {
  margin-top: 1rem;
  padding: 0.65rem 1.25rem;
  background: white;
  color: var(--kbm-green);
  border: 2px solid var(--kbm-green);
  border-radius: 6px;
  font-family: var(--font);
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.copy-btn:hover {
  background: var(--kbm-green);
  color: white;
}

.back-link {
  display: inline-block;
  color: #52682D;
  text-decoration: none;
  font-weight: 500;
  margin-bottom: 1.5rem;
  padding: 0.5rem 0;
  transition: color 0.2s;
}

.back-link:hover {
  color: #3d4e21;
  text-decoration: underline;
}

.breakdown-toggle {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  background: white;
  border: 1px solid #d0d5cc;
  border-radius: 6px;
  cursor: pointer;
  font-family: var(--font);
  font-size: 0.95rem;
  color: var(--text-dark);
  margin-top: 1rem;
  transition: all 0.2s;
  width: 100%;
  text-align: left;
}

.breakdown-toggle:hover {
  background: #f9fafb;
  border-color: var(--kbm-green);
}

.breakdown-toggle .icon {
  transition: transform 0.2s;
}

.breakdown-toggle.open .icon {
  transform: rotate(90deg);
}

.breakdown-content {
  display: none;
  margin-top: 0.5rem;
}

.breakdown-content.show {
  display: block;
}

.breakdown-explanation {
  font-size: 0.8rem;
  color: #6b7280;
  margin-bottom: 0.5rem;
  font-style: italic;
}

.breakdown-table-wrapper {
  overflow-x: auto;
  max-height: 300px;
  overflow-y: auto;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
}

.breakdown-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}

.breakdown-table th,
.breakdown-table td {
  padding: 0.5rem 0.75rem;
  text-align: left;
}

.breakdown-table th {
  background: #ffffff;
  font-weight: 600;
  color: #374151;
  font-size: 0.8rem;
  border-bottom: 2px solid var(--kbm-green);
  position: sticky;
  top: 0;
}

.breakdown-table tbody tr:nth-child(odd) {
  background: #ffffff;
}

.breakdown-table tbody tr:nth-child(even) {
  background: #F7F9F4;
}

.breakdown-table .sts-col,
.breakdown-table td:last-child {
  text-align: center;
}

/* Print styles - hide input sections */
@media print {
  .wizard-page {
    padding-top: 0 !important;
    background: white !important;
  }
  
  .page-header,
  .video-button,
  .back-link,
  .toggle-group,
  .form-grid,
  .section-label,
  .section-divider,
  .floating-input,
  .form-row-2,
  .form-row-3,
  .icon-toggle-group,
  .calculate-btn,
  .results-actions,
  .breakdown-toggle,
  .no-print {
    display: none !important;
  }
  
  .wizard-container {
    box-shadow: none !important;
    padding: 0 !important;
    background: white !important;
    border: none !important;
  }
  
  .results {
    border-top: none !important;
    padding-top: 0 !important;
    background: white !important;
  }
  
  .breakdown-content {
    display: block !important;
    max-height: none !important;
  }
  
  .breakdown-table-wrapper {
    max-height: none !important;
    overflow: visible !important;
  }
}

</style>

  <div class="wizard-page">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
      <a href="/wizards-catalog" class="back-link" data-testid="link-back-catalog">← Back to Wizards Catalog</a>
    </div>

  <div class="page-header">
    <div class="page-header-title">
      <h1>Magic Formula – Stitches & Rows</h1>
      {whyUseThisTool ? (
        <WhyUseThisToolTooltip text={whyUseThisTool} variant="inline" />
      ) : (
        <button class="video-button" data-testid="button-watch-tutorial" onclick="alert('Video tutorial coming soon!')">
          <i class="fas fa-play-circle"></i> Watch Tutorial
        </button>
      )}
    </div>
    <p>
      Turn stitch counts and rows into clear shaping instructions — no spreadsheet required.
    </p>
  </div>

  <div class="wizard-container">
    <form id="wizard-form">
      <div class="toggle-group">
        <div class="units-toggle">
          <button type="button" class="unit-btn active" id="inches-btn" data-unit="in" data-testid="button-unit-inches">Inches</button>
          <button type="button" class="unit-btn" id="cm-btn" data-unit="cm" data-testid="button-unit-cm">Centimeters</button>
        </div>
      </div>

      <div class="form-grid">
        <div class="section-label">Stitch Counts</div>
        
        <div class="form-row-2">
          <div class="floating-input">
            <input 
              type="number" 
              id="startingStitches" 
              min="1"
              step="1" 
              placeholder=" "
              required
              data-testid="input-starting-stitches"
            />
            <label for="startingStitches" id="startingStitchesLabel">Starting stitches</label>
            <span class="error-text" id="startingStitchesError">Please enter a valid number.</span>
          </div>

          <div class="floating-input">
            <input 
              type="number" 
              id="endingStitches" 
              min="1"
              step="1" 
              placeholder=" "
              required
              data-testid="input-ending-stitches"
            />
            <label for="endingStitches" id="endingStitchesLabel">Ending stitches</label>
            <span class="error-text" id="endingStitchesError">Please enter a valid number.</span>
          </div>
        </div>

        <hr class="section-divider" />
        <div class="section-label">Rows & Gauge</div>

        <div class="form-row-3">
          <div class="floating-input">
            <input 
              type="number" 
              id="totalRows" 
              min="1"
              step="1" 
              placeholder=" "
              required
              data-testid="input-total-rows"
            />
            <label for="totalRows" id="totalRowsLabel">Total rows</label>
            <span class="error-text" id="totalRowsError">Please enter a valid number.</span>
          </div>

          <div class="floating-input">
            <input 
              type="number" 
              id="stitchGauge" 
              step="1" 
              min="1"
              placeholder="16"
              required
              data-testid="input-stitch-gauge"
            />
            <label for="stitchGauge" id="stitchGaugeLabel">Stitches in 4 inches</label>
            <span class="error-text" id="stitchGaugeError">Please enter a valid gauge.</span>
          </div>

          <div class="floating-input">
            <input 
              type="number" 
              id="rowGauge" 
              step="1" 
              min="1"
              placeholder="24"
              required
              data-testid="input-row-gauge"
            />
            <label for="rowGauge" id="rowGaugeLabel">Rows in 4 inches</label>
            <span class="error-text" id="rowGaugeError">Please enter a valid gauge.</span>
          </div>
        </div>

        <hr class="section-divider" />
        <div class="section-label">Shaping Options</div>

        <div class="icon-toggle-group">
          <button type="button" class="icon-toggle active" data-value="both" data-testid="button-shape-both">
            <div class="icon-toggle-box">
              <img src="/images/both-sides-choice.svg" alt="Both sides" />
            </div>
            <span class="icon-toggle-label">Both sides</span>
          </button>
          <button type="button" class="icon-toggle" data-value="one" data-testid="button-shape-one">
            <div class="icon-toggle-box">
              <img src="/images/one-side-choice.svg" alt="One side" />
            </div>
            <span class="icon-toggle-label">One side</span>
          </button>
        </div>
      </div>

      <button type="submit" class="calculate-btn" data-testid="button-calculate">Calculate Shaping</button>
    </form>

    <div id="results" class="results" data-testid="results-section">
      <ActionBar />
      <h2>Your Shaping Instructions</h2>
      <div id="resultsContent" data-testid="results-content"></div>
      
      <button id="breakdownToggle" class="breakdown-toggle" data-testid="button-breakdown-toggle">
        <span class="icon">▶</span> Row-by-row breakdown
      </button>
      <div id="breakdownContent" class="breakdown-content" data-testid="breakdown-content">
        <p class="breakdown-explanation">Stitch counts shown are totals after each shaping action.</p>
        <div class="breakdown-table-wrapper">
          <table class="breakdown-table">
            <thead>
              <tr>
                <th>Row</th>
                <th>Action</th>
                <th>Location</th>
                <th class="sts-col">sts</th>
              </tr>
            </thead>
            <tbody id="breakdownBody"></tbody>
          </table>
        </div>
      </div>
      
      <div class="results-actions" style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem;">
        <button id="copyBtn" class="copy-btn" data-testid="button-copy">
          <i class="fas fa-copy"></i> Copy Instructions
        </button>
      </div>
    </div>
  </div>
  <PrintFooter url={pageUrl} />
</div>

<script is:inline src="/js/generateRowByRow.js"></script>
<script is:inline>
  // ========== MAGIC FORMULA CALCULATION HELPER ==========
  
  function calculateShaping(params) {
    const {
      startingSts,
      endingSts,
      totalRows,
      stsGauge,
      rowsGauge,
      units,
      shapingMode
    } = params;
    
    const totalChange = Math.abs(startingSts - endingSts);
    const direction = startingSts > endingSts ? 'decrease' : 'increase';
    
    // No shaping needed
    if (totalChange === 0) {
      return {
        noShaping: true,
        startingSts,
        endingSts,
        totalRows,
        direction: null,
        lengthInUnits: totalRows / rowsGauge,
        units
      };
    }
    
    let changesPerSide;
    let leftSideChanges;
    let rightSideChanges;
    let unevenWarning = false;
    
    if (shapingMode === 'both-sides') {
      if (totalChange % 2 !== 0) {
        // Uneven - distribute as best as possible
        unevenWarning = true;
        leftSideChanges = Math.floor(totalChange / 2);
        rightSideChanges = Math.ceil(totalChange / 2);
        changesPerSide = leftSideChanges; // Use lower for calculation
      } else {
        leftSideChanges = totalChange / 2;
        rightSideChanges = totalChange / 2;
        changesPerSide = totalChange / 2;
      }
    } else {
      // One side only
      changesPerSide = totalChange;
      leftSideChanges = null;
      rightSideChanges = null;
    }
    
    // Check if we have enough rows
    if (changesPerSide > totalRows) {
      return {
        error: 'not-enough-rows',
        shapingCount: changesPerSide,
        totalRows,
        direction
      };
    }
    
    // Calculate spacing based on the primary count (for both-sides with odd total, use the larger count)
    const primaryCount = shapingMode === 'both-sides' && unevenWarning ? rightSideChanges : changesPerSide;
    const baseInterval = Math.floor(totalRows / primaryCount);
    const extraRows = totalRows % primaryCount;
    
    // Build row-by-row breakdown with running stitch totals
    let breakdown = [];
    let timesAtBase = primaryCount - extraRows;
    let timesAtLonger = extraRows;
    
    // Generate breakdown steps
    if (shapingMode === 'both-sides' && unevenWarning) {
      // Asymmetric case: one side has more changes than the other
      // This requires custom logic because the last shaping is on one side only
      let currentRow = 0;
      let currentStitches = startingSts;
      const isDecrease = direction === 'decrease';
      
      for (let i = 0; i < rightSideChanges; i++) {
        const useLonger = i < timesAtLonger;
        const interval = useLonger ? (baseInterval + 1) : baseInterval;
        currentRow += interval;
        
        if (i < leftSideChanges) {
          // This row applies to both sides - 2 stitches changed
          currentStitches = isDecrease ? currentStitches - 2 : currentStitches + 2;
          breakdown.push({
            rowNumber: currentRow,
            action: `${direction === 'decrease' ? 'Decrease' : 'Increase'} 1 stitch`,
            location: 'Both sides',
            stitchesAfter: currentStitches
          });
        } else {
          // This extra row only applies to right side - 1 stitch changed
          currentStitches = isDecrease ? currentStitches - 1 : currentStitches + 1;
          breakdown.push({
            rowNumber: currentRow,
            action: `${direction === 'decrease' ? 'Decrease' : 'Increase'} 1 stitch`,
            location: 'Right side only (extra)',
            stitchesAfter: currentStitches
          });
        }
      }
    } else {
      // Symmetric case or one-side mode: use the reusable utility
      const mode = shapingMode === 'both-sides' ? 'both' : 'one';
      
      // Build steps array for the utility (longer intervals first for proper row distribution)
      const breakdownSteps = [];
      if (timesAtLonger > 0) {
        breakdownSteps.push({ sts: 1, rows: baseInterval + 1, times: timesAtLonger });
      }
      if (timesAtBase > 0) {
        breakdownSteps.push({ sts: 1, rows: baseInterval, times: timesAtBase });
      }
      
      // Use the reusable generateRowByRow utility
      breakdown = window.generateRowByRow({
        startingStitches: startingSts,
        steps: breakdownSteps,
        shapingMode: mode,
        direction: direction
      });
    }
    
    // Calculate approximate length
    const lengthInUnits = totalRows / rowsGauge;
    
    return {
      noShaping: false,
      error: null,
      startingSts,
      endingSts,
      totalRows,
      totalChange,
      direction,
      shapingMode,
      changesPerSide,
      primaryCount,
      leftSideChanges,
      rightSideChanges,
      unevenWarning,
      baseInterval,
      extraRows,
      timesAtBase: primaryCount - extraRows,
      timesAtLonger: extraRows,
      breakdown,
      lengthInUnits,
      units
    };
  }
  
  // ========== UI LOGIC ==========
  
  const inchesBtn = document.getElementById('inches-btn');
  const cmBtn = document.getElementById('cm-btn');
  let useCm = false;

  function updateLabels() {
    const gaugeUnit = useCm ? '10 cm' : '4 inches';
    
    document.getElementById('stitchGaugeLabel').textContent = `Stitches in ${gaugeUnit}`;
    document.getElementById('rowGaugeLabel').textContent = `Rows in ${gaugeUnit}`;
  }

  // Render SVG shaping diagram with trapezoid, labels, and shorthand
  function renderShapingDiagram(startSts, endSts, mode, direction, steps) {
    const isIncrease = direction === 'increase';
    
    // Get polygon points based on mode and direction
    // Points order: top-left, top-right, bottom-right, bottom-left
    // For decrease: wide at bottom (starting), narrow at top (ending)
    // For increase: narrow at bottom (starting), wide at top (ending)
    // For one-side: angled line is on the RIGHT side to match the icon
    let polygonPoints;
    if (mode === 'both') {
      if (isIncrease) {
        // Increase: narrow bottom, wide top (symmetrical)
        polygonPoints = '40,30 220,30 200,170 60,170';
      } else {
        // Decrease: wide bottom, narrow top (symmetrical)
        polygonPoints = '60,30 200,30 220,170 40,170';
      }
    } else {
      // One-side mode: angled line on RIGHT side, left side straight
      if (isIncrease) {
        // Increase: narrow bottom-right, wide top-right
        polygonPoints = '40,30 220,30 180,170 40,170';
      } else {
        // Decrease: wide bottom-right, narrow top-right
        polygonPoints = '40,30 180,30 220,170 40,170';
      }
    }
    
    // Label positions - starting is always at bottom, ending at top
    const startingY = 190;
    const endY = 20;
    const startLabel = `starting (${startSts} sts)`;
    const endLabel = `end (${endSts} sts)`;
    
    // Build shorthand text for ALL steps inside the SVG
    let shorthandSvg = '';
    if (steps.length === 1) {
      // Single step - centered
      shorthandSvg = `
        <text x="130" y="95" text-anchor="middle" fill="#1f2937" style="font-size: 28px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${steps[0].sts}–${steps[0].rows}–${steps[0].times}</text>
        <text x="130" y="118" text-anchor="middle" fill="#6b7280" style="font-size: 13px; font-family: system-ui, -apple-system, sans-serif; font-style: italic;">sts – rows – times</text>
      `;
    } else if (steps.length === 2) {
      // Two steps - stacked inside the shape
      shorthandSvg = `
        <text x="130" y="75" text-anchor="middle" fill="#1f2937" style="font-size: 24px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${steps[0].sts}–${steps[0].rows}–${steps[0].times}</text>
        <text x="130" y="110" text-anchor="middle" fill="#1f2937" style="font-size: 24px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${steps[1].sts}–${steps[1].rows}–${steps[1].times}</text>
        <text x="130" y="135" text-anchor="middle" fill="#6b7280" style="font-size: 13px; font-family: system-ui, -apple-system, sans-serif; font-style: italic;">sts – rows – times</text>
      `;
    } else if (steps.length > 2) {
      // Multiple steps - list them all
      let yPos = 60;
      steps.forEach(step => {
        shorthandSvg += `<text x="130" y="${yPos}" text-anchor="middle" fill="#1f2937" style="font-size: 20px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${step.sts}–${step.rows}–${step.times}</text>`;
        yPos += 28;
      });
      shorthandSvg += `<text x="130" y="${yPos + 5}" text-anchor="middle" fill="#6b7280" style="font-size: 13px; font-family: system-ui, -apple-system, sans-serif; font-style: italic;">sts – rows – times</text>`;
    }
    
    return `
      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; margin: 1rem 0;">
        <div style="width: 100%; max-width: 320px;">
          <svg viewBox="0 0 260 200" style="width: 100%; height: auto; display: block;" aria-label="Shaping diagram showing ${direction} from ${startSts} to ${endSts} stitches on ${mode === 'both' ? 'both sides' : 'one side'}">
            <polygon points="${polygonPoints}" fill="none" stroke="#52682D" stroke-width="6" stroke-linejoin="round"/>
            <text x="25" y="${startingY}" fill="#6b7280" style="font-size: 14px; font-family: system-ui, -apple-system, sans-serif;">${startLabel}</text>
            <text x="235" y="${endY}" text-anchor="end" fill="#6b7280" style="font-size: 14px; font-family: system-ui, -apple-system, sans-serif;">${endLabel}</text>
            ${shorthandSvg}
          </svg>
        </div>
      </div>
    `;
  }

  // Load saved unit preference
  const savedUnit = localStorage.getItem('kbm-unit-preference') || 'in';
  if (savedUnit === 'cm') {
    useCm = true;
    inchesBtn.classList.remove('active');
    cmBtn.classList.add('active');
  } else {
    useCm = false;
    inchesBtn.classList.add('active');
    cmBtn.classList.remove('active');
  }
  updateLabels();

  inchesBtn.addEventListener('click', function() {
    if (!useCm) return;
    useCm = false;
    inchesBtn.classList.add('active');
    cmBtn.classList.remove('active');
    localStorage.setItem('kbm-unit-preference', 'in');
    updateLabels();
  });

  cmBtn.addEventListener('click', function() {
    if (useCm) return;
    useCm = true;
    cmBtn.classList.add('active');
    inchesBtn.classList.remove('active');
    localStorage.setItem('kbm-unit-preference', 'cm');
    updateLabels();
  });

  // Shaping side toggle
  document.querySelectorAll('.icon-toggle').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.icon-toggle').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
    });
  });

  // Validation helper
  function validateField(input, errorEl) {
    const value = parseFloat(input.value);
    if (!input.value || isNaN(value) || value <= 0) {
      input.classList.add('error');
      errorEl.classList.add('show');
      return false;
    }
    input.classList.remove('error');
    errorEl.classList.remove('show');
    return true;
  }

  // Form submission
  document.getElementById('wizard-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Get form values
    const startingStitchesInput = document.getElementById('startingStitches');
    const endingStitchesInput = document.getElementById('endingStitches');
    const totalRowsInput = document.getElementById('totalRows');
    const stitchGaugeInput = document.getElementById('stitchGauge');
    const rowGaugeInput = document.getElementById('rowGauge');
    
    // Validate all fields
    let valid = true;
    valid = validateField(startingStitchesInput, document.getElementById('startingStitchesError')) && valid;
    valid = validateField(endingStitchesInput, document.getElementById('endingStitchesError')) && valid;
    valid = validateField(totalRowsInput, document.getElementById('totalRowsError')) && valid;
    valid = validateField(stitchGaugeInput, document.getElementById('stitchGaugeError')) && valid;
    valid = validateField(rowGaugeInput, document.getElementById('rowGaugeError')) && valid;
    
    if (!valid) {
      return;
    }
    
    const startingSts = parseInt(startingStitchesInput.value);
    const endingSts = parseInt(endingStitchesInput.value);
    const totalRows = parseInt(totalRowsInput.value);
    const stsGaugeRaw = parseFloat(stitchGaugeInput.value);
    const rowsGaugeRaw = parseFloat(rowGaugeInput.value);
    const shapingMode = document.querySelector('.icon-toggle.active').dataset.value === 'both' ? 'both-sides' : 'one-side';
    const units = useCm ? 'cm' : 'in';

    // Convert gauge from 4"/10cm to per-unit values
    const gaugeDivisor = useCm ? 10 : 4;
    const stsGauge = stsGaugeRaw / gaugeDivisor;
    const rowsGauge = rowsGaugeRaw / gaugeDivisor;

    // Calculate shaping
    const result = calculateShaping({
      startingSts,
      endingSts,
      totalRows,
      stsGauge,
      rowsGauge,
      units,
      shapingMode
    });

    let instructions = '';
    
    // Handle errors
    if (result.error === 'not-enough-rows') {
      instructions += `<div class="note error">`;
      instructions += `<strong>Not enough rows!</strong><br>`;
      instructions += `You need ${result.shapingCount} ${result.direction}s but only have ${result.totalRows} rows.<br>`;
      instructions += `Please increase your total rows or reduce the stitch difference.`;
      instructions += `</div>`;
      
      document.getElementById('resultsContent').innerHTML = instructions;
      document.getElementById('results').classList.add('show');
      document.getElementById('breakdownToggle').style.display = 'none';
      window.currentInstructions = document.getElementById('resultsContent').innerText;
      document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return;
    }
    
    // Handle no shaping needed
    if (result.noShaping) {
      const unitLabel = result.units === 'cm' ? 'cm' : 'inches';
      const lengthFormatted = result.units === 'cm' 
        ? Math.round(result.lengthInUnits) 
        : result.lengthInUnits.toFixed(1);
      
      instructions += `<p><strong>No shaping needed!</strong></p>`;
      instructions += `<p>Your starting and ending stitch counts are the same (${result.startingSts} stitches).</p>`;
      instructions += `<p>Simply knit ${result.totalRows} rows with no increases or decreases.</p>`;
      instructions += `<p style="margin-top: 1rem; color: #6b7280;"><em>This section spans about ${lengthFormatted} ${unitLabel}.</em></p>`;
      
      document.getElementById('resultsContent').innerHTML = instructions;
      document.getElementById('results').classList.add('show');
      document.getElementById('breakdownToggle').style.display = 'none';
      window.currentInstructions = document.getElementById('resultsContent').innerText;
      document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return;
    }
    
    // Build success instructions
    const action = result.direction === 'increase' ? 'Increase' : 'Decrease';
    const actionLower = result.direction === 'increase' ? 'increasing' : 'decreasing';
    const location = result.shapingMode === 'both-sides' ? 'at EACH end' : 'at ONE end';
    const locationDisplay = result.shapingMode === 'both-sides' ? 'both sides' : 'one side';
    const unitLabel = result.units === 'cm' ? 'cm' : 'inches';
    const lengthFormatted = result.units === 'cm' 
      ? Math.round(result.lengthInUnits) 
      : result.lengthInUnits.toFixed(1);
    
    // Build shaping steps array for diagram
    let shapingSteps = [];
    if (result.extraRows === 0) {
      shapingSteps = [{ sts: 1, rows: result.baseInterval, times: result.changesPerSide }];
    } else {
      if (result.timesAtBase > 0) {
        shapingSteps.push({ sts: 1, rows: result.baseInterval, times: result.timesAtBase });
      }
      shapingSteps.push({ sts: 1, rows: result.baseInterval + 1, times: result.timesAtLonger });
    }
    
    const diagramMode = result.shapingMode === 'both-sides' ? 'both' : 'one';
    
    // Render the SVG diagram first
    instructions += renderShapingDiagram(result.startingSts, result.endingSts, diagramMode, result.direction, shapingSteps);
    
    // Summary
    instructions += `<p><strong>Summary:</strong></p>`;
    instructions += `<p>You are ${actionLower} from <strong>${result.startingSts}</strong> to <strong>${result.endingSts}</strong> stitches over <strong>${result.totalRows}</strong> rows.</p>`;
    instructions += `<p>Shape <strong>${locationDisplay}</strong>.</p>`;
    
    // Show total changes clearly
    if (result.shapingMode === 'both-sides') {
      if (result.unevenWarning) {
        instructions += `<p>Total ${result.direction}s: <strong>${result.totalChange}</strong> (left side: ${result.leftSideChanges}, right side: ${result.rightSideChanges})</p>`;
      } else {
        instructions += `<p>Total ${result.direction}s: <strong>${result.totalChange}</strong> (${result.changesPerSide} per side)</p>`;
      }
    } else {
      instructions += `<p>Total ${result.direction}s: <strong>${result.totalChange}</strong></p>`;
    }
    
    // Uneven warning
    if (result.unevenWarning) {
      instructions += `<div class="note info">`;
      instructions += `<strong>Note:</strong> The total stitch change (${result.totalChange}) isn't even, so one side will have 1 more ${result.direction} than the other.<br>`;
      instructions += `Left side: ${result.leftSideChanges} ${result.direction}s. Right side: ${result.rightSideChanges} ${result.direction}s.`;
      instructions += `</div>`;
    }
    
    // Main instructions
    instructions += `<p style="margin-top: 1rem;"><strong>Instructions:</strong></p>`;
    
    // Helper function to analyze intervals from breakdown
    function analyzeIntervals(breakdown) {
      if (breakdown.length === 0) return [];
      
      const intervals = [];
      let prevRow = 0;
      
      breakdown.forEach(step => {
        const interval = step.rowNumber - prevRow;
        prevRow = step.rowNumber;
        
        // Find or create interval entry
        const existing = intervals.find(i => i.interval === interval);
        if (existing) {
          existing.count++;
        } else {
          intervals.push({ interval, count: 1 });
        }
      });
      
      // Sort by interval (smaller first)
      intervals.sort((a, b) => a.interval - b.interval);
      return intervals;
    }
    
    // Helper to format inline shorthand
    const shorthand = (sts, rows, times) => `<span style="font-family: 'JetBrains Mono', monospace; color: #52682d;">(${sts}–${rows}–${times} sts/rows/times)</span>`;
    
    if (result.shapingMode === 'both-sides') {
      if (result.unevenWarning) {
        // Asymmetric case - derive from breakdown
        const bothSidesSteps = result.breakdown.filter(s => s.location === 'each side');
        const rightOnlySteps = result.breakdown.filter(s => s.location.includes('right side'));
        
        const bothIntervals = analyzeIntervals(bothSidesSteps);
        
        if (bothIntervals.length === 1) {
          instructions += `<p>• On each side, ${action} 1 stitch every ${bothIntervals[0].interval} rows, ${bothIntervals[0].count} times ${shorthand(1, bothIntervals[0].interval, bothIntervals[0].count)}.</p>`;
        } else if (bothIntervals.length > 1) {
          bothIntervals.forEach(int => {
            instructions += `<p>• On each side, ${action} 1 stitch every ${int.interval} rows, ${int.count} times ${shorthand(1, int.interval, int.count)}.</p>`;
          });
        }
        
        if (rightOnlySteps.length > 0) {
          const extraRow = rightOnlySteps[0].rowNumber;
          instructions += `<p style="margin-top: 0.5rem;">• On right side only, ${action} 1 additional stitch at row ${extraRow}.</p>`;
        }
      } else {
        if (result.extraRows === 0) {
          instructions += `<p>On each side, ${action} 1 stitch every ${result.baseInterval} rows, ${result.changesPerSide} times ${shorthand(1, result.baseInterval, result.changesPerSide)}.</p>`;
        } else {
          if (result.timesAtBase > 0) {
            instructions += `<p>• On each side, ${action} 1 stitch every ${result.baseInterval} rows, ${result.timesAtBase} times ${shorthand(1, result.baseInterval, result.timesAtBase)}.</p>`;
          }
          instructions += `<p>• On each side, ${action} 1 stitch every ${result.baseInterval + 1} rows, ${result.timesAtLonger} times ${shorthand(1, result.baseInterval + 1, result.timesAtLonger)}.</p>`;
          
          instructions += `<div class="note">`;
          instructions += `<strong>Tip:</strong> Your shaping doesn't divide evenly. Alternate between the two intervals to distribute the shaping evenly across your ${result.totalRows} rows.`;
          instructions += `</div>`;
        }
      }
    } else {
      if (result.extraRows === 0) {
        instructions += `<p>On one side only, ${action} 1 stitch every ${result.baseInterval} rows, ${result.changesPerSide} times ${shorthand(1, result.baseInterval, result.changesPerSide)}.</p>`;
      } else {
        if (result.timesAtBase > 0) {
          instructions += `<p>• On one side only, ${action} 1 stitch every ${result.baseInterval} rows, ${result.timesAtBase} times ${shorthand(1, result.baseInterval, result.timesAtBase)}.</p>`;
        }
        instructions += `<p>• On one side only, ${action} 1 stitch every ${result.baseInterval + 1} rows, ${result.timesAtLonger} times ${shorthand(1, result.baseInterval + 1, result.timesAtLonger)}.</p>`;
        
        instructions += `<div class="note">`;
        instructions += `<strong>Tip:</strong> Your shaping doesn't divide evenly. Alternate between the two intervals to distribute the shaping evenly across your ${result.totalRows} rows.`;
        instructions += `</div>`;
      }
    }
    
    // Approximate length
    instructions += `<p style="margin-top: 1.5rem; color: #6b7280;"><em>This shaping covers about <strong>${lengthFormatted} ${unitLabel}</strong>.</em></p>`;

    document.getElementById('resultsContent').innerHTML = instructions;
    document.getElementById('results').classList.add('show');
    document.getElementById('breakdownToggle').style.display = 'flex';
    
    // Build breakdown table
    const breakdownBody = document.getElementById('breakdownBody');
    breakdownBody.innerHTML = '';
    
    result.breakdown.forEach(step => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td>Row ${step.rowNumber}</td>
        <td>${step.action}</td>
        <td>${step.location}</td>
        <td>${step.stitchesAfter}</td>
      `;
      breakdownBody.appendChild(row);
    });
    
    window.currentInstructions = document.getElementById('resultsContent').innerText;
    document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    
    // Show ActionBar
    const actionBar = document.getElementById('action-bar');
    const printBtn = document.getElementById('print-btn');
    if (actionBar) actionBar.style.display = 'flex';
    if (printBtn) printBtn.style.display = 'block';
  });
  
  // Action Bar buttons
  const actionBarEl = document.getElementById('action-bar');
  const startOverBtn = document.getElementById('start-over-btn');
  const printBtnEl = document.getElementById('print-btn');

  // Start Over handler
  if (startOverBtn) {
    startOverBtn.addEventListener('click', () => {
      document.getElementById('results').classList.remove('show');
      if (actionBarEl) actionBarEl.style.display = 'none';
    });
  }

  // Print handler
  if (printBtnEl) {
    printBtnEl.addEventListener('click', () => {
      window.print();
    });
  }

  // Breakdown toggle
  document.getElementById('breakdownToggle').addEventListener('click', function() {
    this.classList.toggle('open');
    document.getElementById('breakdownContent').classList.toggle('show');
  });

  // Copy button
  document.getElementById('copyBtn').addEventListener('click', function() {
    if (window.currentInstructions) {
      // Also include breakdown if visible
      let textToCopy = window.currentInstructions;
      const breakdownContent = document.getElementById('breakdownContent');
      if (breakdownContent.classList.contains('show')) {
        const rows = document.querySelectorAll('#breakdownBody tr');
        textToCopy += '\n\nRow-by-row breakdown:\n';
        rows.forEach(row => {
          const cells = row.querySelectorAll('td');
          textToCopy += `${cells[0].textContent}: ${cells[1].textContent} (${cells[2].textContent}) → ${cells[3].textContent}\n`;
        });
      }
      
      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalText = this.innerHTML;
        this.innerHTML = '<i class="fas fa-check"></i> Copied!';
        setTimeout(() => {
          this.innerHTML = originalText;
        }, 2000);
      });
    }
  });
</script>

</BaseLayout>
