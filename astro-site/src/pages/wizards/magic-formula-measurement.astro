---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tooltip from "../../components/Tooltip.astro";
import PrintFooter from "../../components/common/PrintFooter.astro";
import ActionBar from "../../components/wizards/ActionBar.astro";

const pageTitle = "Magic Formula by Measurement | Knit by Machine";
const pageDescription = "Calculate shaping with the Magic Formula using measurements. Enter your starting and ending widths and gauge to create clear knitting instructions.";
const pageUrl = "https://knitbymachine.com/wizards/magic-formula-measurement";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<style>
.wizard-page {
  padding-top: 120px;
  padding-bottom: 2rem;
  min-height: 100vh;
  background: var(--page-bg);
}

.page-header {
  max-width: 800px;
  margin: 0 auto 1.25rem;
  padding: 0 1rem;
}

.page-header-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}

@media (max-width: 640px) {
  .page-header-title {
    flex-direction: column;
    gap: 0.75rem;
  }
}

.page-header h1 {
  color: var(--kbm-green);
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
}

.page-header p {
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
  text-align: center;
}

.video-button {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  background: #e5e7eb;
  color: #374151;
  text-decoration: none;
  font-weight: 600;
  border-radius: 6px;
  transition: all 0.2s;
  border: 1px solid #d1d5db;
  cursor: pointer;
  font-size: 0.9rem;
  white-space: nowrap;
}

.video-button:hover {
  background: #d1d5db;
  transform: translateY(-1px);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.wizard-container {
  max-width: 700px;
  margin: 0 auto;
  background: white;
  padding: 1.5rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

@media (max-width: 640px) {
  .wizard-container {
    padding: 1.25rem 1rem;
    margin: 0 1rem;
  }
}

.toggle-group {
  display: flex;
  gap: 1rem;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.25rem;
}

.units-toggle {
  display: flex;
  gap: 0.5rem;
  padding: 4px;
  background: #f3f4f6;
  border-radius: 8px;
}

.unit-btn {
  padding: 0.5rem 1.5rem;
  border: none;
  background: transparent;
  color: #6b7280;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
  font-size: 0.95rem;
}

.unit-btn.active {
  background: var(--kbm-green);
  color: white;
}

.form-grid {
  display: grid;
  gap: 0.75rem;
}

.form-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-row-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1rem;
}

@media (max-width: 768px) {
  .form-row-3 {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 480px) {
  .form-row-2,
  .form-row-3 {
    grid-template-columns: 1fr;
  }
}

.floating-input {
  position: relative;
  width: 100%;
}

.floating-input input {
  width: 100%;
  padding: 1.25rem 0.875rem 0.5rem;
  border: 1px solid #d0d5cc;
  border-radius: 6px;
  font-family: var(--font);
  font-size: 1rem;
  color: var(--text-dark);
  background: white;
  transition: border-color 0.2s, box-shadow 0.2s;
  -moz-appearance: textfield;
}

.floating-input input::-webkit-outer-spin-button,
.floating-input input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.floating-input input:focus {
  outline: none;
  border-color: var(--kbm-green);
  box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
}

.floating-input label {
  position: absolute;
  left: 0.875rem;
  top: 50%;
  transform: translateY(-50%);
  font-size: 0.95rem;
  color: #6b7280;
  pointer-events: none;
  transition: all 0.2s ease;
  background: transparent;
  padding: 0 2px;
}

.floating-input input:focus ~ label,
.floating-input input:not(:placeholder-shown) ~ label {
  top: 0.5rem;
  transform: translateY(0);
  font-size: 0.75rem;
  color: var(--kbm-green);
  font-weight: 500;
}

.floating-input input::placeholder {
  color: transparent;
}

.floating-input input:focus::placeholder {
  color: #9ca3af;
}

.section-divider {
  border: none;
  border-top: 1px solid #e5e7eb;
  margin: 1rem 0;
}

.section-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--kbm-green);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.75rem;
}

.icon-toggle-group {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
}

.icon-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}

.icon-toggle-box {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--kbm-green);
  border-radius: 8px;
  background: white;
  transition: all 0.2s ease;
}

.icon-toggle-box img {
  width: 32px;
  height: 32px;
  transition: filter 0.2s ease;
}

.icon-toggle.active .icon-toggle-box {
  background: var(--kbm-green);
  border-color: var(--kbm-green);
}

.icon-toggle.active .icon-toggle-box img {
  filter: brightness(0) invert(1);
}

.icon-toggle:hover:not(.active) .icon-toggle-box {
  background: rgba(82, 104, 45, 0.08);
}

.icon-toggle-label {
  font-size: 0.75rem;
  color: #6b7280;
  font-weight: 400;
  transition: color 0.2s ease;
}

.icon-toggle.active .icon-toggle-label {
  color: #4b5563;
  font-weight: 500;
}

.calculate-btn {
  width: 100%;
  padding: 1rem;
  background: var(--kbm-green);
  color: white;
  border: none;
  border-radius: 6px;
  font-family: var(--font);
  font-size: 1.05rem;
  font-weight: 600;
  cursor: pointer;
  margin-top: 1rem;
  transition: background 0.2s, transform 0.1s;
}

.calculate-btn:hover {
  background: #445626;
}

.calculate-btn:active {
  transform: scale(0.99);
}

.results {
  display: none;
  margin-top: 1.5rem;
  padding: 1.25rem 1.5rem;
  background: #ffffff;
  border-radius: 12px;
  border: 2px solid var(--kbm-green);
  box-shadow: 0 2px 8px rgba(82, 104, 45, 0.08);
}

.results.show {
  display: block;
}

.results h2 {
  color: var(--kbm-green);
  font-size: 1.15rem;
  font-weight: 600;
  margin: 0 0 0.75rem 0;
}

.results p {
  margin: 0.5rem 0;
  line-height: 1.5;
}

.results-section-label {
  font-weight: 600;
  color: #374151;
  margin-top: 0.75rem;
  margin-bottom: 0.25rem;
}

.note {
  margin-top: 1rem;
  padding: 1rem;
  background: #fff3cd;
  border-left: 3px solid #ffc107;
  border-radius: 4px;
  font-size: 0.9rem;
}

.breakdown-toggle {
  display: none;
  width: 100%;
  padding: 0.75rem;
  margin-top: 1rem;
  background: transparent;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-family: var(--font);
  font-weight: 500;
  cursor: pointer;
  text-align: left;
  transition: all 0.2s;
}

.breakdown-toggle:hover {
  background: #f5f5f5;
}

.breakdown-toggle .icon {
  display: inline-block;
  margin-right: 0.5rem;
  transition: transform 0.2s;
}

.breakdown-toggle.open .icon {
  transform: rotate(90deg);
}

.breakdown-content {
  display: none;
  margin-top: 0.5rem;
}

.breakdown-content.show {
  display: block;
}

.breakdown-explanation {
  font-size: 0.8rem;
  color: #6b7280;
  margin-bottom: 0.5rem;
  font-style: italic;
}

.breakdown-table-wrapper {
  overflow-x: auto;
  max-height: 300px;
  overflow-y: auto;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
}

.breakdown-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}

.breakdown-table th,
.breakdown-table td {
  padding: 0.5rem 0.75rem;
  text-align: left;
}

.breakdown-table th {
  background: #ffffff;
  font-weight: 600;
  color: #374151;
  font-size: 0.8rem;
  border-bottom: 2px solid var(--kbm-green);
  position: sticky;
  top: 0;
}

.breakdown-table tbody tr:nth-child(odd) {
  background: #ffffff;
}

.breakdown-table tbody tr:nth-child(even) {
  background: #F7F9F4;
}

.breakdown-table .sts-col,
.breakdown-table td:last-child {
  text-align: center;
}

.copy-btn {
  margin-top: 1rem;
  padding: 0.65rem 1.25rem;
  background: white;
  color: var(--kbm-green);
  border: 2px solid var(--kbm-green);
  border-radius: 6px;
  font-family: var(--font);
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.copy-btn:hover {
  background: var(--kbm-green);
  color: white;
}

.back-link {
  display: inline-block;
  color: #52682D;
  text-decoration: none;
  font-weight: 500;
  margin-bottom: 1.5rem;
  padding: 0.5rem 0;
  transition: color 0.2s;
}

.back-link:hover {
  color: #3d4e21;
  text-decoration: underline;
}

/* Print styles - hide input sections */
@media print {
  .wizard-page {
    padding-top: 0 !important;
    background: white !important;
  }
  
  .page-header,
  .video-button,
  .back-link,
  .toggle-group,
  .form-grid,
  .section-label,
  .section-divider,
  .floating-input,
  .form-row-2,
  .form-row-3,
  .icon-toggle-group,
  .calculate-btn,
  .results-actions,
  .no-print,
  .units-toggle,
  .input-grid,
  .input-group,
  form {
    display: none !important;
  }
  
  .wizard-container,
  .calculator-card {
    box-shadow: none !important;
    padding: 0 !important;
    background: white !important;
    border: none !important;
  }
  
  .results,
  #results {
    border-top: none !important;
    padding-top: 0 !important;
    background: white !important;
  }
}

</style>

  <div class="wizard-page">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
      <a href="/wizards-catalog" class="back-link" data-testid="link-back-catalog">← Back to Wizards Catalog</a>
    </div>

  <div class="page-header">
    <div class="page-header-title">
      <h1>Magic Formula by Measurement</h1>
      <button class="video-button" data-testid="button-watch-tutorial" onclick="alert('Video tutorial coming soon!')">
        <i class="fas fa-play-circle"></i> Watch Tutorial
      </button>
    </div>
    <p>
      Shape your knitting using real measurements instead of stitch counts.
      Enter your starting and ending widths, your row length, and gauge to instantly see your shaping instructions.
    </p>
  </div>

  <div class="wizard-container">
    <form id="wizard-form">
      <div class="toggle-group">
        <div class="units-toggle">
          <button type="button" class="unit-btn active" id="inches-btn" data-unit="in" data-testid="button-unit-inches">Inches</button>
          <button type="button" class="unit-btn" id="cm-btn" data-unit="cm" data-testid="button-unit-cm">Centimeters</button>
        </div>
      </div>

      <div class="form-grid">
        <div class="section-label">Measurements</div>
        
        <div class="form-row-2">
          <div class="floating-input">
            <input 
              type="number" 
              id="startWidth" 
              step="0.25" 
              placeholder=" "
              required
              data-testid="input-start-width"
            />
            <label for="startWidth" id="startWidthLabel">Starting width (in)</label>
          </div>

          <div class="floating-input">
            <input 
              type="number" 
              id="endWidth" 
              step="0.25" 
              placeholder=" "
              required
              data-testid="input-end-width"
            />
            <label for="endWidth" id="endWidthLabel">Ending width (in)</label>
          </div>
        </div>

        <hr class="section-divider" />
        <div class="section-label">Length & Gauge</div>

        <div class="form-row-3">
          <div class="floating-input">
            <input 
              type="number" 
              id="totalLength" 
              step="0.25" 
              placeholder=" "
              required
              data-testid="input-total-length"
            />
            <label for="totalLength" id="totalLengthLabel">Total length (in)</label>
          </div>

          <div class="floating-input">
            <input 
              type="number" 
              id="stitchGauge" 
              step="1" 
              min="1"
              placeholder="16"
              required
              data-testid="input-stitch-gauge"
            />
            <label for="stitchGauge" id="stitchGaugeLabel">Stitches in 4 inches</label>
          </div>

          <div class="floating-input">
            <input 
              type="number" 
              id="rowGauge" 
              step="1" 
              min="1"
              placeholder="24"
              required
              data-testid="input-row-gauge"
            />
            <label for="rowGauge" id="rowGaugeLabel">Rows in 4 inches</label>
          </div>
        </div>

        <hr class="section-divider" />
        <div class="section-label">Shaping Options</div>

        <div class="icon-toggle-group">
          <button type="button" class="icon-toggle active" data-value="both" data-testid="button-shape-both">
            <div class="icon-toggle-box">
              <img src="/images/both-sides-choice.svg" alt="Both sides" />
            </div>
            <span class="icon-toggle-label">Both sides</span>
          </button>
          <button type="button" class="icon-toggle" data-value="one" data-testid="button-shape-one">
            <div class="icon-toggle-box">
              <img src="/images/one-side-choice.svg" alt="One side" />
            </div>
            <span class="icon-toggle-label">One side</span>
          </button>
        </div>
      </div>

      <button type="submit" class="calculate-btn" data-testid="button-calculate">Calculate Shaping</button>
    </form>

    <div id="results" class="results" data-testid="results-section">
      <ActionBar />
      <h2>Your Shaping Instructions</h2>
      <div id="resultsContent" data-testid="results-content"></div>
      
      <button id="breakdownToggle" class="breakdown-toggle" data-testid="button-breakdown-toggle">
        <span class="icon">▶</span> Row-by-row breakdown
      </button>
      <div id="breakdownContent" class="breakdown-content" data-testid="breakdown-content">
        <p class="breakdown-explanation">Stitch counts shown are totals after each shaping action.</p>
        <div class="breakdown-table-wrapper">
          <table class="breakdown-table">
            <thead>
              <tr>
                <th>Row</th>
                <th>Action</th>
                <th>Location</th>
                <th class="sts-col">sts</th>
              </tr>
            </thead>
            <tbody id="breakdownBody"></tbody>
          </table>
        </div>
      </div>
      
      <div class="results-actions" style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem;">
        <button id="copyBtn" class="copy-btn" data-testid="button-copy">
          <i class="fas fa-copy"></i> Copy Instructions
        </button>
      </div>
    </div>
  </div>
  <PrintFooter url={pageUrl} />
</div>

<script is:inline src="/js/generateRowByRow.js"></script>
<script is:inline>
  const inchesBtn = document.getElementById('inches-btn');
  const cmBtn = document.getElementById('cm-btn');
  let useCm = false;

  function updateLabels() {
    const unitShort = useCm ? 'cm' : 'in';
    const gaugeUnit = useCm ? '10 cm' : '4 inches';
    
    document.getElementById('startWidthLabel').textContent = `Starting width (${unitShort})`;
    document.getElementById('endWidthLabel').textContent = `Ending width (${unitShort})`;
    document.getElementById('totalLengthLabel').textContent = `Total length (${unitShort})`;
    document.getElementById('stitchGaugeLabel').textContent = `Stitches in ${gaugeUnit}`;
    document.getElementById('rowGaugeLabel').textContent = `Rows in ${gaugeUnit}`;
  }

  // Render SVG shaping diagram with trapezoid, labels, and shorthand
  function renderShapingDiagram(startSts, endSts, mode, direction, steps) {
    const isIncrease = direction === 'increase';
    
    // Get polygon points based on mode and direction
    // Points order: top-left, top-right, bottom-right, bottom-left
    // For decrease: wide at bottom (starting), narrow at top (ending)
    // For increase: narrow at bottom (starting), wide at top (ending)
    // For one-side: angled line is on the RIGHT side to match the icon
    let polygonPoints;
    if (mode === 'both') {
      if (isIncrease) {
        // Increase: narrow bottom, wide top (symmetrical)
        polygonPoints = '40,30 220,30 200,170 60,170';
      } else {
        // Decrease: wide bottom, narrow top (symmetrical)
        polygonPoints = '60,30 200,30 220,170 40,170';
      }
    } else {
      // One-side mode: angled line on RIGHT side, left side straight
      if (isIncrease) {
        // Increase: narrow bottom-right, wide top-right
        polygonPoints = '40,30 220,30 180,170 40,170';
      } else {
        // Decrease: wide bottom-right, narrow top-right
        polygonPoints = '40,30 180,30 220,170 40,170';
      }
    }
    
    // Label positions - starting is always at bottom, ending at top
    const startingY = 190;
    const endY = 20;
    const startLabel = `starting (${startSts} sts)`;
    const endLabel = `end (${endSts} sts)`;
    
    // Build shorthand text for ALL steps inside the SVG
    let shorthandSvg = '';
    if (steps.length === 1) {
      // Single step - centered
      shorthandSvg = `
        <text x="130" y="95" text-anchor="middle" fill="#1f2937" style="font-size: 28px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${steps[0].sts}–${steps[0].rows}–${steps[0].times}</text>
        <text x="130" y="118" text-anchor="middle" fill="#6b7280" style="font-size: 13px; font-family: system-ui, -apple-system, sans-serif; font-style: italic;">sts – rows – times</text>
      `;
    } else if (steps.length === 2) {
      // Two steps - stacked inside the shape
      shorthandSvg = `
        <text x="130" y="75" text-anchor="middle" fill="#1f2937" style="font-size: 24px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${steps[0].sts}–${steps[0].rows}–${steps[0].times}</text>
        <text x="130" y="110" text-anchor="middle" fill="#1f2937" style="font-size: 24px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${steps[1].sts}–${steps[1].rows}–${steps[1].times}</text>
        <text x="130" y="135" text-anchor="middle" fill="#6b7280" style="font-size: 13px; font-family: system-ui, -apple-system, sans-serif; font-style: italic;">sts – rows – times</text>
      `;
    } else if (steps.length > 2) {
      // Multiple steps - list them all
      let yPos = 60;
      steps.forEach(step => {
        shorthandSvg += `<text x="130" y="${yPos}" text-anchor="middle" fill="#1f2937" style="font-size: 20px; font-weight: 600; font-family: 'JetBrains Mono', monospace;">${step.sts}–${step.rows}–${step.times}</text>`;
        yPos += 28;
      });
      shorthandSvg += `<text x="130" y="${yPos + 5}" text-anchor="middle" fill="#6b7280" style="font-size: 13px; font-family: system-ui, -apple-system, sans-serif; font-style: italic;">sts – rows – times</text>`;
    }
    
    return `
      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; margin: 1rem 0;">
        <div style="width: 100%; max-width: 320px;">
          <svg viewBox="0 0 260 200" style="width: 100%; height: auto; display: block;" aria-label="Shaping diagram showing ${direction} from ${startSts} to ${endSts} stitches on ${mode === 'both' ? 'both sides' : 'one side'}">
            <polygon points="${polygonPoints}" fill="none" stroke="#52682D" stroke-width="6" stroke-linejoin="round"/>
            <text x="25" y="${startingY}" fill="#6b7280" style="font-size: 14px; font-family: system-ui, -apple-system, sans-serif;">${startLabel}</text>
            <text x="235" y="${endY}" text-anchor="end" fill="#6b7280" style="font-size: 14px; font-family: system-ui, -apple-system, sans-serif;">${endLabel}</text>
            ${shorthandSvg}
          </svg>
        </div>
      </div>
    `;
  }

  const savedUnit = localStorage.getItem('kbm-unit-preference') || 'in';
  if (savedUnit === 'cm') {
    useCm = true;
    inchesBtn.classList.remove('active');
    cmBtn.classList.add('active');
  } else {
    useCm = false;
    inchesBtn.classList.add('active');
    cmBtn.classList.remove('active');
  }
  updateLabels();

  inchesBtn.addEventListener('click', function() {
    if (!useCm) return;
    useCm = false;
    inchesBtn.classList.add('active');
    cmBtn.classList.remove('active');
    localStorage.setItem('kbm-unit-preference', 'in');
    updateLabels();
  });

  cmBtn.addEventListener('click', function() {
    if (useCm) return;
    useCm = true;
    cmBtn.classList.add('active');
    inchesBtn.classList.remove('active');
    localStorage.setItem('kbm-unit-preference', 'cm');
    updateLabels();
  });

  document.querySelectorAll('.icon-toggle').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.icon-toggle').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
    });
  });

  document.getElementById('wizard-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const startWidth = parseFloat(document.getElementById('startWidth').value);
    const endWidth = parseFloat(document.getElementById('endWidth').value);
    const totalLength = parseFloat(document.getElementById('totalLength').value);
    const stitchGaugeRaw = parseFloat(document.getElementById('stitchGauge').value);
    const rowGaugeRaw = parseFloat(document.getElementById('rowGauge').value);
    const sides = document.querySelector('.icon-toggle.active').dataset.value;

    // Convert gauge from 4"/10cm to per-unit values
    const gaugeDivisor = useCm ? 10 : 4;
    const stitchGauge = stitchGaugeRaw / gaugeDivisor;
    const rowGauge = rowGaugeRaw / gaugeDivisor;

    const startStitches = Math.round(startWidth * stitchGauge);
    const endStitches = Math.round(endWidth * stitchGauge);
    const stitchDifference = endStitches - startStitches;
    const totalRows = Math.round(totalLength * rowGauge);

    let instructions = '';
    
    if (stitchDifference === 0) {
      instructions += `<p><strong>No shaping needed!</strong></p>`;
      instructions += `<p>Your starting and ending widths are the same (${startStitches} stitches).</p>`;
      instructions += `<p>Simply knit ${totalRows} rows with no increases or decreases.</p>`;
      document.getElementById('breakdownToggle').style.display = 'none';
    } else {
      const isIncrease = stitchDifference > 0;
      const totalStitchChange = Math.abs(stitchDifference);
      
      let shapingCount;
      if (sides === 'both') {
        if (totalStitchChange % 2 !== 0) {
          instructions += `<div class="note" style="background: #f8d7da; border-color: #f5c6cb;">`;
          instructions += `<strong>Cannot shape evenly on both sides!</strong><br>`;
          instructions += `Your stitch difference (${totalStitchChange}) is odd and cannot be split evenly between two sides.<br>`;
          instructions += `Please adjust your measurements to create an even stitch difference, or choose "One side only" shaping.`;
          instructions += `</div>`;
          
          document.getElementById('resultsContent').innerHTML = instructions;
          document.getElementById('results').classList.add('show');
          document.getElementById('breakdownToggle').style.display = 'none';
          window.currentInstructions = document.getElementById('resultsContent').innerText;
          return;
        }
        shapingCount = totalStitchChange / 2;
      } else {
        shapingCount = totalStitchChange;
      }
      
      if (shapingCount > totalRows) {
        instructions += `<div class="note" style="background: #f8d7da; border-color: #f5c6cb;">`;
        instructions += `<strong>Not enough rows!</strong><br>`;
        instructions += `You need ${shapingCount} ${isIncrease ? 'increases' : 'decreases'} but only have ${totalRows} rows.<br>`;
        instructions += `Please increase your total length or reduce the width difference.`;
        instructions += `</div>`;
        
        document.getElementById('resultsContent').innerHTML = instructions;
        document.getElementById('results').classList.add('show');
        document.getElementById('breakdownToggle').style.display = 'none';
        window.currentInstructions = document.getElementById('resultsContent').innerText;
        return;
      }
      
      const spacing = Math.floor(totalRows / shapingCount);
      const remainder = totalRows % shapingCount;
      
      const action = isIncrease ? 'increase' : 'decrease';
      const actionCap = isIncrease ? 'Increase' : 'Decrease';
      const sidePrefix = sides === 'both' ? 'On each side' : 'On one side only';
      const direction = isIncrease ? 'increase' : 'decrease';
      const mode = sides === 'both' ? 'both' : 'one';
      
      // Build shaping steps array for diagram
      let shapingSteps = [];
      
      if (remainder === 0) {
        shapingSteps = [{ sts: 1, rows: spacing, times: shapingCount }];
      } else {
        const timesAtLonger = remainder;
        const timesAtShorter = shapingCount - remainder;
        const longerInterval = spacing + 1;
        if (timesAtShorter > 0) {
          shapingSteps.push({ sts: 1, rows: spacing, times: timesAtShorter });
        }
        shapingSteps.push({ sts: 1, rows: longerInterval, times: timesAtLonger });
      }
      
      // Build row-by-row breakdown using the reusable utility
      // The steps array uses alternating intervals (longer first, then shorter)
      const timesAtLonger = remainder;
      const timesAtShorter = shapingCount - remainder;
      const longerInterval = spacing + 1;
      
      // Build steps array for the utility (longer intervals first for proper row distribution)
      const breakdownSteps = [];
      if (timesAtLonger > 0) {
        breakdownSteps.push({ sts: 1, rows: longerInterval, times: timesAtLonger });
      }
      if (timesAtShorter > 0) {
        breakdownSteps.push({ sts: 1, rows: spacing, times: timesAtShorter });
      }
      
      // Use the reusable generateRowByRow utility
      const breakdown = window.generateRowByRow({
        startingStitches: startStitches,
        steps: breakdownSteps,
        shapingMode: mode,
        direction: direction
      });
      
      // Render the SVG diagram first
      instructions += renderShapingDiagram(startStitches, endStitches, mode, direction, shapingSteps);
      
      instructions += `<p><strong>Summary:</strong></p>`;
      instructions += `<p>Starting stitches: ${startStitches}</p>`;
      instructions += `<p>Ending stitches: ${endStitches}</p>`;
      instructions += `<p>Total rows: ${totalRows}</p>`;
      instructions += `<p>${actionCap}s needed: ${shapingCount} ${sides === 'both' ? 'per side' : 'total'}</p>`;
      instructions += `<p><strong>Instructions:</strong></p>`;
      
      if (remainder === 0) {
        instructions += `<p>${sidePrefix}, ${action} 1 stitch every ${spacing} rows, ${shapingCount} times <span style="font-family: 'JetBrains Mono', monospace; color: #52682d;">(1–${spacing}–${shapingCount} sts/rows/times)</span>.</p>`;
      } else {
        if (timesAtShorter > 0) {
          instructions += `<p>• ${sidePrefix}, ${action} 1 stitch every ${spacing} rows, ${timesAtShorter} times <span style="font-family: 'JetBrains Mono', monospace; color: #52682d;">(1–${spacing}–${timesAtShorter} sts/rows/times)</span>.</p>`;
        }
        instructions += `<p>• ${sidePrefix}, ${action} 1 stitch every ${longerInterval} rows, ${timesAtLonger} times <span style="font-family: 'JetBrains Mono', monospace; color: #52682d;">(1–${longerInterval}–${timesAtLonger} sts/rows/times)</span>.</p>`;
        
        instructions += `<div class="note">`;
        instructions += `<strong>Note:</strong> Your shaping doesn't divide evenly. Alternate between the two intervals above to distribute the shaping evenly across your ${totalRows} rows.`;
        instructions += `</div>`;
      }
      
      // Build breakdown table
      const breakdownBody = document.getElementById('breakdownBody');
      breakdownBody.innerHTML = '';
      
      breakdown.forEach(step => {
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>Row ${step.rowNumber}</td>
          <td>${step.action}</td>
          <td>${step.location}</td>
          <td>${step.stitchesAfter}</td>
        `;
        breakdownBody.appendChild(row);
      });
      
      document.getElementById('breakdownToggle').style.display = 'flex';
    }

    document.getElementById('resultsContent').innerHTML = instructions;
    document.getElementById('results').classList.add('show');
    document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    window.currentInstructions = document.getElementById('resultsContent').innerText;
    
    // Show ActionBar
    const actionBar = document.getElementById('action-bar');
    const printBtn = document.getElementById('print-btn');
    if (actionBar) actionBar.style.display = 'flex';
    if (printBtn) printBtn.style.display = 'block';
  });
  
  // Action Bar buttons
  const actionBarEl = document.getElementById('action-bar');
  const startOverBtn = document.getElementById('start-over-btn');
  const printBtnEl = document.getElementById('print-btn');

  // Start Over handler
  if (startOverBtn) {
    startOverBtn.addEventListener('click', () => {
      document.getElementById('results').classList.remove('show');
      if (actionBarEl) actionBarEl.style.display = 'none';
    });
  }

  // Print handler
  if (printBtnEl) {
    printBtnEl.addEventListener('click', () => {
      window.print();
    });
  }
  
  // Breakdown toggle
  document.getElementById('breakdownToggle').addEventListener('click', function() {
    this.classList.toggle('open');
    document.getElementById('breakdownContent').classList.toggle('show');
  });

  document.getElementById('copyBtn').addEventListener('click', function() {
    if (window.currentInstructions) {
      // Also include breakdown if visible
      let textToCopy = window.currentInstructions;
      const breakdownContent = document.getElementById('breakdownContent');
      if (breakdownContent.classList.contains('show')) {
        const rows = document.querySelectorAll('#breakdownBody tr');
        textToCopy += '\n\nRow-by-row breakdown:\n';
        rows.forEach(row => {
          const cells = row.querySelectorAll('td');
          textToCopy += `${cells[0].textContent}: ${cells[1].textContent} (${cells[2].textContent}) → ${cells[3].textContent}\n`;
        });
      }
      
      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalText = this.innerHTML;
        this.innerHTML = '<i class="fas fa-check"></i> Copied!';
        setTimeout(() => {
          this.innerHTML = originalText;
        }, 2000);
      });
    }
  });
</script>

</BaseLayout>
