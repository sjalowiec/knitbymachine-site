---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Application Received | Knit by Machine";
const description = "Your Guided Workshop application has been received and is under review.";
---

<BaseLayout {title} {description}>
  <main class="page page--received">
    <section class="section">
      <div class="section-inner">
        <div class="grid grid--two grid--reverse-mobile">
          <div class="content-col">
            <h1 data-testid="text-page-title">Application received</h1>
            
            <p class="intro-text">
              Thanks for applying to a Guided Workshop. I've received your application and will review it personally.
            </p>

            <h2>What happens next</h2>
            
            <ul class="next-steps-list">
              <li>I'll review your project details and timeline</li>
              <li>You'll hear from me by email within 1–2 business days</li>
              <li>If it's a good fit, I'll send next steps, including pricing and a start window</li>
            </ul>

            <p class="closing-text">
              You don't need to do anything else right now.
            </p>
            
            <p class="closing-text closing-text--secondary">
              If questions come up while you're waiting, you can reply directly to the confirmation email.
            </p>
          </div>

          <div class="image-col">
            <img 
              src="/images/knit-by-machine-sue.png" 
              alt="Sue from Knit by Machine" 
              class="sue-image"
              data-testid="img-sue"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page--received {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .section-inner {
    max-width: 100%;
  }

  .grid--two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .grid--reverse-mobile {
    /* On desktop: content left, image right */
  }

  .content-col {
    order: 1;
  }

  .image-col {
    order: 2;
    display: flex;
    justify-content: flex-end;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--kbm-green);
    margin: 0 0 1.25rem;
    line-height: 1.2;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 2rem 0 1rem;
  }

  .intro-text {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    color: #5a6b47;
    line-height: 1.7;
    margin-bottom: 0;
  }

  .next-steps-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0;
  }

  .next-steps-list li {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .next-steps-list li:last-child {
    margin-bottom: 0;
  }

  .closing-text {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.7;
    margin: 2rem 0 0;
  }

  .closing-text--secondary {
    margin-top: 1rem;
    color: #6b7a5a;
  }

  .sue-image {
    max-width: 220px;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .page--received {
      padding: 2rem 1rem 3rem;
    }

    .grid--two {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .grid--reverse-mobile .content-col {
      order: 2;
    }

    .grid--reverse-mobile .image-col {
      order: 1;
      justify-content: center;
    }

    .sue-image {
      max-width: 180px;
    }
  }
</style>
