---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin - Knit by Machine" description="KBM Admin Dashboard">
  <div class="admin-dashboard">
    <header class="admin-header">
      <h1>Admin Dashboard</h1>
      <p class="admin-subtitle">Manage your Knit by Machine content</p>
    </header>

    <section class="admin-cards">
      <a href="/admin/wizards" class="admin-card" data-testid="link-wizards">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 4V2"/>
            <path d="M15 16v-2"/>
            <path d="M8 9h2"/>
            <path d="M20 9h2"/>
            <path d="M17.8 11.8 19 13"/>
            <path d="M15 9h.01"/>
            <path d="M17.8 6.2 19 5"/>
            <path d="m3 21 9-9"/>
            <path d="M12.2 6.2 11 5"/>
          </svg>
        </div>
        <h2>Wizards</h2>
        <p>Create and manage KBM wizard JSON.</p>
      </a>

      <a href="/admin/videos" class="admin-card" data-testid="link-videos">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.934a.5.5 0 0 0-.777-.416L16 11"/>
            <rect x="2" y="6" width="14" height="12" rx="2"/>
          </svg>
        </div>
        <h2>Videos</h2>
        <p>Manage your video content collection.</p>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .admin-dashboard {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .admin-header {
    margin-bottom: 2rem;
  }

  .admin-header h1 {
    margin: 0 0 0.5rem 0;
    font-size: 1.75rem;
  }

  .admin-subtitle {
    margin: 0;
    color: #666;
    font-size: 1rem;
  }

  .admin-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .admin-card {
    display: block;
    background: #f8faf5;
    border: 1px solid #d8e2cc;
    border-radius: 10px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .admin-card:hover {
    border-color: var(--kbm-green, #52682d);
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.15);
  }

  .card-icon {
    color: var(--kbm-green, #52682d);
    margin-bottom: 1rem;
  }

  .admin-card h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    color: var(--kbm-green, #52682d);
  }

  .admin-card p {
    margin: 0;
    color: #666;
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
