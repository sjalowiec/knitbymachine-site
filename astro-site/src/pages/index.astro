---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Start Here | Knit by Machine</title>
    <meta
      name="description"
      content="New to machine knitting? Start here. Find your next step, build skills, and get guidance one small win at a time."
    />
  </head>

  <body>
    <Header />

    <!-- Immediate localStorage check to prevent flash of content -->
    <script is:inline>
      (function() {
        if (window.localStorage.getItem('kbmIntroDismissed') === 'true') {
          document.write('<style>.kbm-intro-wrapper { display: none !important; }</style>');
        }
      })();
    </script>

    <!-- Welcome Intro Banner + Drawer -->
    <div class="kbm-intro-wrapper" data-kbm-intro-wrapper data-testid="welcome-intro-wrapper">
      <div class="kbm-intro-banner" data-kbm-intro-banner data-testid="welcome-intro-banner">
        <div class="kbm-intro-banner-inner">
          <span class="kbm-intro-banner-text">
            Welcome! Knit by Machine is brand new —
            <button
              type="button"
              class="kbm-intro-banner-inline-link"
              data-kbm-intro-open
              data-testid="button-see-intro"
            >
              see what's here and what's coming.
            </button>
          </span>
          <button
            type="button"
            class="kbm-intro-banner-close"
            data-kbm-intro-dismiss
            aria-label="Hide this message"
            data-testid="button-dismiss-banner"
          >
            ×
          </button>
        </div>
      </div>

      <section
        class="kbm-intro-drawer"
        data-kbm-intro-drawer
        aria-hidden="true"
        data-testid="welcome-intro-drawer"
      >
        <div class="kbm-intro-drawer-header">
          <h2 class="kbm-intro-drawer-title">
            Hi, I'm Sue — welcome to the new Knit by Machine.
          </h2>
          <button
            type="button"
            class="kbm-intro-drawer-close"
            aria-label="Close intro"
            data-kbm-intro-close
            data-testid="button-close-drawer"
          >
            ×
          </button>
        </div>

        <p class="kbm-intro-drawer-body">
          Knit by Machine is a fresh, modern home for machine knitters. I'm rebuilding everything to be clearer, calmer, and more confidence-boosting.
        </p>
        <p class="kbm-intro-drawer-body">
          You'll find smart tools, Skill Builders, Ask 'n Answer Answers (ANA), and simple next steps to help you feel successful with your machine.
        </p>

        <div class="kbm-intro-drawer-actions">
          <a href="/about" class="kbm-intro-secondary" data-testid="link-about-kbm">
            About Knit by Machine
          </a>
        </div>

        <p class="kbm-intro-subtext">
          Just browsing? You can close this and explore on your own.
        </p>
      </section>
    </div>

    <main class="kbm-start-here">
      <!-- HERO SECTION -->
      <section class="kbm-hero">
        <div class="kbm-hero__grid">
          <div class="kbm-hero__content">
            <h1>Machine knitting doesn’t have to be overwhelming - I’ll guide your next step.</h1>
            <p class="kbm-hero__text">
              You don’t need to figure it out alone — I’ll help you move forward, one clear step at a time.
            </p>
            <div class="kbm-hero__actions">
              <a href="#where-are-you" class="btn primary" data-testid="button-find-next-step">Find your next step</a>
            </div>
          </div>
          <div class="kbm-hero__image">
            <picture>
              <source srcset="/images/machine-knitting-cast-on.webp" type="image/webp" />
              <img 
                src="/images/machine-knitting-cast-on.webp" 
                alt="A knitting machine set up and ready to knit." 
                loading="eager"
                data-testid="img-hero"
              />
            </picture>
          </div>
        </div>
      </section>

      <!-- WHERE ARE YOU RIGHT NOW? SECTION -->
      <section id="where-are-you" class="kbm-where-section journey-section">
        <div class="kbm-section-header">
          <h2>Where are you right now?</h2>
          <p class="kbm-section-subtitle">Pick the path that fits you best.</p>
        </div>

        <div class="journey-track" aria-hidden="true">
          <div class="journey-line"></div>
          <div class="journey-hex">
            <svg width="28" height="32" viewBox="0 0 32 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 0L30.9282 9V27L16 36L1.0718 27V9L16 0Z" stroke="#52682D" stroke-width="1.5" fill="none"/>
            </svg>
          </div>
        </div>

        <div class="kbm-hex-grid">
          <!-- Card 1: Start Phase -->
          <div class="pulse-once">
            <a href="/getting-started" class="kbm-hex-card kbm-hex-card--link" data-testid="card-start-phase">
            <div class="kbm-hex-icon">
              <img src="/images/knit.svg" alt="Start phase icon" />
            </div>
            <h3>I just opened the box… where do I start?</h3>
            <p>You're in the <strong>Start</strong> phase. All you need right now is one simple win.</p>
            <p class="kbm-highlight">Next step: Make your first swatch.</p>
            <span class="btn primary" data-testid="button-getting-started">Get Started</span>
            </a>
          </div>

          <!-- Card 2: Build Skills Phase -->
          <a href="/skillbuilder-catalog" class="kbm-hex-card kbm-hex-card--link" data-testid="card-skills-phase">
            <div class="kbm-hex-icon">
              <img src="/images/practice-icon.svg" alt="Build skills icon" />
            </div>
            <h3>I know the basics. I want to build skills.</h3>
            <p>You're in the <strong>Build Skills</strong> phase.</p>
            <p class="kbm-highlight">Next step: Visit Skill Builders.</p>
            <span class="btn primary" data-testid="button-skill-builders">Explore Skill Builders</span>
          </a>

          <!-- Card 3: Make Projects Phase -->
          <a href="/agents/ready-set-knit-projects/" class="kbm-hex-card kbm-hex-card--link" data-testid="card-projects-phase">
            <div class="kbm-hex-icon">
              <img src="/images/guide-icon.svg" alt="Make projects icon" />
            </div>
            <h3>I want to knit an actual project.</h3>
            <p>You're in the <strong>Make Projects</strong> phase.</p>
            <p class="kbm-highlight">Next step: choose one easy win.</p>
            <span class="btn primary" data-testid="button-rsk">Ready Set Knit</span>
          </a>

          <!-- Card 4: Troubleshoot Phase -->
          <a href="/agents/ready-set-knit-troubleshooting/" class="kbm-hex-card kbm-hex-card--link" data-testid="card-troubleshoot-phase">
            <div class="kbm-hex-icon">
              <img src="/images/troubleshoot.svg" alt="Troubleshoot icon" />
            </div>
            <h3>Something went wrong.</h3>
            <p>You're in the <strong>Troubleshoot</strong> phase.</p>
            <p class="kbm-highlight">Next step: get a quick answer.</p>
            <span class="btn primary" data-testid="button-troubleshoot">Troubleshoot</span>
          </a>
        </div>

      </section>

      <!-- GUIDED START CTA - Rounded section with background image -->
      <section class="kbm-guided-cta" data-testid="section-guided-cta">
        <div class="kbm-guided-cta__overlay"></div>
        <div class="kbm-guided-cta__inner">
          <div class="kbm-guided-cta__box">
            <h2 class="kbm-guided-cta__title">Not sure which one fits?</h2>
            <p class="kbm-guided-cta__text">Answer a couple of quick questions and I'll recommend your best next step.</p>
            <a href="https://knitbymachine.com/getting-started" class="btn primary" data-testid="button-guided-start">Try the Guided Start</a>
          </div>
        </div>
      </section>

      <!-- WHAT YOU'LL FIND SECTION -->
      <section class="kbm-reassurance-section">
        <div class="kbm-section-header">
          <h2>What you'll find at Knit by Machine</h2>
        </div>

        <div class="kbm-reassurance-grid">
          <div class="kbm-reassurance-item" data-testid="reassurance-next-steps">
            <h4>Clear next steps</h4>
            <p>You don't have to figure it out alone. I'll point you to the one thing to do next so you can keep moving without overwhelm.</p>
          </div>

          <div class="kbm-reassurance-item" data-testid="reassurance-tools">
            <h4>Tools that do the hard parts</h4>
            <p>Let the site handle the math, shaping, and planning. You focus on knitting, not calculations.</p>
          </div>

          <div class="kbm-reassurance-item" data-testid="reassurance-support">
            <h4>Support when you get stuck</h4>
            <p>Troubleshooters, Smart Guides, and Ask 'n Answer are here to help you fix problems and finish more projects.</p>
          </div>
        </div>
      </section>

      <!-- ABOUT-LITE STRIP -->
      <section class="kbm-about-strip">
        <div class="kbm-about-strip__inner">
          <div class="kbm-about-strip__image">
            <img src="/images/sue_icon9.png" alt="Sue at a knitting machine." data-testid="img-sue-headshot" />
          </div>
          <div class="kbm-about-strip__content">
            <h3>You're not doing this alone.</h3>
            <p>
              I'm Sue, your guide here at Knit by Machine. I've helped thousands of knitters 
              get comfortable at their machines. I'll walk with you one small win at a time.
            </p>
            <a href="/about" class="kbm-about-link" data-testid="link-about">Learn more about Knit by Machine</a>
          </div>
        </div>
      </section>
    </main>

    <!-- Lead Magnet Floating Button -->
    <button
      id="lead-magnet-trigger"
      type="button"
      class="fixed bottom-6 right-4 z-40 px-4 py-2 rounded-full bg-[#6E8B3D] text-white text-sm font-medium shadow-lg hover:bg-[#52682D] hover:scale-105 transition-transform transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#6E8B3D]"
      data-testid="button-lead-magnet-trigger"
    >
      Free Project Tool
    </button>

    <!-- Lead Magnet Modal -->
    <div
      id="lead-magnet-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="lead-magnet-title"
      data-lead-magnet-backdrop
      data-testid="modal-lead-magnet"
    >
      <div class="relative w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl">
        <button
          type="button"
          class="absolute right-3 top-3 text-slate-500 hover:text-slate-700 focus:outline-none"
          aria-label="Close"
          data-lead-magnet-close
          data-testid="button-lead-magnet-close"
        >
          &#10005;
        </button>
        <h2
          id="lead-magnet-title"
          class="text-xl font-semibold text-slate-900 mb-2"
        >
          Get Your Free MSK Project Tool
        </h2>
        <p class="text-sm text-slate-600 mb-4">
          Share your email and I'll send you a simple "My Starting Knit" (MSK) project based on your machine, yarn, and confidence level. It's a small, do-able project to help you get knitting right away.
        </p>

        <!-- ActiveCampaign form goes here -->
        <div id="lead-magnet-form" class="mt-4" data-testid="container-lead-magnet-form">
          <!-- TODO: Paste ActiveCampaign embed form code here -->
          <p class="text-xs text-slate-400">
            Sign-up form will appear here when you paste your ActiveCampaign embed code.
          </p>
        </div>
      </div>
    </div>

    <!-- Lead Magnet Modal Script -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        window.addEventListener('DOMContentLoaded', () => {
          const trigger = document.getElementById('lead-magnet-trigger');
          const modal = document.getElementById('lead-magnet-modal');
          if (!trigger || !modal) return;

          const closeButtons = modal.querySelectorAll('[data-lead-magnet-close]');
          const backdrop = modal;

          const openLeadMagnetModal = () => {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
          };

          const closeLeadMagnetModal = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          };

          trigger.addEventListener('click', openLeadMagnetModal);

          closeButtons.forEach((btn) => {
            btn.addEventListener('click', closeLeadMagnetModal);
          });

          backdrop.addEventListener('click', (event) => {
            // Close if clicking on the backdrop, not inside the card
            if (event.target === backdrop) {
              closeLeadMagnetModal();
            }
          });

          window.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
              closeLeadMagnetModal();
            }
          });
        });
      }
    </script>

    <Footer />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const wrapper = document.querySelector('[data-kbm-intro-wrapper]');
        const banner = document.querySelector('[data-kbm-intro-banner]');
        const drawer = document.querySelector('[data-kbm-intro-drawer]');
        const openButtons = document.querySelectorAll('[data-kbm-intro-open]');
        const drawerCloseButtons = document.querySelectorAll('[data-kbm-intro-close]');
        const bannerDismissButtons = document.querySelectorAll('[data-kbm-intro-dismiss]');

        if (!wrapper || !banner || !drawer) return;

        const introDismissed = window.localStorage.getItem('kbmIntroDismissed') === 'true';

        if (introDismissed) {
          wrapper.classList.add('hidden');
          return;
        }

        const openDrawer = () => {
          drawer.classList.add('kbm-intro-drawer--open');
          drawer.setAttribute('aria-hidden', 'false');
        };

        const closeDrawer = () => {
          drawer.classList.remove('kbm-intro-drawer--open');
          drawer.setAttribute('aria-hidden', 'true');
        };

        openButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            openDrawer();
          });
        });

        drawerCloseButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            closeDrawer();
          });
        });

        bannerDismissButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            window.localStorage.setItem('kbmIntroDismissed', 'true');
            wrapper.classList.add('hidden');
          });
        });
      });
    </script>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  :root {
    --kbm-green: #52682d;
    --kbm-green-hover: #445626;
    --kbm-green-2: #738c52;
    --font: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    background: #f7f8f7;
    font-family: var(--font);
    color: #222;
  }

  /* ========== MAIN WRAPPER ========== */
  .kbm-start-here {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  /* ========== SHARED BUTTON STYLES ========== */
  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid transparent;
    transition: background-color 0.2s ease;
  }

  .btn.primary {
    background-color: var(--kbm-green);
    color: #fff;
  }

  .btn.primary:hover {
    background-color: var(--kbm-green-hover);
  }

  /* ========== SECTION HEADERS ========== */
  .kbm-section-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .kbm-section-header h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: #2c3a57;
    margin: 0 0 0.5rem;
  }

  .kbm-section-subtitle {
    color: #4d5a48;
    font-size: 1rem;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ========== HERO SECTION ========== */
  .kbm-hero {
    margin-bottom: 1.5rem;
    padding-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .kbm-hero {
      padding-top: 0.5rem;
    }
  }

  .kbm-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .kbm-hero__content {
    text-align: center;
  }

  .kbm-hero__eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--kbm-green-2);
    margin-bottom: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(115, 140, 82, 0.12);
    border-radius: 999px;
  }

  .kbm-hero h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0 0 1rem;
    color: #2c3a57;
    line-height: 1.3;
  }

  .kbm-hero__text {
    max-width: 42rem;
    margin: 0 auto 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #4d5a48;
  }

  .kbm-hero__actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  .kbm-hero__image {
    display: flex;
    justify-content: center;
  }

  .kbm-hero__image img {
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    background: #e0e5d8;
    min-height: 200px;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .kbm-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .kbm-hero__content {
      text-align: left;
    }

    .kbm-hero__text {
      margin-left: 0;
    }

    .kbm-hero__actions {
      justify-content: flex-start;
    }

    .kbm-hero__image img {
      max-width: 100%;
    }

    .kbm-start-here {
      padding-top: 0;
    }
  }

  /* ========== WHERE ARE YOU SECTION ========== */
  .kbm-where-section {
    margin-bottom: 3rem;
    padding-top: 1rem;
    scroll-margin-top: calc(var(--header-height, 160px) + 1rem);
  }

  .kbm-hex-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 600px) {
    .kbm-hex-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .kbm-hex-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .kbm-hex-card {
    background-color: #ffffff;
    border-radius: 1.25rem;
    padding: 1.5rem 1.25rem;
    border: 2px solid #c7d8a4;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }

  .kbm-hex-card:hover {
    background-color: #f6f8f2;
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(82, 104, 45, 0.12);
    border-color: var(--kbm-green);
  }

  .kbm-hex-card--link {
    text-decoration: none;
    cursor: pointer;
    color: inherit;
  }

  .kbm-hex-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 1rem;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kbm-hex-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .kbm-hex-card h3 {
    font-size: 1rem;
    color: #2c3a57;
    margin: 0 0 0.75rem;
    line-height: 1.35;
  }

  .kbm-hex-card p {
    font-size: 0.9rem;
    color: #4f5a4b;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .kbm-highlight {
    font-weight: 600;
    color: var(--kbm-green);
    font-style: italic;
  }

  .kbm-hex-card .btn {
    margin-top: auto;
    text-align: center;
    font-size: 0.85rem;
    padding: 0.55rem 1rem;
  }

  .kbm-link-list {
    padding-left: 1.1rem;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: #4f5a4b;
  }

  .kbm-link-list li {
    margin-bottom: 0.4rem;
    line-height: 1.45;
  }

  .kbm-link-list a {
    color: var(--kbm-green);
    font-weight: 600;
    text-decoration: none;
  }

  .kbm-link-list a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ========== GUIDED START CTA (ROUNDED SECTION WITH BG IMAGE) ========== */
  .kbm-guided-cta {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: url('/images/knitting-machine-needlebed.webp') center/cover no-repeat;
    padding: 3rem 1.5rem;
    margin: 2.5rem 0 0;
  }

  .kbm-guided-cta__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(241, 246, 236, 0.75);
    pointer-events: none;
  }

  .kbm-guided-cta__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kbm-guided-cta__box {
    max-width: 720px;
    width: 100%;
    margin: 1rem auto;
    padding: 2rem 1.5rem;
    border-radius: 24px;
    background-color: #F1F6EC;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    text-align: center;
  }

  .kbm-guided-cta__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: #2c3a57;
  }

  .kbm-guided-cta__text {
    font-size: 1rem;
    margin: 0 0 1.5rem;
    line-height: 1.5;
    color: #4f5a4b;
  }

  @media (min-width: 768px) {
    .kbm-guided-cta {
      padding: 4rem 2rem;
    }

    .kbm-guided-cta__box {
      padding: 3rem 3.5rem;
      border-radius: 32px;
    }

    .kbm-guided-cta__title {
      font-size: 1.9rem;
    }

    .kbm-guided-cta__text {
      font-size: 1.05rem;
    }
  }

  /* ========== REASSURANCE SECTION ========== */
  .kbm-reassurance-section {
    margin-bottom: 1.5rem;
    padding: 2rem 0;
  }

  .kbm-reassurance-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .kbm-reassurance-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .kbm-reassurance-item {
    text-align: center;
    padding: 1.25rem;
  }

  @media (min-width: 768px) {
    .kbm-reassurance-item {
      text-align: left;
    }
  }

  .kbm-reassurance-item h4 {
    font-size: 1.05rem;
    color: #2c3a57;
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .kbm-reassurance-item p {
