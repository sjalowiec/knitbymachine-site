---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

const title = "Help Hub | Knit by Machine";
const description = "Find answers, ask the community, look up terms, or contact us.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Help Hub" 
      iconPath="/images/ana-icon.svg"
      iconAlt="Help Hub icon"
    />

    <div class="intro-section">
      <p class="intro-text">
        Not sure where to start? This is the place.<br>
        Choose the option that fits what you need right now:
      </p>
    </div>

    <div class="cards-grid" data-testid="help-hub-grid">
      <a href="/ana-catalog" class="hub-card" data-testid="card-answers">
        <h3 class="card-title">Find an Answer</h3>
        <p class="card-body">
          Search clear, focused answers to common machine knitting questions - one question at a time.
        </p>
        <span class="card-cta">Browse Answers &rarr;</span>
      </a>

      <a href="/community" class="hub-card" data-testid="card-community">
        <h3 class="card-title">Ask the Community</h3>
        <p class="card-body">
          See what other machine knitters are working on, or ask a question and get help from people who've been there.
        </p>
        <span class="card-cta">Visit the Community &rarr;</span>
      </a>

      <a href="/glossary" class="hub-card" data-testid="card-glossary">
        <h3 class="card-title">Look Up a Term</h3>
        <p class="card-body">
          Quick definitions and explanations for machine knitting terms and concepts.
        </p>
        <span class="card-cta">View the Glossary &rarr;</span>
      </a>

      <a href="/contact" class="hub-card" data-testid="card-contact">
        <h3 class="card-title">Still Stuck?</h3>
        <p class="card-body">
          If your question is about your account, access, or something on the site, you can reach us directly.
        </p>
        <span class="card-cta">Contact Us &rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 0 2.5rem;
    text-align: left;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.7;
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .hub-card {
    background-color: #f9fdf5;
    border: 1px solid #c7d8a4;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hub-card:hover {
    border-color: #52682D;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.1);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #52682D;
    margin: 0;
    line-height: 1.3;
  }

  .card-body {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .card-cta {
    display: inline-block;
    color: #52682D;
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .hub-card:hover .card-cta {
    color: #738C52;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .intro-section {
      margin-bottom: 2rem;
    }
  }
</style>
