---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllSoftware, getSoftwareBySlug } from '../../lib/software/getSoftwareById';

export async function getStaticPaths() {
  const software = getAllSoftware();
  return software.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { slug } = Astro.params;
const product = getSoftwareBySlug(slug);

if (!product) {
  return Astro.redirect('/404');
}
---

<BaseLayout 
  title={`${product.name} | Knit by Machine`}
  description={product.tagline}
>
  <article class="software-detail-page">
    
    {product.icon && (
      <div class="product-icon">
        <img src={product.icon} alt={product.name} />
      </div>
    )}
    
    <h1>{product.name}</h1>
    <p class="tagline">{product.tagline}</p>
    
    <section class="outcomes-section">
      <h2>What You Can Do With This Version</h2>
      <ul>
        {product.outcomes.map((outcome) => (
          <li>{outcome}</li>
        ))}
      </ul>
    </section>
    
    <section class="included-section">
      <h2>What's Included</h2>
      <ul>
        {product.included.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
    
    <div class="cta-section">
      <a href={product.purchaseUrl} class="btn-primary">Buy / Upgrade</a>
    </div>
    
  </article>
</BaseLayout>

<style>
  .software-detail-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .product-icon {
    margin-bottom: 1.5rem;
  }

  .product-icon img {
    max-width: 200px;
    height: auto;
    border-radius: 8px;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--kbm-green);
  }

  .tagline {
    font-size: 1.125rem;
    color: #555;
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: #333;
  }

  .outcomes-section,
  .included-section {
    margin-bottom: 2rem;
  }

  ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0;
  }

  li {
    margin-bottom: 0.5rem;
    color: #444;
    line-height: 1.5;
  }

  .cta-section {
    margin-top: 2rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.875rem 1.75rem;
    background: var(--kbm-green);
    color: white;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--kbm-green-2);
  }
</style>
