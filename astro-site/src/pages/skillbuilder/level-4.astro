---
import BaseLayout from '../../layouts/BaseLayout.astro';

const LEVEL = 4;
const LEVEL_TITLE = "Ribber & Double Bed";
const LEVEL_SUBHEAD = "Expand your machine with two-bed knitting.";
const LEVEL_DESCRIPTION = "Learn the fundamentals of working with a ribber or double bed, including ribbing, double-knit fabrics, and more advanced structures. These small, skill-focused exercises open up a whole new range of possibilities at your machine.";

let builders = [];
let errorMessage = '';

try {
  const response = await fetch('https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/skillbuilders');
  
  if (response.ok) {
    const directories = await response.json();
    
    const builderPromises = directories
      .filter(dir => dir.type === 'dir')
      .map(async (dir) => {
        try {
          const fileResponse = await fetch(`https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/skillbuilders/${dir.name}/data.json`);
          const fileData = await fileResponse.json();
          const content = Buffer.from(fileData.content, 'base64').toString('utf-8');
          const data = JSON.parse(content);
          return {
            slug: data.slug || dir.name,
            title: data.title,
            description: data.description,
            tagline: data.tagline,
            level: data.level,
            moduleCount: data.modules?.length || 0,
            prepCount: data.prepChecklist?.length || 0,
            isDraft: data.isDraft,
            pendingPublish: data.pendingPublish,
            publishedDate: data.publishedDate,
          };
        } catch (e) {
          console.error(`Error fetching skill builder ${dir.name}:`, e);
          return null;
        }
      });
    
    const allBuilders = await Promise.all(builderPromises);
    builders = allBuilders.filter(builder => 
      builder && 
      !builder.isDraft && 
      !builder.pendingPublish && 
      builder.level === LEVEL
    );
  }
} catch (error) {
  console.error('Error fetching skill builders:', error);
  errorMessage = error.message;
}

const title = `${LEVEL_TITLE} - Skill Builders`;
const description = LEVEL_SUBHEAD;
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <div class="back-link fade-in">
      <a href="/skillbuilder-catalog">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="back-icon">
          <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
        </svg>
        Back to Skill Builders
      </a>
    </div>

    <div class="hero-panel fade-in">
      <div class="hero-icon">
        <img src="/images/level-4.svg" alt="Level 4" class="level-icon" />
      </div>
      <div class="hero-content">
        <span class="level-pill">Level {LEVEL}</span>
        <h1 class="hero-title">{LEVEL_TITLE}</h1>
        <p class="hero-subhead">{LEVEL_SUBHEAD}</p>
        <p class="hero-description">{LEVEL_DESCRIPTION}</p>
      </div>
    </div>

    <div class="section-header fade-in">
      <h2 class="section-title">Skills in this level</h2>
    </div>

    <div id="catalogueContent" class="catalogue-content fade-in">
      {errorMessage && (
        <div class="error">
          <p><strong>Error loading skill builders</strong></p>
          <p>Unable to fetch skill builders. Please try again later.</p>
        </div>
      )}
      
      {!errorMessage && builders.length === 0 && (
        <div class="empty-state">
          <h3>No skill builders yet</h3>
          <p>Check back soon—we're adding new skills to this level!</p>
        </div>
      )}

      {builders.length > 0 && (
        <div class="builder-grid">
          {builders.map(builder => (
            <div class="builder-card">
              <a href={`/skillbuilder/${builder.slug}`} class="builder-title">{builder.title}</a>
              {builder.tagline && <p class="builder-tagline">{builder.tagline}</p>}
              <p class="builder-description">{builder.description}</p>
              <div class="builder-meta">
                <span class="builder-meta-item">📚 {builder.moduleCount} {builder.moduleCount === 1 ? 'module' : 'modules'}</span>
                {builder.prepCount > 0 && (
                  <span class="builder-meta-item">✓ {builder.prepCount} prep {builder.prepCount === 1 ? 'item' : 'items'}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 3rem;
  }

  .back-link {
    margin-bottom: 1.5rem;
  }

  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #52682D;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .back-link a:hover {
    color: #738C52;
  }

  .back-icon {
    width: 20px;
    height: 20px;
  }

  .hero-panel {
    background-color: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(82, 104, 45, 0.1);
    padding: 2rem 2.5rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .hero-icon {
    flex-shrink: 0;
  }

  .level-icon {
    width: 100px;
    height: auto;
  }

  .hero-content {
    flex: 1;
  }

  .level-pill {
    display: inline-block;
    background-color: #e6eddc;
    color: #52682D;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.9rem;
    border-radius: 50px;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    color: #52682D;
    font-size: 2.25rem;
    margin: 0 0 0.75rem 0;
    font-weight: 700;
  }

  .hero-subhead {
    color: #52682D;
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    max-width: 700px;
  }

  .hero-description {
    color: #555;
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
    max-width: 700px;
  }

  .section-header {
    margin-bottom: 1.5rem;
  }

  .section-title {
    color: #52682D;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .catalogue-content {
    position: relative;
  }

  .builder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .builder-card {
    background: white;
    border: 2px solid #e6eddc;
    border-radius: 14px;
    padding: 1.75rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.08);
  }

  .builder-card:hover {
    border-color: #738C52;
    box-shadow: 0 6px 20px rgba(82, 104, 45, 0.15);
    transform: translateY(-3px);
  }

  .builder-title {
    color: #52682D;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    text-decoration: none;
    display: block;
  }

  .builder-title:hover {
    color: #738C52;
  }

  .builder-tagline {
    font-style: italic;
    color: #738C52;
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
  }

  .builder-description {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .builder-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: #666;
    padding-top: 1rem;
    border-top: 1px solid #e6eddc;
  }

  .builder-meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .error {
    background-color: #fef2f2;
    border: 2px solid #fca5a5;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    color: #991b1b;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: #666;
    background: white;
    border-radius: 14px;
    border: 2px solid #e6eddc;
  }

  .empty-state h3 {
    color: #52682D;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .fade-in {
    animation: fadeIn 0.6s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero-panel {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      gap: 1.5rem;
    }

    .level-icon {
      width: 80px;
    }

    .hero-title {
      font-size: 1.75rem;
    }

    .builder-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
