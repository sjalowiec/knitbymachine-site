---
import Layout from "../../layouts/layout.astro";
const supportEmail = "sue@knitbymachine.com";
---

<Layout>
  <style>
    main {
      max-width: 900px;
      padding: 140px 20px 60px;
      margin: 0 auto;
    }

    h2 {
      font-size: 1.5rem;
      color: var(--kbm-green);
      margin-bottom: 0.5rem;
    }

    .page-header {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .page-header-icon {
      width: clamp(80px, 8vw, 96px);
      height: clamp(80px, 8vw, 96px);
      flex-shrink: 0;
      object-fit: contain;
    }

    .page-header h1 {
      font-size: clamp(2.25rem, 4vw, 3rem);
      font-weight: 700;
      color: var(--kbm-green, #52682d);
      margin: 0;
      line-height: 1.2;
    }

    .intro-copy {
      margin-bottom: 1rem;
    }

    @media (max-width: 768px) {
      .page-header {
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
      }

      .page-header-icon {
        align-self: center;
        width: clamp(64px, 15vw, 80px);
        height: clamp(64px, 15vw, 80px);
      }
    }

    .direct-email {
      margin-top: 1rem;
      font-size: 0.95rem;
    }

    .direct-email a {
      color: #2C3A57;
      text-decoration: underline;
      text-underline-offset: 2px;
      font-weight: 500;
    }

    .contact-wrap {
      max-width: 680px;
      margin: 0 auto;
      padding: 2rem 1rem 3rem;
      text-align: left;
    }

    /* ===== Netlify Contact Form Styles ===== */
    .contact-form {
      max-width: 640px;
      margin: 1.5rem auto;
      background: #fff;
      border-radius: 12px;
      border: 1px solid #e5e8e0;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      padding: 2rem;
    }

    .contact-form__field {
      display: flex;
      flex-direction: column;
      margin-bottom: 1.25rem;
    }

    .contact-form__field span {
      font-weight: 600;
      color: #2C3A57;
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
    }

    .contact-form__field input,
    .contact-form__field textarea {
      padding: 0.75rem 1rem;
      font-size: 1rem;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      background: #fafafa;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .contact-form__field input:focus,
    .contact-form__field textarea:focus {
      outline: none;
      border-color: var(--kbm-green);
      box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
      background: #fff;
    }

    .contact-form__field textarea {
      resize: vertical;
      min-height: 120px;
    }

    .contact-form__submit {
      background-color: var(--kbm-green);
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      padding: 0.85rem 1.5rem;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
      transition: background-color 0.2s, transform 0.1s;
      width: 100%;
    }

    .contact-form__submit:hover {
      background-color: var(--kbm-green-2);
    }

    .contact-form__submit:active {
      transform: scale(0.98);
    }

    .hidden {
      display: none !important;
    }

    /* ===== Success Message Styling ===== */
    .contact-success {
      background: #f6f8f5;
      border: 2px solid var(--kbm-green);
      border-radius: 12px;
      padding: 2rem 1.5rem;
      text-align: center;
      color: #2C3A57;
      max-width: 640px;
      margin: 1.5rem auto;
      box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      animation: fadeInUp 0.6s ease both;
    }

    .contact-success::before {
      content: "";
      display: block;
      width: 72px;
      height: 72px;
      margin: 0 auto 1rem;
      background-image: url("/images/envelope.svg");
      background-size: contain;
      background-repeat: no-repeat;
      background-position: center;
      opacity: 0.9;
    }

    .contact-success h2 {
      color: var(--kbm-green);
      margin-bottom: 0.75rem;
    }

    .contact-success p {
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .contact-success a {
      color: var(--kbm-green);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>

  <div class="page-header">
    <img src="/images/envelope.svg" alt="Contact icon" class="page-header-icon" />
    <h1>Contact Us</h1>
  </div>
  <div class="intro-copy">
    <p><b>Have a question or comment? I’m here to help.</b><br>
Use the form below to reach me directly. I typically reply within <b>1–2 business days.</b></p>
    <p>I try to respond within 1–2 business days.</p>
    <div class="direct-email">
      Prefer email? Reach me directly at
      <a href="mailto:sue@knitbymachine.com">sue@knitbymachine.com</a>
    </div>
  </div>

  <section class="contact-wrap">
    <h2>Send a message</h2>
    <p>I read every note and respond personally.</p>

    <!-- Netlify-powered Contact form -->
    <form
      id="contactForm"
      name="contact-sue"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value="contact-sue" />
      <input type="hidden" name="submission-type" value="contact" />
      <input type="hidden" name="submitted-at" id="contactSubmittedAt" value="" />
      
      <!-- Honeypot for spam -->
      <p class="hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>

      <label class="contact-form__field">
        <span>Name</span>
        <input type="text" name="name" required />
      </label>

      <label class="contact-form__field">
        <span>Email</span>
        <input type="email" name="email" required />
      </label>

      <label class="contact-form__field">
        <span>Your message</span>
        <textarea name="message" rows="6" required></textarea>
      </label>

      <button type="submit" class="contact-form__submit">
        Send message
      </button>
    </form>

    <!-- Inline success message (hidden until form submits) -->
    <div id="contactSuccess" class="contact-success hidden">
      <h2>Thank you — your message has been sent.</h2>
      <p>I'll read it soon and reply if needed. While you're here, you can also explore <a href="/ana-catalog">ANA</a>, <a href="/wizards-catalog">Tools</a>, or <a href="/glossary">Glossary</a> for quick help.</p>
    </div>

    <script>
      document.getElementById('contactForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const form = e.target;
        
        // Add submission timestamp
        const now = new Date();
        const timestamp = now.toLocaleString('en-US', { 
          dateStyle: 'medium', 
          timeStyle: 'short',
          timeZone: 'America/New_York'
        });
        document.getElementById('contactSubmittedAt').value = timestamp;
        
        const formData = new FormData(form);
        
        // POST to the blueprint page where Netlify detects the form
        fetch('/contact-form.html', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString()
        })
        .then(response => {
          if (response.ok) {
            // Hide form and show success message
            form.classList.add('hidden');
            document.getElementById('contactSuccess').classList.remove('hidden');
          } else {
            alert('Something went wrong. Please try again.');
          }
        })
        .catch(error => {
          console.error('Form submission error:', error);
          alert('Something went wrong. Please try again.');
        });
      });
    </script>
  </section>
</Layout>
