---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

const title = "Project Walkthroughs | Knit by Machine";
const description = "Develop machine-knitting skills through guided projects that explain the how and why behind each step.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Project Walkthroughs" 
      iconPath="/images/workshop_icon.png"
      iconAlt="Project Walkthrough icon"
    />

    <h2 class="page-tagline">Want to build skills by knitting real projects? Follow a clear path.</h2>

    <div class="intro-section">
      <p class="intro-text">
        Project Walkthroughs help you develop machine-knitting skills by working through complete projects with structured guidance. Each walkthrough focuses on how and why a project comes together — not just the finished result.
      </p>
    </div>

    <div class="cards-grid" data-testid="project-walkthroughs-grid">
      <div class="info-card" data-testid="card-what-they-are">
        <h2 class="card-title">What they are</h2>
        <p class="card-body">Project Walkthroughs are guided project experiences. They follow a real project from start to finish, showing the full process with context and explanation along the way.</p>
      </div>

      <div class="info-card" data-testid="card-how-they-work">
        <h2 class="card-title">How they work</h2>
        <p class="card-body">Each walkthrough focuses on technique, setup, and sequencing. Decisions are explained as they come up, so you can apply the same thinking to future projects.</p>
      </div>

      <div class="info-card" data-testid="card-what-to-use-now">
        <h2 class="card-title">What to use now</h2>
        <p class="card-body"><a href="/practice-projects">Practice Projects</a> and <a href="/patterns">Patterns</a> support the same techniques and decisions covered in Project Walkthroughs.</p>
      </div>
    </div>

    <p class="project-types-note">
      Project types and formats will vary by walkthrough.
    </p>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .page-tagline {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    font-weight: 500;
    color: #5a6b47;
    text-align: left;
    margin: -1.5rem 0 2rem;
    line-height: 1.4;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 0 3rem;
    text-align: left;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .info-card {
    background-color: #f9fdf5;
    border: 1px solid #c7d8a4;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #52682D;
    margin: 0;
    line-height: 1.3;
  }

  .card-body {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .card-body a {
    color: #52682D;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .card-body a:hover {
    color: #738C52;
  }

  .project-types-note {
    font-size: 0.9rem;
    color: #6b7280;
    text-align: center;
    margin: 0;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .intro-section {
      margin-bottom: 2rem;
    }
  }
</style>
