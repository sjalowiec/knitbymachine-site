---
import Layout from "../layouts/layout.astro";
import SectionHero from "../components/SectionHero.astro";

// Helper to normalize image paths - handles full URLs, paths, and bare filenames
function normalizeGlossaryImagePath(imageValue: string | null | undefined): string | null {
  if (!imageValue) return null;
  
  // If it's already a full URL or absolute path, return as-is
  if (imageValue.startsWith('http://') || imageValue.startsWith('https://') || imageValue.startsWith('/')) {
    return imageValue;
  }
  
  // Otherwise, it's just a filename - prepend the glossary images directory
  return `/images/glossary/${imageValue}`;
}

// Fetch glossary terms from individual JSON files in GitHub at build time
let allTerms = [];
let errorMessage = '';

try {
  const response = await fetch('https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/astro-site/src/content/glossary');
  
  if (response.ok) {
    const files = await response.json();
    
    // Fetch each JSON file's content
    const termPromises = files
      .filter(file => file.name.endsWith('.json'))
      .map(async (file) => {
        try {
          const fileResponse = await fetch(file.download_url);
          const data = await fileResponse.json();
          
          // Handle both old format (title) and new format (term)
          const termName = data.term || data.title;
          const definition = data.description || data.definition;
          
          // Validate required fields
          if (!termName || !data.slug || !definition) {
            console.warn(`Skipping invalid glossary entry in ${file.name}: missing required fields`);
            return null;
          }
          
          return {
            _id: data.slug,
            title: termName,
            slug: data.slug,
            excerpt: data.tooltip || data.excerpt || '',
            definition: definition,
            example: data.example || '',
            image: normalizeGlossaryImagePath(data.imageFilename || data.image),
            imageAlt: data.imageAlt || '',
            aliases: [],
            isDraft: data.isDraft || false,
            pendingPublish: data.pendingPublish || false,
          };
        } catch (error) {
          console.error(`Error fetching glossary file ${file.name}:`, error);
          return null;
        }
      });
    
    const fetchedTerms = await Promise.all(termPromises);
    
    // Filter out null entries, drafts, and pending publish entries, then sort alphabetically
    allTerms = fetchedTerms
      .filter(term => term !== null && !term.isDraft && !term.pendingPublish)
      .sort((a, b) => (a.title || '').localeCompare(b.title || ''));
  }
} catch (error) {
  console.error('Error fetching glossary terms:', error);
  errorMessage = error.message;
}

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");

const lettersWithTerms = new Set(
  allTerms.map(term => term.title.charAt(0).toUpperCase())
);

const title = "Machine Knitting Terms Glossary";
const description = "Your key to understanding abbreviations and terms used in machine knitting patterns and vintage publications.";
---

<Layout bodyClass="has-catalog-search">
  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .glossary-search {
      flex: 1;
      max-width: 400px;
      min-width: 250px;
    }

    .glossary-search form {
      display: flex;
      gap: 0.5rem;
    }

    .kbm-search-input {
      flex: 1;
      padding: 0.5rem 0.875rem;
      border: 2px solid #c7d8a4;
      border-radius: 50px;
      font-size: var(--text-sm);
      background: #fff;
    }

    .kbm-search-input:focus {
      outline: none;
      border-color: var(--kbm-green);
      box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
    }

    .kbm-search-btn {
      padding: 0.5rem 0.875rem;
      background: var(--kbm-green);
      color: #fff;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      font-size: var(--text-sm);
      transition: background 0.2s ease;
    }

    .kbm-search-btn:hover {
      background: var(--kbm-green-2);
    }

    .tap-hint {
      font-size: var(--text-base);
      color: #6b7280;
      margin: 0.5rem 0 0 0;
      font-style: italic;
    }


    .alphabet-filter {
      position: sticky;
      top: var(--header-height);
      background: #fff;
      z-index: 1100;
      padding: 1.25rem;
      margin: 0 auto 2rem auto;
      max-width: 1200px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .alphabet {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
    }

    .alphabet a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      font-size: var(--text-base);
      color: #1f2937;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      transition: all 0.2s ease;
    }

    .alphabet a:hover:not(.disabled) {
      background: #f0f4ea;
      color: var(--kbm-green);
      border-color: var(--kbm-green);
    }

    .alphabet a.active {
      background: var(--kbm-green);
      color: #fff;
      border-color: var(--kbm-green);
    }

    .alphabet a.disabled {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
      margin-bottom: 3rem;
    }

    .term-card {
      border: 1px solid rgba(82, 104, 45, 0.18);
      border-radius: 16px;
      background: #fff;
      overflow: hidden;
      box-shadow: 0 8px 22px rgba(0,0,0,0.06);
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .term-card:hover {
      box-shadow: 0 12px 28px rgba(0,0,0,0.1);
      transform: translateY(-2px);
    }

    .term-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .term-card-link:focus-visible {
      outline: 3px solid rgba(199, 216, 164, 0.85);
      outline-offset: 3px;
    }

    .term-media {
      border-bottom: 1px solid rgba(82, 104, 45, 0.14);
      background: #f7f7f4;
    }

    .term-media img {
      display: block;
      width: 100%;
      height: auto;
    }

    .term-content {
      padding: .9rem 1rem 1.1rem;
    }

    .term-title {
      margin: 0 0 .35rem;
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--kbm-green, #52682d);
    }

    .term-card-link:hover .term-title {
      text-decoration: underline;
    }

    .term-tooltip {
      margin: 0;
      font-size: .95rem;
      line-height: 1.55;
      color: #5a6b47;
    }

    .no-results {
      text-align: center;
      padding: 3rem 1.5rem;
      background: #f9fafb;
      border-radius: 16px;
      margin: 2rem 0;
    }

    .no-results h2 {
      color: #1f2937;
      margin: 0 0 0.5rem 0;
    }

    .no-results p {
      color: #6b7280;
      margin: 0;
    }

    .error {
      padding: 2rem;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 12px;
      color: #991b1b;
    }

    @media (min-width: 769px) and (max-width: 1024px) {
      .card-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1025px) {
      .card-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    /* Mobile alphabet control - hidden by default */
    .alpha-mobile { display: none; }

    @media (max-width: 768px) {
      .alphabet-filter { display: none; }
      
      .alpha-mobile { 
        display: block; 
        margin: 0 auto 1rem; 
        padding: 0 1.5rem; 
        max-width: 1200px; 
      }

      .alpha-mobile-btn {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .75rem 1rem;
        border-radius: 999px;
        border: 1px solid rgba(82, 104, 45, 0.22);
        background: #fff;
        color: var(--kbm-green, #52682d);
        font-weight: 800;
        font-size: var(--text-base);
        cursor: pointer;
        font-family: inherit;
      }

      .alpha-mobile-caret {
        transition: transform 0.2s ease;
      }

      .alpha-mobile-btn[aria-expanded="true"] .alpha-mobile-caret {
        transform: rotate(180deg);
      }

      .alpha-mobile-panel {
        margin-top: .75rem;
        border-radius: 16px;
        border: 1px solid rgba(82, 104, 45, 0.18);
        background: #fff;
        padding: .75rem;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
      }

      .alpha-mobile-letters {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: .35rem;
      }

      .alpha-mobile-letters a {
        text-align: center;
        padding: .5rem 0;
        border-radius: 10px;
        font-weight: 800;
        color: var(--kbm-green, #52682d);
        text-decoration: none;
        border: 1px solid rgba(82, 104, 45, 0.14);
        transition: all 0.15s ease;
      }

      .alpha-mobile-letters a:hover:not(.disabled) {
        background: #f0f4ea;
        border-color: var(--kbm-green);
      }

      .alpha-mobile-letters a.active {
        background: var(--kbm-green);
        color: #fff;
        border-color: var(--kbm-green);
      }

      .alpha-mobile-letters a.disabled {
        opacity: .35;
        pointer-events: none;
      }

      .card-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (min-width: 769px) and (max-width: 1024px) {
      .alphabet-filter {
        top: var(--header-height);
      }

      .glossary-search {
        max-width: none;
      }

      .alphabet {
        gap: 0.35rem;
      }

      .alphabet a {
        width: 36px;
        height: 36px;
        font-size: 0.9rem;
      }

      .card-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <SectionHero 
    title={title} 
    subtitle={description}
    iconPath="/images/glossary/glossary_logo.svg"
    iconAlt="Glossary"
  >
    <p class="tap-hint">Tap a term to see the full explanation.</p>
    <div slot="toolbar" class="glossary-search">
      <form method="get" action="/glossary" id="searchForm">
        <input
          type="text"
          name="q"
          placeholder="Search glossary terms..."
          class="kbm-search-input"
          id="searchInput"
        />
        <button type="submit" class="kbm-search-btn" aria-label="Search">
          <i class="fa fa-search"></i>
        </button>
      </form>
    </div>
  </SectionHero>
  
  <div class="alphabet-filter">
    <div class="alphabet">
      <a href="/glossary" class="active" id="filterAll">All</a>
      {alphabet.map((letter) => {
        const hasTerms = lettersWithTerms.has(letter);
        return (
          <a
            href={`#${letter}`}
            class={!hasTerms ? "disabled" : ""}
            data-letter={letter}
          >
            {letter}
          </a>
        );
      })}
    </div>
  </div>

  <div class="alpha-mobile">
    <button type="button" class="alpha-mobile-btn" aria-expanded="false" aria-controls="alphaMobilePanel">
      Jump to a letter
      <span class="alpha-mobile-caret">▾</span>
    </button>

    <div id="alphaMobilePanel" class="alpha-mobile-panel" hidden>
      <div class="alpha-mobile-letters">
        <a href="/glossary" class="active" id="filterAllMobile">All</a>
        {alphabet.map((letter) => {
          const hasTerms = lettersWithTerms.has(letter);
          return (
            <a
              href={`#${letter}`}
              class={!hasTerms ? "disabled" : ""}
              data-letter={letter}
            >
              {letter}
            </a>
          );
        })}
      </div>
    </div>
  </div>
  
  <div class="container">
    {errorMessage ? (
      <div class="error">
        <p><strong>Error loading glossary terms</strong></p>
        <p>Unable to fetch terms from GitHub. Please try again later.</p>
        <p style="font-size: 0.9rem; margin-top: 1rem;">{errorMessage}</p>
      </div>
    ) : (
      <div class="card-grid" id="termGrid" data-terms={JSON.stringify(allTerms)}>
        {allTerms.length > 0 ? (
          allTerms.map((term) => {
            const altText = term.imageAlt || term.title;

            return (
              <article class="term-card" data-title={term.title.toLowerCase()}>
                <a href={`/glossary/${term.slug}`} class="term-card-link">
                  {term.image && (
                    <div class="term-media">
                      <img src={term.image} alt={altText} loading="lazy" class="kbm-reference-image" />
                    </div>
                  )}
                  <div class="term-content">
                    <h2 class="term-title">{term.title}</h2>
                    {term.excerpt && <p class="term-tooltip">{term.excerpt}</p>}
                  </div>
                </a>
              </article>
            );
          })
        ) : (
          <div class="no-results">
            <h2>No terms found</h2>
            <p>Check back soon as we add more glossary terms.</p>
          </div>
        )}
      </div>
    )}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('.term-card');
      const searchInput = document.getElementById('searchInput');
      const letterLinks = document.querySelectorAll('.alphabet a[data-letter]');
      const allLink = document.getElementById('filterAll');
      const termGrid = document.getElementById('termGrid');
      
      // Mobile alphabet panel elements
      const alphaMobileBtn = document.querySelector('.alpha-mobile-btn');
      const alphaMobilePanel = document.getElementById('alphaMobilePanel');
      const mobileLetterLinks = document.querySelectorAll('.alpha-mobile-letters a[data-letter]');
      const allLinkMobile = document.getElementById('filterAllMobile');
      
      let currentFilter = { search: '', letter: '' };

      // Mobile panel toggle
      function toggleMobilePanel() {
        const isOpen = alphaMobilePanel.hidden === false;
        alphaMobilePanel.hidden = isOpen;
        alphaMobileBtn.setAttribute('aria-expanded', !isOpen);
      }

      function closeMobilePanel() {
        alphaMobilePanel.hidden = true;
        alphaMobileBtn.setAttribute('aria-expanded', 'false');
      }

      alphaMobileBtn?.addEventListener('click', toggleMobilePanel);

      // Close mobile panel on outside click
      document.addEventListener('click', (e) => {
        if (alphaMobilePanel && !alphaMobilePanel.hidden) {
          const isInsidePanel = alphaMobilePanel.contains(e.target);
          const isButton = alphaMobileBtn.contains(e.target);
          if (!isInsidePanel && !isButton) {
            closeMobilePanel();
          }
        }
      });

      // Filter functionality
      function filterTerms() {
        cards.forEach(card => {
          const title = card.dataset.title || '';
          const firstLetter = title.charAt(0).toUpperCase();
          
          let show = true;
          
          // Search filter
          if (currentFilter.search) {
            const searchLower = currentFilter.search.toLowerCase();
            show = title.includes(searchLower);
          }
          
          // Letter filter
          if (show && currentFilter.letter) {
            show = firstLetter === currentFilter.letter;
          }
          
          card.style.display = show ? '' : 'none';
        });

        // Check if any cards are visible
        const visibleCards = Array.from(cards).filter(card => card.style.display !== 'none');
        const noResults = document.querySelector('.no-results');
        
        if (visibleCards.length === 0 && !noResults) {
          const noResultsDiv = document.createElement('div');
          noResultsDiv.className = 'no-results';
          noResultsDiv.innerHTML = '<h2>No terms found</h2><p>Try adjusting your search or filters.</p>';
          termGrid.appendChild(noResultsDiv);
        } else if (visibleCards.length > 0 && noResults) {
          noResults.remove();
        }
      }

      // Search functionality
      searchInput?.addEventListener('input', (e) => {
        currentFilter.search = e.target.value;
        filterTerms();
      });

      // Helper to sync active states across desktop and mobile
      function syncActiveStates(letter) {
        // Update desktop
        letterLinks.forEach(l => l.classList.remove('active'));
        allLink?.classList.remove('active');
        
        // Update mobile
        mobileLetterLinks.forEach(l => l.classList.remove('active'));
        allLinkMobile?.classList.remove('active');
        
        if (letter) {
          // Activate specific letter in both
          letterLinks.forEach(l => {
            if (l.dataset.letter === letter) l.classList.add('active');
          });
          mobileLetterLinks.forEach(l => {
            if (l.dataset.letter === letter) l.classList.add('active');
          });
        } else {
          // Activate "All" in both
          allLink?.classList.add('active');
          allLinkMobile?.classList.add('active');
        }
      }

      // Letter filter (desktop)
      letterLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const letter = link.dataset.letter;
          
          currentFilter.letter = letter;
          syncActiveStates(letter);
          filterTerms();
        });
      });

      // Letter filter (mobile)
      mobileLetterLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const letter = link.dataset.letter;
          
          currentFilter.letter = letter;
          syncActiveStates(letter);
          filterTerms();
          closeMobilePanel();
        });
      });

      // All filter (desktop)
      allLink?.addEventListener('click', (e) => {
        e.preventDefault();
        
        currentFilter.letter = '';
        syncActiveStates('');
        filterTerms();
      });

      // All filter (mobile)
      allLinkMobile?.addEventListener('click', (e) => {
        e.preventDefault();
        
        currentFilter.letter = '';
        syncActiveStates('');
        filterTerms();
        closeMobilePanel();
      });
    });
  </script>
</Layout>
