---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';

let entries = [];
let errorMessage = '';

try {
  const response = await fetch('https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/astro-site/src/content/workshops');
  
  if (!response.ok) {
    throw new Error(`Failed to fetch workshops: ${response.status}`);
  }
  
  const files = await response.json();
  
  const entryPromises = files
    .filter((file: any) => file.name.endsWith('.json'))
    .map(async (file: any) => {
      const fileResponse = await fetch(file.download_url);
      const data = await fileResponse.json();
      return {
        title: data.title,
        slug: data.slug,
        shortDescription: data.shortDescription || '',
        description: data.description || '',
        category: data.category || 'other',
        tags: data.tags || [],
        level: data.level || '',
        duration: data.duration || '',
        price: data.price || '',
        format: data.format || '',
        dateTime: data.dateTime || null,
        imageUrl: data.imageUrl || '',
        imageAlt: data.imageAlt || '',
        isMemberOnly: data.isMemberOnly || false,
        isFeatured: data.isFeatured || false,
        isDraft: data.isDraft,
        pendingPublish: data.pendingPublish,
        publishedDate: data.publishedDate,
      };
    });
  
  const allEntries = await Promise.all(entryPromises);
  entries = allEntries.filter((entry: any) => !entry.isDraft && !entry.pendingPublish);
} catch (error) {
  console.error('Error fetching workshops:', error);
  errorMessage = error.message;
}

const title = "Workshops";
const description = "Join our live and on-demand workshops to develop your machine knitting skills. From beginner basics to advanced techniques.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Workshops" 
      subtitle="Develop your machine knitting skills through guided instruction. Join live sessions or watch on-demand."
      iconPath="/images/workshop.svg"
      iconAlt="Workshops"
    >
      <div slot="toolbar" class="workshops-toolbar">
        <div class="search-wrapper">
          <input 
            type="text" 
            class="search-input" 
            id="searchInput" 
            placeholder="Search workshops..."
            aria-label="Search workshops"
          >
        </div>
        
        <div class="category-filters-wrapper">
          <div class="category-filters">
            <button class="filter-btn active" data-category="all" aria-label="Show all workshops">
              <img src="/images/all_icon.svg" alt="All" class="filter-icon-img" />
              <span class="filter-text">All</span>
            </button>
            <button class="filter-btn" data-category="learn" aria-label="Filter by Learn">
              <img src="/images/play_icon.svg" alt="Learn" class="filter-icon-img" />
              <span class="filter-text">Learn</span>
            </button>
            <button class="filter-btn" data-category="knit" aria-label="Filter by Knit">
              <img src="/images/knit_icon.svg" alt="Knit" class="filter-icon-img" />
              <span class="filter-text">Knit</span>
            </button>
          </div>
        </div>
      </div>
    </SectionHero>

    <div id="catalogueContent" class="catalogue-content" data-entries={JSON.stringify(entries)}>
      {errorMessage && (
        <div class="error">
          <p><strong>Error loading workshops</strong></p>
          <p>Unable to fetch workshop entries. Please try again later.</p>
          <p style="font-size: 0.9rem; margin-top: 1rem;">{errorMessage}</p>
        </div>
      )}
    </div>
  </div>

  <button id="scrollToTop" class="scroll-to-top" aria-label="Scroll to top">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
    </svg>
  </button>
</BaseLayout>

<style>
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 3rem;
  }

  .workshops-toolbar {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .search-wrapper {
    flex-shrink: 0;
    width: 100%;
    max-width: 320px;
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 1.5rem;
    border: 2px solid #e5e8e0;
    border-radius: 50px;
    font-size: clamp(1.1rem, 2.5vw, 1.2rem);
    background-color: white;
    transition: all 0.3s ease;
    box-sizing: border-box;
    min-height: 44px;
  }

  .search-input:focus {
    outline: none;
    border-color: #52682D;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
  }

  .category-filters-wrapper {
    flex: 1;
    min-width: 0;
  }

  .category-filters {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    padding: 0.5rem 1rem;
  }

  .filter-btn {
    background: transparent;
    border: 3px solid transparent;
    border-radius: 16px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-shrink: 0;
    min-width: 80px;
  }

  .filter-icon-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .filter-btn:hover .filter-icon-img {
    transform: scale(1.1);
  }

  .filter-text {
    font-size: 0.95rem;
    color: #52682D;
    font-weight: 600;
    text-align: center;
  }

  .filter-btn:hover {
    transform: scale(1.05);
  }

  .filter-btn:hover .filter-text {
    color: #3e5023;
  }

  .filter-btn.active {
    border-color: #52682D;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
    background: #f7f8f7;
  }

  @media (min-width: 1024px) {
    .workshops-toolbar {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .search-wrapper {
      width: 100%;
      max-width: 600px;
    }

    .category-filters-wrapper {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .category-filters {
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .filter-text {
      font-size: 1.1rem;
    }

    :global(.section-hero) {
      position: sticky;
      top: 0;
      background: white;
      z-index: 100;
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      transition: box-shadow 0.3s ease;
    }

    :global(.section-hero.scrolled) {
      box-shadow: 0 4px 16px rgba(82, 104, 45, 0.15);
    }
  }

  @media (max-width: 1024px) {
    .filter-icon-img {
      width: 48px;
      height: 48px;
    }

    .filter-text {
      font-size: 0.85rem;
    }
  }

  .catalogue-content {
    position: relative;
  }

  :global(.featured-section) {
    margin-bottom: 2rem;
    padding: 2rem;
    background: linear-gradient(135deg, #f9fdf5 0%, #eef3e4 100%);
    border-radius: 16px;
    border: 2px solid #c7d8a4;
  }

  :global(.featured-title) {
    color: #52682D;
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.featured-title svg) {
    color: #daa520;
  }

  :global(.category-section) {
    margin-bottom: 1.5rem;
    padding: 2.5rem;
    border-radius: 12px;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  :global(.category-section:nth-child(odd)) {
    background-color: #ffffff;
  }

  :global(.category-section:nth-child(even)) {
    background-color: #f9fdf5;
  }

  :global(.category-section.hidden) {
    display: none;
  }

  :global(.section-title) {
    color: #52682D;
    font-size: clamp(1.6rem, 3.5vw, 1.8rem);
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.75rem;
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  :global(.category-icon) {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }

  :global(.category-icon.learn) { background-color: #4a90a4; }
  :global(.category-icon.knit) { background-color: #738c52; }
  :global(.category-icon.other) { background-color: #8b7355; }

  :global(.category-icon svg) {
    width: 24px;
    height: 24px;
  }

  :global(.workshops-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  :global(.workshop-card) {
    position: relative;
    background-color: #ffffff;
    color: #52682D;
    border: 2px solid #c7d8a4;
    padding: 1.75rem;
    border-radius: 1.5rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    opacity: 0;
    transform: translateY(20px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 260px;
  }

  :global(.workshop-card.animate-in) {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.workshop-card:hover) {
    background-color: #f6f8f2;
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(82, 104, 45, 0.15);
    border-color: #52682D;
  }

  :global(.workshop-card.featured) {
    border-color: #daa520;
    box-shadow: 0 4px 12px rgba(218, 165, 32, 0.2);
  }

  :global(.workshop-card.featured:hover) {
    border-color: #b8860b;
    box-shadow: 0 12px 24px rgba(218, 165, 32, 0.25);
  }

  :global(.workshop-card-header) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  :global(.workshop-card-icon) {
    width: 52px;
    height: 52px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 1px 2px rgba(82, 104, 45, 0.25));
  }

  @media (min-width: 768px) {
    :global(.workshop-card-icon) {
      width: 56px;
      height: 56px;
    }
  }

  :global(.workshop-card-title) {
    font-size: clamp(1.3rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #52682D;
    margin: 0;
    line-height: 1.3;
    flex: 1;
  }

  :global(.featured-star) {
    color: #daa520;
    flex-shrink: 0;
  }

  :global(.workshop-card-description) {
    font-size: 1.1rem;
    color: #6b7280;
    line-height: 1.5;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.workshop-card-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  :global(.meta-item) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: #52682D;
  }

  :global(.meta-item svg) {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }

  :global(.workshop-card-badges) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  :global(.workshop-badge) {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  :global(.badge-level) {
    background-color: #e5e8e0;
    color: #52682D;
  }

  :global(.badge-format) {
    background-color: #C7D8A4;
    color: #52682D;
  }

  :global(.badge-price) {
    background-color: #52682D;
    color: white;
  }

  :global(.badge-member) {
    background-color: #8BA556;
    color: white;
  }

  :global(.workshop-card.card-hidden) {
    display: none;
  }

  :global(.workshop-card-image) {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 0.5rem;
  }

  .scroll-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #52682D;
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1000;
  }

  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .scroll-to-top:hover {
    background-color: #3e5023;
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(82, 104, 45, 0.4);
  }

  .scroll-to-top svg {
    width: 24px;
    height: 24px;
  }

  .error {
    text-align: center;
    padding: 3rem;
    color: #d64545;
    background-color: #ffe5e5;
    border-radius: 10px;
    margin: 2rem;
  }

  :global(.no-results) {
    text-align: center;
    padding: 3rem;
    color: #666;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .page-container {
      padding: 2rem 1rem;
    }

    :global(.category-section) {
      padding: 1.5rem 1rem;
      margin-bottom: 2rem;
    }

    :global(.section-title) {
      font-size: 1.4rem;
    }

    :global(.workshops-grid) {
      grid-template-columns: 1fr;
    }

    .scroll-to-top {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 45px;
      height: 45px;
    }
  }
</style>

<script>
  let allEntries = [];
  let currentCategory = 'all';

  const CATEGORY_LABELS = {
    learn: 'Learn',
    knit: 'Knit'
  };

  const CATEGORY_ORDER = ['learn', 'knit'];

  function getCategoryIcon(category) {
    const icons = {
      learn: `<img src="/images/play_icon.svg" alt="Learn" style="width: 32px; height: 32px;" />`,
      knit: `<img src="/images/knit_icon.svg" alt="Knit" style="width: 32px; height: 32px;" />`
    };
    return icons[category] || icons.learn;
  }

  function formatDate(dateTime) {
    if (!dateTime) return '';
    const date = new Date(dateTime);
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    });
  }

  function groupByCategory(entries) {
    const grouped = {};
    CATEGORY_ORDER.forEach(cat => {
      grouped[cat] = [];
    });
    
    entries.forEach(entry => {
      const cat = entry.category || 'other';
      if (!grouped[cat]) {
        grouped[cat] = [];
      }
      grouped[cat].push(entry);
    });
    
    return grouped;
  }

  function renderWorkshopCard(entry, isFeaturedSection = false) {
    const featuredClass = entry.isFeatured && !isFeaturedSection ? 'featured' : '';
    
    let metaHtml = '';
    if (entry.duration) {
      metaHtml += `<span class="meta-item"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>${entry.duration}</span>`;
    }
    if (entry.dateTime) {
      metaHtml += `<span class="meta-item"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>${formatDate(entry.dateTime)}</span>`;
    }
    
    let badgesHtml = '';
    if (entry.level) {
      badgesHtml += `<span class="workshop-badge badge-level">${entry.level}</span>`;
    }
    if (entry.format) {
      badgesHtml += `<span class="workshop-badge badge-format">${entry.format}</span>`;
    }
    if (entry.price) {
      badgesHtml += `<span class="workshop-badge badge-price">${entry.price}</span>`;
    }
    if (entry.isMemberOnly) {
      badgesHtml += `<span class="workshop-badge badge-member">Members</span>`;
    }
    
    const imageHtml = entry.imageUrl 
      ? `<img src="${entry.imageUrl}" alt="${entry.imageAlt || entry.title}" class="workshop-card-image" loading="lazy" />`
      : '';
    
    const cardIconHtml = entry.cardIconUrl
      ? `<img src="${entry.cardIconUrl}" alt="" class="workshop-card-icon" loading="lazy" />`
      : '';
    
    const featuredStar = entry.isFeatured && !isFeaturedSection
      ? `<svg class="featured-star" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
      : '';
    
    return `
      <a href="/workshops/${entry.slug}" 
         class="workshop-card ${featuredClass}" 
         data-title="${entry.title.toLowerCase()}"
         data-tags="${(entry.tags || []).join(' ').toLowerCase()}">
        ${imageHtml}
        <div class="workshop-card-header">
          ${cardIconHtml}
          <h3 class="workshop-card-title">${entry.title}</h3>
          ${featuredStar}
        </div>
        <p class="workshop-card-description">${entry.shortDescription || entry.description}</p>
        ${metaHtml ? `<div class="workshop-card-meta">${metaHtml}</div>` : ''}
        ${badgesHtml ? `<div class="workshop-card-badges">${badgesHtml}</div>` : ''}
      </a>
    `;
  }

  function renderCatalogue(entries) {
    const container = document.getElementById('catalogueContent');
    
    let filteredEntries = entries;
    if (currentCategory !== 'all') {
      filteredEntries = entries.filter(entry => entry.category === currentCategory);
    }
    
    if (filteredEntries.length === 0) {
      container.innerHTML = '<div class="no-results">No workshops found matching your criteria.</div>';
      return;
    }
    
    let html = '';
    
    const featuredEntries = filteredEntries.filter(e => e.isFeatured);
    if (featuredEntries.length > 0 && currentCategory === 'all') {
      html += `
        <div class="featured-section">
          <h2 class="featured-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Featured Workshops
          </h2>
          <div class="workshops-grid">
            ${featuredEntries.map(entry => renderWorkshopCard(entry, true)).join('')}
          </div>
        </div>
      `;
    }
    
    // Render all workshops in a single grid (no category headers)
    const nonFeaturedEntries = currentCategory === 'all' 
      ? filteredEntries.filter(e => !e.isFeatured)
      : filteredEntries;
    
    if (nonFeaturedEntries.length > 0) {
      html += `
        <div class="workshops-grid">
          ${nonFeaturedEntries.map(entry => renderWorkshopCard(entry)).join('')}
        </div>
      `;
    }
    
    container.innerHTML = html;
    
    requestAnimationFrame(() => {
      const cards = container.querySelectorAll('.workshop-card');
      cards.forEach((card, index) => {
        setTimeout(() => {
          card.classList.add('animate-in');
        }, index * 50);
      });
    });
  }

  function filterCards(searchTerm) {
    const cards = document.querySelectorAll('.workshop-card');
    const term = searchTerm.toLowerCase().trim();
    
    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const tags = card.getAttribute('data-tags') || '';
      const visible = !term || title.includes(term) || tags.includes(term);
      card.classList.toggle('card-hidden', !visible);
    });
    
    document.querySelectorAll('.category-section').forEach(section => {
      const visibleCards = section.querySelectorAll('.workshop-card:not(.card-hidden)');
      section.classList.toggle('hidden', visibleCards.length === 0);
    });
    
    const featuredSection = document.querySelector('.featured-section');
    if (featuredSection) {
      const visibleFeatured = featuredSection.querySelectorAll('.workshop-card:not(.card-hidden)');
      featuredSection.classList.toggle('hidden', visibleFeatured.length === 0);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('catalogueContent');
    const entriesData = container?.getAttribute('data-entries');
    
    if (entriesData) {
      try {
        allEntries = JSON.parse(entriesData);
        renderCatalogue(allEntries);
      } catch (e) {
        console.error('Error parsing entries:', e);
      }
    }

    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
      let debounceTimer;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          filterCards(e.target.value);
        }, 200);
      });
    }

    const filterButtons = document.querySelectorAll('.filter-btn');
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-category') || 'all';
        renderCatalogue(allEntries);
        
        const searchInput = document.getElementById('searchInput') as HTMLInputElement;
        if (searchInput && searchInput.value) {
          filterCards(searchInput.value);
        }
      });
    });

    const scrollToTopBtn = document.getElementById('scrollToTop');
    if (scrollToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          scrollToTopBtn.classList.add('visible');
        } else {
          scrollToTopBtn.classList.remove('visible');
        }
      });

      scrollToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
