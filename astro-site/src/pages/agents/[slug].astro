---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readdir, readFile } from "fs/promises";
import path from "path";

export async function getStaticPaths() {
  const contentDir = path.join(process.cwd(), "astro-site/src/content/ai-agents");
  
  try {
    const files = await readdir(contentDir);
    const jsonFiles = files.filter(file => file.endsWith('.json'));
    
    const paths = await Promise.all(
      jsonFiles.map(async (file) => {
        const filePath = path.join(contentDir, file);
        const content = await readFile(filePath, 'utf-8');
        const data = JSON.parse(content);
        
        return {
          params: { slug: data.slug },
          props: { agent: data }
        };
      })
    );
    
    return paths;
  } catch (error) {
    console.error('Error loading AI agents:', error);
    return [];
  }
}

const { agent } = Astro.props;
const pageTitle = agent.metaTitle || `${agent.title} | Knit by Machine`;
const pageDescription = agent.metaDescription || agent.description;
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}>

<style>
.agent-page {
  padding-top: 120px;
  padding-bottom: 3rem;
  min-height: 100vh;
  background: var(--page-bg);
}

.page-header {
  max-width: 900px;
  margin: 0 auto 2rem;
  padding: 0 1rem;
}

.page-header h1 {
  color: var(--kbm-green);
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 0.75rem 0;
  text-align: center;
}

.page-header p {
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
  text-align: center;
}

.agent-container {
  max-width: 900px;
  margin: 0 auto;
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.kbm-agent {
  width: 100%;
  min-height: 700px;
}

.kbm-agent iframe {
  border: none;
  border-radius: 12px;
  width: 100%;
  height: 700px;
}

@media (max-width: 768px) {
  .agent-page {
    padding-top: 100px;
  }
  
  .agent-container {
    padding: 1rem;
  }
  
  .kbm-agent iframe {
    height: 600px;
  }
}
</style>

<div class="agent-page">
  <div class="page-header">
    <h1>{agent.title}</h1>
    {agent.excerpt && <p>{agent.excerpt}</p>}
  </div>

  <div class="agent-container">
    <section class="kbm-agent">
      <iframe 
        src={agent.iframeUrl}
        width="100%"
        height={agent.iframeHeight || "700"}
        style="border: none; border-radius: 12px;"
        title={agent.title}
      ></iframe>
    </section>
  </div>
</div>

</BaseLayout>
