---
export const prerender = false;

import Layout from "../../layouts/layout.astro";

const { slug } = Astro.params;

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const REPO_OWNER = 'sjalowiec';
const REPO_NAME = 'knitbymachine-site';
const CONTENT_PATH = 'astro-site/src/content/ai-agents';

async function getAgentEntry(slug: string) {
  try {
    const url = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${slug}.json`;
    
    const headers: Record<string, string> = {
      'Accept': 'application/vnd.github.v3+json',
      'User-Agent': 'knitbymachine-site'
    };
    
    if (GITHUB_TOKEN) {
      headers['Authorization'] = `token ${GITHUB_TOKEN}`;
    }
    
    const response = await fetch(url, { headers });

    if (!response.ok) {
      console.error('GitHub API error:', response.status, response.statusText);
      return null;
    }

    const data = await response.json();
    const content = atob(data.content);
    const entry = JSON.parse(content);
    
    // Skip entries that are drafts or pending publish
    if (entry.isDraft || entry.pendingPublish) {
      return null;
    }

    return {
      title: entry.title,
      slug: entry.slug,
      description: entry.description || '',
      excerpt: entry.excerpt || '',
      category: entry.category || 'Smart Guides',
      tags: entry.tags || [],
      iframeUrl: entry.iframeUrl || '',
      iconUrl: entry.iconUrl || '',
      htmlContent: entry.htmlContent || '',
      imageUrl: entry.imageUrl || '',
      imageAlt: entry.imageAlt || '',
      metaTitle: entry.metaTitle || entry.title,
      metaDescription: entry.metaDescription || entry.description,
      accessLevel: entry.accessLevel || 'free',
      relatedAnas: entry.relatedAnas || [],
      relatedWorkshops: entry.relatedWorkshops || [],
      publishedDate: entry.publishedDate
    };
  } catch (error) {
    console.error('Error fetching agent entry:', error);
    return null;
  }
}

const entry = await getAgentEntry(slug);

if (!entry) {
  return Astro.redirect('/404');
}

const pageTitle = entry.metaTitle || entry.title;
const pageDescription = entry.metaDescription || entry.description;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="agent-container">
    <a href="/wizards-catalog" class="back-link">← Back to Tools & Resources</a>

    <div class="hero-section">
      {entry.iconUrl && (
        <div class="hero-icon-wrapper">
          <img src={entry.iconUrl} alt={entry.title} class="hero-icon" />
        </div>
      )}
      <h1 class="hero-title">{entry.title}</h1>
      {entry.excerpt && (
        <p class="hero-excerpt">{entry.excerpt}</p>
      )}
    </div>

    <div class="content-section">
      <div class="description-column">
        <h2 class="section-heading">About This Guide</h2>
        <p class="description-text">{entry.description}</p>
        
        {entry.iframeUrl && (
          <a href={entry.iframeUrl} target="_blank" rel="noopener noreferrer" class="launch-button">
            Launch {entry.title}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        )}
      </div>
      
      {entry.htmlContent && (
        <div class="page-content-column">
          <div class="html-content" set:html={entry.htmlContent}></div>
        </div>
      )}
    </div>

    {(entry.relatedAnas.length > 0 || entry.relatedWorkshops.length > 0) && (
      <div class="related-section">
        <h2 class="related-heading">Related Resources</h2>
        <div class="related-links">
          {entry.relatedAnas.map((anaSlug: string) => (
            <a href={`/ana/${anaSlug}`} class="related-link">
              <span class="arrow">→</span> {anaSlug.replace(/-/g, ' ')}
            </a>
          ))}
          {entry.relatedWorkshops.map((workshopSlug: string) => (
            <a href={`/workshops/${workshopSlug}`} class="related-link">
              <span class="arrow">→</span> {workshopSlug.replace(/-/g, ' ')}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .agent-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: #52682D;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    color: #3E5524;
    text-decoration: underline;
  }

  /* Hero Section */
  .hero-section {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #e5e8e0;
  }

  .hero-icon-wrapper {
    margin-bottom: 1.5rem;
  }

  .hero-icon {
    width: 100px;
    height: 100px;
    object-fit: contain;
  }

  .hero-title {
    color: #52682D;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .hero-excerpt {
    color: #6b7280;
    font-size: clamp(1.1rem, 2.5vw, 1.25rem);
    font-style: italic;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Content Section - Two Columns */
  .content-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .description-column {
    display: flex;
    flex-direction: column;
  }

  .section-heading {
    color: #52682D;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
  }

  .description-text {
    color: #374151;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  .launch-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #52682D;
    color: white;
    padding: 1rem 1.75rem;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .launch-button:hover {
    background-color: #3E5524;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.3);
  }

  .launch-button svg {
    flex-shrink: 0;
  }

  /* Page Content Column */
  .page-content-column {
    background-color: #f9fdf5;
    border-radius: 12px;
    padding: 2rem;
    border: 1px solid #e5e8e0;
  }

  .html-content {
    color: #374151;
    font-size: 1rem;
    line-height: 1.7;
  }

  .html-content :global(h1),
  .html-content :global(h2),
  .html-content :global(h3) {
    color: #52682D;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .html-content :global(h1) {
    font-size: 1.5rem;
  }

  .html-content :global(h2) {
    font-size: 1.25rem;
  }

  .html-content :global(h3) {
    font-size: 1.1rem;
  }

  .html-content :global(p) {
    margin-bottom: 1rem;
  }

  .html-content :global(a) {
    color: #52682D;
    text-decoration: underline;
  }

  .html-content :global(a:hover) {
    color: #3E5524;
  }

  .html-content :global(ul),
  .html-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .html-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .html-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1rem 0;
  }

  /* Related Section */
  .related-section {
    padding-top: 2rem;
    border-top: 2px solid #e5e8e0;
  }

  .related-heading {
    color: #52682D;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
  }

  .related-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related-link {
    color: #52682D;
    font-size: 1rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
    text-transform: capitalize;
  }

  .related-link:hover {
    color: #3E5524;
  }

  .related-link:hover .arrow {
    transform: translateX(4px);
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .agent-container {
      padding: 1.5rem 1rem 3rem;
    }

    .hero-icon {
      width: 80px;
      height: 80px;
    }

    .content-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .page-content-column {
      padding: 1.5rem;
    }

    .html-content {
      font-size: 0.95rem;
    }

    .html-content :global(h1) {
      font-size: 1.25rem;
    }

    .html-content :global(h2) {
      font-size: 1.1rem;
    }

    .html-content :global(h3) {
      font-size: 1rem;
    }

    .launch-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
