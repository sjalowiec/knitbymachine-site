---
export const prerender = false;

import Layout from "../../layouts/layout.astro";
import Tooltip from "../../components/Tooltip.astro";
import VimeoEmbed from "../../components/VimeoEmbed.astro";
import DroppedStitchWizard from "../../components/DroppedStitchWizard.astro";
import "../../styles/global.css";
import "../../styles/wizard.css";

const { slug } = Astro.params;

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
const REPO_OWNER = 'sjalowiec';
const REPO_NAME = 'knitbymachine-site';
const CONTENT_PATH = 'src/content/ana';

async function getANAEntry(slug: string) {
  try {
    const response = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${slug}.json`,
      {
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'knitbymachine-astro'
        }
      }
    );

    if (!response.ok) {
      return null;
    }

    const data = await response.json();
    // Properly decode UTF-8 from base64 to handle special characters
    const binaryString = atob(data.content);
    const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
    const content = new TextDecoder('utf-8').decode(bytes);
    const jsonData = JSON.parse(content);

    // Filter out drafts and pending publish entries
    if (jsonData.isDraft || jsonData.pendingPublish) {
      return null;
    }

    return {
      data: jsonData,
      slug: slug
    };
  } catch (error) {
    console.error('Error fetching ANA entry:', error);
    return null;
  }
}

async function fetchRelatedContent(slugs: string[], contentPath: string) {
  const items = [];
  for (const itemSlug of slugs) {
    try {
      const response = await fetch(
        `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${contentPath}/${itemSlug}.json`,
        {
          headers: {
            'Authorization': `token ${GITHUB_TOKEN}`,
            'Accept': 'application/vnd.github.v3+json',
            'User-Agent': 'knitbymachine-astro'
          }
        }
      );
      if (response.ok) {
        const data = await response.json();
        // Properly decode UTF-8 from base64 to handle special characters
        const binaryString = atob(data.content);
        const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
        const content = new TextDecoder('utf-8').decode(bytes);
        const jsonData = JSON.parse(content);
        if (!jsonData.isDraft && !jsonData.pendingPublish) {
          items.push({ ...jsonData, slug: itemSlug });
        }
      }
    } catch (error) {
      console.error(`Error fetching ${contentPath}/${itemSlug}:`, error);
    }
  }
  return items;
}

// Fetch child ANAs for hub/gateway pages (find all ANAs where parentGatewaySlug matches this hub's slug)
async function fetchChildAnas(hubSlug: string) {
  const children = [];
  try {
    // Get all ANA files from GitHub
    const response = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}`,
      {
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'knitbymachine-astro'
        }
      }
    );
    
    if (!response.ok) return children;
    
    const files = await response.json();
    const jsonFiles = files.filter((f: any) => f.name.endsWith('.json'));
    
    // Fetch each file using GitHub API with proper auth (not download_url which lacks auth)
    for (const file of jsonFiles) {
      try {
        const fileResponse = await fetch(
          `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${file.name}`,
          {
            headers: {
              'Authorization': `token ${GITHUB_TOKEN}`,
              'Accept': 'application/vnd.github.v3+json',
              'User-Agent': 'knitbymachine-astro'
            }
          }
        );
        if (!fileResponse.ok) continue;
        
        const fileData = await fileResponse.json();
        // Properly decode UTF-8 from base64
        const binaryString = atob(fileData.content);
        const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
        const content = new TextDecoder('utf-8').decode(bytes);
        const data = JSON.parse(content);
        
        // Skip drafts and check if this ANA is a child of the hub
        if (data.isDraft || data.pendingPublish) continue;
        if (data.parentGatewaySlug === hubSlug) {
          children.push({ ...data, slug: file.name.replace('.json', '') });
        }
      } catch (err) {
        console.error(`Error fetching child ANA ${file.name}:`, err);
      }
    }
  } catch (error) {
    console.error('Error fetching child ANAs:', error);
  }
  return children;
}

const entry = await getANAEntry(slug);

if (!entry) {
  return Astro.redirect('/404');
}

// Check if this is a hub/gateway ANA (defensive: check both type AND children array)
const isHub = entry.data.type === 'gateway' || (Array.isArray(entry.data.children) && entry.data.children.length > 0);

// Fetch child ANAs if this is a hub page
const childAnas = isHub ? await fetchChildAnas(slug) : [];

const relatedAnas = entry.data.relatedAnas?.length 
  ? await fetchRelatedContent(entry.data.relatedAnas, 'src/content/ana')
  : [];

const relatedWorkshops = entry.data.relatedWorkshops?.length
  ? await fetchRelatedContent(entry.data.relatedWorkshops, 'src/content/workshops')
  : [];

const relatedWizards = entry.data.relatedWizards?.length
  ? await fetchRelatedContent(entry.data.relatedWizards, 'src/content/wizards')
  : [];
---

<Layout>
  <div class="ana-container">
    <!-- Back Link -->
    <a href="/ana-catalog" class="back-link" data-testid="link-back-catalog">← Back to Answers</a>

    {/* ========================================
        GATEWAY / HUB RENDERING
        ======================================== */}
    {isHub && (
      <div class="gateway-page" data-testid="gateway-page">
        <header class="gateway-hero">
          <div class="ana-title-row">
            <img src="/images/ask-n-answer_logo.svg" alt="Ask 'n Answer" class="ana-logo-icon" />
            <h1 class="ana-page-title" data-testid="text-page-title">{entry.data.title}</h1>
          </div>
          
          {entry.data.body && entry.data.body.trim() !== '' && (
            <p class="gateway-intro" data-testid="text-gateway-intro">{entry.data.body}</p>
          )}

          {entry.data.tags && entry.data.tags.length > 0 && (
            <div class="gateway-tags" data-testid="gateway-tags">
              {entry.data.tags.map((tag: string) => (
                <span class="gateway-tag">{tag}</span>
              ))}
            </div>
          )}
        </header>

        {relatedAnas.length > 0 && (
          <section class="choose-path-section" data-testid="section-choose-path">
            <h2 class="choose-path-heading">Choose a path</h2>
            <div class="path-cards-grid">
              {relatedAnas.map((leafAna) => (
                <a href={`/ana/${leafAna.slug}`} class="path-card" data-testid={`path-card-${leafAna.slug}`}>
                  <div class="path-card-icon">
                    <img src="/images/ask-n-answer_logo.svg" alt="" class="ana-logo-icon-small" />
                  </div>
                  <div class="path-card-content">
                    <h3 class="path-card-title">{leafAna.title}</h3>
                    {(leafAna.questionDisplay || leafAna.shortAnswer) && (
                      <p class="path-card-description">{leafAna.questionDisplay || leafAna.shortAnswer}</p>
                    )}
                  </div>
                  <div class="path-card-arrow">→</div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    )}

    {/* ========================================
        LEAF RENDERING (scannable card-based layout)
        ======================================== */}
    {!isHub && (
      <div class="leaf-page-wrapper">
    <!-- ========================================
         SECTION 1: HERO / ORIENTATION
         ======================================== -->
    <header class="ana-hero">
      <div class="ana-title-row">
        <img src="/images/ask-n-answer_logo.svg" alt="Ask 'n Answer" class="ana-logo-icon" />
        {/* H1: Use pageTitle > title (if not slug-like) > questionDisplay with line clamp */}
        <h1 class="ana-page-title" data-testid="text-page-title">
          {entry.data.pageTitle?.trim() 
            ? entry.data.pageTitle 
            : (entry.data.title && !entry.data.title.includes('-') && entry.data.title !== entry.data.slug)
              ? entry.data.title
              : entry.data.questionDisplay ?? entry.data.title
          }
        </h1>
      </div>
      
      {/* Subtitle: Show questionDisplay (or shortAnswer fallback) if different from H1 */}
      {(() => {
        const h1Text = entry.data.pageTitle?.trim() 
          ? entry.data.pageTitle 
          : (entry.data.title && !entry.data.title.includes('-') && entry.data.title !== entry.data.slug)
            ? entry.data.title
            : null;
        const subtitleText = entry.data.questionDisplay?.trim() || entry.data.shortAnswer?.trim();
        return h1Text && subtitleText && subtitleText !== h1Text ? (
          <p class="ana-subtitle" data-testid="text-subtitle">{subtitleText}</p>
        ) : null;
      })()}
      
      {/* Outcome Line - styled as callout */}
      {entry.data.outcomeLine && entry.data.outcomeLine.trim() !== '' && (
        <div class="outcome-callout" data-testid="callout-outcome">
          <p class="outcome-callout-text">{entry.data.outcomeLine}</p>
        </div>
      )}
      
      {/* Intro Paragraph */}
      {entry.data.introParagraph && entry.data.introParagraph.trim() !== '' && (
        <p class="ana-intro-paragraph" data-testid="text-intro-paragraph">{entry.data.introParagraph}</p>
      )}
    </header>

    <!-- Scannable Card Layout -->
    <div class="leaf-cards-container">
      
      <!-- A) Direct Answer Card (full width, top) -->
      {(entry.data.shortAnswer?.trim() || entry.data.body?.trim()) && (
        <div class="leaf-card leaf-card-direct-answer" data-testid="card-direct-answer">
          <h2 class="leaf-card-heading">Direct Answer</h2>
          <p class="direct-answer-text">
            {entry.data.shortAnswer?.trim() 
              ? entry.data.shortAnswer 
              : (() => {
                  const firstSentence = entry.data.body?.replace(/<[^>]*>/g, '').split(/(?<=[.!?])\s+/)[0] || '';
                  return /[.!?]$/.test(firstSentence) ? firstSentence : firstSentence + '.';
                })()
            }
          </p>
        </div>
      )}

      <!-- Next Step Card (auto-generated from existing fields) -->
      {(() => {
        const actions: Array<{ label: string; url: string }> = [];
        
        // Primary action priority: wizardUrl > parentGatewaySlug > relatedAnas
        if (entry.data.wizardUrl?.trim()) {
          // wizardUrl is a slug, construct full path
          const wizardSlug = entry.data.wizardUrl.trim();
          const wizardPath = wizardSlug.startsWith('/') || wizardSlug.startsWith('http') 
            ? wizardSlug 
            : `/wizards/${wizardSlug}`;
          actions.push({ label: "Use the helper", url: wizardPath });
        } else if (entry.data.parentGatewaySlug?.trim()) {
          actions.push({ label: "Start at the gateway", url: `/ana/${entry.data.parentGatewaySlug.trim()}` });
        } else if (entry.data.relatedAnas?.length > 0) {
          actions.push({ label: "Related answer", url: `/ana/${entry.data.relatedAnas[0]}` });
        }
        
        // Secondary action: videoUrl > relatedWorkshops (only if different from primary)
        if (actions.length < 2) {
          if (entry.data.videoUrl?.trim()) {
            actions.push({ label: "Watch the demo", url: `#video-section` });
          } else if (entry.data.relatedWorkshops?.length > 0) {
            const workshopSlug = entry.data.relatedWorkshops[0];
            actions.push({ label: "Go deeper", url: `/guided-workshops/${workshopSlug}` });
          }
        }
        
        return actions.length > 0 ? (
          <div class="leaf-card leaf-card-next-step" data-testid="card-next-step">
            <h3 class="leaf-card-heading leaf-card-heading-small">Next step</h3>
            <ul class="next-step-list">
              {actions.slice(0, 2).map((action) => (
                <li class="next-step-item">
                  <a href={action.url} class="next-step-link" data-testid={`link-next-step-${action.label.toLowerCase().replace(/\s+/g, '-')}`}>
                    <span class="next-step-arrow">→</span>
                    {action.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : null;
      })()}

      <!-- B) Two-column grid: Key Insight + Image (or Quick Check fallback) -->
      {(entry.data.keyInsight?.trim() || entry.data.imageUrl || (!entry.data.imageUrl && entry.data.quickCheckText?.trim())) && (
        <div class="leaf-cards-row" data-testid="row-insights">
          {/* Key Insight - always on left when present */}
          {entry.data.keyInsight && entry.data.keyInsight.trim() !== '' && (
            <div class="leaf-card leaf-card-insight" data-testid="card-key-insight">
              <div class="leaf-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18h6" />
                  <path d="M10 22h4" />
                  <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />
                </svg>
              </div>
              <h3 class="leaf-card-heading">Key Insight</h3>
              <p class="leaf-card-text">{entry.data.keyInsight}</p>
            </div>
          )}

          {/* Right column: Image if exists, otherwise Quick Check fallback */}
          {entry.data.imageUrl ? (
            <div class="leaf-card leaf-card-media leaf-card-media-compact" data-testid="card-media">
              <div class="ana-hero-image media-image-wrapper">
                <img 
                  src={entry.data.imageUrl} 
                  alt={entry.data.imageAlt || entry.data.title}
                  class="ana-image zoomable-image"
                  data-testid="img-ana-visual"
                  role="button"
                  tabindex="0"
                  aria-label="Click to zoom image"
                />
                <p class="zoom-hint">Click image to zoom</p>
              </div>
            </div>
          ) : (
            entry.data.quickCheckText && entry.data.quickCheckText.trim() !== '' && (
              <div class="leaf-card leaf-card-quickcheck" data-testid="card-quick-check">
                <div class="leaf-card-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                  </svg>
                </div>
                <h3 class="leaf-card-heading">Quick Check</h3>
                <ul class="quick-check-list">
                  {entry.data.quickCheckText.split('\n').filter((line: string) => line.trim() !== '').map((line: string) => (
                    <li>{line.trim()}</li>
                  ))}
                </ul>
              </div>
            )
          )}
        </div>
      )}

      <!-- C) What's really going on here Card -->
      {entry.data.body && entry.data.body.trim() !== '' && (
        <div class="leaf-card leaf-card-explanation" data-testid="card-explanation">
          <h2 class="leaf-card-heading">What's really going on here</h2>
          <div class="leaf-card-prose" set:html={entry.data.body}></div>
        </div>
      )}

      <!-- D) Quick Check Card (full width, only when image exists) -->
      {entry.data.imageUrl && entry.data.quickCheckText && entry.data.quickCheckText.trim() !== '' && (
        <div class="leaf-card leaf-card-quickcheck leaf-card-quickcheck-full" data-testid="card-quick-check">
          <div class="leaf-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
          </div>
          <h3 class="leaf-card-heading">Quick Check</h3>
          <ul class="quick-check-list">
            {entry.data.quickCheckText.split('\n').filter((line: string) => line.trim() !== '').map((line: string) => (
              <li>{line.trim()}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- E) Video Section (separate from image, only if video exists) -->
      {entry.data.videoUrl && entry.data.videoUrl.trim() !== '' && (
        <div class="leaf-card leaf-card-media" id="video-section" data-testid="card-video">
          <div class="media-video-wrapper">
            <h3 class="leaf-card-heading">Watch</h3>
            <VimeoEmbed 
              videoId={entry.data.videoUrl.trim()}
              title={entry.data.title}
              aspectRatio="16:9"
            />
          </div>
        </div>
      )}

      <!-- Situational Clarity Cards (if present) -->
      {(entry.data.whyNotMatterYet?.trim() || entry.data.whatToFocus?.trim() || entry.data.whenThisMatters?.trim()) && (
        <div class="leaf-cards-row leaf-cards-situational" data-testid="row-situational">
          {entry.data.whyNotMatterYet && entry.data.whyNotMatterYet.trim() !== '' && (
            <div class="leaf-card leaf-card-situational" data-testid="card-why-not-matter">
              <h3 class="leaf-card-heading">Why this may not matter yet</h3>
              <div class="leaf-card-prose" set:html={entry.data.whyNotMatterYet}></div>
            </div>
          )}

          {entry.data.whatToFocus && entry.data.whatToFocus.trim() !== '' && (
            <div class="leaf-card leaf-card-situational" data-testid="card-what-to-focus">
              <h3 class="leaf-card-heading">What to focus on right now</h3>
              <div class="leaf-card-prose" set:html={entry.data.whatToFocus}></div>
            </div>
          )}

          {entry.data.whenThisMatters && entry.data.whenThisMatters.trim() !== '' && (
            <div class="leaf-card leaf-card-situational" data-testid="card-when-matters">
              <h3 class="leaf-card-heading">When this does matter</h3>
              <div class="leaf-card-prose" set:html={entry.data.whenThisMatters}></div>
            </div>
          )}
        </div>
      )}

      <!-- Exploration Section -->
      {(entry.data.goFurtherLinks?.length > 0 || entry.data.embedWizard) && (
        <div class="leaf-card leaf-card-exploration" data-testid="card-exploration">
          <h2 class="leaf-card-heading">If you want to go further</h2>
          
          {entry.data.goFurtherLinks && entry.data.goFurtherLinks.length > 0 && (
            <ul class="go-further-list">
              {entry.data.goFurtherLinks.map((link: { url: string; label: string }) => (
                <li>
                  <a href={link.url} class="go-further-link" data-testid={`link-go-further-${link.label?.toLowerCase().replace(/\s+/g, '-')}`}>
                    <span class="link-arrow">→</span>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}

          {entry.data.embedWizard === 'dropped-stitch-troubleshooter' && (
            <div class="embedded-wizard" data-testid="embed-wizard">
              <DroppedStitchWizard />
            </div>
          )}
        </div>
      )}

      <!-- E) Member-only Section Card -->
      {(entry.data.memberTitle || entry.data.memberBody || entry.data.memberVideoUrl) && (
        <div class="leaf-card leaf-card-member" data-testid="card-member">
          <div class="member-divider">
            <div class="divider-line"></div>
            <span class="divider-text">{entry.data.memberDividerText || "Member-only"}</span>
            <div class="divider-line"></div>
          </div>

          <div class="member-content" data-testid="content-member">
            {entry.data.memberTitle && (
              <h2 class="member-title">{entry.data.memberTitle}</h2>
            )}

            {entry.data.memberBody && (
              <div class="leaf-card-prose" set:html={entry.data.memberBody} data-testid="text-member-body"></div>
            )}

            {entry.data.memberVideoUrl && (
              <div class="member-video">
                <VimeoEmbed 
                  videoId={entry.data.memberVideoUrl}
                  title={entry.data.memberTitle || "Member video"}
                  aspectRatio="16:9"
                />
              </div>
            )}
          </div>
        </div>
      )}

      <!-- F) Related Content Section -->
      {(relatedAnas.length > 0 || relatedWorkshops.length > 0 || relatedWizards.length > 0) && (
        <div class="leaf-card leaf-card-related" data-testid="card-related">
          <h2 class="leaf-card-heading">Related</h2>
          
          <div class="related-grid">
            {relatedAnas.length > 0 && (
              <div class="related-group" data-testid="group-related-anas">
                <h3 class="related-subtitle">Related Questions</h3>
                <ul class="related-list">
                  {relatedAnas.slice(0, 3).map((ana) => (
                    <li class="related-item related-ana-item">
                      <img src="/images/ask-n-answer_logo.svg" alt="" class="ana-logo-icon-small" />
                      <a href={`/ana/${ana.slug}`} class="related-link" data-testid={`link-related-ana-${ana.slug}`}>
                        {ana.questionDisplay || ana.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {relatedWorkshops.length > 0 && (
              <div class="related-group" data-testid="group-related-workshops">
                <h3 class="related-subtitle">Workshops</h3>
                <ul class="related-list">
                  {relatedWorkshops.map((workshop) => (
                    <li class="related-item">
                      <a href={`/workshops/${workshop.slug}`} class="related-link" data-testid={`link-related-workshop-${workshop.slug}`}>
                        {workshop.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {relatedWizards.length > 0 && (
              <div class="related-group" data-testid="group-related-wizards">
                <h3 class="related-subtitle">Interactive Tools</h3>
                <ul class="related-list">
                  {relatedWizards.map((wizard) => (
                    <li class="related-item">
                      <a href={`/wizards/${wizard.slug}`} class="related-link" data-testid={`link-related-wizard-${wizard.slug}`}>
                        {wizard.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )}

    </div>
    </div>
    )}

    <!-- Zoom Modal (hidden by default) -->
    {entry.data.imageUrl && (
      <div id="zoom-modal" class="zoom-modal" data-testid="modal-image-zoom">
        <div class="zoom-backdrop"></div>
        <button class="zoom-close" aria-label="Close zoom" data-testid="button-close-zoom">&times;</button>
        <img id="zoom-image" src="" alt="" class="zoom-image" />
      </div>
    )}

    <!-- Debug ANA JSON (temporary) -->
    <details style="margin-top:2rem; background:#f5f5f5; padding:1rem; border-radius:8px;">
      <summary style="cursor:pointer; font-weight:bold;">Debug ANA JSON</summary>
      <pre style="white-space:pre-wrap; word-break:break-all; font-size:0.75rem; max-height:600px; overflow:auto;">{JSON.stringify(entry.data, null, 2)}</pre>
    </details>
  </div>
</Layout>

<style>
  /* =========================================
     BASE LAYOUT
     ========================================= */
  .ana-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-block;
    color: #52682D;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: #3E5524;
    text-decoration: underline;
  }

  /* =========================================
     GATEWAY / HUB PAGE STYLES
     ========================================= */
  .gateway-page {
    /* Container for gateway-specific content */
  }

  .gateway-hero {
    margin-bottom: 2rem;
  }

  .gateway-intro {
    font-size: 1.1rem;
    line-height: 1.7;
