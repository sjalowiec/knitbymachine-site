---
export const prerender = false;

import Layout from "../../layouts/layout.astro";
import Tooltip from "../../components/Tooltip.astro";
import VimeoEmbed from "../../components/VimeoEmbed.astro";
import DroppedStitchWizard from "../../components/DroppedStitchWizard.astro";
import "../../styles/global.css";
import "../../styles/wizard.css";

const { slug } = Astro.params;

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
const REPO_OWNER = 'sjalowiec';
const REPO_NAME = 'knitbymachine-site';
const CONTENT_PATH = 'src/content/ana';

async function getANAEntry(slug: string) {
  try {
    const response = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${slug}.json`,
      {
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'knitbymachine-astro'
        }
      }
    );

    if (!response.ok) {
      return null;
    }

    const data = await response.json();
    const content = atob(data.content);
    const jsonData = JSON.parse(content);

    // Filter out drafts and pending publish entries
    if (jsonData.isDraft || jsonData.pendingPublish) {
      return null;
    }

    return {
      data: jsonData,
      slug: slug
    };
  } catch (error) {
    console.error('Error fetching ANA entry:', error);
    return null;
  }
}

async function fetchRelatedContent(slugs: string[], contentPath: string) {
  const items = [];
  for (const itemSlug of slugs) {
    try {
      const response = await fetch(
        `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${contentPath}/${itemSlug}.json`,
        {
          headers: {
            'Authorization': `token ${GITHUB_TOKEN}`,
            'Accept': 'application/vnd.github.v3+json',
            'User-Agent': 'knitbymachine-astro'
          }
        }
      );
      if (response.ok) {
        const data = await response.json();
        const content = atob(data.content);
        const jsonData = JSON.parse(content);
        if (!jsonData.isDraft && !jsonData.pendingPublish) {
          items.push({ ...jsonData, slug: itemSlug });
        }
      }
    } catch (error) {
      console.error(`Error fetching ${contentPath}/${itemSlug}:`, error);
    }
  }
  return items;
}

const entry = await getANAEntry(slug);

if (!entry) {
  return Astro.redirect('/404');
}

const relatedAnas = entry.data.relatedAnas?.length 
  ? await fetchRelatedContent(entry.data.relatedAnas, 'src/content/ana')
  : [];

const relatedWorkshops = entry.data.relatedWorkshops?.length
  ? await fetchRelatedContent(entry.data.relatedWorkshops, 'src/content/workshops')
  : [];

const relatedWizards = entry.data.relatedWizards?.length
  ? await fetchRelatedContent(entry.data.relatedWizards, 'src/content/wizards')
  : [];
---

<Layout>
  <div class="ana-container">
    <div class="header-row">
      <a href="/ana-catalog" class="back-link" data-testid="link-back-catalog">← Back to Ask 'n Answer</a>
      <div class="ana-label-wrapper">
        <p class="ana-detail-label">
          You're not alone — asking questions is how you grow your skills.
        </p>
      </div>
    </div>

    <div class="content-wrapper">
      <article class="ana-item">
        <!-- Question Bubble -->
        <div class="bubble-wrapper question-wrapper">
          <div class="thought-bubble question-bubble">
            <p>{entry.data.title}</p>
          </div>
        </div>

        <!-- Answer Bubble -->
        <div class="bubble-wrapper answer-wrapper">
          <div class="speech-bubble answer-bubble">
            <div class="bubble-content" set:html={entry.data.body}></div>
          </div>
        </div>

        <!-- Image centered below bubbles with zoom feature -->
        {entry.data.imageUrl && (
          <div class="ana-image-section">
            <img 
              src={entry.data.imageUrl} 
              alt={entry.data.imageAlt || entry.data.title}
              class="ana-image zoomable-image"
              data-testid="img-ana-visual"
              role="button"
              tabindex="0"
              aria-label="Click to zoom image"
            />
            <p class="zoom-hint">Click image to zoom</p>
          </div>
        )}

        <!-- Zoom Modal (hidden by default) -->
        <div id="zoom-modal" class="zoom-modal" data-testid="modal-image-zoom">
          <div class="zoom-backdrop"></div>
          <button class="zoom-close" aria-label="Close zoom" data-testid="button-close-zoom">&times;</button>
          <img id="zoom-image" src="" alt="" class="zoom-image" />
        </div>

        <!-- Video Section (if videoUrl is provided) -->
        {entry.data.videoUrl && (
          <div class="ana-video-section">
            <VimeoEmbed 
              videoId={entry.data.videoUrl}
              title={entry.data.title}
              aspectRatio="16:9"
            />
          </div>
        )}

        <!-- Related Content Section -->
        {(relatedAnas.length > 0 || relatedWorkshops.length > 0 || relatedWizards.length > 0) && (
          <div class="related-content-section">
            <h2 class="related-title">Want to learn more?</h2>
            
            {relatedAnas.length > 0 && (
              <div class="related-group">
                <h3 class="related-subtitle">Related Questions</h3>
                <ul class="related-list">
                  {relatedAnas.map((ana) => (
                    <li>
                      <a href={`/ana/${ana.slug}`} class="related-link" data-testid={`link-related-ana-${ana.slug}`}>
                        {ana.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {relatedWorkshops.length > 0 && (
              <div class="related-group">
                <h3 class="related-subtitle">Workshops</h3>
                <ul class="related-list">
                  {relatedWorkshops.map((workshop) => (
                    <li>
                      <a href={`/workshops/${workshop.slug}`} class="related-link" data-testid={`link-related-workshop-${workshop.slug}`}>
                        {workshop.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {relatedWizards.length > 0 && (
              <div class="related-group">
                <h3 class="related-subtitle">Interactive Tools</h3>
                <ul class="related-list">
                  {relatedWizards.map((wizard) => (
                    <li>
                      <a href={`/wizards/${wizard.slug}`} class="related-link" data-testid={`link-related-wizard-${wizard.slug}`}>
                        {wizard.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        <!-- Divider Band with Custom Text -->
        {(entry.data.memberTitle || entry.data.memberBody || entry.data.memberVideoUrl || entry.data.embedWizard) && (
          <>
            <div class="member-divider">
              <div class="divider-content">
                <p class="divider-text">
                  {entry.data.memberDividerText || "Ready to go deeper? Unlock member-only content"}
                </p>
              </div>
            </div>

            <!-- Member-Only Content (visible for now, memberstack controls later) -->
            <div class="member-content-section" data-testid="section-member-content">
              {entry.data.memberTitle && (
                <h2 class="member-title">{entry.data.memberTitle}</h2>
              )}

              {entry.data.memberVideoUrl && (
                <div class="member-video">
                  <VimeoEmbed 
                    videoId={entry.data.memberVideoUrl}
                    title={entry.data.memberTitle || "Member video"}
                    aspectRatio="16:9"
                  />
                </div>
              )}

              {entry.data.memberBody && (
                <div class="member-body" set:html={entry.data.memberBody} data-testid="text-member-body"></div>
              )}

              {entry.data.embedWizard === 'dropped-stitch-troubleshooter' && (
                <DroppedStitchWizard />
              )}
            </div>
          </>
        )}
      </article>
    </div>
  </div>
</Layout>

<style>
  .ana-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .back-link {
    color: #52682D;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #3E5524;
    text-decoration: underline;
  }

  .ana-label-wrapper {
    flex: 1;
    background-color: rgba(231, 240, 220, 0.4);
    border-radius: 8px;
    padding: 0.5rem 1rem;
  }

  .ana-detail-label {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 500;
    font-style: italic;
    color: #52682d;
    opacity: 0.85;
    text-align: center;
  }

  .content-wrapper {
    width: 100%;
  }

  .ana-item {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .bubble-wrapper {
    display: flex;
    max-width: 650px;
  }

  .question-wrapper {
    justify-content: flex-start;
  }

  .answer-wrapper {
    justify-content: flex-end;
    margin-left: auto;
  }

  .thought-bubble {
    position: relative;
    background-color: #ffffff;
    color: #2c3a57;
    border: 1px solid #c7d8a4;
    padding: 1.5rem 2rem;
    border-radius: 25px;
    font-size: 1.2rem;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.08);
  }

  .thought-bubble.question-bubble {
    color: #2c3a57;
    font-size: 1.1rem;
  }

  .thought-bubble::before {
    content: '';
    position: absolute;
    left: -14px;
    bottom: 20px;
    width: 12px;
    height: 12px;
    background-color: #ffffff;
    border: 1px solid #c7d8a4;
    border-radius: 50%;
  }

  .thought-bubble::after {
    content: '';
    position: absolute;
    left: -24px;
    bottom: 12px;
    width: 8px;
    height: 8px;
    background-color: #ffffff;
    border: 1px solid #c7d8a4;
    border-radius: 50%;
  }

  .speech-bubble {
    position: relative;
    background-color: #eef3e4;
    color: #2c3a57;
    padding: 1.4rem 1.8rem;
    border-radius: 22px;
    border: 1px solid #c7d8a4;
    font-size: 1rem;
    line-height: 1.6;
    box-shadow: 0 2px 6px rgba(82, 104, 45, 0.10);
  }

  .speech-bubble::before {
    content: "";
    position: absolute;
    right: -10px;
    bottom: 18px;
    width: 0;
    height: 0;
    border-left: 14px solid #eef3e4;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
  }

  .speech-bubble::after {
    content: "";
    position: absolute;
    right: -12px;
    bottom: 18px;
    width: 0;
    height: 0;
    border-left: 16px solid #c7d8a4;
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
    z-index: -1;
  }

  .bubble-content {
    color: #2c3a57;
  }

  .bubble-content :global(p) {
    margin-bottom: 1rem;
  }

  .bubble-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .bubble-content :global(ul),
  .bubble-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .bubble-content :global(strong) {
    font-weight: 600;
    color: #52682d;
  }

  /* Image Section */
  .ana-image-section {
    text-align: center;
    margin: 0 auto;
    max-width: 400px;
  }

  .ana-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.15);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .zoomable-image {
    cursor: zoom-in;
  }

  .zoomable-image:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.25);
  }

  .zoom-hint {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #52682d;
    opacity: 0.7;
    font-style: italic;
  }

  /* Video Section */
  .ana-video-section {
    max-width: 700px;
    margin: 0 auto;
  }

  /* Zoom Modal */
  .zoom-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .zoom-modal.active {
    display: flex;
  }

  .zoom-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    cursor: zoom-out;
  }

  .zoom-close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: white;
    font-size: 3rem;
    font-weight: 300;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 10001;
    line-height: 1;
    padding: 0;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .zoom-close:hover {
    opacity: 0.7;
  }

  .zoom-image {
    position: relative;
    max-width: 95%;
    max-height: 95%;
    width: auto;
    height: auto;
    object-fit: contain;
    z-index: 10000;
    border-radius: 8px;
    cursor: zoom-out;
  }

  /* Related Content Section */
  .related-content-section {
    background-color: #f9faf7;
    border: 1px solid #DDE4D1;
    border-radius: 12px;
    padding: 2rem;
    margin-top: 1rem;
  }

  .related-title {
    font-size: 1.4rem;
    font-weight: 600;
    color: #52682d;
    margin: 0 0 1.5rem 0;
  }

  .related-group {
    margin-bottom: 1.5rem;
  }

  .related-group:last-child {
    margin-bottom: 0;
  }

  .related-subtitle {
    font-size: 1.1rem;
    font-weight: 600;
    color: #52682d;
    margin: 0 0 0.75rem 0;
  }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .related-list li {
    margin-bottom: 0.5rem;
  }

  .related-link {
    color: #52682d;
    text-decoration: none;
    font-size: 1rem;
    transition: all 0.2s ease;
    display: inline-block;
    padding: 0.4rem 0;
  }

  .related-link:hover {
    color: #3E5524;
    text-decoration: underline;
    transform: translateX(3px);
  }

  .related-link::before {
    content: '→ ';
    margin-right: 0.5rem;
    color: #52682d;
  }

  /* Member Divider */
  .member-divider {
    background: linear-gradient(135deg, #52682d 0%, #6b8840 100%);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.2);
    margin-top: 1rem;
  }

  .divider-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .divider-text {
    color: white;
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
  }

  /* Member Content Section */
  .member-content-section {
    background-color: #fff;
    border: 2px solid #52682d;
    border-radius: 12px;
    padding: 2rem;
    margin-top: -0.5rem;
  }

  .member-title {
    font-size: 1.6rem;
    font-weight: 600;
    color: #52682d;
    margin: 0 0 1.5rem 0;
  }

  .member-video {
    margin-bottom: 1.5rem;
  }

  .member-body {
    color: #2c3a57;
    font-size: 1rem;
    line-height: 1.6;
  }

  .member-body :global(p) {
    margin-bottom: 1rem;
  }

  .member-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .member-body :global(ul),
  .member-body :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .member-body :global(strong) {
    font-weight: 600;
    color: #52682d;
  }

  @media (max-width: 768px) {
    .ana-container {
      padding: 1.5rem 0.75rem 3rem;
    }

    .back-link {
      display: block;
      text-align: center;
    }

    .bubble-wrapper {
      max-width: 100%;
    }

    .question-wrapper,
    .answer-wrapper {
      margin-left: 0;
    }

    .ana-image-section {
      max-width: 100%;
      padding: 0 1rem;
    }

    .zoom-hint {
      font-size: 0.75rem;
    }

    .zoom-close {
      top: 10px;
      right: 10px;
      font-size: 2.5rem;
      width: 40px;
      height: 40px;
    }

    .zoom-image {
      max-width: 98%;
      max-height: 98%;
    }

    .related-content-section {
      padding: 1.5rem;
    }

    .related-title {
      font-size: 1.2rem;
    }

    .member-divider {
      padding: 1.25rem 1.5rem;
    }

    .divider-text {
      font-size: 1.05rem;
    }

    .member-content-section {
      padding: 1.5rem;
    }
  }
</style>

<script is:inline src="/scripts/dynamic-tooltips.js"></script>

<script is:inline>
  // Image Zoom Functionality
  (function() {
    const zoomableImage = document.querySelector('.zoomable-image');
    const zoomModal = document.getElementById('zoom-modal');
    const zoomImage = document.getElementById('zoom-image');
    const zoomClose = document.querySelector('.zoom-close');
    const zoomBackdrop = document.querySelector('.zoom-backdrop');

    if (!zoomableImage || !zoomModal || !zoomImage) return;

    function openZoom() {
      zoomImage.src = zoomableImage.src;
      zoomImage.alt = zoomableImage.alt;
      zoomModal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeZoom() {
      zoomModal.classList.remove('active');
      document.body.style.overflow = '';
    }

    // Open zoom on image click
    zoomableImage.addEventListener('click', openZoom);
    
    // Open zoom on Enter key
    zoomableImage.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openZoom();
      }
    });

    // Close zoom on close button click
    if (zoomClose) {
      zoomClose.addEventListener('click', closeZoom);
    }

    // Close zoom on backdrop click
    if (zoomBackdrop) {
      zoomBackdrop.addEventListener('click', closeZoom);
    }

    // Close zoom on image click
    zoomImage.addEventListener('click', closeZoom);

    // Close zoom on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && zoomModal.classList.contains('active')) {
        closeZoom();
      }
    });
  })();
</script>
