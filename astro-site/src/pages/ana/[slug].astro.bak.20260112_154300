---
export const prerender = false;

import Layout from "../../layouts/layout.astro";
import Tooltip from "../../components/Tooltip.astro";
import VimeoEmbed from "../../components/VimeoEmbed.astro";
import DroppedStitchWizard from "../../components/DroppedStitchWizard.astro";
import "../../styles/global.css";
import "../../styles/wizard.css";

const { slug } = Astro.params;

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
const REPO_OWNER = 'sjalowiec';
const REPO_NAME = 'knitbymachine-site';
const CONTENT_PATH = 'src/content/ana';

async function getANAEntry(slug: string) {
  try {
    const response = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${slug}.json`,
      {
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'knitbymachine-astro'
        }
      }
    );

    if (!response.ok) {
      return null;
    }

    const data = await response.json();
    // Properly decode UTF-8 from base64 to handle special characters
    const binaryString = atob(data.content);
    const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
    const content = new TextDecoder('utf-8').decode(bytes);
    const jsonData = JSON.parse(content);

    // Filter out drafts and pending publish entries
    if (jsonData.isDraft || jsonData.pendingPublish) {
      return null;
    }

    return {
      data: jsonData,
      slug: slug
    };
  } catch (error) {
    console.error('Error fetching ANA entry:', error);
    return null;
  }
}

async function fetchRelatedContent(slugs: string[], contentPath: string) {
  const items = [];
  for (const itemSlug of slugs) {
    try {
      const response = await fetch(
        `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${contentPath}/${itemSlug}.json`,
        {
          headers: {
            'Authorization': `token ${GITHUB_TOKEN}`,
            'Accept': 'application/vnd.github.v3+json',
            'User-Agent': 'knitbymachine-astro'
          }
        }
      );
      if (response.ok) {
        const data = await response.json();
        // Properly decode UTF-8 from base64 to handle special characters
        const binaryString = atob(data.content);
        const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
        const content = new TextDecoder('utf-8').decode(bytes);
        const jsonData = JSON.parse(content);
        if (!jsonData.isDraft && !jsonData.pendingPublish) {
          items.push({ ...jsonData, slug: itemSlug });
        }
      }
    } catch (error) {
      console.error(`Error fetching ${contentPath}/${itemSlug}:`, error);
    }
  }
  return items;
}

// Fetch child ANAs for hub/gateway pages (find all ANAs where parentGatewaySlug matches this hub's slug)
async function fetchChildAnas(hubSlug: string) {
  const children = [];
  try {
    // Get all ANA files from GitHub
    const response = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}`,
      {
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'knitbymachine-astro'
        }
      }
    );
    
    if (!response.ok) return children;
    
    const files = await response.json();
    const jsonFiles = files.filter((f: any) => f.name.endsWith('.json'));
    
    // Fetch each file using GitHub API with proper auth (not download_url which lacks auth)
    for (const file of jsonFiles) {
      try {
        const fileResponse = await fetch(
          `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${file.name}`,
          {
            headers: {
              'Authorization': `token ${GITHUB_TOKEN}`,
              'Accept': 'application/vnd.github.v3+json',
              'User-Agent': 'knitbymachine-astro'
            }
          }
        );
        if (!fileResponse.ok) continue;
        
        const fileData = await fileResponse.json();
        // Properly decode UTF-8 from base64
        const binaryString = atob(fileData.content);
        const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
        const content = new TextDecoder('utf-8').decode(bytes);
        const data = JSON.parse(content);
        
        // Skip drafts and check if this ANA is a child of the hub
        if (data.isDraft || data.pendingPublish) continue;
        if (data.parentGatewaySlug === hubSlug) {
          children.push({ ...data, slug: file.name.replace('.json', '') });
        }
      } catch (err) {
        console.error(`Error fetching child ANA ${file.name}:`, err);
      }
    }
  } catch (error) {
    console.error('Error fetching child ANAs:', error);
  }
  return children;
}

const entry = await getANAEntry(slug);

if (!entry) {
  return Astro.redirect('/404');
}

// Check if this is a hub/gateway ANA (defensive: check both type AND children array)
const isHub = entry.data.type === 'gateway' || (Array.isArray(entry.data.children) && entry.data.children.length > 0);

// Fetch child ANAs if this is a hub page
const childAnas = isHub ? await fetchChildAnas(slug) : [];

const relatedAnas = entry.data.relatedAnas?.length 
  ? await fetchRelatedContent(entry.data.relatedAnas, 'src/content/ana')
  : [];

const relatedWorkshops = entry.data.relatedWorkshops?.length
  ? await fetchRelatedContent(entry.data.relatedWorkshops, 'src/content/workshops')
  : [];

const relatedWizards = entry.data.relatedWizards?.length
  ? await fetchRelatedContent(entry.data.relatedWizards, 'src/content/wizards')
  : [];
---

<Layout>
  <div class="ana-container">
    <!-- Back Link -->
    <a href="/ana-catalog" class="back-link" data-testid="link-back-catalog">← Back to Answers</a>

    <!-- ========================================
         SECTION 1: HERO / ORIENTATION
         ======================================== -->
    <header class="ana-hero">
      <div class="ana-title-row">
        <img src="/images/ask-n-answer_logo.svg" alt="Ask 'n Answer" class="ana-logo-icon" />
        <h1 class="ana-page-title" data-testid="text-page-title">{entry.data.questionDisplay ?? entry.data.title}</h1>
      </div>
      
      {entry.data.introParagraph && entry.data.introParagraph.trim() !== '' && (
        <p class="ana-intro-paragraph" data-testid="text-intro-paragraph">{entry.data.introParagraph}</p>
      )}

      {/* Featured Image in Hero (displayed whenever imageUrl exists) */}
      {entry.data.imageUrl && (
        <div class="ana-hero-image">
          <img 
            src={entry.data.imageUrl} 
            alt={entry.data.imageAlt || entry.data.title}
            class="ana-image zoomable-image"
            data-testid="img-ana-visual"
            role="button"
            tabindex="0"
            aria-label="Click to zoom image"
          />
          <p class="zoom-hint">Click image to zoom</p>
        </div>
      )}
    </header>

    <div class="unified-content-card">
      <article class="ana-item">
        
        <!-- ========================================
             SECTION 2: QUICK ANSWER (SCANNABLE WIN)
             ======================================== -->
        {(entry.data.keyInsight?.trim() || entry.data.quickCheckText?.trim()) && (
          <section class="quick-answer-section" data-testid="section-quick-answer">
            {entry.data.keyInsight && entry.data.keyInsight.trim() !== '' && (
              <div class="key-insight-callout" data-testid="callout-key-insight">
                <div class="callout-icon-wrapper">
                  <svg class="callout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18h6" />
                    <path d="M10 22h4" />
                    <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />
                  </svg>
                </div>
                <div class="callout-content">
                  <h2 class="callout-label">Key Insight</h2>
                  <p class="callout-text">{entry.data.keyInsight}</p>
                </div>
              </div>
            )}

            {entry.data.quickCheckText && entry.data.quickCheckText.trim() !== '' && (
              <div class="quick-check-callout" data-testid="callout-quick-check">
                <h3 class="quick-check-title">Quick Check</h3>
                <ul class="quick-check-list">
                  {entry.data.quickCheckText.split('\n').filter((line: string) => line.trim() !== '').map((line: string) => (
                    <li>{line.trim()}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}

        <!-- Video Section (after Quick Answer, before main explanation) -->
        {entry.data.videoUrl && entry.data.videoUrl.trim() !== '' && (
          <div class="ana-video-section" data-testid="section-video">
            <VimeoEmbed 
              videoId={entry.data.videoUrl.trim()}
              title={entry.data.title}
              aspectRatio="16:9"
            />
          </div>
        )}

        <!-- ========================================
             SECTION 3: WHAT'S REALLY GOING ON HERE
             ======================================== -->
        {entry.data.body && (
          <section class="main-explanation-section" data-testid="section-main-explanation">
            <h2 class="section-heading">What's really going on here</h2>
            <div class="section-body" set:html={entry.data.body}></div>
          </section>
        )}

        <!-- ========================================
             SECTION 4: SITUATIONAL CLARITY
             ======================================== -->
        {(entry.data.whyNotMatterYet?.trim() || entry.data.whatToFocus?.trim() || entry.data.whenThisMatters?.trim()) && (
          <section class="situational-section" data-testid="section-situational">
            {entry.data.whyNotMatterYet && entry.data.whyNotMatterYet.trim() !== '' && (
              <div class="situational-card" data-testid="card-why-not-matter">
                <h3 class="situational-heading">Why this may not matter yet</h3>
                <div class="situational-content" set:html={entry.data.whyNotMatterYet}></div>
              </div>
            )}

            {entry.data.whatToFocus && entry.data.whatToFocus.trim() !== '' && (
              <div class="situational-card" data-testid="card-what-to-focus">
                <h3 class="situational-heading">What to focus on right now</h3>
                <div class="situational-content" set:html={entry.data.whatToFocus}></div>
              </div>
            )}

            {entry.data.whenThisMatters && entry.data.whenThisMatters.trim() !== '' && (
              <div class="situational-card" data-testid="card-when-matters">
                <h3 class="situational-heading">When this does matter</h3>
                <div class="situational-content" set:html={entry.data.whenThisMatters}></div>
              </div>
            )}
          </section>
        )}

        <!-- ========================================
             SECTION 5: OPTIONAL EXPLORATION
             ======================================== -->
        {(entry.data.goFurtherLinks?.length > 0 || entry.data.embedWizard) && (
          <section class="exploration-section" data-testid="section-exploration">
            <h2 class="section-heading">If you want to go further</h2>
            
            {entry.data.goFurtherLinks && entry.data.goFurtherLinks.length > 0 && (
              <ul class="go-further-list">
                {entry.data.goFurtherLinks.map((link: { url: string; label: string }) => (
                  <li>
                    <a href={link.url} class="go-further-link" data-testid={`link-go-further-${link.label?.toLowerCase().replace(/\s+/g, '-')}`}>
                      <span class="link-arrow">→</span>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {entry.data.embedWizard === 'dropped-stitch-troubleshooter' && (
              <div class="embedded-wizard" data-testid="embed-wizard">
                <DroppedStitchWizard />
              </div>
            )}
          </section>
        )}

        <!-- Child ANAs Section (for Hub pages) -->
        {isHub && childAnas.length > 0 && (
          <div class="child-anas-section" data-testid="section-child-anas">
            <h2 class="section-heading">Explore these related questions</h2>
            <p class="child-anas-intro">Each of these addresses a specific part of this topic:</p>
            <ul class="child-anas-list">
              {childAnas.map((child) => (
                <li class="child-ana-item">
                  <a href={`/ana/${child.slug}`} class="child-ana-link" data-testid={`link-child-ana-${child.slug}`}>
                    <img src="/images/ask-n-answer_logo.svg" alt="" class="ana-logo-icon-small" />
                    <span class="child-ana-title">{child.questionDisplay || child.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- ========================================
             SECTION 6: MEMBER-ONLY (ALWAYS LAST CONTENT)
             ======================================== -->
        {(entry.data.memberTitle || entry.data.memberBody || entry.data.memberVideoUrl) && (
          <section class="member-section" data-testid="section-member">
            <div class="member-divider">
              <div class="divider-line"></div>
              <span class="divider-text">{entry.data.memberDividerText || "Member-only"}</span>
              <div class="divider-line"></div>
            </div>

            <div class="member-content" data-testid="content-member">
              {entry.data.memberTitle && (
                <h2 class="member-title">{entry.data.memberTitle}</h2>
              )}

              {entry.data.memberBody && (
                <div class="member-body" set:html={entry.data.memberBody} data-testid="text-member-body"></div>
              )}

              {entry.data.memberVideoUrl && (
                <div class="member-video">
                  <VimeoEmbed 
                    videoId={entry.data.memberVideoUrl}
                    title={entry.data.memberTitle || "Member video"}
                    aspectRatio="16:9"
                  />
                </div>
              )}
            </div>
          </section>
        )}

        <!-- ========================================
             SECTION 7: RELATED CONTENT (EXIT RAMPS)
             ======================================== -->
        {(relatedAnas.length > 0 || relatedWorkshops.length > 0 || relatedWizards.length > 0) && (
          <section class="related-section" data-testid="section-related">
            <h2 class="section-heading">Related</h2>
            
            <div class="related-grid">
              {relatedAnas.length > 0 && (
                <div class="related-group" data-testid="group-related-anas">
                  <h3 class="related-subtitle">Related Questions</h3>
                  <ul class="related-list">
                    {relatedAnas.map((ana) => (
                      <li class="related-item related-ana-item">
                        <img src="/images/ask-n-answer_logo.svg" alt="" class="ana-logo-icon-small" />
                        <a href={`/ana/${ana.slug}`} class="related-link" data-testid={`link-related-ana-${ana.slug}`}>
                          {ana.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {relatedWorkshops.length > 0 && (
                <div class="related-group" data-testid="group-related-workshops">
                  <h3 class="related-subtitle">Workshops</h3>
                  <ul class="related-list">
                    {relatedWorkshops.map((workshop) => (
                      <li class="related-item">
                        <a href={`/workshops/${workshop.slug}`} class="related-link" data-testid={`link-related-workshop-${workshop.slug}`}>
                          {workshop.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {relatedWizards.length > 0 && (
                <div class="related-group" data-testid="group-related-wizards">
                  <h3 class="related-subtitle">Interactive Tools</h3>
                  <ul class="related-list">
                    {relatedWizards.map((wizard) => (
                      <li class="related-item">
                        <a href={`/wizards/${wizard.slug}`} class="related-link" data-testid={`link-related-wizard-${wizard.slug}`}>
                          {wizard.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}

      </article>
    </div>

    <!-- Zoom Modal (hidden by default) -->
    {entry.data.imageUrl && (
      <div id="zoom-modal" class="zoom-modal" data-testid="modal-image-zoom">
        <div class="zoom-backdrop"></div>
        <button class="zoom-close" aria-label="Close zoom" data-testid="button-close-zoom">&times;</button>
        <img id="zoom-image" src="" alt="" class="zoom-image" />
      </div>
    )}

    <!-- Debug ANA JSON (temporary) -->
    <details style="margin-top:2rem; background:#f5f5f5; padding:1rem; border-radius:8px;">
      <summary style="cursor:pointer; font-weight:bold;">Debug ANA JSON</summary>
      <pre style="white-space:pre-wrap; word-break:break-all; font-size:0.75rem; max-height:600px; overflow:auto;">{JSON.stringify(entry.data, null, 2)}</pre>
    </details>
  </div>
</Layout>

<style>
  /* =========================================
     BASE LAYOUT
     ========================================= */
  .ana-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-block;
    color: #52682D;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: #3E5524;
    text-decoration: underline;
  }

  /* =========================================
     SECTION 1: HERO / ORIENTATION
     ========================================= */
  .ana-hero {
    margin-bottom: 2rem;
  }

  .ana-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .ana-logo-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .ana-page-title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: #2c3a57;
    line-height: 1.3;
  }

  .ana-intro-paragraph {
    margin: 0 0 1.5rem 0;
    font-size: 1.1rem;
    line-height: 1.7;
    color: #5a6c7d;
  }

  .ana-hero-image {
    text-align: center;
    margin: 1.5rem auto 0;
    max-width: 500px;
  }

  .ana-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(82, 104, 45, 0.15);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .zoomable-image {
    cursor: zoom-in;
  }

  .zoomable-image:hover {
    transform: scale(1.02);
    box-shadow: 0 6px 20px rgba(82, 104, 45, 0.25);
  }

  .zoom-hint {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #52682d;
    opacity: 0.7;
    font-style: italic;
  }

  /* =========================================
     UNIFIED CONTENT CARD
     ========================================= */
  .unified-content-card {
    background-color: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(82, 104, 45, 0.1);
    padding: 2.5rem;
    width: 100%;
  }

  .ana-item {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* =========================================
     SECTION 2: QUICK ANSWER (SCANNABLE WIN)
     ========================================= */
  .quick-answer-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Key Insight Callout */
  .key-insight-callout {
    display: flex;
    gap: 1rem;
    background: linear-gradient(135deg, #f5f8f0 0%, #e7f0dc 100%);
    border: 2px solid #52682d;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .callout-icon-wrapper {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #52682d;
    border-radius: 50%;
  }

  .callout-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: white;
  }

  .callout-content {
    flex: 1;
  }

  .callout-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #52682d;
    margin: 0 0 0.5rem 0;
  }

  .callout-text {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.5;
    color: #2c3a57;
    margin: 0;
  }

  /* Quick Check Callout */
  .quick-check-callout {
    background-color: #fafbf8;
    border: 1px solid #dde4d1;
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
  }

  .quick-check-title {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #52682d;
    margin: 0 0 0.75rem 0;
  }

  .quick-check-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .quick-check-list li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #2c3a57;
    margin-bottom: 0.4rem;
  }

  .quick-check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #52682d;
    font-weight: 600;
  }

  .quick-check-list li:last-child {
    margin-bottom: 0;
  }

  /* =========================================
     VIDEO SECTION
     ========================================= */
  .ana-video-section {
    max-width: 100%;
    margin: 0 auto;
  }

  /* =========================================
     SECTION 3: MAIN EXPLANATION
     ========================================= */
  .main-explanation-section {
    /* Clean, readable main content */
  }

  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    color: #52682d;
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid #d8e2cc;
  }

  .section-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #2c3a57;
  }

  .section-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .section-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .section-body :global(ul),
  .section-body :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .section-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .section-body :global(strong) {
    font-weight: 600;
    color: #52682d;
  }

  /* =========================================
     SECTION 4: SITUATIONAL CLARITY
     ========================================= */
  .situational-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .situational-card {
    background-color: #fafbf8;
    border: 1px solid #dde4d1;
    border-radius: 10px;
    padding: 1.5rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .situational-card:hover {
    border-color: #52682d;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.1);
  }

  .situational-heading {
    font-size: 1.1rem;
    font-weight: 600;
    color: #52682d;
    margin: 0 0 0.75rem 0;
  }

  .situational-content {
    font-size: 1rem;
    line-height: 1.7;
    color: #2c3a57;
  }

  .situational-content :global(p) {
    margin-bottom: 0.75rem;
  }

  .situational-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .situational-content :global(ul),
  .situational-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .situational-content :global(li) {
