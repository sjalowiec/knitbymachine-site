---
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch Skill Builders from GitHub at build time
let builders = [];
let errorMessage = '';

try {
  const response = await fetch('https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/skillbuilders');
  
  if (response.ok) {
    const directories = await response.json();
    
    // Fetch each data.json file's content
    const builderPromises = directories
      .filter(dir => dir.type === 'dir')
      .map(async (dir) => {
        try {
          const fileResponse = await fetch(`https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/skillbuilders/${dir.name}/data.json`);
          const fileData = await fileResponse.json();
          const content = Buffer.from(fileData.content, 'base64').toString('utf-8');
          const data = JSON.parse(content);
          return {
            slug: data.slug || dir.name,
            title: data.title,
            description: data.description,
            tagline: data.tagline,
            level: data.level,
            moduleCount: data.modules?.length || 0,
            prepCount: data.prepChecklist?.length || 0,
            isDraft: data.isDraft,
            pendingPublish: data.pendingPublish,
            publishedDate: data.publishedDate,
          };
        } catch (e) {
          console.error(`Error fetching skill builder ${dir.name}:`, e);
          return null;
        }
      });
    
    const allBuilders = await Promise.all(builderPromises);
    // Filter out drafts, pending publish entries, and nulls
    builders = allBuilders.filter(builder => builder && !builder.isDraft && !builder.pendingPublish);
  }
} catch (error) {
  console.error('Error fetching skill builders:', error);
  errorMessage = error.message;
}

const title = "Skill Builders";
const description = "Interactive step-by-step journeys to master knitting machine techniques. Learn at your own pace with hands-on practice.";

// Level definitions for the selector (line1 = "Level X", line2 = description)
const levels = [
  { id: 'all', level: 'all', icon: '/images/practice-icon.svg', line1: 'All', line2: 'Levels' },
  { id: 'level-1', level: '1', icon: '/images/level-1.svg', line1: 'Level 1', line2: 'Basics' },
  { id: 'level-2', level: '2', icon: '/images/level-2.svg', line1: 'Level 2', line2: 'Hand Manipulation' },
  { id: 'level-3', level: '3', icon: '/images/level-3.svg', line1: 'Level 3', line2: 'Stitch Patterns' },
  { id: 'level-4', level: '4', icon: '/images/level-4.svg', line1: 'Level 4', line2: 'Ribber' },
];
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <!-- Integrated Hero Panel with Controls -->
    <div class="hero-panel fade-in">
      <!-- Top row: Icon + Title/Intro -->
      <div class="hero-top">
        <div class="hero-icon">
          <img src="/images/practice-icon.svg" alt="Skill Builders" class="header-icon" />
        </div>
        <div class="hero-content">
          <h1 class="hero-title">Skill Builders</h1>
          <p class="hero-tagline">Master your machine one skill at a time.</p>
          <p class="hero-subtitle">Step-by-step interactive journeys designed to build your confidence and expertise with hands-on practice.</p>
        </div>
      </div>

      <!-- Bottom row: Level chips + Search -->
      <div class="hero-controls">
        <div class="level-selector-area">
          <span class="level-hint">Choose your level</span>
          <div class="level-chips">
            {levels.map((level) => (
              <button 
                type="button"
                data-level={level.level}
                class={`level-chip ${level.id === 'all' ? 'active' : ''}`}
                aria-label={`${level.line1} ${level.line2}`}
              >
                <img src={level.icon} alt="" class="level-chip__icon" />
                <span class="level-chip__label">
                  <span class="level-chip__line1">{level.line1}</span>
                  <span class="level-chip__line2">{level.line2}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
        <div class="search-wrapper">
          <input 
            type="text" 
            class="search-input" 
            id="searchInput" 
            placeholder="Search..."
            aria-label="Search skill builders"
          >
        </div>
      </div>
    </div>

    <!-- Catalogue Content -->
    <div id="catalogueContent" class="catalogue-content" data-builders={JSON.stringify(builders)}>
      {errorMessage && (
        <div class="error">
          <p><strong>Error loading skill builders</strong></p>
          <p>Unable to fetch skill builders. Please try again later.</p>
          <p style="font-size: 0.9rem; margin-top: 1rem;">{errorMessage}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Scroll to Top Button -->
  <button id="scrollToTop" class="scroll-to-top" aria-label="Scroll to top">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
    </svg>
  </button>
</BaseLayout>

<style>
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 3rem;
  }

  /* Integrated Hero Panel */
  .hero-panel {
    background-color: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(82, 104, 45, 0.1);
    padding: 1.5rem 2rem 2rem;
    margin-bottom: 1.25rem;
  }

  /* Top row: Icon + Title */
  .hero-top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .hero-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-icon {
    width: 80px;
    height: auto;
  }

  .hero-content {
    flex: 1;
    min-width: 250px;
  }

  .hero-title {
    color: #52682D;
    font-size: 1.75rem;
    margin: 0 0 0.25rem 0;
    font-weight: 700;
  }

  .hero-tagline {
    color: #52682D;
    font-size: 1.05rem;
    line-height: 1.4;
    margin: 0 0 0.35rem 0;
    opacity: 0.85;
  }

  .hero-subtitle {
    color: #52682D;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    opacity: 0.7;
    max-width: 520px;
  }

  /* Bottom row: Controls (chips + search) */
  .hero-controls {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }

  .level-selector-area {
    flex: 1;
    min-width: 0;
  }

  .level-hint {
    display: block;
    font-size: 0.8rem;
    color: #738C52;
    font-weight: 500;
    margin-bottom: 0.5rem;
    opacity: 0.85;
  }

  .level-chips {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .level-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    text-decoration: none;
    padding: 0.4rem;
    border: 2px solid #c7d8a4;
    border-radius: 12px;
    background-color: #ffffff;
    box-shadow: 0 2px 6px rgba(82, 104, 45, 0.08);
    transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, transform 0.12s ease;
    width: 5.5rem;
    height: 6.5rem;
    text-align: center;
    cursor: pointer;
  }

  .level-chip:hover {
    background-color: #f7f9f3;
    border-color: #6e8b3d;
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(82, 104, 45, 0.20);
  }

  .level-chip:active {
    transform: translateY(0);
    box-shadow: 0 1px 3px rgba(82, 104, 45, 0.15);
  }

  .level-chip:hover .level-chip__line1,
  .level-chip:hover .level-chip__line2 {
    color: #3e5023;
  }

  .level-chip.active {
    border-color: #52682D;
    background: #f7f8f7;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
  }

  .level-chip__icon {
    width: 44px;
    height: 44px;
    object-fit: contain;
    display: block;
    transition: all 0.3s ease;
  }

  .level-chip__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    line-height: 1.15;
    min-height: 2.2rem;
  }

  .level-chip__line1 {
    font-size: 0.75rem;
    color: #52682D;
    font-weight: 600;
    white-space: nowrap;
  }

  .level-chip__line2 {
    font-size: 0.6rem;
    color: #738C52;
    font-weight: 600;
    word-wrap: break-word;
    max-width: 100%;
  }

  /* Search input */
  .search-wrapper {
    flex-shrink: 0;
    align-self: flex-end;
  }

  .search-input {
    width: 160px;
    padding: 0.6rem 1rem;
    border: 1px solid #c7d8a4;
    border-radius: 50px;
    font-size: 0.9rem;
    background-color: #fafcf7;
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: #52682D;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
    width: 200px;
    background-color: white;
  }

  /* Catalogue Content */
  .catalogue-content {
    position: relative;
  }

  /* Skill Builder Cards */
  :global(.builder-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  :global(.builder-card) {
    background: white;
    border: 2px solid #e6eddc;
    border-radius: 14px;
    padding: 1.75rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.08);
  }

  :global(.builder-card:hover) {
    border-color: #738C52;
    box-shadow: 0 6px 20px rgba(82, 104, 45, 0.15);
    transform: translateY(-3px);
  }

  :global(.builder-card-header) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  :global(.builder-title) {
    color: #52682D;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    text-decoration: none;
    display: block;
    flex: 1;
  }

  :global(.builder-title:hover) {
    color: #738C52;
  }

  :global(.builder-level-badge) {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background-color: #f0f4e8;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #52682D;
  }

  :global(.builder-level-badge img) {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  :global(.builder-tagline) {
    font-style: italic;
    color: #738C52;
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
  }

  :global(.builder-description) {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }


  /* Error State */
  .error {
    background-color: #fef2f2;
    border: 2px solid #fca5a5;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    color: #991b1b;
  }

  /* Empty State */
  :global(.empty-state) {
    text-align: center;
    padding: 4rem 2rem;
    color: #666;
  }

  :global(.empty-state h3) {
    color: #52682D;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  /* Scroll to Top */
  .scroll-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #52682D;
    color: white;
    border: none;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  .scroll-to-top:hover {
    background-color: #738C52;
    transform: translateY(-3px);
  }

  .scroll-to-top svg {
    width: 24px;
    height: 24px;
  }

  /* Animation */
  .fade-in {
    animation: fadeIn 0.6s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-panel {
      padding: 1.25rem 1.5rem;
    }

    .hero-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .header-icon {
      width: 60px;
    }

    .hero-title {
      font-size: 1.5rem;
    }

    .hero-tagline {
      font-size: 1rem;
    }

    .hero-controls {
      flex-direction: column;
      align-items: stretch;
      margin-top: 1rem;
    }

    .level-hint {
      text-align: center;
    }

    .level-chips {
      justify-content: center;
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    .level-chip {
      width: 5rem;
      height: 6rem;
    }

    .level-chip__icon {
      width: 40px;
      height: 40px;
    }

    .level-chip__label {
      min-height: 2rem;
    }

    .level-chip__line1 {
      font-size: 0.7rem;
    }

    .level-chip__line2 {
      font-size: 0.55rem;
    }

    .search-wrapper {
      width: 100%;
      margin-top: 0.75rem;
    }

    .search-input {
      width: 100%;
    }

    .search-input:focus {
      width: 100%;
    }

    :global(.builder-grid) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-panel {
      padding: 1rem 1rem 1.5rem;
    }

    .level-chips {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem;
    }

    .level-chip {
      width: 4.25rem;
      height: 5.25rem;
      padding: 0.35rem 0.25rem;
    }

    .level-chip__icon {
      width: 32px;
      height: 32px;
    }

    .level-chip__label {
      min-height: 1.6rem;
    }

    .level-chip__line1 {
      font-size: 0.6rem;
    }

    .level-chip__line2 {
      font-size: 0.5rem;
    }

    .level-hint {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  const buildersData = JSON.parse(document.getElementById('catalogueContent').dataset.builders || '[]');
  const searchInput = document.getElementById('searchInput');
  const catalogueContent = document.getElementById('catalogueContent');
  const levelChips = document.querySelectorAll('.level-chip');
  
  let currentLevel = 'all';

  function getLevelInfo(level) {
    const levels = {
      1: { label: 'Level 1', icon: '/images/level-1.svg' },
      2: { label: 'Level 2', icon: '/images/level-2.svg' },
      3: { label: 'Level 3', icon: '/images/level-3.svg' },
      4: { label: 'Level 4', icon: '/images/level-4.svg' },
    };
    return levels[level] || null;
  }

  function renderBuilders(builders) {
    if (builders.length === 0) {
      catalogueContent.innerHTML = `
        <div class="empty-state">
          <h3>No skill builders found</h3>
          <p>Try adjusting your search or check back later for new content.</p>
        </div>
      `;
      return;
    }

    const grid = document.createElement('div');
    grid.className = 'builder-grid';

    builders.forEach(builder => {
      const card = document.createElement('div');
      card.className = 'builder-card';
      card.dataset.level = builder.level;
      
      const levelInfo = getLevelInfo(builder.level);
      const levelBadgeHtml = levelInfo 
        ? `<span class="builder-level-badge">
             <img src="${levelInfo.icon}" alt="" />
             ${levelInfo.label}
           </span>`
        : '';
      
      card.innerHTML = `
        <div class="builder-card-header">
          <a href="/skillbuilder/${builder.slug}" class="builder-title">${builder.title}</a>
          ${levelBadgeHtml}
        </div>
        ${builder.tagline ? `<p class="builder-tagline">${builder.tagline}</p>` : ''}
        <p class="builder-description">${builder.description}</p>
      `;
      
      grid.appendChild(card);
    });

    catalogueContent.innerHTML = '';
    catalogueContent.appendChild(grid);
  }

  function filterBuilders() {
    const searchTerm = searchInput.value.toLowerCase();

    let filtered = buildersData;
    
    // Filter by level first
    if (currentLevel !== 'all') {
      filtered = filtered.filter(builder => String(builder.level) === currentLevel);
    }
    
    // Then filter by search term
    filtered = filtered.filter(builder => 
      builder.title.toLowerCase().includes(searchTerm) ||
      builder.description.toLowerCase().includes(searchTerm) ||
      (builder.tagline && builder.tagline.toLowerCase().includes(searchTerm))
    );

    renderBuilders(filtered);
  }

  // Level chip click handlers
  levelChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const level = chip.dataset.level;
      const isAlreadyActive = chip.classList.contains('active');
      
      // Remove active from all chips
      levelChips.forEach(c => c.classList.remove('active'));
      
      // Toggle behavior: if clicking already-active chip, reset to 'all'
      if (isAlreadyActive && level !== 'all') {
        currentLevel = 'all';
        // Set active on the 'All' chip
        document.querySelector('.level-chip[data-level="all"]').classList.add('active');
      } else {
        chip.classList.add('active');
        currentLevel = level;
      }
      
      filterBuilders();
    });
  });

  searchInput.addEventListener('input', filterBuilders);

  // Scroll to top button
  const scrollToTopBtn = document.getElementById('scrollToTop');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      scrollToTopBtn.classList.add('visible');
    } else {
      scrollToTopBtn.classList.remove('visible');
    }
  });

  scrollToTopBtn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Initial render
  filterBuilders();
</script>
