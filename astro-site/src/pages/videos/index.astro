---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allVideos = await getCollection('videos');

const publishedVideos = allVideos
  .filter(v => v.data.published !== false)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Video Library | Knit by Machine" description="Browse our library of knitting machine tutorial videos">
  <main class="videos-page">
    <div class="container">
      <header class="page-header">
        <h1>Video Library</h1>
        <p class="subtitle">Tutorial videos for machine knitting techniques</p>
      </header>

      {publishedVideos.length === 0 ? (
        <div class="empty-state">
          <p>No videos published yet. Check back soon!</p>
        </div>
      ) : (
        <ul class="video-list" data-testid="video-list">
          {publishedVideos.map((video) => (
            <li class="video-item" data-testid={`video-item-${video.id}`}>
              <a href={`/videos/${video.id.replace('.json', '')}`} class="video-link">
                <div class="video-info">
                  <h2 class="video-title">{video.data.title}</h2>
                  {video.data.skillLevel && (
                    <span class="skill-badge">{video.data.skillLevel}</span>
                  )}
                </div>
                {video.data.tags && video.data.tags.length > 0 && (
                  <div class="video-tags">
                    {video.data.tags.join(' · ')}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .videos-page {
    padding: 2rem 0 4rem;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--kbm-green, #52682d);
    margin: 0 0 0.5rem;
  }

  .subtitle {
    color: #666;
    font-size: 1.1rem;
    margin: 0;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    background: #f9f9f9;
    border-radius: 8px;
    color: #666;
  }

  .video-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .video-item {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .video-item:hover {
    border-color: var(--kbm-green, #52682d);
    box-shadow: 0 2px 8px rgba(82, 104, 45, 0.1);
  }

  .video-link {
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  .video-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .video-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    margin: 0;
  }

  .skill-badge {
    background: var(--kbm-green-light, #e8eee0);
    color: var(--kbm-green, #52682d);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: capitalize;
  }

  .video-tags {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #666;
    font-style: italic;
  }
</style>
