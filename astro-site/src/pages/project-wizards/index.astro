---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

const title = "Project Wizards | Knit by Machine";
const description = "Plan a machine-knitting project before you cast on. Clear, practical setup support for common project types.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Project Wizards" 
      iconPath="/images/guide_icon.png"
      iconAlt="Project Wizard icon"
    />

    <div class="intro-section">
      <p class="intro-text">
        Project Wizards help you plan a machine-knitting project before you cast on. Each wizard focuses on a specific type of project and helps you arrive at a clear, workable setup.
      </p>
    </div>

    <div class="cards-grid" data-testid="project-wizards-grid">
      <div class="info-card" data-testid="card-what-it-is">
        <h2 class="card-title">What it is</h2>
        <p class="card-body">Plan a project before you start knitting. Each wizard helps you arrive at a clear, workable setup.</p>
      </div>

      <div class="info-card" data-testid="card-how-it-works">
        <h2 class="card-title">How it works</h2>
        <p class="card-body">Answer only what matters. Get a plan you can knit from — not general advice.</p>
      </div>

      <div class="info-card" data-testid="card-what-to-use-now">
        <h2 class="card-title">What to use now</h2>
        <p class="card-body">Gauge tools, setup references, and Ask 'n Answer entries support the same planning decisions.</p>
      </div>
    </div>

    <p class="project-types-note">
      Project types will be handled separately (socks, hats, blankets, sweaters).
    </p>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .info-card {
    background-color: #f9fdf5;
    border: 1px solid #c7d8a4;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #52682D;
    margin: 0;
    line-height: 1.3;
  }

  .card-body {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .project-types-note {
    font-size: 0.9rem;
    color: #6b7280;
    text-align: center;
    margin: 0;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .intro-section {
      margin-bottom: 2rem;
    }
  }
</style>
