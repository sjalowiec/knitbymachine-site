---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Getting Started with Your Knitting Machine';
const pageDescription = 'A simple starting point to get your knitting machine set up, moving smoothly, and ready for real knitting.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="kbm-getting-started">
    <!-- HERO SECTION -->
    <section class="kbm-section kbm-section--soft">
      <div class="kbm-container kbm-page-layout">
        <div class="kbm-hero-text">
          <header class="kbm-page-header">
            <p class="kbm-eyebrow" data-testid="text-eyebrow">Start here</p>
            <h1 data-testid="text-page-title">Getting Started with Your Knitting Machine</h1>
            <p class="kbm-lede" data-testid="text-lede">
              Machine knitting can feel unfamiliar at first — that's normal. This page gives you a simple place to begin so you can get your machine set up, moving smoothly, and ready for real knitting.
            </p>
          </header>
        </div>

        <div class="kbm-hero-media">
          <img 
            src="/images/knitting-machine-collage.webp" 
            alt="Four photos showing different types of knitting machines to reassure beginners that any machine will work"
            class="kbm-hero-image"
            data-testid="img-hero-collage"
          />
        </div>
      </div>
    </section>

    <!-- YOUR NEXT STEP SECTION -->
    <section class="kbm-section" data-testid="section-next-step">
      <div class="kbm-container">
        <h2>Your next step</h2>
        <p>
          When you're ready, scroll to the Getting Started Helper below. Tell it where you're starting — new, returning, or unsure — and it will guide you one simple step at a time.
        </p>

        <div class="kbm-next-step-cta">
          <a href="#getting-started-helper" class="kbm-button kbm-button--primary" data-testid="button-go-to-helper">
            Go to the Getting Started Helper
          </a>
        </div>
      </div>
    </section>

    <!-- GETTING STARTED HELPER SECTION (MindPal Embed) -->
    <section id="getting-started-helper" class="kbm-section kbm-section--agent" data-testid="section-helper">
      <h2>Getting Started Helper</h2>
      <p class="kbm-section-intro">
        Use this helper for calm, simple guidance. It will ask a few questions and suggest one clear next step at a time.
      </p>

      <div class="kbm-starter-chips">
        <p class="kbm-starter-label">
          Pick a starting point, or type your own question:
        </p>

        <div class="kbm-starter-chip-row">
          <button
            type="button"
            class="kbm-chip kbm-chip--starter"
            data-starter="Where do I start with my knitting machine?"
            data-testid="chip-where-start"
          >
            Where do I start?
          </button>

          <button
            type="button"
            class="kbm-chip kbm-chip--starter"
            data-starter="Help me get my machine ready to use."
            data-testid="chip-machine-ready"
          >
            Get my machine ready
          </button>

          <button
            type="button"
            class="kbm-chip kbm-chip--starter"
            data-starter="It's been a while — how do I get going again?"
            data-testid="chip-rusty"
          >
            I'm rusty
          </button>

          <button
            type="button"
            class="kbm-chip kbm-chip--starter"
            data-starter="Show me how to make my first rows."
            data-testid="chip-first-rows"
          >
            Make my first rows
          </button>

          <button
            type="button"
            class="kbm-chip kbm-chip--starter"
            data-starter="I'm unsure what to do next."
            data-testid="chip-not-sure"
          >
            Not sure what to do
          </button>
        </div>
      </div>

      <div class="kbm-agent-wrapper">
        <iframe 
          src="https://chatbot.getmindpal.com/getting-started-helper-gdl"
          allow="clipboard-read; clipboard-write; microphone"
          class="kbm-mindpal-iframe"
          data-testid="iframe-mindpal-agent"
        ></iframe>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const chips = document.querySelectorAll('.kbm-chip--starter');

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const starterText = chip.getAttribute('data-starter');
          if (!starterText) return;

          const agentWrapper = document.querySelector('.kbm-agent-wrapper');
          if (!agentWrapper) return;

          const iframe = agentWrapper.querySelector('iframe');
          if (!iframe || !iframe.contentWindow) {
            console.warn('MindPal iframe not found inside .kbm-agent-wrapper');
            return;
          }

          iframe.contentWindow.postMessage(
            {
              type: 'kbm_starter_message',
              text: starterText,
              source: 'kbm-getting-started-page'
            },
            '*'
          );
        });
      });
    });
  </script>
</BaseLayout>

<style>
  /* ========== GETTING STARTED PAGE STYLES ========== */
  
  .kbm-getting-started {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  /* ========== SECTIONS ========== */
  .kbm-section {
    padding: 2rem 0;
  }

  .kbm-section--soft {
    background: linear-gradient(180deg, #f1f6ec 0%, transparent 100%);
    border-radius: 1.5rem;
    padding: 2.5rem 0;
    margin-bottom: 1rem;
  }

  .kbm-section--agent {
    background-color: #f7f8f7;
    border: 2px solid #c7d8a4;
    border-radius: 1.25rem;
    padding: 2rem;
    scroll-margin-top: calc(var(--header-height, 6rem) + 1rem);
  }

  .kbm-container {
    width: 100%;
  }

  /* ========== HERO LAYOUT ========== */
  .kbm-page-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .kbm-page-layout {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* ========== HERO TEXT ========== */
  .kbm-hero-text {
    text-align: center;
  }

  @media (min-width: 768px) {
    .kbm-hero-text {
      text-align: left;
    }
  }

  .kbm-page-header {
    margin: 0;
  }

  .kbm-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #738c52;
    margin-bottom: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(115, 140, 82, 0.12);
    border-radius: 999px;
  }

  .kbm-page-header h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0 0 1rem;
    color: #2c3a57;
    line-height: 1.25;
  }

  .kbm-lede {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #4d5a48;
    margin: 0;
    max-width: 500px;
  }

  @media (min-width: 768px) {
    .kbm-lede {
      margin: 0;
    }
  }

  @media (max-width: 767px) {
    .kbm-lede {
      margin: 0 auto;
    }
  }

  /* ========== HERO MEDIA / IMAGE ========== */
  .kbm-hero-media {
    display: flex;
    justify-content: center;
  }

  .kbm-hero-image {
    width: 100%;
    max-width: 450px;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  /* ========== SECTION HEADINGS ========== */
  .kbm-section h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    color: #2c3a57;
    margin: 0 0 0.75rem;
    text-align: center;
  }

  .kbm-section-intro {
    font-size: 1rem;
    color: #4d5a48;
    line-height: 1.6;
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  /* ========== NEXT STEP CTA ========== */
  .kbm-next-step-cta {
    text-align: center;
    margin-top: 1.5rem;
  }

  .kbm-button {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-size: 1rem;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .kbm-button--primary {
    background-color: #52682d;
    color: #ffffff;
  }

  .kbm-button--primary:hover {
    background-color: #445626;
  }

  /* ========== STARTER CHIPS ========== */
  .kbm-starter-chips {
    margin: 1.5rem 0;
  }

  .kbm-starter-label {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: #4d5a48;
  }

  .kbm-starter-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .kbm-chip {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 2px solid #52682D;
    background-color: #ffffff;
    color: #2C3A57;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.08s ease;
  }

  .kbm-chip:hover {
    background-color: #F0F4EC;
    transform: translateY(-1px);
  }

  .kbm-chip:active {
    transform: translateY(0);
  }

  /* ========== AGENT WRAPPER ========== */
  .kbm-agent-wrapper {
    margin-top: 1.5rem;
    width: 100%;
  }

  /* ========== MINDPAL IFRAME ========== */
  .kbm-mindpal-iframe {
    width: 100%;
    height: 100%;
    min-height: 700px;
    border: none;
    border-radius: 0.75rem;
    background-color: #ffffff;
  }

  /* ========== SECTION-SPECIFIC ADJUSTMENTS ========== */
  .kbm-section--agent h2 {
    text-align: left;
  }

  .kbm-section--agent .kbm-section-intro {
    text-align: left;
    margin-left: 0;
    margin-right: 0;
  }

  /* ========== MOBILE ADJUSTMENTS ========== */
  @media (max-width: 480px) {
    .kbm-getting-started {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .kbm-section--soft {
      padding: 1.5rem 1rem;
      border-radius: 1rem;
    }

    .kbm-section--agent {
      padding: 1.5rem 1rem;
    }

    .kbm-hero-image {
      max-width: 100%;
    }
  }
</style>
