---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Getting Started with Your Knitting Machine';
const pageDescription = 'A simple starting point to get your knitting machine set up, moving smoothly, and ready for real knitting.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="kbm-getting-started">
    <!-- HERO SECTION -->
    <section class="kbm-section kbm-section--soft">
      <div class="kbm-container kbm-page-layout">
        <div class="kbm-hero-text">
          <header class="kbm-page-header">
            <h1 data-testid="text-page-title">Get Started with Your Knitting Machine</h1>
            <p class="kbm-lede" data-testid="text-lede">
              Whether this is your first session or your first session in a while, this guide helps you get oriented and choose your next step.
            </p>
          </header>

          <p class="kbm-hero-cta-text">
            When you're ready, scroll to the Ready ● Set ● Knit helper below. Tell it where you're starting — new, returning, or unsure — and it will guide you one simple step at a time.
          </p>

          <div class="kbm-next-step-cta">
            <a href="#getting-started-helper" class="kbm-button kbm-button--primary" data-testid="button-go-to-helper">
              Ready ● Set ● Knit
            </a>
          </div>
        </div>

        <div class="kbm-hero-media">
          <div class="kbm-image-grid">
            <img 
              src="/images/knitting-machine-collage.webp" 
              alt="Four photos showing different types of knitting machines to reassure beginners that any machine will work"
              class="kbm-hero-image"
              data-testid="img-hero-collage"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- GETTING STARTED HELPER SECTION (MindPal Embed) -->
    <section id="getting-started-helper" class="kbm-section kbm-section--agent" data-testid="section-helper">
      <div class="kbm-agent-wrapper">
        <iframe 
          src="https://chatbot.getmindpal.com/ready-set-knit-getting-started-25e"
          allow="clipboard-read; clipboard-write; microphone"
          class="kbm-mindpal-iframe"
          data-testid="iframe-mindpal-agent"
        ></iframe>
      </div>

      <button id="finish" class="kbm-confetti-btn" data-testid="button-next-step">I'm ready for my next step!</button>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Confetti button
      const finishBtn = document.getElementById('finish');
      if (finishBtn) {
        finishBtn.addEventListener('click', () => {
          confetti({
            particleCount: 120,
            spread: 70,
            origin: { y: 0.7 }
          });
        });
      }
    });
  </script>
</BaseLayout>

<style>
  /* ========== GETTING STARTED PAGE STYLES ========== */
  
  .kbm-getting-started {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  /* ========== SECTIONS ========== */
  .kbm-section {
    padding: 2rem 0;
  }

  .kbm-section--soft {
    background: linear-gradient(180deg, #f1f6ec 0%, transparent 100%);
    border-radius: 1.5rem;
    padding: 2.5rem 0;
    margin-bottom: 0;
  }

  .kbm-section--agent {
    background-color: #f7f8f7;
    border: 2px solid #c7d8a4;
    border-radius: 1.25rem;
    padding: 2rem;
    scroll-margin-top: calc(var(--header-height, 6rem) + 1rem);
  }

  .kbm-container {
    width: 100%;
  }

  /* ========== HERO LAYOUT ========== */
  .kbm-page-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .kbm-page-layout {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* ========== HERO TEXT ========== */
  .kbm-hero-text {
    text-align: center;
  }

  @media (min-width: 768px) {
    .kbm-hero-text {
      text-align: left;
    }
  }

  .kbm-page-header {
    margin: 0;
  }

  .kbm-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #738c52;
    margin-bottom: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(115, 140, 82, 0.12);
    border-radius: 999px;
  }

  .kbm-page-header h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0 0 1rem;
    color: #2c3a57;
    line-height: 1.25;
  }

  .kbm-lede {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #4d5a48;
    margin: 0;
    max-width: 500px;
  }

  @media (min-width: 768px) {
    .kbm-lede {
      margin: 0;
    }
  }

  @media (max-width: 767px) {
    .kbm-lede {
      margin: 0 auto;
    }
  }

  .kbm-hero-cta-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #4d5a48;
    margin: 1.25rem 0 0;
    max-width: 500px;
  }

  @media (max-width: 767px) {
    .kbm-hero-cta-text {
      text-align: center;
      margin: 1.25rem auto 0;
    }
  }

  /* ========== HERO MEDIA / IMAGE ========== */
  .kbm-hero-media {
    display: flex;
    justify-content: center;
  }

  .kbm-image-grid {
    border: 5px solid #52682D;
    border-radius: 8px;
    overflow: hidden;
    max-width: 450px;
  }

  .kbm-hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ========== SECTION HEADINGS ========== */
  .kbm-section h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    color: #2c3a57;
    margin: 0 0 0.75rem;
    text-align: center;
  }

  .kbm-section-intro {
    font-size: 1rem;
    color: #4d5a48;
    line-height: 1.6;
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  /* ========== NEXT STEP CTA ========== */
  .kbm-next-step-cta {
    text-align: left;
    margin-top: 1.5rem;
  }

  @media (max-width: 767px) {
    .kbm-next-step-cta {
      text-align: center;
    }
  }

  .kbm-button {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-size: 1rem;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .kbm-button--primary {
    background-color: #52682d;
    color: #ffffff;
  }

  .kbm-button--primary:hover {
    background-color: #445626;
  }

  /* ========== AGENT WRAPPER ========== */
  .kbm-agent-wrapper {
    margin-top: 1.5rem;
    width: 100%;
  }

  /* ========== MINDPAL IFRAME ========== */
  .kbm-mindpal-iframe {
    width: 100%;
    height: 100%;
    min-height: 700px;
    border: none;
    border-radius: 0.75rem;
    background-color: #ffffff;
  }

  /* ========== CONFETTI BUTTON ========== */
  .kbm-confetti-btn {
    width: 100%;
    margin-top: 1.5rem;
    padding: 1rem 2rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #ffffff;
    background-color: #52682d;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .kbm-confetti-btn:hover {
    background-color: #6e8b3d;
    transform: translateY(-2px);
  }

  .kbm-confetti-btn:active {
    transform: translateY(0);
  }

  /* ========== SECTION-SPECIFIC ADJUSTMENTS ========== */
  .kbm-section--agent h2 {
    text-align: left;
  }

  .kbm-section--agent .kbm-section-intro {
    text-align: left;
    margin-left: 0;
    margin-right: 0;
  }

  /* ========== MOBILE ADJUSTMENTS ========== */
  @media (max-width: 480px) {
    .kbm-getting-started {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .kbm-section--soft {
      padding: 1.5rem 1rem;
      border-radius: 1rem;
    }

    .kbm-section--agent {
      padding: 1.5rem 1rem;
    }

    .kbm-hero-image {
      max-width: 100%;
    }
  }
</style>
