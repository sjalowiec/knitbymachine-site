---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

const title = "Workshops | Knit by Machine";
const description = "Structured knitting experiences with clear outcomes, intentional sequences, and demonstrations built into the process.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Workshops" 
      iconPath="/images/workshop_icon.png"
      iconAlt="Workshops icon"
    />

    <div class="intro-section">
      <p class="intro-text">
        Workshops at Knit by Machine are structured knitting experiences.
        Each workshop has a clear outcome, an intentional sequence, and demonstrations built into the process.
      </p>
    </div>

    <h2 class="section-heading">Two Ways to Take a Workshop</h2>

    <div class="cards-grid" data-testid="workshops-grid">
      <div class="workshop-card" data-testid="card-self-paced">
        <h3 class="card-title">Self-Paced Workshops</h3>
        <p class="card-body">
          Follow the full workshop structure on your own schedule.
          Includes recorded lessons and demonstrations, with no live support.
          Start anytime and move at your own pace.
        </p>
      </div>

      <div class="workshop-card" data-testid="card-guided">
        <h3 class="card-title">Guided Workshops</h3>
        <p class="card-body">
          Includes the same structured content as the self-paced version,
          plus time-based guidance, feedback, and conversation.
          Guided workshops are offered periodically.
        </p>
        <a href="/guided-workshops" class="card-link" data-testid="link-guided-workshops">View Guided Workshops</a>
      </div>
    </div>

    <!--
    Future enhancement:
    - Workshop listing grid
    - Filters for Project / Foundations / Skill workshops
    - Badges for Self-Paced vs Guided
    -->
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 0 2.5rem;
    text-align: left;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .section-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #52682D;
    margin: 0 0 1.5rem;
    text-align: left;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .workshop-card {
    background-color: #f9fdf5;
    border: 1px solid #c7d8a4;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #52682D;
    margin: 0;
    line-height: 1.3;
  }

  .card-body {
    font-size: 1rem;
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .card-link {
    display: inline-block;
    color: #52682D;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    font-weight: 600;
    transition: color 0.2s ease;
    margin-top: 0.5rem;
  }

  .card-link:hover {
    color: #738C52;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .intro-section {
      margin-bottom: 2rem;
    }
  }
</style>
