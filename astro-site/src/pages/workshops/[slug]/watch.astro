---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/global.css";

const { slug } = Astro.params;

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
const REPO_OWNER = 'sjalowiec';
const REPO_NAME = 'knitbymachine-site';
const CONTENT_PATH = 'astro-site/src/content/workshops';

async function getWorkshopEntry(slug: string) {
  try {
    const response = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${slug}.json`,
      {
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'knitbymachine-astro'
        }
      }
    );

    if (!response.ok) {
      return null;
    }

    const data = await response.json();
    const binaryString = atob(data.content);
    const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
    const content = new TextDecoder('utf-8').decode(bytes);
    const jsonData = JSON.parse(content);

    if (jsonData.isDraft || jsonData.pendingPublish) {
      return null;
    }

    return {
      data: jsonData,
      slug: slug
    };
  } catch (error) {
    console.error('Error fetching workshop entry:', error);
    return null;
  }
}

const entry = await getWorkshopEntry(slug);

if (!entry) {
  return Astro.redirect('/404');
}

const workshop = entry.data;

const CATEGORY_LABELS = {
  learn: { label: 'Learn', color: '#4a90a4' },
  knit: { label: 'Knit', color: '#738c52' },
  other: { label: 'Other', color: '#8b7355' }
};

const categoryInfo = CATEGORY_LABELS[workshop.category] || CATEGORY_LABELS.other;

const title = `${workshop.title} – Watch the Workshop | Knit by Machine`;
const description = workshop.metaDescription || workshop.tagline || workshop.shortDescription || workshop.description?.slice(0, 150);
---

<BaseLayout {title} {description}>
  <div class="workshop-watch-page">
    
    <!-- Top Bar / Header -->
    <header class="watch-header">
      <div class="header-content">
        <div class="header-left">
          <span class="category-label" style={`background-color: ${categoryInfo.color}`}>
            {categoryInfo.label}
          </span>
          <h1 class="workshop-title" data-testid="text-workshop-title">{workshop.title}</h1>
        </div>
        <a href={`/workshops/${slug}`} class="back-link" data-testid="link-workshop-details">
          ← Workshop details
        </a>
      </div>
    </header>

    <!-- Main Two-Column Layout -->
    <div class="watch-layout">
      
      <!-- Left / Main Content: Video -->
      <main class="video-column">
        <div class="video-section">
          {workshop.videoUrl ? (
            <div class="video-wrapper">
              <iframe 
                src={workshop.videoUrl}
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                title={workshop.title}
              ></iframe>
            </div>
          ) : (
            <div class="video-placeholder">
              <div class="placeholder-icon">🎬</div>
              <p class="placeholder-text">Video coming soon</p>
              <p class="placeholder-subtext">Check back later for the full workshop video.</p>
            </div>
          )}
        </div>
        
        <p class="video-hint">
          You can pause, rewind, and come back anytime.
        </p>
      </main>

      <!-- Right / Sidebar: Supporting Info -->
      <aside class="sidebar-column">
        
        <!-- What You Need -->
        {workshop.materials && workshop.materials.length > 0 && (
          <section class="sidebar-section">
            <h2 class="sidebar-heading">What You Need</h2>
            <ul class="materials-list">
              {workshop.materials.map((material: string) => (
                <li>{material}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- Downloads -->
        {workshop.downloads && workshop.downloads.length > 0 && (
          <section class="sidebar-section">
            <h2 class="sidebar-heading">Downloads</h2>
            <ul class="downloads-list">
              {workshop.downloads.map((download: { label: string; url: string }) => (
                <li>
                  <a href={download.url} target="_blank" rel="noopener noreferrer" class="download-link">
                    <span class="download-icon">📄</span>
                    {download.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Related Links -->
        {workshop.relatedLinks && workshop.relatedLinks.length > 0 && (
          <section class="sidebar-section">
            <h2 class="sidebar-heading">Related Resources</h2>
            <ul class="related-list">
              {workshop.relatedLinks.map((link: { label: string; url: string }) => (
                <li>
                  <a href={link.url} class="related-link">
                    → {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Notes & Tips Placeholder -->
        <section class="sidebar-section">
          <h2 class="sidebar-heading">Notes & Tips</h2>
          <p class="placeholder-note">
            Tips and notes for this workshop will appear here. Check back for updates!
          </p>
        </section>

        <!-- Questions? -->
        <section class="sidebar-section">
          <h2 class="sidebar-heading">Questions?</h2>
          <p class="questions-text">
            Have a question about this workshop? Check out our 
            <a href="/ana-catalog">Ask 'n Answer</a> section or 
            <a href="/contact">contact us</a> directly.
          </p>
        </section>

      </aside>
    </div>

    <!-- Footer CTA -->
    <footer class="watch-footer">
      <a href="/workshops" class="footer-link" data-testid="link-all-workshops">
        ← Back to All Workshops
      </a>
    </footer>

  </div>
</BaseLayout>

<style>
  .workshop-watch-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 140px 20px 60px;
  }

  /* Watch Header */
  .watch-header {
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e8e0;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .category-label {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 16px;
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .workshop-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #52682d;
    margin: 0;
  }

  .back-link {
    color: #52682d;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #738c52;
  }

  /* Two-Column Layout */
  .watch-layout {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 40px;
  }

  /* Video Column */
  .video-column {
    min-width: 0;
  }

  .video-section {
    background: #1a1a1a;
    border-radius: 12px;
    overflow: hidden;
  }

  .video-wrapper {
    position: relative;
    padding-top: 56.25%; /* 16:9 aspect ratio */
    background: #000;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .video-placeholder {
    padding: 80px 40px;
    text-align: center;
    color: #888;
  }

  .placeholder-icon {
    font-size: 48px;
    margin-bottom: 16px;
  }

  .placeholder-text {
    font-size: 1.25rem;
    font-weight: 600;
    color: #ccc;
    margin: 0 0 8px;
  }

  .placeholder-subtext {
    font-size: 0.95rem;
    color: #888;
    margin: 0;
  }

  .video-hint {
    font-size: 0.9rem;
    color: #888;
    text-align: center;
    margin-top: 16px;
    font-style: italic;
  }

  /* Sidebar Column */
  .sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-section {
    background: #f7f8f5;
    border-radius: 12px;
    padding: 24px;
    border: 1px solid #e5e8e0;
  }

  .sidebar-heading {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #52682d;
    margin: 0 0 16px;
  }

  .materials-list,
  .downloads-list,
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .materials-list li {
    padding: 8px 0;
    border-bottom: 1px solid #e5e8e0;
    font-size: 0.95rem;
    color: #444;
  }

  .materials-list li:last-child {
    border-bottom: none;
  }

  .downloads-list li {
    margin-bottom: 10px;
  }

  .download-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #52682d;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 10px 12px;
    background: white;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .download-link:hover {
    background: #eef3e4;
  }

  .download-icon {
    font-size: 1.1rem;
  }

  .related-list li {
    margin-bottom: 8px;
  }

  .related-link {
    color: #52682d;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .related-link:hover {
    color: #738c52;
  }

  .placeholder-note {
    font-size: 0.9rem;
    color: #888;
    font-style: italic;
    margin: 0;
    line-height: 1.5;
  }

  .questions-text {
    font-size: 0.95rem;
    color: #5a5a5a;
    margin: 0;
    line-height: 1.6;
  }

  .questions-text a {
    color: #52682d;
    font-weight: 500;
    text-decoration: none;
  }

  .questions-text a:hover {
    text-decoration: underline;
  }

  /* Footer */
  .watch-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #e5e8e0;
    text-align: center;
  }

  .footer-link {
    color: #52682d;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: #738c52;
  }

  /* Mobile Responsive */
  @media (max-width: 900px) {
    .watch-layout {
      grid-template-columns: 1fr;
    }

    .sidebar-column {
      order: 2;
    }

    .workshop-watch-page {
      padding: 120px 16px 40px;
    }

    .workshop-title {
      font-size: 1.4rem;
    }

    .header-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .header-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
