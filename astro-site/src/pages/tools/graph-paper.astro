---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PrintFooter from "../../components/common/PrintFooter.astro";
import WizardBackLink from "../../components/wizards/WizardBackLink.astro";
import ToolActionBar from "../../components/wizards/ToolActionBar.astro";
import UnitToggle from "../../components/wizards/components/UnitToggle.astro";
import "../../styles/wizard.css";

const pageUrl = "https://knitbymachine.com/tools/graph-paper";
---

<BaseLayout 
  title="Graph Paper Tool | Knit by Machine" 
  description="Create full-scale knitter's graph paper based on your stitch and row gauge. Download printable SVG graph paper for shaping, motifs, and intarsia.">

<style>
/* Tool-specific container (wider than default wizard-container) */
.tool-container {
  max-width: 900px;
  margin: 0 auto;
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.form-section {
  margin-bottom: 2rem;
}

.section-label {
  color: var(--kbm-green);
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 1rem;
  display: block;
}

.gauge-helper {
  font-size: 0.9rem;
  color: #6b7280;
  margin-top: 0.5rem;
  font-style: italic;
}

.options-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
}

.input-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

/* Print styles */
@media print {
  .wizard-page {
    padding-top: 0 !important;
    background: white !important;
  }
  
  .page-header,
  .back-link,
  .form-section,
  .actions-section,
  .info-box,
  .no-print {
    display: none !important;
  }
  
  .tool-container {
    box-shadow: none !important;
    padding: 0 !important;
    background: white !important;
    border: none !important;
  }
}

@media (max-width: 640px) {
  .options-row,
  .input-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<div class="wizard-page">
  <div style="max-width: 900px; margin: 0 auto; padding: 0 1rem;">
    <WizardBackLink category="tool" />
  </div>

  <div class="page-header">
    <div class="page-header-title">
      <h1>Graph Paper Tool</h1>
    </div>
    <p>
      Create full-scale knitter's graph paper based on your stitch and row gauge. Plan shaping, motifs, and intarsia on a grid that matches how your knitting grows.
    </p>
  </div>

  <div class="tool-container">
    <!-- Gauge Section -->
    <div class="form-section">
      <div class="kbm-header-layout">
        <span class="section-label">Your Gauge</span>
        <div id="kbm-units-toggle">
          <UnitToggle id="graph" />
        </div>
      </div>
      
      <div class="input-grid">
        <div class="input-group">
          <label for="stitches" id="stitch-label">Stitches over 4 inches</label>
          <input 
            type="number" 
            id="stitches" 
            step="1" 
            min="1"
            placeholder="sts over 4&quot;"
            data-testid="input-stitches"
          />
        </div>
        <div class="input-group">
          <label for="rows" id="row-label">Rows over 4 inches</label>
          <input 
            type="number" 
            id="rows" 
            step="1" 
            min="1"
            placeholder="rows over 4&quot;"
            data-testid="input-rows"
          />
        </div>
      </div>
      <p class="gauge-helper">Enter your measured gauge over 4" (or 10 cm). Use whole numbers for best results.</p>
    </div>

    <!-- Paper Options -->
    <div class="form-section">
      <span class="section-label">Paper Options</span>
      
      <div class="options-row">
        <div class="input-group">
          <label for="paper-size">Paper Size</label>
          <select id="paper-size" data-testid="select-paper-size">
            <option value="letter">Letter (8.5 × 11 in)</option>
            <option value="a4">A4 (210 × 297 mm)</option>
          </select>
        </div>
        
        <div class="input-group">
          <label for="orientation">Orientation</label>
          <select id="orientation" data-testid="select-orientation">
            <option value="portrait">Portrait</option>
            <option value="landscape">Landscape</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <ToolActionBar downloadId="download-btn" downloadFilename="knit-graph-paper.svg" showPrint={false} />
    
    <div class="info-box no-print">
      <strong>Tip:</strong> For true-scale printing, print at Actual Size / 100% (not "Fit to page").
    </div>
  </div>
  
  <PrintFooter url={pageUrl} />
</div>

<script>
  // State
  let unit = localStorage.getItem('graphpaper.unit') || 'in';
  let stitches = localStorage.getItem('graphpaper.sts') || '24';
  let rows = localStorage.getItem('graphpaper.rows') || '32';
  let paperSize = localStorage.getItem('graphpaper.paper') || 'letter';
  let orientation = localStorage.getItem('graphpaper.orientation') || 'portrait';

  // DOM elements
  const btnInches = document.getElementById('graph-btn-inches');
  const btnCm = document.getElementById('graph-btn-cm');
  const inputStitches = document.getElementById('stitches') as HTMLInputElement;
  const inputRows = document.getElementById('rows') as HTMLInputElement;
  const selectPaper = document.getElementById('paper-size') as HTMLSelectElement;
  const selectOrientation = document.getElementById('orientation') as HTMLSelectElement;
  const stitchLabel = document.getElementById('stitch-label');
  const rowLabel = document.getElementById('row-label');
  const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;

  // Initialize inputs from localStorage
  if (inputStitches) inputStitches.value = stitches;
  if (inputRows) inputRows.value = rows;
  if (selectPaper) selectPaper.value = paperSize;
  if (selectOrientation) selectOrientation.value = orientation;

  // Update UI based on unit
  function updateUnitsUI() {
    if (unit === 'in') {
      btnInches?.classList.add('active');
      btnCm?.classList.remove('active');
      if (stitchLabel) stitchLabel.textContent = 'Stitches over 4 inches';
      if (rowLabel) rowLabel.textContent = 'Rows over 4 inches';
      if (inputStitches) inputStitches.placeholder = 'sts over 4"';
      if (inputRows) inputRows.placeholder = 'rows over 4"';
    } else {
      btnCm?.classList.add('active');
      btnInches?.classList.remove('active');
      if (stitchLabel) stitchLabel.textContent = 'Stitches over 10 cm';
      if (rowLabel) rowLabel.textContent = 'Rows over 10 cm';
      if (inputStitches) inputStitches.placeholder = 'sts over 10cm';
      if (inputRows) inputRows.placeholder = 'rows over 10cm';
    }
  }

  updateUnitsUI();

  // Build query string
  function buildQueryString(): string {
    const params = new URLSearchParams({
      sts: inputStitches.value || '24',
      rows: inputRows.value || '32',
      unit: unit,
      paper: selectPaper.value,
      orientation: selectOrientation.value,
    });
    return params.toString();
  }

  // Update download link
  function updateDownloadLink() {
    const query = buildQueryString();
    if (downloadBtn) downloadBtn.href = `/api/graph-paper.svg?${query}`;
    
    // Save to localStorage
    localStorage.setItem('graphpaper.sts', inputStitches.value);
    localStorage.setItem('graphpaper.rows', inputRows.value);
    localStorage.setItem('graphpaper.unit', unit);
    localStorage.setItem('graphpaper.paper', selectPaper.value);
    localStorage.setItem('graphpaper.orientation', selectOrientation.value);
  }

  // Unit toggle handlers
  btnInches?.addEventListener('click', () => {
    unit = 'in';
    updateUnitsUI();
    updateDownloadLink();
  });

  btnCm?.addEventListener('click', () => {
    unit = 'cm';
    updateUnitsUI();
    updateDownloadLink();
  });

  // Input change handlers - auto-update download link
  inputStitches?.addEventListener('input', updateDownloadLink);
  inputRows?.addEventListener('input', updateDownloadLink);
  selectPaper?.addEventListener('change', updateDownloadLink);
  selectOrientation?.addEventListener('change', updateDownloadLink);

  // Initial download link update
  updateDownloadLink();
</script>

</BaseLayout>
