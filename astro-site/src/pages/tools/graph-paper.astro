---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PrintFooter from "../../components/common/PrintFooter.astro";
import UnitToggle from "../../components/wizards/components/UnitToggle.astro";
import "../../styles/wizard.css";

const pageUrl = "https://knitbymachine.com/tools/graph-paper";
---

<BaseLayout 
  title="Graph Paper Tool | Knit by Machine" 
  description="Create full-scale knitter's graph paper based on your stitch and row gauge. Download printable SVG graph paper for shaping, motifs, and intarsia.">

<style>
.wizard-page {
  padding-top: 120px;
  padding-bottom: 3rem;
  min-height: 100vh;
  background: var(--page-bg);
}

.page-header {
  max-width: 800px;
  margin: 0 auto 2rem;
  padding: 0 1rem;
}

.page-header-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}

@media (max-width: 640px) {
  .page-header-title {
    flex-direction: column;
    gap: 0.75rem;
  }
}

.page-header h1 {
  color: var(--kbm-green);
  font-size: 2rem;
  font-weight: 700;
  margin: 0;
}

.page-header p {
  color: #6b7280;
  font-size: 1.05rem;
  line-height: 1.6;
  text-align: center;
}

.wizard-container {
  max-width: 900px;
  margin: 0 auto;
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.form-section {
  margin-bottom: 2rem;
}

.section-label {
  color: var(--kbm-green);
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 1rem;
  display: block;
}

.input-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.input-group {
  margin-bottom: 1rem;
}

.input-group label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: #374151;
  font-size: 0.95rem;
}

.input-group input,
.input-group select {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  font-size: 1rem;
  transition: border-color 0.2s;
  font-family: inherit;
}

.input-group input:focus,
.input-group select:focus {
  outline: none;
  border-color: var(--kbm-green);
}

.input-group input::placeholder {
  color: #9ca3af;
  font-size: 0.9rem;
}

.unit-label {
  font-size: 0.85rem;
  color: #6b7280;
  margin-top: 0.25rem;
}

.options-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;
}

.checkbox-group input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
  accent-color: var(--kbm-green);
}

.checkbox-group label {
  cursor: pointer;
  font-weight: 600;
  color: #374151;
  font-size: 0.95rem;
}

.preview-section {
  margin-top: 2rem;
  padding: 1.5rem;
  background: #f9fafb;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
}

.preview-section h3 {
  color: var(--kbm-green);
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0 0 1rem 0;
}

.preview-container {
  background: white;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  padding: 0.5rem;
  overflow: auto;
  max-height: 400px;
}

.preview-container img {
  display: block;
  max-width: 100%;
  height: auto;
}

.preview-hint {
  font-size: 0.9rem;
  color: #6b7280;
  margin-top: 1rem;
  line-height: 1.5;
}

.actions-section {
  margin-top: 2rem;
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  border: none;
  font-family: inherit;
}

.action-btn-primary {
  background: var(--kbm-green);
  color: white;
}

.action-btn-primary:hover {
  background: #3f5123;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(82, 104, 45, 0.25);
}

.action-btn-secondary {
  background: #e5e7eb;
  color: #374151;
}

.action-btn-secondary:hover {
  background: #d1d5db;
  transform: translateY(-1px);
}

.helper-note {
  margin-top: 1rem;
  padding: 0.75rem 1rem;
  background: rgba(82, 104, 45, 0.08);
  border-left: 3px solid var(--kbm-green);
  border-radius: 4px;
  font-size: 0.9rem;
  color: #374151;
}

.back-link {
  display: inline-block;
  color: #52682D;
  text-decoration: none;
  font-weight: 500;
  margin-bottom: 1.5rem;
  padding: 0.5rem 0;
  transition: color 0.2s;
}

.back-link:hover {
  color: #3d4e21;
  text-decoration: underline;
}

/* Print styles */
@media print {
  .wizard-page {
    padding-top: 0 !important;
    background: white !important;
  }
  
  .page-header,
  .back-link,
  .form-section,
  .actions-section,
  .helper-note,
  .no-print {
    display: none !important;
  }
  
  .wizard-container {
    box-shadow: none !important;
    padding: 0 !important;
    background: white !important;
    border: none !important;
  }
  
  .preview-section {
    background: white !important;
    border: none !important;
    padding: 0 !important;
  }
}

@media (max-width: 640px) {
  .input-grid {
    grid-template-columns: 1fr;
  }
  
  .options-row {
    grid-template-columns: 1fr;
  }
  
  .actions-section {
    flex-direction: column;
  }
  
  .action-btn {
    justify-content: center;
  }
}
</style>

<div class="wizard-page">
  <div style="max-width: 900px; margin: 0 auto; padding: 0 1rem;">
    <a href="/tools" class="back-link" data-testid="link-back-tools">← Back to Tools</a>
  </div>

  <div class="page-header">
    <div class="page-header-title">
      <h1>Graph Paper Tool</h1>
    </div>
    <p>
      Create full-scale knitter's graph paper based on your stitch and row gauge. Plan shaping, motifs, and intarsia on a grid that matches how your knitting grows.
    </p>
  </div>

  <div class="wizard-container">
    <!-- Gauge Section -->
    <div class="form-section">
      <div class="kbm-header-layout">
        <span class="section-label">Your Gauge</span>
        <div id="kbm-units-toggle">
          <UnitToggle id="graph" />
        </div>
      </div>
      
      <div class="input-grid">
        <div class="input-group">
          <label for="stitches">Stitch Gauge</label>
          <input 
            type="number" 
            id="stitches" 
            step="0.5" 
            min="0.5"
            placeholder="e.g., 6"
            data-testid="input-stitches"
          />
          <div class="unit-label" id="stitch-unit-label">stitches per inch</div>
        </div>
        <div class="input-group">
          <label for="rows">Row Gauge</label>
          <input 
            type="number" 
            id="rows" 
            step="0.5" 
            min="0.5"
            placeholder="e.g., 8"
            data-testid="input-rows"
          />
          <div class="unit-label" id="row-unit-label">rows per inch</div>
        </div>
      </div>
    </div>

    <!-- Paper Options -->
    <div class="form-section">
      <span class="section-label">Paper Options</span>
      
      <div class="options-row">
        <div class="input-group">
          <label for="paper-size">Paper Size</label>
          <select id="paper-size" data-testid="select-paper-size">
            <option value="letter">Letter (8.5 × 11 in)</option>
            <option value="a4">A4 (210 × 297 mm)</option>
          </select>
        </div>
        
        <div class="input-group">
          <label for="orientation">Orientation</label>
          <select id="orientation" data-testid="select-orientation">
            <option value="portrait">Portrait</option>
            <option value="landscape">Landscape</option>
          </select>
        </div>
        
        <div class="input-group">
          <label for="bold-every">Bold Lines Every</label>
          <select id="bold-every" data-testid="select-bold-every">
            <option value="5">5 cells</option>
            <option value="10" selected>10 cells</option>
          </select>
        </div>
      </div>
      
      <div class="checkbox-group">
        <input 
          type="checkbox" 
          id="show-guides" 
          checked 
          data-testid="checkbox-guides"
        />
        <label for="show-guides" id="guides-label">Show reference guides (every 1 inch)</label>
      </div>
    </div>

    <!-- Preview -->
    <div class="preview-section">
      <h3>Preview</h3>
      <div class="preview-container">
        <img 
          id="preview-img" 
          src="/api/graph-paper.svg?sts=6&rows=8&unit=in&paper=letter&orientation=portrait&boldEvery=10&guides=1" 
          alt="Graph paper preview"
          data-testid="img-preview"
        />
      </div>
      <p class="preview-hint">
        Print at 100%, tape sheets together for larger pieces, and sketch shapes or motifs directly on the grid.
      </p>
    </div>

    <!-- Actions -->
    <div class="actions-section no-print">
      <button class="action-btn action-btn-primary" id="update-preview-btn" data-testid="button-update-preview">
        <i class="fas fa-sync-alt"></i> Update Preview
      </button>
      <a class="action-btn action-btn-primary" id="download-btn" href="#" download="knit-graph-paper.svg" data-testid="link-download-svg">
        <i class="fas fa-download"></i> Download SVG
      </a>
      <button class="action-btn action-btn-secondary" id="print-btn" data-testid="button-print">
        <i class="fas fa-print"></i> Print
      </button>
    </div>
    
    <div class="helper-note no-print">
      <strong>Tip:</strong> For true-scale printing, print at Actual Size / 100% (not "Fit to page").
    </div>
  </div>
  
  <PrintFooter url={pageUrl} />
</div>

<script>
  // State
  let unit = localStorage.getItem('graphpaper.unit') || 'in';
  let stitches = localStorage.getItem('graphpaper.sts') || '6';
  let rows = localStorage.getItem('graphpaper.rows') || '8';
  let paperSize = localStorage.getItem('graphpaper.paper') || 'letter';
  let orientation = localStorage.getItem('graphpaper.orientation') || 'portrait';
  let boldEvery = localStorage.getItem('graphpaper.boldEvery') || '10';
  let showGuides = localStorage.getItem('graphpaper.guides') !== '0';

  // DOM elements
  const btnInches = document.getElementById('graph-btn-inches');
  const btnCm = document.getElementById('graph-btn-cm');
  const inputStitches = document.getElementById('stitches') as HTMLInputElement;
  const inputRows = document.getElementById('rows') as HTMLInputElement;
  const selectPaper = document.getElementById('paper-size') as HTMLSelectElement;
  const selectOrientation = document.getElementById('orientation') as HTMLSelectElement;
  const selectBoldEvery = document.getElementById('bold-every') as HTMLSelectElement;
  const checkboxGuides = document.getElementById('show-guides') as HTMLInputElement;
  const stitchUnitLabel = document.getElementById('stitch-unit-label');
  const rowUnitLabel = document.getElementById('row-unit-label');
  const guidesLabel = document.getElementById('guides-label');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const updateBtn = document.getElementById('update-preview-btn');
  const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;
  const printBtn = document.getElementById('print-btn');

  // Initialize inputs from localStorage
  inputStitches.value = stitches;
  inputRows.value = rows;
  selectPaper.value = paperSize;
  selectOrientation.value = orientation;
  selectBoldEvery.value = boldEvery;
  checkboxGuides.checked = showGuides;

  // Update UI based on unit
  function updateUnitsUI() {
    if (unit === 'in') {
      btnInches?.classList.add('active');
      btnCm?.classList.remove('active');
      if (stitchUnitLabel) stitchUnitLabel.textContent = 'stitches per inch';
      if (rowUnitLabel) rowUnitLabel.textContent = 'rows per inch';
      if (guidesLabel) guidesLabel.textContent = 'Show reference guides (every 1 inch)';
    } else {
      btnCm?.classList.add('active');
      btnInches?.classList.remove('active');
      if (stitchUnitLabel) stitchUnitLabel.textContent = 'stitches per cm';
      if (rowUnitLabel) rowUnitLabel.textContent = 'rows per cm';
      if (guidesLabel) guidesLabel.textContent = 'Show reference guides (every 5 cm)';
    }
  }

  updateUnitsUI();

  // Build query string
  function buildQueryString(): string {
    const params = new URLSearchParams({
      sts: inputStitches.value || '6',
      rows: inputRows.value || '8',
      unit: unit,
      paper: selectPaper.value,
      orientation: selectOrientation.value,
      boldEvery: selectBoldEvery.value,
      guides: checkboxGuides.checked ? '1' : '0',
    });
    return params.toString();
  }

  // Update preview
  function updatePreview() {
    const query = buildQueryString();
    previewImg.src = `/api/graph-paper.svg?${query}`;
    downloadBtn.href = `/api/graph-paper.svg?${query}`;
    
    // Save to localStorage
    localStorage.setItem('graphpaper.sts', inputStitches.value);
    localStorage.setItem('graphpaper.rows', inputRows.value);
    localStorage.setItem('graphpaper.unit', unit);
    localStorage.setItem('graphpaper.paper', selectPaper.value);
    localStorage.setItem('graphpaper.orientation', selectOrientation.value);
    localStorage.setItem('graphpaper.boldEvery', selectBoldEvery.value);
    localStorage.setItem('graphpaper.guides', checkboxGuides.checked ? '1' : '0');
  }

  // Unit toggle handlers
  btnInches?.addEventListener('click', () => {
    unit = 'in';
    updateUnitsUI();
    updatePreview();
  });

  btnCm?.addEventListener('click', () => {
    unit = 'cm';
    updateUnitsUI();
    updatePreview();
  });

  // Input change handlers - auto-update preview
  inputStitches.addEventListener('input', updatePreview);
  inputRows.addEventListener('input', updatePreview);
  selectPaper.addEventListener('change', updatePreview);
  selectOrientation.addEventListener('change', updatePreview);
  selectBoldEvery.addEventListener('change', updatePreview);
  checkboxGuides.addEventListener('change', updatePreview);

  // Button handlers
  updateBtn?.addEventListener('click', updatePreview);
  
  printBtn?.addEventListener('click', () => {
    window.print();
  });

  // Initial preview update
  updatePreview();
</script>

</BaseLayout>
