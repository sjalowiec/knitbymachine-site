---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

let entries = [];
let errorMessage = '';

async function fetchEntriesFromPath(path: string, entryType: 'wizard' | 'agent') {
  try {
    const response = await fetch(`https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/${path}`);
    
    if (!response.ok) {
      return [];
    }
    
    const files = await response.json();
    
    const entryPromises = files
      .filter((file: any) => file.name.endsWith('.json'))
      .map(async (file: any) => {
        const fileResponse = await fetch(file.download_url);
        const data = await fileResponse.json();
        return {
          title: data.title,
          slug: data.slug,
          hero: data.hero || '',
          excerpt: data.excerpt || '',
          description: data.description || '',
          category: data.category || 'Uncategorized',
          tags: data.tags || [],
          accessLevel: data.accessLevel || 'free',
          price: data.price || '',
          isDraft: data.isDraft,
          pendingPublish: data.pendingPublish,
          publishedDate: data.publishedDate,
          iconUrl: data.iconUrl || '',
          entryType: entryType,
        };
      });
    
    const allEntries = await Promise.all(entryPromises);
    return allEntries.filter((entry: any) => !entry.isDraft && !entry.pendingPublish);
  } catch (error) {
    console.error(`Error fetching ${entryType} entries:`, error);
    return [];
  }
}

function isTool(category: string): boolean {
  const cat = (category || '').toLowerCase().trim();
  return cat.includes('tool') || cat.includes('tools');
}

try {
  const [wizardEntries, agentEntries] = await Promise.all([
    fetchEntriesFromPath('astro-site/src/content/wizards', 'wizard'),
    fetchEntriesFromPath('astro-site/src/content/ai-agents', 'agent')
  ]);
  
  const allEntries = [...wizardEntries, ...agentEntries];
  entries = allEntries.filter(entry => isTool(entry.category));
  
  entries.sort((a, b) => a.title.localeCompare(b.title));
} catch (error) {
  console.error('Error fetching entries:', error);
  errorMessage = error.message;
}

const title = "Charting Tools";
const description = "Machine-knitting tools that do the math for you. Let the wizards handle the numbers so you can stay at the machine.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Charting Tools" 
      subtitle="Choose a tool, enter your gauge, get the numbers — ready to use at your machine."
      iconPath="/images/tools_icon.png"
      iconAlt="Charting Tools icon"
    />

    <div class="intro-section">
      <p class="intro-text">
        Knit by Machine charting tools turn tricky calculations into clear, usable results. Enter your yarn and gauge once, and each tool gives you stitch counts, row spacing, and shaping numbers you can apply immediately as you knit.
      </p>
    </div>

    <div class="guides-grid" data-testid="tools-grid">
      {errorMessage && (
        <div class="error">
          <p><strong>Error loading Tools</strong></p>
          <p>Unable to fetch entries. Please try again later.</p>
          <p style="font-size: 0.9rem; margin-top: 1rem;">{errorMessage}</p>
        </div>
      )}
      
      {entries.length === 0 && !errorMessage && (
        <div class="no-results">
          <p>Tools are coming soon! Check back for machine-knitting calculators and helpers.</p>
        </div>
      )}
      
      {entries.map((entry, index) => {
        const basePath = entry.entryType === 'agent' ? '/agents' : '/wizards';
        const displayText = entry.excerpt || entry.hero || '';
        const isFree = entry.accessLevel === 'free';
        
        return (
          <a 
            href={`${basePath}/${entry.slug}`} 
            class="guide-card kbm-card" 
            data-testid={`card-tool-${entry.slug}`}
            style={`animation-delay: ${index * 0.1}s`}
          >
            {isFree && <span class="kbm-card-ribbon">Free</span>}
            <h2 class="guide-card-title kbm-card__title">{entry.title}</h2>
            {displayText && (
              <p class="guide-card-description kbm-card__desc">{displayText}</p>
            )}
            <div class="kbm-card__meta">Open calculator →</div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .guide-card {
    position: relative;
    background-color: #ffffff;
    color: #52682D;
    border: 2px solid #c7d8a4;
    padding: 2rem;
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 260px;
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .guide-card:hover {
    background-color: #f6f8f2;
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(82, 104, 45, 0.15);
    border-color: #52682D;
  }

  .guide-card-title {
    font-size: clamp(1.4rem, 3vw, 1.6rem);
    font-weight: 700;
    color: #52682D;
    margin: 0;
    line-height: 1.3;
  }

  .guide-card-description {
    font-size: 1.1rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
    flex: 1 0 auto;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error {
    text-align: center;
    padding: 3rem;
    color: #d64545;
    background-color: #ffe5e5;
    border-radius: 12px;
    grid-column: 1 / -1;
  }

  .no-results {
    text-align: center;
    padding: 3rem;
    color: #5a6b47;
    background-color: #f9fdf5;
    border-radius: 12px;
    grid-column: 1 / -1;
  }

  .no-results p {
    font-size: 1.1rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .guides-grid {
      grid-template-columns: 1fr;
    }

    .guide-card {
      min-height: 220px;
    }

    .intro-section {
      margin-bottom: 2rem;
    }
  }
</style>
