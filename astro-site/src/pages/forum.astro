---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Community Forum - Coming Soon | Knit by Machine</title>
  <meta name="description" content="The Knit by Machine community forum is coming soon! Connect with fellow machine knitters, share projects, and get help from the community." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Shadows+Into+Light+Two&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <link rel="stylesheet" href="/styles/temphome.css" />
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Poppins', Arial, sans-serif;
      background-color: #f7f8f7;
    }
    
    .page-content {
      margin-top: 140px;
      min-height: 60vh;
      padding: 60px 20px;
      text-align: center;
    }
    
    .coming-soon-container {
      max-width: 650px;
      margin: 0 auto;
      background: white;
      padding: 60px 40px;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      border: 2px solid #c7d8a4;
    }
    
    .coming-soon-icon {
      font-size: 72px;
      color: #52682d;
      margin-bottom: 24px;
    }
    
    .coming-soon-container h1 {
      font-size: 2.5rem;
      color: #52682d;
      margin-bottom: 16px;
      font-weight: 700;
    }
    
    .coming-soon-container p {
      font-size: 1.1rem;
      color: #5a5a5a;
      line-height: 1.6;
      margin-bottom: 24px;
    }
    
    .feature-list {
      text-align: left;
      max-width: 400px;
      margin: 0 auto 32px auto;
      padding: 24px;
      background: #f7f8f7;
      border-radius: 8px;
    }
    
    .feature-list h3 {
      color: #52682d;
      font-size: 1.1rem;
      margin-bottom: 16px;
      text-align: center;
    }
    
    .feature-list ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    .feature-list li {
      padding: 8px 0;
      color: #5a5a5a;
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .feature-list li i {
      color: #738c52;
      font-size: 1rem;
      width: 20px;
    }
    
    .back-link {
      display: inline-block;
      padding: 12px 32px;
      background: #52682d;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 600;
      transition: background 0.3s ease;
      margin-right: 12px;
    }
    
    .back-link:hover {
      background: #738c52;
    }
    
    .secondary-link {
      display: inline-block;
      padding: 12px 32px;
      background: white;
      color: #52682d;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 600;
      border: 2px solid #52682d;
      transition: all 0.3s ease;
    }
    
    .secondary-link:hover {
      background: #52682d;
      color: white;
    }
    
    .button-row {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    
    @media (max-width: 1024px) {
      .coming-soon-container {
        padding: 40px 24px;
      }
      
      .coming-soon-container h1 {
        font-size: 2rem;
      }
      
      .coming-soon-icon {
        font-size: 56px;
      }
      
      .feature-list {
        padding: 20px;
      }
    }
  </style>
</head>
<body>
  <Header />
  
  <main class="page-content">
    <div class="coming-soon-container">
      <div class="coming-soon-icon">
        <i class="fas fa-comments"></i>
      </div>
      <h1>Community Forum</h1>
      <p style="font-size: 1.3rem; color: #738c52; font-weight: 600; margin-bottom: 16px;">Coming Soon!</p>
      <p>We're building a space for machine knitters to connect, share, and learn from each other.</p>
      
      <div class="feature-list">
        <h3>What to expect:</h3>
        <ul>
          <li><i class="fas fa-question-circle"></i> Ask questions and get answers</li>
          <li><i class="fas fa-images"></i> Share your projects and patterns</li>
          <li><i class="fas fa-users"></i> Connect with fellow machine knitters</li>
          <li><i class="fas fa-lightbulb"></i> Exchange tips and techniques</li>
          <li><i class="fas fa-wrench"></i> Troubleshoot together</li>
        </ul>
      </div>
      
      <p style="font-size: 0.95rem; color: #888;">In the meantime, check out our Answers section for quick help!</p>
      
      <div class="button-row">
        <a href="/ana-catalog" class="back-link" data-testid="link-ana-catalog">Browse Answers</a>
        <a href="/" class="secondary-link" data-testid="link-home">Back to Home</a>
      </div>
    </div>
  </main>
  
  <Footer />
</body>
</html>
