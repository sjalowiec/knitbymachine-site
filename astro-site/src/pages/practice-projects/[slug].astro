---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toVimeoPlayerUrl, getVimeoThumbnailUrl } from '../../lib/vimeo';

export const prerender = false;

const { slug } = Astro.params;

let contentPage = null;
let errorMessage = '';
let isNotFound = false;

const adminApiUrl = import.meta.env.CONTENT_API_BASE_URL || 'https://knit-content-manager-sue23.replit.app';
// Cache-buster for dev preview - ensures fresh data on every refresh
const cacheBuster = `_cb=${Date.now()}`;

try {
  const response = await fetch(`${adminApiUrl}/api/public/content-pages/${slug}?${cacheBuster}`);
  
  const contentType = response.headers.get('content-type') || '';
  
  if (response.ok && contentType.includes('application/json')) {
    contentPage = await response.json();
  } else if (response.status === 404) {
    isNotFound = true;
  } else if (!response.ok) {
    console.error('Error fetching practice project:', response.status, response.statusText);
    errorMessage = `Failed to load this practice project. Please try again later. (Error ${response.status})`;
  } else {
    console.error('Invalid response content type:', contentType);
    errorMessage = 'Unable to reach the content server. Please try again later.';
  }
} catch (error: any) {
  console.error('Error fetching practice project:', error);
  errorMessage = 'Unable to load this practice project. Please check your connection and try again.';
}

if (isNotFound) {
  return Astro.redirect('/404');
}

const title = contentPage?.title || 'Practice Project';
const summary = contentPage?.summary || '';
const htmlContent = contentPage?.htmlContent || '';
const accessLevel = contentPage?.accessLevel || '';
const priceLabel = contentPage?.priceLabel || '';
const imageUrl = contentPage?.imageUrl || '';
const imageAlt = contentPage?.imageAlt || '';
const videoUrl = contentPage?.videoUrl || '';

// Derive video data if videoUrl exists (only valid Vimeo URLs)
let playerUrl: string | null = null;
let thumbnailUrl: string | null = null;

if (videoUrl) {
  playerUrl = toVimeoPlayerUrl(videoUrl);
  if (playerUrl) {
    thumbnailUrl = await getVimeoThumbnailUrl(videoUrl);
  }
}
---

<BaseLayout title={`${title} | Practice Projects`} description={summary || ''}>
  <main class="practice-project-page">
    <div class="breadcrumb no-print">
      <a href="/practice-projects" class="link-back" data-testid="link-back-catalog">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to Practice Projects
      </a>
    </div>

    {errorMessage ? (
      <div class="error-panel" data-testid="error-panel">
        <div class="error-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <h2>Something went wrong</h2>
        <p>{errorMessage}</p>
        <a href="/practice-projects" class="error-back-link">
          Return to Practice Projects
        </a>
      </div>
    ) : (
      <div class="project-sticky-actions no-print" data-testid="sticky-actions">
        <button
          type="button"
          class="print-btn print-btn--compact"
          onclick="window.print()"
          data-testid="button-print-sticky"
          aria-label="Print instructions"
          title="Print this project"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print
        </button>
      </div>

      <article class="project-content">
        <header class="pp-hero">
          <div class="pp-hero__text">
            <div class="title-row">
              <h1 class="project-title" data-testid="text-title">{title}</h1>
              <button type="button" class="print-btn no-print" onclick="window.print()" data-testid="button-print" title="Print this project">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 6 2 18 2 18 9"/>
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                  <rect x="6" y="14" width="12" height="8"/>
                </svg>
                Print
              </button>
            </div>
            {summary && (
              <p class="project-summary" data-testid="text-summary" set:html={summary} />
            )}
          </div>
          
          {playerUrl && (
            <div class="pp-hero__media no-print">
              <button
                type="button"
                class="pp-video-thumb"
                data-player-url={playerUrl}
                data-testid="button-open-video"
                aria-label="Watch the walkthrough video"
              >
                <div class="pp-video-thumb__ratio">
                  {thumbnailUrl ? (
                    <img
                      src={thumbnailUrl}
                      alt=""
                      class="pp-video-thumb__img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="pp-video-thumb__placeholder"></div>
                  )}
                  <div class="pp-video-thumb__play">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="white" stroke="none">
                      <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                  </div>
                </div>
              </button>
            </div>
          )}
        </header>

        <div
          class="kbm-modal-overlay no-print"
          id="video-modal"
          aria-hidden="true"
          role="dialog"
          aria-modal="true"
          aria-label="Video walkthrough"
        >
          <div class="kbm-modal">
            <button
              type="button"
              class="kbm-modal-close"
              data-testid="button-close-video"
              aria-label="Close video"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
            <div class="kbm-video-frame">
              <!-- iframe injected by JS when modal opens -->
            </div>
          </div>
        </div>

        {htmlContent ? (
          <div class="project-body" data-testid="content-body" set:html={htmlContent} />
        ) : (
          <div class="project-body-empty">
            <p>Content is being prepared. Check back soon!</p>
          </div>
        )}
      </article>

      <footer class="project-footer no-print">
        <a href="/practice-projects" class="back-link" data-testid="link-back-footer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          Explore more Practice Projects
        </a>
      </footer>
    )}
  </main>
</BaseLayout>

<style>
  .practice-project-page {
    min-height: 100vh;
    background: var(--page-bg, #f7f8f7);
    padding: 2rem 1.5rem 3rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .link-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--kbm-green-2, #738C52);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .link-back:hover {
    color: var(--kbm-green, #52682D);
  }

  .project-content {
    background: white;
    border-radius: 16px;
    border: 1px solid var(--ring, #e5e8e0);
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(82, 104, 45, 0.08);
  }

  /* Two-column hero layout */
  .pp-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--ring, #e5e8e0);
  }

  @media (min-width: 640px) {
    .pp-hero {
      grid-template-columns: 1fr auto;
    }
  }

  .pp-hero__text {
    min-width: 0;
  }

  .pp-hero__media {
    width: 100%;
    max-width: 360px;
  }

  @media (min-width: 640px) {
    .pp-hero__media {
      width: 280px;
    }
  }

  @media (min-width: 768px) {
    .pp-hero__media {
      width: 320px;
    }
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .project-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--kbm-green, #52682D);
    margin: 0;
    line-height: 1.2;
  }

  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--kbm-green, #52682D);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .print-btn:hover {
    background: var(--kbm-green-hover, #445626);
  }

  .print-btn:active {
    transform: scale(0.97);
  }

  .project-summary {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #555;
    margin: 0 0 1rem 0;
  }

  /* Video thumbnail tile */
  .pp-video-thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pp-video-thumb:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 16px rgba(82, 104, 45, 0.15);
  }

  .pp-video-thumb:focus-visible {
    outline: 3px solid var(--kbm-green, #52682D);
    outline-offset: 2px;
  }

  .pp-video-thumb__ratio {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--kbm-border, #e5e8e0);
    background: var(--kbm-soft-bg, #f0f4e8);
  }

  .pp-video-thumb__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pp-video-thumb__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #3a3a3a 0%, #2a2a2a 100%);
  }

  .pp-video-thumb__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: rgba(82, 104, 45, 0.9);
    border-radius: 50%;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pp-video-thumb:hover .pp-video-thumb__play {
    background: rgba(82, 104, 45, 1);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .pp-video-thumb__play svg {
    margin-left: 4px; /* optical centering for play icon */
  }

  /* Modal overlay - MUST sit above fixed site header */
  .kbm-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .kbm-modal-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  /* Modal dialog - centered, sized correctly */
  .kbm-modal {
    position: relative;
    width: min(960px, 92vw);
    max-height: 90vh;
    overflow: hidden;
    background: #fff;
    border-radius: 12px;
    transform: scale(0.95);
    transition: transform 0.2s ease;
  }

  .kbm-modal-overlay[aria-hidden="false"] .kbm-modal {
    transform: scale(1);
  }

  /* Close button - visible and clickable */
  .kbm-modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: rgba(0, 0, 0, 0.6);
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .kbm-modal-close:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  .kbm-modal-close:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  /* 16:9 video frame */
  .kbm-video-frame {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    background: #000;
    overflow: hidden;
  }

  /* Use :global for dynamically injected iframe */
  .kbm-video-frame :global(iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Scroll lock when modal open */
  :global(body.modal-open) {
    overflow: hidden;
  }

  .project-body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #444;
  }

  .project-body :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--kbm-green, #52682D);
    margin: 2rem 0 1rem 0;
  }

  .project-body :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--kbm-green, #52682D);
    margin: 1.5rem 0 0.75rem 0;
  }

  .project-body :global(p) {
    margin: 0 0 1rem 0;
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    margin: 0 0 1rem 0;
    padding-left: 1.5rem;
  }

  .project-body :global(li) {
    margin-bottom: 0.25rem;
  }

  .project-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 1.5rem 0;
  }

  .project-body :global(a) {
    color: var(--kbm-green, #52682D);
    text-decoration: underline;
  }

  .project-body :global(a:hover) {
    color: var(--kbm-green-hover, #445626);
  }

  .project-body :global(blockquote) {
    border-left: 4px solid var(--kbm-green, #52682D);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #666;
  }

  .project-body-empty {
    text-align: center;
    padding: 3rem;
    color: #888;
    font-style: italic;
  }

  .project-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--kbm-green, #52682D);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.75rem 1.25rem;
    background: #f0f4e8;
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    background: #e4ebd6;
    transform: translateX(-4px);
  }

  .error-panel {
    background: white;
    border-radius: 16px;
    border: 1px solid var(--ring, #e5e8e0);
    padding: 3rem 2rem;
    text-align: center;
    box-shadow: 0 2px 12px rgba(82, 104, 45, 0.08);
  }

  .error-icon {
    color: #d97706;
    margin-bottom: 1rem;
  }

  .error-panel h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--kbm-green, #52682D);
    margin: 0 0 0.75rem 0;
  }

  .error-panel p {
    font-size: 1.05rem;
    color: #666;
    margin: 0 0 1.5rem 0;
    line-height: 1.6;
  }

  .error-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: white;
    background: var(--kbm-green, #52682D);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .error-back-link:hover {
    background: var(--kbm-green-hover, #445626);
    transform: translateY(-2px);
  }

  /* Sticky Print (appears after scroll) */
  .project-sticky-actions {
    position: sticky;
    top: calc(var(--header-height, 0px) + 12px);
    z-index: 30;

    display: flex;
    justify-content: flex-end;

    padding: 8px 0;

    /* Transparent background - button only floats */
    background: transparent;
    pointer-events: none;

    /* hidden by default; becomes visible after scroll */
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .project-sticky-actions .print-btn {
    pointer-events: auto;
  }

  .project-sticky-actions.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Compact print button so sticky doesn't feel heavy */
  .print-btn.print-btn--compact {
    padding: 8px 12px;
    font-size: 0.95rem;
    border-radius: 10px;
  }

  @media (max-width: 640px) {
    .practice-project-page {
      padding: 1.5rem 1rem 2rem;
    }

    .project-content {
      padding: 1.5rem;
    }

    .pp-hero__media {
      max-width: 100%;
    }

    .error-panel {
      padding: 2rem 1.5rem;
    }

    .project-sticky-actions {
      top: calc(var(--header-height, 0px) + 8px);
      padding: 6px 0;
    }

    .print-btn.print-btn--compact {
      padding: 8px 10px;
    }
  }

  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    // Sticky print button
    const bar = document.querySelector('.project-sticky-actions');
    if (bar) {
      const SHOW_AFTER_PX = 220;
      const onScroll = () => {
        bar.classList.toggle('is-visible', window.scrollY > SHOW_AFTER_PX);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Video modal
    const thumbBtn = document.querySelector('.pp-video-thumb');
    const modal = document.getElementById('video-modal');
    const closeBtn = modal?.querySelector('.kbm-modal-close');
    const videoFrame = modal?.querySelector('.kbm-video-frame');

    if (!thumbBtn || !modal || !closeBtn || !videoFrame) return;

    let previousActiveElement = null;

    // Validate Vimeo player URL format (client-side security check)
    function isValidVimeoPlayerUrl(url) {
      if (!url || typeof url !== 'string') return false;
      return /^https:\/\/player\.vimeo\.com\/video\/\d+$/.test(url.trim());
    }

    function openModal() {
      const playerUrl = thumbBtn.dataset.playerUrl;
      
      // Strict validation: only allow vetted Vimeo embed URLs
      if (!playerUrl || !isValidVimeoPlayerUrl(playerUrl)) {
        console.warn('Invalid or missing video URL');
        return;
      }
      
      // Create iframe safely using DOM API
      const iframe = document.createElement('iframe');
      iframe.src = playerUrl;
      iframe.title = 'Practice project walkthrough video';
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      
      // Clear and append safely
      videoFrame.textContent = '';
      videoFrame.appendChild(iframe);

      previousActiveElement = document.activeElement;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-open');
      
      // Focus close button
      setTimeout(() => closeBtn.focus(), 50);

      // Add event listeners
      document.addEventListener('keydown', handleKeydown);
      modal.addEventListener('click', handleBackdropClick);
    }

    function closeModal() {
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('modal-open');
      
      // Remove iframe to stop video
      videoFrame.textContent = '';

      // Restore focus
      if (previousActiveElement) {
        previousActiveElement.focus();
        previousActiveElement = null;
      }

      // Remove event listeners
      document.removeEventListener('keydown', handleKeydown);
      modal.removeEventListener('click', handleBackdropClick);
    }

    function handleKeydown(e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
        return;
      }

      // Basic focus trap
      if (e.key === 'Tab') {
        const focusableEls = modal.querySelectorAll(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        const firstEl = focusableEls[0];
        const lastEl = focusableEls[focusableEls.length - 1];

        if (e.shiftKey && document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        } else if (!e.shiftKey && document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    }

    function handleBackdropClick(e) {
      // Only close when clicking the overlay itself, not modal content
      if (e.target === modal) {
        closeModal();
      }
    }

    function handleModalContentClick(e) {
      // Prevent clicks inside modal from bubbling to backdrop
      e.stopPropagation();
    }

    // Attach event listeners
    thumbBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    
    // Stop propagation on modal content clicks
    const modalContent = modal.querySelector('.kbm-modal');
    if (modalContent) {
      modalContent.addEventListener('click', handleModalContentClick);
    }
  })();
</script>
