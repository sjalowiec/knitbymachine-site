---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

const title = "1:1 with Sue";
const description = "Personal one-on-one sessions with Sue to get help with your machine knitting questions and projects.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="1:1 with Sue" 
      iconPath="/images/one-on-one_icon.png"
      iconAlt="1:1 with Sue icon"
    />

    <div class="coming-soon-section">
      <div class="coming-soon-badge">Coming Soon</div>
      <h2 class="coming-soon-headline">Personal guidance for your machine knitting journey</h2>
      <p class="coming-soon-text">
        Sometimes you just need to talk it through with someone who gets it. 1:1 sessions with Sue give you dedicated time to ask questions, troubleshoot problems, and get personalized advice for your projects.
      </p>
      <p class="coming-soon-text">
        Whether you're stuck on a tricky technique, planning a new project, or just want a second opinion — this is your chance to get one-on-one help.
      </p>
      <p class="coming-soon-note">
        Check back soon for booking information and availability.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .coming-soon-section {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    background-color: #f9fdf5;
    border-radius: 16px;
    padding: 3rem 2.5rem;
  }

  .coming-soon-badge {
    display: inline-block;
    background-color: #52682D;
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    margin-bottom: 1.5rem;
  }

  .coming-soon-headline {
    font-size: clamp(1.5rem, 3vw, 1.8rem);
    font-weight: 700;
    color: #52682D;
    line-height: 1.3;
    margin: 0 0 1.5rem 0;
  }

  .coming-soon-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }

  .coming-soon-note {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    color: #738c52;
    font-style: italic;
    margin: 2rem 0 0 0;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .coming-soon-section {
      padding: 2rem 1.5rem;
    }
  }
</style>
