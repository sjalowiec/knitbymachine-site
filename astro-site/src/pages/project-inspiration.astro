---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Ready ● Set ● Knit: Project Inspiration';
const pageDescription = 'Not sure what to make next on your knitting machine? Ready ● Set ● Knit: Project Inspiration asks a few simple questions and gives you project ideas that fit your machine, yarn, and experience.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="pi-page">
    <!-- HERO SECTION -->
    <section class="pi-hero">
      <!-- Decorative Speech Bubble -->
      <div class="flex justify-center pb-4">
        <img
          src="/images/speech_bubble.svg"
          alt="Decorative speech bubble"
          class="h-10 w-auto opacity-95 drop-shadow-md"
          loading="lazy"
        />
      </div>
      <div class="pi-hero__grid">
        <div class="pi-hero__content">
          <span class="pi-eyebrow" data-testid="text-eyebrow">Free interactive tool</span>
          <h1 data-testid="text-page-title">Ready ● Set ● Knit: Project Inspiration</h1>
          <p class="pi-subhead" data-testid="text-subhead">
            Not sure what to make next? Answer a few simple questions and get project ideas that fit your machine, yarn, and experience.
          </p>
          <ul class="pi-benefits" data-testid="list-benefits">
            <li>Choose a project that makes sense for where you are right now.</li>
            <li>Avoid overwhelm with clear, realistic options—no endless scrolling.</li>
            <li>Use your machine, your yarn, and your time instead of starting from scratch.</li>
          </ul>
        </div>

        <div class="pi-hero__form">
          <div class="pi-form-card" data-testid="container-form-card">
            <p class="pi-form-intro">
              Enter your email to open Project Inspiration. I'll also send the link to your inbox so you can come back to it anytime.
            </p>
            <!-- ActiveCampaign Form -->
            <form method="POST" action="https://knitbymachine.activehosted.com/proc.php" id="_form_1_" class="pi-form _form _form_1" novalidate data-testid="form-project-inspiration">
              <input type="hidden" name="u" value="1" />
              <input type="hidden" name="f" value="1" />
              <input type="hidden" name="s" />
              <input type="hidden" name="c" value="0" />
              <input type="hidden" name="m" value="0" />
              <input type="hidden" name="act" value="sub" />
              <input type="hidden" name="v" value="2" />
              <input type="hidden" name="or" value="dc606db2-daa8-4067-8615-c5a1021874f8" />
              <div class="_form-content">
                <div class="pi-form-group">
                  <label for="fullname" class="pi-label">First name</label>
                  <input 
                    type="text" 
                    id="fullname" 
                    name="fullname" 
                    class="pi-input" 
                    placeholder="Type your name"
                    data-testid="input-first-name"
                  />
                </div>
                <div class="pi-form-group">
                  <label for="email" class="pi-label">Email address</label>
                  <input 
                    type="text" 
                    id="email" 
                    name="email" 
                    class="pi-input" 
                    placeholder="Type your email"
                    required
                    data-testid="input-email"
                  />
                </div>
                <button type="submit" id="_form_1_submit" class="btn primary pi-submit _submit" data-testid="button-submit">
                  Get Project Inspiration
                </button>
                <p class="pi-reassurance">Instant access. No spam. Unsubscribe anytime.</p>
              </div>
              <div class="_form-thank-you" style="display:none;"></div>
              <div class="_form-branding" style="display:none;"></div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- IS THIS FOR YOU? SECTION -->
    <section class="pi-section" data-testid="section-is-this-for-you">
      <h2>Is Project Inspiration for you?</h2>
      <p class="pi-section-intro">Yes—if any of this sounds familiar:</p>
      <ul class="pi-checklist">
        <li>Your machine is ready, but you're not sure what to make next.</li>
        <li>You keep collecting patterns without actually starting one.</li>
        <li>You'd like a realistic project that fits your time, yarn, and current skills.</li>
      </ul>
    </section>

    <!-- HOW IT WORKS SECTION -->
    <section class="pi-section" data-testid="section-how-it-works">
      <h2>How Ready ● Set ● Knit: Project Inspiration works</h2>
      <ol class="pi-steps">
        <li>Tell me a bit about your machine, your yarn, and your experience.</li>
        <li>I'll suggest project ideas that match where you are right now.</li>
        <li>Pick one, get started, and come back anytime when you're ready for the next step.</li>
      </ol>
    </section>

    <!-- TRUST / ABOUT SECTION -->
    <section class="pi-section pi-section--trust" data-testid="section-trust">
      <h3>Why Ready ● Set ● Knit?</h3>
      <p>
        I've helped thousands of knitters get unstuck with their machines. Knit by Machine is designed to give you clear, manageable next steps—without the overwhelm. Project Inspiration is one simple way to get you moving again.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* ========== PAGE WRAPPER ========== */
  .pi-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  /* ========== HERO SECTION ========== */
  .pi-hero {
    padding: 2rem 0 3rem;
  }

  .pi-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .pi-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* ========== HERO CONTENT ========== */
  .pi-hero__content {
    text-align: center;
  }

  @media (min-width: 768px) {
    .pi-hero__content {
      text-align: left;
    }
  }

  .pi-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #738c52;
    margin-bottom: 0.75rem;
    padding: 0.35rem 1rem;
    background: rgba(115, 140, 82, 0.12);
    border-radius: 999px;
  }

  .pi-hero__content h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0 0 1rem;
    color: #2c3a57;
    line-height: 1.25;
  }

  .pi-subhead {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #4d5a48;
    margin: 0 0 1.5rem;
    max-width: 500px;
  }

  @media (max-width: 767px) {
    .pi-subhead {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .pi-benefits {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0;
    color: #4d5a48;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .pi-benefits li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 767px) {
    .pi-benefits {
      text-align: left;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* ========== FORM CARD ========== */
  .pi-hero__form {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .pi-hero__form {
      justify-content: flex-end;
    }
  }

  .pi-form-card {
    background-color: #f6f8f2;
    border: 2px solid #c7d8a4;
    border-radius: 1.25rem;
    padding: 1.75rem;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .pi-form-intro {
    font-size: 0.95rem;
    color: #4d5a48;
    line-height: 1.55;
    margin: 0 0 1.25rem;
  }

  .pi-form-group {
    margin-bottom: 1rem;
  }

  .pi-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    color: #2c3a57;
    margin-bottom: 0.35rem;
  }

  .pi-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    font-size: 1rem;
    border: 1.5px solid #c7d8a4;
    border-radius: 0.5rem;
    background-color: #ffffff;
    color: #2c3a57;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .pi-input:focus {
    outline: none;
    border-color: #52682d;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
  }

  .pi-submit {
    width: 100%;
    margin-top: 0.5rem;
  }

  .pi-reassurance {
    font-size: 0.8rem;
    color: #6b7565;
    text-align: center;
    margin: 0.75rem 0 0;
    font-style: italic;
  }

  /* ========== SHARED BUTTON STYLES ========== */
  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-size: 1rem;
    text-decoration: none;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn.primary {
    background-color: #52682d;
    color: #ffffff;
  }

  .btn.primary:hover {
    background-color: #445626;
  }

  /* ========== SECTIONS ========== */
  .pi-section {
    padding: 2.5rem 0;
    border-top: 1px solid #e0e5d8;
  }

  .pi-section h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    color: #2c3a57;
    margin: 0 0 0.75rem;
    text-align: center;
  }

  .pi-section-intro {
    font-size: 1rem;
    color: #4d5a48;
    text-align: center;
    margin: 0 0 1.25rem;
  }

  .pi-checklist {
    list-style: disc;
    padding-left: 1.5rem;
    max-width: 600px;
    margin: 0 auto;
    color: #4d5a48;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .pi-checklist li {
    margin-bottom: 0.5rem;
  }

  .pi-steps {
    list-style: decimal;
    padding-left: 1.5rem;
    max-width: 600px;
    margin: 1rem auto 0;
    color: #4d5a48;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .pi-steps li {
    margin-bottom: 0.75rem;
  }

  /* ========== TRUST SECTION ========== */
  .pi-section--trust {
    background-color: #f6f8f2;
    border-radius: 1rem;
    padding: 2rem;
    border: none;
    margin-top: 1rem;
  }

  .pi-section--trust h3 {
    font-size: 1.1rem;
    color: #52682d;
    margin: 0 0 0.75rem;
    text-align: center;
    font-weight: 600;
  }

  .pi-section--trust p {
    font-size: 0.95rem;
    color: #4d5a48;
    line-height: 1.65;
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }

  /* ========== MOBILE ADJUSTMENTS ========== */
  @media (max-width: 480px) {
    .pi-page {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .pi-form-card {
      padding: 1.5rem 1.25rem;
    }

    .pi-section {
      padding: 2rem 0;
    }

    .pi-section--trust {
      padding: 1.5rem;
    }
  }
</style>

<!-- ActiveCampaign Form Script -->
<script is:inline>
  window.cfields = [];
  window._show_thank_you = function(id, message, trackcmp_url, email) {
    var form = document.getElementById('_form_' + id + '_'), thank_you = form.querySelector('._form-thank-you');
    form.querySelector('._form-content').style.display = 'none';
    thank_you.innerHTML = message || '<h3 style="margin-bottom:0.5rem;color:#2c3a57;">Thanks for signing up!</h3><p style="color:#4d5a48;">Check your inbox for your Project Inspiration link.</p>';
    thank_you.style.display = 'block';
    thank_you.style.padding = '1rem 0';
    thank_you.style.textAlign = 'center';
    var branding = form.querySelector('._form-branding');
    if (branding) branding.style.display = 'none';
    if (typeof window._form_callback !== 'undefined') window._form_callback(id);
    thank_you.setAttribute('tabindex', '-1');
    thank_you.focus();
  };
  window._show_error = function(id, message, html) {
    var form = document.getElementById('_form_' + id + '_'),
        err = document.createElement('div'),
        button = form.querySelector('button[type="submit"]'),
        old_error = form.querySelector('._form_error');
    if (old_error) old_error.parentNode.removeChild(old_error);
    err.innerHTML = message;
    err.className = '_error-inner _form_error';
    err.style.cssText = 'background:#fef2f2;border:1px solid #fecaca;border-radius:0.5rem;padding:0.75rem;color:#dc2626;font-size:0.9rem;margin-bottom:1rem;';
    button.parentNode.insertBefore(err, button);
    var submitButton = form.querySelector('[id^="_form"][id$="_submit"]');
    submitButton.disabled = false;
    submitButton.classList.remove('processing');
  };
  window._load_script = function(url, callback, isSubmit) {
    var head = document.querySelector('head'), script = document.createElement('script'), r = false;
    var submitButton = document.querySelector('#_form_1_submit');
    script.charset = 'utf-8';
    script.src = url;
    if (callback) {
      script.onload = script.onreadystatechange = function() {
        if (!r && (!this.readyState || this.readyState == 'complete')) {
          r = true;
          callback();
        }
      };
    }
    script.onerror = function() {
      if (isSubmit) {
        _show_error("1", "Sorry, your submission failed. Please try again.");
        submitButton.disabled = false;
        submitButton.classList.remove('processing');
      }
    }
    head.appendChild(script);
  };
  (function() {
    if (window.location.search.search("excludeform") !== -1) return false;
    var form_to_submit = document.getElementById('_form_1_');
    if (!form_to_submit) return;
    var allInputs = form_to_submit.querySelectorAll('input, select, textarea'), tooltips = [], submitted = false;

    var remove_tooltips = function() {
      var errors = form_to_submit.querySelectorAll('._error');
      errors.forEach(function(e) { e.parentNode.removeChild(e); });
    };
    var create_tooltip = function(elem, text) {
      var tooltip = document.createElement('div');
      tooltip.className = '_error';
      tooltip.innerHTML = text;
      tooltip.style.cssText = 'color:#dc2626;font-size:0.8rem;margin-top:0.25rem;';
      elem.parentNode.appendChild(tooltip);
    };
    var validate_field = function(elem, remove) {
      var value = elem.value, no_error = true;
      if (remove) {
        var old_tooltip = elem.parentNode.querySelector('._error');
        if (old_tooltip) old_tooltip.parentNode.removeChild(old_tooltip);
      }
      elem.style.borderColor = '';
      if (elem.getAttribute('required') !== null) {
        if (value === undefined || value === null || value === '') {
          elem.style.borderColor = '#dc2626';
          no_error = false;
          create_tooltip(elem, "This field is required.");
        }
      }
      if (no_error && elem.name == 'email') {
        if (!value.match(/^[\+_a-z0-9-'&=]+(\.[\+_a-z0-9-']+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,})$/i)) {
          elem.style.borderColor = '#dc2626';
          no_error = false;
          create_tooltip(elem, "Enter a valid email address.");
        }
      }
      return no_error;
    };
    var validate_form = function(e) {
      var no_error = true;
      if (!submitted) {
        submitted = true;
        for (var i = 0, len = allInputs.length; i < len; i++) {
          var input = allInputs[i];
          if (input.getAttribute('required') !== null || input.name === 'email') {
            if (input.type == 'text') {
              input.addEventListener('blur', function() {
                this.value = this.value.trim();
                validate_field(this, true);
              });
              input.addEventListener('input', function() {
                validate_field(this, true);
              });
            }
          }
        }
      }
      remove_tooltips();
      for (var i = 0, len = allInputs.length; i < len; i++) {
        var elem = allInputs[i];
        if (elem.getAttribute('required') !== null || elem.name === 'email') {
          if (!validate_field(elem)) {
            no_error = false;
          }
        }
      }
      if (!no_error && e) {
        e.preventDefault();
      }
      return no_error;
    };
    var form_submit = function(e) {
      e.preventDefault();
      if (validate_form()) {
        var serialized = '';
        for (var i = 0; i < allInputs.length; i++) {
          var input = allInputs[i];
          if (input.type === 'hidden' || input.type === 'text' || input.type === 'email') {
            serialized += (serialized ? '&' : '') + encodeURIComponent(input.name) + '=' + encodeURIComponent(input.value);
          }
        }
        var submitButton = form_to_submit.querySelector('#_form_1_submit');
        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';
        var url = form_to_submit.getAttribute('action') + '?' + serialized;
        _load_script(url, function() {
          // Success handled by _show_thank_you callback
        }, true);
      }
      return false;
    };
    form_to_submit.addEventListener('submit', form_submit);
  })();
</script>
