---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Ready ● Set ● Knit: Project Inspiration';
const pageDescription = 'Not sure what to make next on your knitting machine? Ready ● Set ● Knit: Project Inspiration asks a few simple questions and gives you project ideas that fit your machine, yarn, and experience.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- HERO SECTION -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="grid gap-8 md:grid-cols-2 items-start">
      <!-- Left column: icon + heading + intro -->
      <div class="space-y-4 text-center md:text-left">
        <img
          src="/images/troubleshoot.svg"
          alt="Project Inspiration"
          class="mx-auto md:mx-0 opacity-95 drop-shadow-md"
          style="width: 120px; height: auto;"
          loading="lazy"
        />
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 leading-tight" data-testid="text-page-title">
          Ready ● Set ● Knit: Project Inspiration
        </h1>
        <p class="text-base text-slate-600 leading-relaxed max-w-md mx-auto md:mx-0" data-testid="text-subhead">
          Not sure what to make next? Answer a few simple questions and get project ideas that fit your machine, yarn, and experience.
        </p>
      </div>

      <!-- Right column: pill + form card -->
      <div class="flex justify-center md:justify-end">
        <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-testid="container-form-card">
          <!-- Pill badge at top of form -->
          <div class="inline-block rounded-full px-4 py-1 text-xs font-semibold uppercase tracking-wide mb-4" style="background: rgba(115, 140, 82, 0.12); color: #738c52;">
            Free interactive tool
          </div>
          
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Enter your email to open Project Inspiration. I'll also send the link to your inbox so you can come back to it anytime.
          </p>
          
          <!-- 
            NOTE: Thank-you timing and redirect after form submit are configured 
            in ActiveCampaign. Do not modify redirect logic here.
          -->
          <!-- Hidden iframe for form submission -->
          <iframe name="ac_form_target" id="ac_form_target" style="display:none;"></iframe>
          <!-- ActiveCampaign Form -->
          <form method="POST" action="https://knitbymachine.activehosted.com/proc.php" id="_form_1_" class="_form _form_1" target="ac_form_target" data-testid="form-project-inspiration">
            <input type="hidden" name="u" value="1" />
            <input type="hidden" name="f" value="1" />
            <input type="hidden" name="s" />
            <input type="hidden" name="c" value="0" />
            <input type="hidden" name="m" value="0" />
            <input type="hidden" name="act" value="sub" />
            <input type="hidden" name="v" value="2" />
            <input type="hidden" name="or" value="dc606db2-daa8-4067-8615-c5a1021874f8" />
            <div class="_form-content space-y-4">
              <div>
                <label for="fullname" class="block text-sm font-medium text-slate-700 mb-1">First name</label>
                <input 
                  type="text" 
                  id="fullname" 
                  name="fullname" 
                  class="pi-input w-full px-3 py-2 text-base border border-slate-300 rounded-lg bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-600/20 focus:border-green-700 transition-colors"
                  placeholder="Type your name"
                  data-testid="input-first-name"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="pi-input w-full px-3 py-2 text-base border border-slate-300 rounded-lg bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-600/20 focus:border-green-700 transition-colors"
                  placeholder="Type your email"
                  required
                  data-testid="input-email"
                />
              </div>
              <button type="submit" id="_form_1_submit" class="w-full py-3 px-4 rounded-full text-base font-medium text-white transition-colors cursor-pointer" style="background-color: #52682d;" data-testid="button-submit">
                Get Project Inspiration
              </button>
              <p class="text-xs text-slate-500 text-center italic">Instant access. No spam. Unsubscribe anytime.</p>
            </div>
            <div class="_form-thank-you" style="display:none;"></div>
            <div class="_form-branding" style="display:none;"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- AGENT EMBED CONTAINER (will be populated after signup) -->
  <div id="project-inspiration-agent">
    <!-- agent embed will be injected here -->
  </div>

  <!-- COMBINED INFO PANEL -->
  <section id="project-inspiration-benefits" class="max-w-4xl mx-auto px-4 pt-8 pb-16" data-testid="section-info-panel">
    <div class="rounded-3xl border border-slate-200 bg-white/80 p-8 shadow-sm space-y-8">
      
      <!-- What you'll get inside -->
      <div class="space-y-3">
        <h2 class="text-xl font-semibold text-slate-900">What you'll get inside</h2>
        <ul class="list-disc pl-5 text-sm leading-relaxed text-slate-700 space-y-1">
          <li>A project that makes sense for where you are right now.</li>
          <li>Clear, realistic options—no endless scrolling.</li>
          <li>A simple, doable next step you can actually see yourself knitting.</li>
          <li>A way to use your yarn, your machine, and your time instead of starting from scratch.</li>
        </ul>
      </div>

      <!-- Is this for you? -->
      <div class="space-y-3">
        <h2 class="text-xl font-semibold text-slate-900">Is Project Inspiration for you?</h2>
        <p class="text-sm text-slate-700 italic">Yes—if any of this sounds familiar:</p>
        <ul class="list-disc pl-5 text-sm leading-relaxed text-slate-700 space-y-1">
          <li>Your machine is ready, but you're not sure what to make next.</li>
          <li>You keep collecting patterns without actually starting one.</li>
          <li>You'd like a realistic project that fits your time, yarn, and current skills.</li>
        </ul>
      </div>

      <!-- How it works -->
      <div class="space-y-3">
        <h2 class="text-xl font-semibold text-slate-900">How Ready ● Set ● Knit: Project Inspiration works</h2>
        <ol class="list-decimal pl-5 text-sm leading-relaxed text-slate-700 space-y-1">
          <li>Tell me a bit about your machine, your yarn, and your experience.</li>
          <li>I'll suggest project ideas that match where you are right now.</li>
          <li>Pick one, get started, and come back anytime when you're ready for the next step.</li>
        </ol>
      </div>

      <!-- Why Ready Set Knit -->
      <div class="space-y-3">
        <h2 class="text-xl font-semibold text-slate-900">Why Ready ● Set ● Knit?</h2>
        <p class="text-sm leading-relaxed text-slate-700">
          I've helped thousands of knitters get unstuck with their machines. Knit by Machine is designed to give you clear, manageable next steps—without the overwhelm. Project Inspiration is one simple way to get you moving again.
        </p>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* Button hover state */
  button[type="submit"]:hover {
    background-color: #445626 !important;
  }
  
  /* Input focus states */
  .pi-input:focus {
    border-color: #52682d;
  }
</style>

<!-- 
  NOTE: Thank-you timing and redirect after form submit are configured 
  in ActiveCampaign, not in this Astro file. Do not modify redirect logic here.
-->
<!-- ActiveCampaign Form Script -->
<script is:inline>
  (function() {
    var form = document.getElementById('_form_1_');
    if (!form) return;

    var emailInput = form.querySelector('input[name="email"]');
    var submitButton = form.querySelector('#_form_1_submit');
    var formContent = form.querySelector('._form-content');
    var thankYou = form.querySelector('._form-thank-you');

    function validateEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function showThankYou() {
      formContent.style.display = 'none';
      thankYou.innerHTML = '<h3 style="margin-bottom:0.5rem;color:#2c3a57;">Thanks for signing up!</h3><p style="color:#4d5a48;">Redirecting to Project Inspiration...</p>';
      thankYou.style.display = 'block';
      thankYou.style.padding = '1rem 0';
      thankYou.style.textAlign = 'center';
      // NOTE: Redirect timing is intentional. Thank-you duration is controlled in ActiveCampaign.
      setTimeout(function() {
        window.location.href = '/project-inspiration/session';
      }, 1000);
    }

    function showError(message) {
      var oldError = form.querySelector('._form_error');
      if (oldError) oldError.remove();
      var err = document.createElement('div');
      err.className = '_form_error';
      err.innerHTML = message;
      err.style.cssText = 'background:#fef2f2;border:1px solid #fecaca;border-radius:0.5rem;padding:0.75rem;color:#dc2626;font-size:0.9rem;margin-bottom:1rem;';
      submitButton.parentNode.insertBefore(err, submitButton);
    }

    form.addEventListener('submit', function(e) {
      var oldError = form.querySelector('._form_error');
      if (oldError) oldError.remove();

      var email = emailInput.value.trim();
      if (!email || !validateEmail(email)) {
        e.preventDefault();
        emailInput.style.borderColor = '#dc2626';
        showError('Please enter a valid email address.');
        return false;
      }

      emailInput.style.borderColor = '';
      submitButton.disabled = true;
      submitButton.textContent = 'Submitting...';

      setTimeout(function() {
        showThankYou();
      }, 1500);
    });
  })();
</script>

<!-- Benefits visibility toggle based on agent presence -->
<script is:inline>
  if (typeof window !== "undefined") {
    const benefits = document.getElementById("project-inspiration-benefits");

    function updateBenefitsVisibility() {
      const agent = document.getElementById("project-inspiration-agent");
      const hasAgentContent = agent && agent.childElementCount > 0;
      if (benefits) {
        benefits.classList.toggle("hidden", !!hasAgentContent);
      }
    }

    // Run once on load
    updateBenefitsVisibility();

    // Watch for changes in the DOM (for when the agent embed is injected later)
    const observer = new MutationObserver(updateBenefitsVisibility);
    observer.observe(document.body, { childList: true, subtree: true });
  }
</script>
