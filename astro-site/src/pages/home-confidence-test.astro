---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Machine Knitting Made Clear, Calm, and Doable | Knit by Machine";
const description = "You can knit beautiful things on your machine. Knit by Machine gives you the tools, guidance, and confidence to make it happen.";
---

<BaseLayout {title} {description}>
  <main>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content">
            <p class="eyebrow">Knit by Machine</p>
            <h1>Machine Knitting Made Clear, Calm, and Doable</h1>
            <p class="subhead">
              You can knit beautiful things on your machine.<br />
              Knit by Machine gives you the tools, guidance, and confidence to make it happen.
            </p>
            <div class="hero-buttons">
              <a href="#confidence-path" class="button button--primary">Start Your Confidence Path</a>
              <a href="/tools" class="button button--secondary">Explore Tools & Patterns</a>
            </div>
          </div>
          <div class="hero-image">
            <div class="image-placeholder">
              <span>Image placeholder</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What You'll Find Here -->
    <section class="section">
      <div class="container">
        <h2>What You'll Find Here</h2>
        <ul class="feature-list">
          <li>Practical tools that take the guesswork out of machine knitting.</li>
          <li>Skill Builders that strengthen your foundation step by step.</li>
          <li>Smart Guides that help you choose and plan your projects.</li>
          <li>Guided Workshops for personalized, project-focused progress.</li>
          <li>Clear answers you can trust without overwhelm.</li>
        </ul>
      </div>
    </section>

    <!-- The Confidence Path -->
    <section class="section section--highlight" id="confidence-path">
      <div class="container">
        <h2>The Confidence Path</h2>
        <p class="section-subhead">Your clear, encouraging roadmap for machine knitting success.</p>
        
        <div class="path-grid">
          <div class="path-card">
            <span class="path-step">1</span>
            <h3>Orientation</h3>
            <p>Get your bearings so you know exactly where you are and what support is available.</p>
          </div>
          <div class="path-card">
            <span class="path-step">2</span>
            <h3>Foundations</h3>
            <p>Build the essential skills and setup that make everything else easier and more enjoyable.</p>
          </div>
          <div class="path-card">
            <span class="path-step">3</span>
            <h3>Choose Your Entry Track</h3>
            <p>Pick the path that matches your goals, your machine, and your current comfort level.</p>
          </div>
          <div class="path-card">
            <span class="path-step">4</span>
            <h3>First Win</h3>
            <p>Complete a small, finishable project that builds trust in yourself and momentum at the machine.</p>
          </div>
          <div class="path-card">
            <span class="path-step">5</span>
            <h3>Explore and Expand</h3>
            <p>Grow your skills with new tools, techniques, and projects at your own pace.</p>
          </div>
        </div>

        <div class="section-cta">
          <a href="/start-here" class="button button--primary">Start Your Confidence Path</a>
        </div>
      </div>
    </section>

    <!-- Choose Your Entry Track -->
    <section class="section">
      <div class="container">
        <h2>Choose Your Entry Track</h2>
        <div class="track-grid">
          <a href="/getting-started" class="track-card">
            <h3>Getting Started</h3>
            <p>New to machine knitting? Begin here with orientation and foundational skills.</p>
          </a>
          <a href="/tools" class="track-card">
            <h3>Tools & Patterns</h3>
            <p>Ready to create? Explore wizards, calculators, and project guides.</p>
          </a>
          <a href="/guided-workshops" class="track-card">
            <h3>Guided Workshops</h3>
            <p>Want personal guidance? Work with Sue on a project that matters to you.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Tools & Skill Builders -->
    <section class="section">
      <div class="container">
        <h2>Featured Tools & Skill Builders</h2>
        <div class="tools-grid">
          <div class="tool-card">
            <h3>Blanket Wizard</h3>
            <p>Build custom blankets in minutes.</p>
          </div>
          <div class="tool-card">
            <h3>Gauge Wizard</h3>
            <p>Trust your numbers every time.</p>
          </div>
          <div class="tool-card">
            <h3>Skill Builder: Cast Ons</h3>
            <p>Clear demonstrations without overwhelm.</p>
          </div>
          <div class="tool-card">
            <h3>Skill Builder: Yarn Handling</h3>
            <p>Confidence at the carriage.</p>
          </div>
        </div>
        <p class="section-link">
          <a href="/tools">Explore All Tools</a>
        </p>
      </div>
    </section>

    <!-- Guided Workshops With Sue -->
    <section class="section section--alt">
      <div class="container">
        <h2>Guided Workshops With Sue</h2>
        <p>A calm, personal way to make real progress — without schedules, overwhelm, or live calls.</p>
        <div class="section-cta">
          <a href="/guided-workshops" class="button button--primary">See Workshops</a>
        </div>
      </div>
    </section>

    <!-- Ask 'n Answer (ANA) -->
    <section class="section">
      <div class="container">
        <h2>Ask 'n Answer (ANA)</h2>
        <p>Real questions from real knitters — with clear, confidence-building answers.</p>
        <div class="section-cta">
          <a href="/ask-n-answer" class="button button--primary">Browse ANA Library</a>
        </div>
      </div>
    </section>

    <!-- From Sue's Desk (Blog) -->
    <section class="section section--alt">
      <div class="container">
        <h2>From Sue's Desk</h2>
        <p>Encouragement, clarity, and project inspiration — in Sue's warm, steady voice.</p>
        <div class="section-cta">
          <a href="/blog" class="button button--primary">Read the Latest</a>
        </div>
      </div>
    </section>

    <!-- Join the Community -->
    <section class="section">
      <div class="container">
        <h2>Join the Community</h2>
        <p>A supportive space to share progress, ask questions, and stay motivated.</p>
        <div class="section-cta">
          <a href="/community" class="button button--primary">Visit the Community</a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* Container */
  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Section Spacing */
  .section {
    padding: 3rem 0;
  }

  .section--highlight {
    background: linear-gradient(135deg, #f9fdf5 0%, #e9ece7 100%);
    padding: 3rem 0;
  }

  .section--alt {
    background: #f5f7f2;
    padding: 3rem 0;
  }

  .section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--kbm-green);
    margin: 0 0 1rem;
  }

  .section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #4a5a3d;
    max-width: 700px;
  }

  .section-subhead {
    margin-bottom: 2rem;
  }

  .section-cta {
    margin-top: 2rem;
  }

  .section-link {
    margin-top: 1.5rem;
    text-align: center;
  }

  .section-link a {
    color: var(--kbm-green);
    text-decoration: underline;
    font-weight: 500;
  }

  /* Hero Section */
  .hero-section {
    padding: 4rem 0;
    background: linear-gradient(180deg, #f9fdf5 0%, #ffffff 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .hero-content .eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--kbm-green-2);
    margin: 0 0 0.75rem;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--kbm-green);
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .hero-content .subhead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #4a5a3d;
    margin: 0 0 2rem;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }

  .image-placeholder {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 4/3;
    background: #f5f7f2;
    border: 2px dashed var(--kbm-green-2);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--kbm-green-2);
    font-weight: 500;
  }

  /* Buttons */
  .button {
    display: inline-block;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .button--primary {
    background: var(--kbm-green);
    color: white;
    border: 2px solid var(--kbm-green);
  }

  .button--primary:hover {
    background: var(--kbm-green-2);
    border-color: var(--kbm-green-2);
  }

  .button--secondary {
    background: transparent;
    color: var(--kbm-green);
    border: 2px solid var(--kbm-green);
  }

  .button--secondary:hover {
    background: var(--kbm-green);
    color: white;
  }

  /* Feature List */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .feature-list li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.875rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #4a5a3d;
  }

  .feature-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--kbm-green);
    font-weight: 700;
  }

  /* Path Grid (Confidence Path) */
  .path-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .path-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .path-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .path-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid #d4dbc8;
    position: relative;
  }

  .path-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: var(--kbm-green);
    color: white;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 50%;
    margin-bottom: 0.75rem;
  }

  .path-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .path-card p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #5a6b47;
    margin: 0;
  }

  /* Track Grid (Entry Tracks) */
  .track-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .track-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .track-card {
    display: block;
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    border: 2px solid #d4dbc8;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .track-card:hover {
    border-color: var(--kbm-green);
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.1);
  }

  .track-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .track-card p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #5a6b47;
    margin: 0;
  }

  /* Tools Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid #d4dbc8;
  }

  .tool-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.375rem;
  }

  .tool-card p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #5a6b47;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 640px) {
    .section {
      padding: 2rem 0;
    }

    .hero-section {
      padding: 2.5rem 0;
    }

    .section h2 {
      font-size: 1.5rem;
    }
  }
</style>
