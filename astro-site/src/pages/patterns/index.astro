---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

let entries = [];
let errorMessage = '';

async function fetchEntriesFromPath(path: string, entryType: 'wizard' | 'agent') {
  try {
    const response = await fetch(`https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/${path}`);
    
    if (!response.ok) {
      return [];
    }
    
    const files = await response.json();
    
    const entryPromises = files
      .filter((file: any) => file.name.endsWith('.json'))
      .map(async (file: any) => {
        const fileResponse = await fetch(file.download_url);
        const data = await fileResponse.json();
        return {
          title: data.title,
          slug: data.slug,
          hero: data.hero || '',
          excerpt: data.excerpt || '',
          description: data.description || '',
          category: data.category || 'Uncategorized',
          tags: data.tags || [],
          accessLevel: data.accessLevel || 'free',
          price: data.price || '',
          isDraft: data.isDraft,
          pendingPublish: data.pendingPublish,
          publishedDate: data.publishedDate,
          iconUrl: data.iconUrl || '',
          entryType: entryType,
        };
      });
    
    const allEntries = await Promise.all(entryPromises);
    return allEntries.filter((entry: any) => !entry.isDraft && !entry.pendingPublish);
  } catch (error) {
    console.error(`Error fetching ${entryType} entries:`, error);
    return [];
  }
}

function isPattern(category: string): boolean {
  const cat = (category || '').toLowerCase().trim();
  return cat.includes('pattern') || cat.includes('patterns');
}

try {
  const [wizardEntries, agentEntries] = await Promise.all([
    fetchEntriesFromPath('astro-site/src/content/wizards', 'wizard'),
    fetchEntriesFromPath('astro-site/src/content/ai-agents', 'agent')
  ]);
  
  const allEntries = [...wizardEntries, ...agentEntries];
  entries = allEntries.filter(entry => isPattern(entry.category));
  
  entries.sort((a, b) => a.title.localeCompare(b.title));
} catch (error) {
  console.error('Error fetching entries:', error);
  errorMessage = error.message;
}

const title = "Patterns";
const description = "Custom-fit patterns for your knitting machine. Tell the wizard what you want to knit and get a plan that fits your yarn, gauge, and style.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Patterns" 
      iconPath="/images/pattern_icon.png"
      iconAlt="Pattern icon"
    />

    <div class="intro-section">
      <p class="intro-headline">Tell the wizard what you want to knit — get a plan that fits your yarn, gauge, and style.</p>
      <p class="intro-text">
        Pattern wizards help you move from "I'd love to make this" to "Here's exactly how." You set the basics — size, style, yarn, and gauge — and the wizard builds a roadmap you can follow at the machine.
      </p>
    </div>

    <div class="guides-grid" data-testid="patterns-grid">
      {errorMessage && (
        <div class="error">
          <p><strong>Error loading Patterns</strong></p>
          <p>Unable to fetch entries. Please try again later.</p>
          <p style="font-size: 0.9rem; margin-top: 1rem;">{errorMessage}</p>
        </div>
      )}
      
      {entries.length === 0 && !errorMessage && (
        <div class="no-results">
          <p>Patterns are coming soon! Check back for custom-fit pattern wizards.</p>
        </div>
      )}
      
      {entries.map((entry, index) => {
        const basePath = entry.entryType === 'agent' ? '/agents' : '/wizards';
        const displayText = entry.excerpt || entry.hero || '';
        const badgeClass = `badge-${entry.accessLevel}`;
        const badgeText = entry.accessLevel === 'paid' && entry.price 
          ? `$${entry.price}` 
          : entry.accessLevel.charAt(0).toUpperCase() + entry.accessLevel.slice(1);
        
        return (
          <a 
            href={`${basePath}/${entry.slug}`} 
            class="guide-card" 
            data-testid={`card-pattern-${entry.slug}`}
            style={`animation-delay: ${index * 0.1}s`}
          >
            {entry.iconUrl && (
              <img src={entry.iconUrl} alt="" class="guide-card-icon" />
            )}
            <h2 class="guide-card-title">{entry.title}</h2>
            {displayText && (
              <p class="guide-card-description">{displayText}</p>
            )}
            <span class={`guide-card-badge ${badgeClass}`}>{badgeText}</span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .intro-headline {
    font-size: clamp(1.3rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #52682D;
    line-height: 1.4;
    margin: 0 0 0.5rem 0;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .guide-card {
    position: relative;
    background-color: #ffffff;
    color: #52682D;
    border: 2px solid #c7d8a4;
    padding: 2rem;
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 260px;
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .guide-card:hover {
    background-color: #f6f8f2;
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(82, 104, 45, 0.15);
    border-color: #52682D;
  }

  .guide-card-icon {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    width: 56px;
    height: 56px;
    object-fit: contain;
    opacity: 0.5;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .guide-card:hover .guide-card-icon {
    opacity: 1;
  }

  .guide-card-title {
    font-size: clamp(1.4rem, 3vw, 1.6rem);
    font-weight: 700;
    color: #52682D;
    margin: 0;
    line-height: 1.3;
    padding-right: 70px;
  }

  .guide-card-description {
    font-size: 1.1rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
    flex: 1 0 auto;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .guide-card-badge {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border-radius: 12px;
    font-size: clamp(0.9rem, 2vw, 1rem);
    font-weight: 600;
    text-transform: uppercase;
    align-self: flex-start;
  }

  .badge-free {
    background-color: #C7D8A4;
    color: #52682D;
  }

  .badge-paid {
    background-color: #52682D;
    color: white;
  }

  .badge-membership {
    background-color: #8BA556;
    color: white;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error {
    text-align: center;
    padding: 3rem;
    color: #d64545;
    background-color: #ffe5e5;
    border-radius: 12px;
    grid-column: 1 / -1;
  }

  .no-results {
    text-align: center;
    padding: 3rem;
    color: #5a6b47;
    background-color: #f9fdf5;
    border-radius: 12px;
    grid-column: 1 / -1;
  }

  .no-results p {
    font-size: 1.1rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .guides-grid {
      grid-template-columns: 1fr;
    }

    .guide-card {
      min-height: 220px;
    }

    .intro-section {
      margin-bottom: 2rem;
    }
  }
</style>
