---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

const title = "Patterns";
const description = "Custom-fit patterns for your knitting machine. Tell the wizard what you want to knit and get a plan that fits your yarn, gauge, and style.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Custom-fit patterns for your knitting machine" 
      iconPath="/images/pattern_icon.png"
      iconAlt="Pattern icon"
    />

    <div class="intro-section">
      <p class="intro-headline">Tell the wizard what you want to knit — get a plan that fits your yarn, gauge, and style.</p>
      <p class="intro-text">
        Pattern wizards help you move from "I'd love to make this" to "Here's exactly how." You set the basics — size, style, yarn, and gauge — and the wizard builds a roadmap you can follow at the machine. No guessing, no rewriting hand-knitting patterns on the fly.
      </p>
    </div>

    <div class="content-section">
      <h2 class="content-title">What you can use these for</h2>
      <ul class="bullet-list" data-testid="patterns-bullet-list">
        <li>Simple, everyday sweaters</li>
        <li>Blankets in the sizes you actually want</li>
        <li>Hats, scarves, and quick gifts</li>
        <li>Practice projects that build your confidence</li>
      </ul>
    </div>

    <div class="cta-section">
      <a href="/wizards-catalog" class="cta-button" data-testid="button-browse-patterns">
        Browse all pattern wizards
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .intro-headline {
    font-size: clamp(1.3rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #52682D;
    line-height: 1.4;
    margin: 0 0 0.5rem 0;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
    margin: 0;
  }

  .content-section {
    max-width: 800px;
    margin: 0 auto 3rem;
    background-color: #f9fdf5;
    border-radius: 16px;
    padding: 2rem 2.5rem;
  }

  .content-title {
    font-size: clamp(1.4rem, 2.5vw, 1.6rem);
    font-weight: 700;
    color: #52682D;
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bullet-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
  }

  .bullet-list li:last-child {
    margin-bottom: 0;
  }

  .bullet-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 10px;
    height: 10px;
    background-color: #C7D8A4;
    border-radius: 50%;
  }

  .cta-section {
    text-align: center;
    margin-top: 2rem;
  }

  .cta-button {
    display: inline-block;
    background-color: #52682D;
    color: white;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    font-weight: 600;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.2);
  }

  .cta-button:hover {
    background-color: #3e5023;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(82, 104, 45, 0.3);
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .content-section {
      padding: 1.5rem;
    }

    .intro-section {
      margin-bottom: 2rem;
    }
  }
</style>
