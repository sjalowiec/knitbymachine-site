---
import BaseLayout from "../../layouts/BaseLayout.astro";

const STRIPE_URL = "PASTE_STRIPE_PAYMENT_LINK_HERE";

const title = "Hybrid Blanket Pattern | Knit by Machine";
const description =
  "Combine hand and machine knitting — or mix stitch patterns for borders and body — without doing any math and without distorted edges.";
---

<BaseLayout title={title} description={description}>
  <style>
    :root{
      --kbm-green: var(--kbm-green, #52682D);
      --page-bg:#f7f6f2;
      --surface:#ffffff;
      --text:#1f2937;
      --muted:#5b6472;
      --border:#e5e7eb;
      --shadow:0 10px 30px rgba(0,0,0,.08);
      --radius:18px;
      --max:860px;
      --font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
    }
    *{box-sizing:border-box}

    /* Page wrapper spacing (plays nicely with your existing header) */
    .page-wrap{
      max-width:var(--max);
      margin:0 auto;
      padding:34px 18px 60px;
    }

    .hero{
      background:var(--surface);
      border:1px solid var(--border);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding:28px;
    }

    .hero-image{
      margin:-28px -28px 20px;
      border-radius:var(--radius) var(--radius) 0 0;
      overflow:hidden;
    }
    .hero-image img{
      width:100%;
      display:block;
    }
    .hero-image figcaption{
      background:#111827;
      color:#fff;
      padding:10px 14px;
      font-size:14px;
    }

    h1{
      font-size:clamp(28px, 4vw, 40px);
      line-height:1.15;
      margin:0 0 10px;
    }
    .subhead{
      font-size:18px;
      color:var(--muted);
      margin:0 0 20px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:12px 16px;
      border-radius:14px;
      background:var(--kbm-green);
      color:#fff;
      text-decoration:none;
      font-weight:700;
      box-shadow:0 14px 26px rgba(82,104,45,.2);
    }

    .divider{
      height:1px;
      background:var(--border);
      margin:24px 0;
    }

    .lead p{margin:8px 0;}
    .muted{color:var(--muted);}

    .grid{
      display:grid;
      gap:18px;
      margin-top:24px;
    }
    @media(min-width:860px){
      .grid{grid-template-columns:1fr 1fr;}
    }

    .card{
      background:var(--surface);
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:20px;
    }
    ul{padding-left:18px;margin:10px 0;}
    li{margin:8px 0;}

    .note{
      font-size:13px;
      color:var(--muted);
    }
  </style>

  <main class="page-wrap">
    <article class="hero">
      <figure class="hero-image">
        <img src="/images/blanket.webp" alt="Ruffled blanket edge caused by incorrect stitch math" />
        <figcaption>
          <strong>The “Ruffle” Problem:</strong> This happens when the math is wrong. My pattern fixes this.
        </figcaption>
      </figure>

      <h1>A Blanket Pattern That Lets You Mix Techniques — Without the Math</h1>
      <p class="subhead">
        Combine hand knitting and machine knitting, or use different stitch patterns for borders and body,
        <strong>without recalculating stitch counts or ending up with distorted edges</strong>.
      </p>

      <a class="btn" href={STRIPE_URL}>Get the Pattern — $9</a>

      <div class="divider"></div>

      <div class="lead">
        <p><strong>Stop guessing at the math.</strong> Mixing hand and machine knitting usually leads to flared edges and distorted borders.</p>
        <p class="muted">This pattern provides the exact ratios you need so your borders and body line up perfectly the first time.</p>
      </div>
    </article>

    <section class="grid">
      <div class="card">
        <h2>What this pattern lets you do</h2>
        <ul>
          <li>Combine <strong>hand-knit borders</strong> with a <strong>machine-knit body</strong></li>
          <li>Use <strong>different stitch patterns</strong> for top/bottom borders and center</li>
          <li>Keep blanket edges <strong>straight and stable</strong></li>
          <li>Skip stitch-count recalculations</li>
          <li>Focus on knitting, not math</li>
        </ul>
      </div>

      <div class="card">
        <h2>Why this works</h2>
        <p>
          The pattern handles the stitch and row transitions that normally cause distortion.
          You follow the structure. The edges behave.
        </p>
        <ul>
          <li>No spreadsheets</li>
          <li>No re-engineering</li>
          <li>No trial-and-error</li>
        </ul>
      </div>

      <div class="card" style="border-left:4px solid var(--kbm-green);">
        <h2>What you get</h2>
        <ul>
          <li><strong>The Ratio:</strong> The exact numbers for hand-to-machine transitions.</li>
          <li><strong>The Layout:</strong> A stable structure for any size blanket.</li>
          <li><strong>The Result:</strong> Straight edges, even with different stitch patterns.</li>
        </ul>
      </div>

      <div class="card" style="background:#f9fafb;">
        <h2>What it isn’t</h2>
        <ul style="opacity:0.8;">
          <li>No 2-hour video courses.</li>
          <li>No complex spreadsheets.</li>
          <li>No “theory” — just the pattern.</li>
        </ul>
      </div>
    </section>

    <section class="section" aria-label="Bottom call to action">
      <div class="card" style="text-align: center; padding: 40px 20px;">
        <h2 style="font-size: 24px;">Start knitting in 60 seconds</h2>
        <p style="margin: 10px 0 20px; color: var(--muted);">
          Get the PDF pattern immediately after checkout.
        </p>
        <a class="btn" href={STRIPE_URL} style="font-size: 18px; padding: 16px 32px;">
          Get the Pattern — $9
        </a>
        <p class="note" style="margin-top: 15px;">
          Secure checkout via Stripe
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
