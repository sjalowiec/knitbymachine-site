---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AvailabilityBadge from '../../components/machines/AvailabilityBadge.astro';
import GaugeOverview from '../../components/machines/GaugeOverview.astro';
import { getAllMachines, getMachineById, formatPrice } from '../../lib/machines/getMachineById';

export async function getStaticPaths() {
  const machines = getAllMachines();
  return machines.map((machine) => ({
    params: { id: machine.id },
    props: { machine }
  }));
}

const { id } = Astro.params;
const machine = getMachineById(id);

if (!machine) {
  return Astro.redirect('/machines');
}

const gaugeShort = machine.gauge.replace('-Gauge', '').replace(' Gauge', '');

const cycaInfo: Record<number, { label: string; description: string }> = {
  0: { label: 'Lace', description: 'CYCA 0 — Lace weight' },
  1: { label: 'Fingering', description: 'CYCA 1 — Fingering / Sock (often ~28–32 sts per 4" / 10 cm)' },
  2: { label: 'Sport', description: 'CYCA 2 — Sport (often ~24–26 sts per 4" / 10 cm)' },
  3: { label: 'DK', description: 'CYCA 3 — DK / Light Worsted (often ~21–24 sts per 4" / 10 cm)' },
  4: { label: 'Worsted', description: 'CYCA 4 — Worsted / Aran (often ~16–20 sts per 4" / 10 cm)' },
  5: { label: 'Bulky', description: 'CYCA 5 — Bulky (often ~12–15 sts per 4" / 10 cm)' },
  6: { label: 'Super Bulky', description: 'CYCA 6 — Super Bulky (often ~7–11 sts per 4" / 10 cm)' },
  7: { label: 'Jumbo', description: 'CYCA 7 — Jumbo (typically under ~7 sts per 4" / 10 cm)' }
};
---

<BaseLayout 
  title={`${machine.model} | Knit by Machine`}
  description={machine.shortDescription}
>
  <article class="machine-detail-page">
    
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-grid">
        <div class="hero-image">
          {machine.primaryImage ? (
            <img 
              src={machine.primaryImage} 
              alt={machine.model}
            />
          ) : (
            <div class="image-placeholder">
              <span>Image coming soon</span>
            </div>
          )}
          {machine.isBundle && (
            <span class="bundle-badge">Bundle</span>
          )}
        </div>
        
        <div class="hero-content">
          <div class="hero-badges">
            <span class="gauge-badge">
              {machine.gaugeLabel} {gaugeShort}
            </span>
            <AvailabilityBadge 
              status={machine.availability} 
              leadTimeNotes={machine.leadTimeNotes}
            />
          </div>
          
          <h1>{machine.model}</h1>
          
          <p class="subhead">{machine.shortDescription}</p>
          
          <div class="price-section">
            <span class="price">{formatPrice(machine.priceUSD)}</span>
            {machine.leadTimeNotes && (
              <span class="lead-time">Lead time: {machine.leadTimeNotes}</span>
            )}
          </div>
          
          <!-- Shopify Buy Button -->
          <div class="buy-button-container" id={machine.buyButtonDivId}></div>
          
          <div class="hero-actions">
            <a href="/machines" class="btn-secondary">
              Browse all machines
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Specs Section -->
    <section class="content-card specs-section">
      <h2>Specifications</h2>
      <div class="specs-grid">
        <div class="spec-item">
          <span class="spec-label">Gauge</span>
          <span class="spec-value">{machine.gaugeLabel} ({machine.gaugeMm}mm)</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Needle Bed</span>
          <span class="spec-value">{machine.bedWidthNeedles} needles ({machine.bedWidthCm})</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Yarn Range</span>
          <span class="spec-value">{machine.yarnYppMin.toLocaleString()}–{machine.yarnYppMax.toLocaleString()} YPP</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">CYCA Weight</span>
          <span class="spec-value cyca-icons">
            {typeof machine.cycaMin === "number" && cycaInfo[machine.cycaMin] && (
              <span
                class="kbm-tooltip"
                data-tip={cycaInfo[machine.cycaMin].description}
              >
                <img
                  src={`/images/yarn-weights/${machine.cycaMin}.svg`}
                  alt={cycaInfo[machine.cycaMin].label}
                  width="36"
                  height="36"
                  loading="lazy"
                  style="vertical-align: middle;"
                />
              </span>
            )}
            {machine.cycaMin !== machine.cycaMax && (
              <>
                <span class="cyca-separator">–</span>
                {typeof machine.cycaMax === "number" && cycaInfo[machine.cycaMax] && (
                  <span
                    class="kbm-tooltip"
                    data-tip={cycaInfo[machine.cycaMax].description}
                  >
                    <img
                      src={`/images/yarn-weights/${machine.cycaMax}.svg`}
                      alt={cycaInfo[machine.cycaMax].label}
                      width="36"
                      height="36"
                      loading="lazy"
                      style="vertical-align: middle;"
                    />
                  </span>
                )}
              </>
            )}
          </span>
        </div>
        {machine.operationType && (
          <div class="spec-item">
            <span class="spec-label">Patterning</span>
            <span class="spec-value" style="text-transform: capitalize;">{machine.operationType}</span>
          </div>
        )}
        <div class="spec-item">
          <span class="spec-label">Weight</span>
          <span class="spec-value">{machine.machineWeightLbs} lbs</span>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    {machine.keyBenefits && machine.keyBenefits.length > 0 && (
      <section class="content-card benefits-section">
        <h2>What this {machine.isBundle ? 'bundle' : 'machine'} does well</h2>
        <ul class="benefits-list">
          {machine.keyBenefits.map((benefit) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--kbm-green-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7" />
              </svg>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- What's Included Section -->
    {machine.includedItems && machine.includedItems.length > 0 && (
      <section class="content-card">
        <h2>What's Included</h2>
        <ul class="included-list">
          {machine.includedItems.map((item) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--kbm-green-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Bundle Contents (if bundle) -->
    {machine.isBundle && machine.bundleIncludes && machine.bundleIncludes.length > 0 && (
      <section class="content-card bundle-section">
        <h2>Bundle Contents</h2>
        <ul class="bundle-list">
          {machine.bundleIncludes.map((item) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--kbm-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <path d="M9 12l2 2 4-4" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Gauge Explainer Section -->
    <section class="content-card gauge-section">
      <h2>Understanding Gauge</h2>
      <GaugeOverview currentGaugeName={gaugeShort} showExplainer={true} />
    </section>

    <!-- Warranty & Info -->
    {machine.warrantyNotes && (
      <section class="content-card">
        <h2>Warranty</h2>
        <p class="warranty-text">{machine.warrantyNotes}</p>
      </section>
    )}

    <!-- Help Section -->
    <section class="content-card help-section">
      <h2>Need help deciding?</h2>
      <div class="help-links">
        <a href="/contact" class="help-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Ask a question
        </a>
        <a href="/machines" class="help-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Compare machines
        </a>
      </div>
    </section>

  </article>
</BaseLayout>

<!-- Shopify Buy Button Script -->
<script is:inline define:vars={{ shopifyProductId: machine.shopifyProductId, buyButtonDivId: machine.buyButtonDivId }}>
  (function () {
    var scriptURL = 'https://sdks.shopifycdn.com/buy-button/latest/buy-button-storefront.min.js';
    if (window.ShopifyBuy) { 
      if (window.ShopifyBuy.UI) { ShopifyBuyInit(); } else { loadScript(); } 
    } else { 
      loadScript(); 
    }
    
    function loadScript() {
      var script = document.createElement('script');
      script.async = true;
      script.src = scriptURL;
      (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(script);
      script.onload = ShopifyBuyInit;
    }
    
    function ShopifyBuyInit() {
      var client = ShopifyBuy.buildClient({
        domain: 'knit-by-machine.myshopify.com',
        storefrontAccessToken: '66fba9d9b42bfea416c8e0af7987dc94'
      });
      ShopifyBuy.UI.onReady(client).then(function (ui) {
        ui.createComponent('product', {
          id: shopifyProductId,
          node: document.getElementById(buyButtonDivId),
          options: {
            product: {
              styles: {
                button: {
                  'background-color': '#52682d',
                  ':hover': { 'background-color': '#4a5e29' },
                  ':focus': { 'background-color': '#4a5e29' },
                  'border-radius': '11px',
                  'font-weight': '600',
                  'padding': '12px 24px'
                }
              },
              text: { button: 'Add to cart' },
              contents: {
                img: false,
                title: false,
                price: false,
                description: false
              }
            }
          }
        });
      });
    }
  })();
</script>

<style>
  .machine-detail-page {
    padding: 2rem 0;
  }

  .hero-section {
    margin-bottom: 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-image {
    aspect-ratio: 1;
    background: #f3f4f6;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5e7eb;
    color: #9ca3af;
  }

  .bundle-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--kbm-green);
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .gauge-badge {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    background: #f3f4f6;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .hero-content h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .hero-content h1 {
      font-size: 2.5rem;
    }
  }

  .subhead {
    font-size: 1.125rem;
    color: #374151;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .price-section {
    margin-bottom: 1.5rem;
  }

  .price {
    font-size: 2rem;
    font-weight: 700;
    color: var(--kbm-green);
    display: block;
  }

  .lead-time {
    font-size: 0.875rem;
    color: #6b7280;
    display: block;
    margin-top: 0.25rem;
  }

  .buy-button-container {
    margin-bottom: 1rem;
    min-height: 50px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--kbm-green);
    color: white;
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--kbm-green-2);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--kbm-green);
    color: var(--kbm-green);
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-secondary:hover {
    background: var(--kbm-bg);
  }

  .content-card {
    background: white;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .content-card {
      padding: 2rem;
    }
  }

  .content-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .gauge-section {
    background: var(--kbm-bg);
    border: none;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .specs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec-value {
    font-size: 1rem;
    font-weight: 500;
    color: #1f2937;
  }

  .benefits-list,
  .included-list,
  .bundle-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .benefits-list li,
  .included-list li,
  .bundle-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .benefits-list li svg,
  .included-list li svg,
  .bundle-list li svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .benefits-list li span,
  .included-list li span,
  .bundle-list li span {
    color: #374151;
  }

  .warranty-text {
    color: #6b7280;
    margin: 0;
  }

  .help-section h2 {
    font-size: 1.25rem;
  }

  .help-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    color: #374151;
    text-decoration: none;
    transition: background 0.2s;
  }

  .help-link:hover {
    background: #f9fafb;
  }

  .help-link svg {
    flex-shrink: 0;
  }
</style>
