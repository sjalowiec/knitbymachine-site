---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AvailabilityBadge from '../../components/machines/AvailabilityBadge.astro';
import GaugeOverview from '../../components/machines/GaugeOverview.astro';
import BundleCard from '../../components/machines/BundleCard.astro';
import { getAllMachines, getMachineById } from '../../lib/machines/getMachineById';

export async function getStaticPaths() {
  const machines = getAllMachines();
  return machines.map((machine) => ({
    params: { id: machine.id },
    props: { machine }
  }));
}

const { id } = Astro.params;
const machine = getMachineById(id);

if (!machine) {
  return Astro.redirect('/machines');
}

const hasBundles = machine.bundleOptions && machine.bundleOptions.length > 0;
const subhead = machine.shortDescription || 
  `A ${machine.gaugeName.toLowerCase()} gauge machine ${machine.bestFor ? `perfect for ${machine.bestFor.toLowerCase()}` : ''}`;
---

<BaseLayout 
  title={`${machine.displayName} | Knit by Machine`}
  description={machine.shortDescription || machine.bestFor}
>
  <article class="machine-detail-page">
    
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-grid">
        <div class="hero-image">
          {machine.imageMain ? (
            <img 
              src={machine.imageMain} 
              alt={machine.imageAlt || machine.displayName}
            />
          ) : (
            <div class="image-placeholder">
              <span>Image coming soon</span>
            </div>
          )}
        </div>
        
        <div class="hero-content">
          <div class="hero-badges">
            <span class="gauge-badge">
              {machine.gaugeLabel} {machine.gaugeName} Gauge
            </span>
            <AvailabilityBadge 
              status={machine.availabilityStatus} 
              leadTimeMinWeeks={machine.leadTimeMinWeeks}
              leadTimeMaxWeeks={machine.leadTimeMaxWeeks}
            />
          </div>
          
          <h1>{machine.displayName}</h1>
          
          <p class="subhead">{subhead}</p>
          
          <div class="hero-actions">
            <a href="/machines/choose" class="btn-primary">
              Help me choose
            </a>
            <a href="/machines" class="btn-secondary">
              Browse all machines
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    {machine.keyBenefits && machine.keyBenefits.length > 0 && (
      <section class="content-card benefits-section">
        <h2>What this machine does well</h2>
        <ul class="benefits-list">
          {machine.keyBenefits.map((benefit) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--kbm-green-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7" />
              </svg>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
        {machine.bestFor && (
          <p class="best-for">
            <strong>Best for:</strong> {machine.bestFor}
          </p>
        )}
      </section>
    )}

    <!-- Gauge Explainer Section -->
    <section class="content-card gauge-section">
      <h2>Understanding Gauge</h2>
      <GaugeOverview currentGaugeName={machine.gaugeName} showExplainer={true} />
    </section>

    <!-- Availability Section -->
    <section class="content-card">
      <h2>Availability</h2>
      <AvailabilityBadge 
        status={machine.availabilityStatus} 
        leadTimeMinWeeks={machine.leadTimeMinWeeks}
        leadTimeMaxWeeks={machine.leadTimeMaxWeeks}
        showMessage={true}
      />
    </section>

    <!-- Bundles Section -->
    {hasBundles && (
      <section class="bundles-section">
        <h2>Bundle Options</h2>
        <p class="bundles-intro">
          Get started with everything you need in one package.
        </p>
        <div class="bundles-grid">
          {machine.bundleOptions!.map((bundle) => (
            <BundleCard bundle={bundle} />
          ))}
        </div>
      </section>
    )}

    <!-- Comparison CTA Section -->
    <section class="content-card cta-section">
      <h2>Want to compare?</h2>
      <p>See how the {machine.displayName} stacks up against other machines.</p>
      <a href={`/machines?compare=${machine.id}`} class="btn-primary">
        Compare machines
      </a>
    </section>

    <!-- Help Section -->
    <section class="content-card help-section">
      <h2>Need help deciding?</h2>
      <div class="help-links">
        <a href="/contact" class="help-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Ask a question
        </a>
        <a href="/machines/choose" class="help-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Not sure where to start?
        </a>
      </div>
    </section>

  </article>
</BaseLayout>

<style>
  .machine-detail-page {
    padding: 2rem 0;
  }

  .hero-section {
    margin-bottom: 3rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-image {
    aspect-ratio: 1;
    background: #f3f4f6;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5e7eb;
    color: #9ca3af;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .gauge-badge {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    background: #f3f4f6;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .hero-content h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .hero-content h1 {
      font-size: 2.5rem;
    }
  }

  .subhead {
    font-size: 1.125rem;
    color: #374151;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--kbm-green);
    color: white;
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--kbm-green-2);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--kbm-green);
    color: var(--kbm-green);
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-secondary:hover {
    background: var(--kbm-bg);
  }

  .content-card {
    background: white;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .content-card {
      padding: 2rem;
    }
  }

  .content-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .gauge-section {
    background: var(--kbm-bg);
    border: none;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }

  .benefits-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .benefits-list li svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .benefits-list li span {
    color: #374151;
  }

  .best-for {
    font-size: 0.875rem;
    color: #6b7280;
    border-top: 1px solid #f3f4f6;
    padding-top: 1rem;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .best-for strong {
    color: #374151;
  }

  .bundles-section {
    margin-bottom: 2rem;
  }

  .bundles-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .bundles-intro {
    color: #6b7280;
    margin-bottom: 1.5rem;
  }

  .bundles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .bundles-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cta-section {
    background: var(--kbm-bg);
    border: none;
    text-align: center;
  }

  .cta-section h2 {
    font-size: 1.25rem;
  }

  .cta-section p {
    color: #6b7280;
    margin-bottom: 1rem;
  }

  .help-section h2 {
    font-size: 1.25rem;
  }

  .help-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    color: #374151;
    text-decoration: none;
    transition: background 0.2s;
  }

  .help-link:hover {
    background: #f9fafb;
  }

  .help-link svg {
    flex-shrink: 0;
  }
</style>
