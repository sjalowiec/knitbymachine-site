---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AvailabilityBadge from '../../components/machines/AvailabilityBadge.astro';
import GaugeOverview from '../../components/machines/GaugeOverview.astro';
import BundleCard from '../../components/machines/BundleCard.astro';
import { getAllMachines, getMachineById } from '../../lib/machines/getMachineById';

export async function getStaticPaths() {
  const machines = getAllMachines();
  return machines.map((machine) => ({
    params: { id: machine.id },
    props: { machine }
  }));
}

const { id } = Astro.params;
const machine = getMachineById(id);

if (!machine) {
  return Astro.redirect('/machines');
}

const hasBundles = machine.bundleOptions && machine.bundleOptions.length > 0;
const subhead = machine.shortDescription || 
  `A ${machine.gaugeName.toLowerCase()} gauge machine ${machine.bestFor ? `perfect for ${machine.bestFor.toLowerCase()}` : ''}`;
---

<BaseLayout 
  title={`${machine.displayName} | Knit by Machine`}
  description={machine.shortDescription || machine.bestFor}
>
  <article class="machine-detail-page py-8">
    
    <!-- Hero Section -->
    <section class="hero-section mb-12">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="hero-image aspect-square bg-gray-100 rounded-xl overflow-hidden">
          {machine.imageMain ? (
            <img 
              src={machine.imageMain} 
              alt={machine.imageAlt || machine.displayName}
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-gray-200">
              <span class="text-gray-400">Image coming soon</span>
            </div>
          )}
        </div>
        
        <div class="hero-content">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-sm font-medium text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
              {machine.gaugeLabel} {machine.gaugeName} Gauge
            </span>
            <AvailabilityBadge 
              status={machine.availabilityStatus} 
              leadTimeMinWeeks={machine.leadTimeMinWeeks}
              leadTimeMaxWeeks={machine.leadTimeMaxWeeks}
            />
          </div>
          
          <h1 class="text-3xl md:text-4xl font-bold text-[var(--kbm-green)] mb-4">
            {machine.displayName}
          </h1>
          
          <p class="text-lg text-gray-700 mb-6 leading-relaxed">
            {subhead}
          </p>
          
          <div class="flex flex-wrap gap-3">
            <a 
              href="/machines/choose" 
              class="inline-flex items-center px-6 py-3 bg-[var(--kbm-green)] text-white font-medium rounded-lg hover:bg-[var(--kbm-green-2)] transition-colors"
            >
              Help me choose
            </a>
            <a 
              href="/machines" 
              class="inline-flex items-center px-6 py-3 border-2 border-[var(--kbm-green)] text-[var(--kbm-green)] font-medium rounded-lg hover:bg-[var(--kbm-bg)] transition-colors"
            >
              Browse all machines
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    {machine.keyBenefits && machine.keyBenefits.length > 0 && (
      <section class="benefits-section bg-white rounded-xl border border-gray-200 p-6 md:p-8 mb-8">
        <h2 class="text-2xl font-semibold text-[var(--kbm-green)] mb-4">
          What this machine does well
        </h2>
        <ul class="space-y-3 mb-4">
          {machine.keyBenefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[var(--kbm-green-2)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700">{benefit}</span>
            </li>
          ))}
        </ul>
        {machine.bestFor && (
          <p class="text-sm text-gray-600 border-t border-gray-100 pt-4 mt-4">
            <strong class="text-gray-700">Best for:</strong> {machine.bestFor}
          </p>
        )}
      </section>
    )}

    <!-- Gauge Explainer Section -->
    <section class="gauge-section bg-[var(--kbm-bg)] rounded-xl p-6 md:p-8 mb-8">
      <h2 class="text-2xl font-semibold text-[var(--kbm-green)] mb-4">
        Understanding Gauge
      </h2>
      <GaugeOverview currentGaugeName={machine.gaugeName} showExplainer={true} />
    </section>

    <!-- Availability Section -->
    <section class="availability-section bg-white rounded-xl border border-gray-200 p-6 md:p-8 mb-8">
      <h2 class="text-2xl font-semibold text-[var(--kbm-green)] mb-4">
        Availability
      </h2>
      <AvailabilityBadge 
        status={machine.availabilityStatus} 
        leadTimeMinWeeks={machine.leadTimeMinWeeks}
        leadTimeMaxWeeks={machine.leadTimeMaxWeeks}
        showMessage={true}
      />
    </section>

    <!-- Bundles Section -->
    {hasBundles && (
      <section class="bundles-section mb-8">
        <h2 class="text-2xl font-semibold text-[var(--kbm-green)] mb-4">
          Bundle Options
        </h2>
        <p class="text-gray-600 mb-6">
          Get started with everything you need in one package.
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          {machine.bundleOptions!.map((bundle) => (
            <BundleCard bundle={bundle} />
          ))}
        </div>
      </section>
    )}

    <!-- Comparison CTA Section -->
    <section class="comparison-section bg-[var(--kbm-bg)] rounded-xl p-6 md:p-8 mb-8 text-center">
      <h2 class="text-xl font-semibold text-[var(--kbm-green)] mb-2">
        Want to compare?
      </h2>
      <p class="text-gray-600 mb-4">
        See how the {machine.displayName} stacks up against other machines.
      </p>
      <a 
        href={`/machines?compare=${machine.id}`}
        class="inline-flex items-center px-6 py-3 bg-[var(--kbm-green)] text-white font-medium rounded-lg hover:bg-[var(--kbm-green-2)] transition-colors"
      >
        Compare machines
      </a>
    </section>

    <!-- Help Section -->
    <section class="help-section bg-white rounded-xl border border-gray-200 p-6 md:p-8">
      <h2 class="text-xl font-semibold text-[var(--kbm-green)] mb-4">
        Need help deciding?
      </h2>
      <div class="flex flex-wrap gap-4">
        <a 
          href="/contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Ask a question
        </a>
        <a 
          href="/machines/choose"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Not sure where to start?
        </a>
      </div>
    </section>

  </article>
</BaseLayout>
