---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Just Opened the Box | Knit by Machine';
const pageDescription = 'Your first steps after unboxing your knitting machine. Thread the mast, choose a machine-friendly yarn, and try an e-wrap cast on — your first step toward fabric.';

// Local video thumbnail images
const setupThumbnail = '/images/video1.webp';
const castonThumbnail = '/images/video2.webp';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="jotb-page">
    <!-- Breadcrumb -->
    <nav class="jotb-breadcrumb" aria-label="Breadcrumb" data-testid="nav-breadcrumb">
      <a href="/" data-testid="link-back-home">&larr; Back to Home</a>
    </nav>

    <!-- Page Header -->
    <header class="jotb-header">
      <h1 data-testid="text-page-title">Just Opened the Box…</h1>
      <p class="jotb-promise" data-testid="text-promise">
        You're about to take your first real step with your knitting machine — no overwhelm, just clear next moves.
      </p>
      <p class="jotb-start-here" data-testid="text-start-here">
        <strong>Start here:</strong> Set up and yarn → watch the video
      </p>
    </header>

    <!-- Path SVG -->
    <div class="jotb-path-container">
      <img src="/images/setup.png" alt="Set up and yarn → First Cast On → Challenge" class="jotb-path-svg" data-testid="img-path" />
    </div>

    <!-- SECTION 1: Set Up + Yarn (Bordered) -->
    <section id="setup" class="jotb-bordered-section" data-testid="section-setup">
      <div class="jotb-heading-row">
        <img src="/images/curved_arrow.svg" alt="" aria-hidden="true" class="jotb-heading-arrow" />
        <h2 data-testid="text-section-1-title">Set up and yarn</h2>
      </div>
      <div class="jotb-section-grid">
        <div class="jotb-section-content">
          <p>
            Before you cast on, choose a machine-friendly yarn, thread the mast, and get familiar with the basic parts of your machine.
          </p>
          <h3 class="jotb-notes-title">Quick Notes</h3>
          <ul class="jotb-checklist">
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              Appropriate yarn for your machine
            </li>
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              Triangle Yarn Guide
            </li>
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              Mast Tension Dial
            </li>
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              Loop in front of Yarn Feeder
            </li>
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              Thread the Takeup Spring
            </li>
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              Secure in the clip
            </li>
          </ul>
        </div>
        <div class="jotb-section-action">
          <p class="jotb-first-step" data-testid="text-first-hands-on">
            <strong>This is your first hands-on step.</strong>
          </p>
          <button
            type="button"
            class="jotb-video-card"
            data-video="setup"
            data-title="Setting Up Your Machine"
            aria-label="Watch: Setting Up Your Machine"
            data-testid="button-watch-setup"
          >
            <div class="jotb-thumb-frame">
              <img src={setupThumbnail} alt="" class="jotb-thumb-img" />
              <div class="jotb-play-overlay" aria-hidden="true">
                <svg class="jotb-play-icon" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div class="jotb-card-label">
              <span class="jotb-card-title">Setting Up Your Machine</span>
              <span class="jotb-card-helper">Opens in a large player. 2:15</span>
            </div>
          </button>
        </div>
      </div>
    </section>

    <!-- SECTION 2: First Cast On (Bordered) -->
    <section id="caston" class="jotb-bordered-section" data-testid="section-caston">
      <div class="jotb-heading-row">
        <img src="/images/curved_arrow.svg" alt="" aria-hidden="true" class="jotb-heading-arrow" />
        <h2 data-testid="text-section-2-title">First cast on</h2>
      </div>
      <div class="jotb-section-grid jotb-section-grid--mirrored">
        <div class="jotb-section-action">
          <button
            type="button"
            class="jotb-video-card"
            data-video="caston"
            data-title="E-Wrap Cast On"
            aria-label="Watch: E-Wrap Cast On"
            data-testid="button-watch-caston"
          >
            <div class="jotb-thumb-frame">
              <img src={castonThumbnail} alt="" class="jotb-thumb-img" />
              <div class="jotb-play-overlay" aria-hidden="true">
                <svg class="jotb-play-icon" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div class="jotb-card-label">
              <span class="jotb-card-title">E-Wrap Cast On</span>
              <span class="jotb-card-helper">Opens in a large player. 1:21</span>
            </div>
          </button>
        </div>
        <div class="jotb-section-content">
          <p>
            This is your hands-on moment. Follow along and you'll have stitches on your machine in minutes.
          </p>

          <h3 class="jotb-steps-title">Steps to Follow:</h3>
          <ol class="jotb-steps-list" data-testid="list-steps">
            <li>Set your carriage to the right</li>
            <li>Pull out a few needles</li>
            <li>Working left to right, e-wrap each needle (or every other needle)</li>
            <li>Thread the carriage</li>
            <li>Knit a few rows</li>
          </ol>

          <h3 class="jotb-done-title">You're Done When…</h3>
          <ul class="jotb-checklist" data-testid="list-done-checklist">
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              All needles have stitches on them
            </li>
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              Your fabric hangs evenly with weights attached
            </li>
            <li>
              <span class="jotb-check" aria-hidden="true">&#10003;</span>
              You can knit 5+ rows without dropped stitches
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION 3: Optional Paid Practice Project (Card) -->
    <section id="challenge" class="jotb-practice-card" data-testid="section-challenge">
      <div class="jotb-heading-row">
        <img src="/images/curved_arrow.svg" alt="" aria-hidden="true" class="jotb-heading-arrow" />
        <div class="jotb-practice-heading">
         <h2 data-testid="text-section-3-title">5-Day Cast On + Bind Off Practice Project ($19)</h2>
        </div>
      </div>
      <p class="jotb-optional-note" data-testid="text-optional-note">
        Totally optional — you can skip this and keep going.
      </p>
      <p>
        Want a little more structure? This optional practice project breaks the cast on and bind off into short daily sessions — perfect if you like a calm, guided pace and clear stopping points.
      </p>
      <div class="jotb-cta-wrap">
        <a href="#" class="jotb-btn-primary" data-testid="button-challenge">
          See the 5-Day Practice Project
        </a>
        <p class="jotb-helper-text">
          Short daily practice. Clear steps. No overwhelm.
        </p>
      </div>
    </section>

    <!-- SECTION 4: What's next? (Text-only) -->
    <section id="next" class="jotb-text-section" data-testid="section-next">
      <h2 data-testid="text-section-4-title">What's next?</h2>
      <p>
        Everyone who knits on a machine was once right where you are now, figuring things out one small step at a time. You don't need to rush or decide what comes next today. When questions come up (or you just want to see how others are getting started), you're welcome to visit the Knit by Machine community and join the conversation:
      </p>
      <p>
        <a href="https://knitbymachine.discourse.group/" class="jotb-community-link" data-testid="link-community">https://knitbymachine.discourse.group/</a>
      </p>
    </section>
  </div>

  <!-- VIDEO MODAL -->
  <div class="video-modal" id="video-modal" aria-hidden="true" data-testid="modal-video">
    <div class="video-modal__backdrop" data-close></div>
    <div class="video-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="video-modal-title">
      <div class="video-modal__header">
        <h2 id="video-modal-title" data-testid="text-modal-title">Video</h2>
        <button type="button" class="video-modal__close" data-close aria-label="Close video" data-testid="button-modal-close">&#10005;</button>
      </div>
      <div class="video-modal__body">
        <div class="video-frame" id="video-frame"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ============================================
     Just Opened the Box - Scoped Page Styles
     ============================================ */

  .jotb-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* Breadcrumb */
  .jotb-breadcrumb {
    margin-bottom: 1.5rem;
  }

  .jotb-breadcrumb a {
    color: var(--kbm-green, #52682d);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .jotb-breadcrumb a:hover {
    text-decoration: underline;
  }

  /* Page Header */
  .jotb-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .jotb-header h1 {
    margin-bottom: 0.75rem;
  }

  .jotb-promise {
    font-size: 1.1rem;
    color: #5a6b40;
    margin: 0 auto;
    line-height: 1.6;
    max-width: 700px;
  }

  .jotb-start-here {
    margin-top: 0.5rem;
    font-size: 0.98rem;
    line-height: 1.35;
    opacity: 0.95;
    color: #5a6b40;
  }

  .jotb-start-here strong {
    font-weight: 700;
  }

  .jotb-first-step {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.35;
    opacity: 0.9;
  }

  .jotb-first-step strong {
    font-weight: 600;
  }

  .jotb-optional-note {
    margin: 0.35rem 0 0.9rem;
    font-size: 0.95rem;
    line-height: 1.35;
    opacity: 0.9;
  }

  /* Path SVG Container */
  .jotb-path-container {
    margin-bottom: 0;
  }

  .jotb-path-svg {
    max-width: 100%;
    height: auto;
  }

  /* Heading Row with Inline Arrow */
  .jotb-heading-row {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: 1rem;
  }

  .jotb-heading-arrow {
    width: 33px;
    height: auto;
    opacity: 0.8;
    flex: 0 0 auto;
    transform: translateY(-0.5em);
  }

  .jotb-heading-row h2 {
    margin: 0;
    color: var(--kbm-green, #52682d);
  }

  /* Bordered Sections (1 & 2) */
  .jotb-bordered-section {
    background: #ffffff;
    border: 1px solid #c7d8a4;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .jotb-section-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    align-items: flex-start;
  }

  .jotb-section-grid--mirrored {
    grid-template-columns: 320px 1fr;
  }

  .jotb-section-content p {
    margin: 0 0 1.25rem 0;
    line-height: 1.6;
    color: #4a5739;
  }

  .jotb-notes-title,
  .jotb-steps-title,
  .jotb-done-title {
    font-size: 1rem;
    font-weight: 600;
    color: #52682d;
    margin: 1.25rem 0 0.5rem 0;
  }

  .jotb-notes-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0;
    color: #4a5739;
  }

  .jotb-notes-list li {
    margin: 0.4rem 0;
    line-height: 1.5;
  }

  .jotb-steps-list {
    padding-left: 1.5rem;
    margin: 0;
    color: #4a5739;
  }

  .jotb-steps-list li {
    margin: 0.5rem 0;
    line-height: 1.5;
  }

  .jotb-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .jotb-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0.4rem 0;
    line-height: 1.5;
    color: #4a5739;
  }

  .jotb-check {
    color: #6e8b3d;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Action Column */
  .jotb-section-action {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  /* Video Thumbnail Card */
  .jotb-video-card {
    display: block;
    width: 100%;
    background: #ffffff;
    border: 1px solid #c7d8a4;
    border-radius: 10px;
    padding: 0;
    cursor: pointer;
    text-align: left;
    overflow: hidden;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .jotb-video-card:hover {
    border-color: #6e8b3d;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.15);
  }

  .jotb-video-card:focus {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .jotb-thumb-frame {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 */
    overflow: hidden;
    background: #e9eee0;
  }

  .jotb-thumb-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .jotb-play-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.25);
    transition: background 0.15s ease;
  }

  .jotb-video-card:hover .jotb-play-overlay {
    background: rgba(0, 0, 0, 0.35);
  }

  .jotb-play-icon {
    width: 56px;
    height: 56px;
    color: rgba(255, 255, 255, 0.9);
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.3));
    transition: transform 0.15s ease;
  }

  .jotb-video-card:hover .jotb-play-icon {
    transform: scale(1.1);
  }

  .jotb-card-label {
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .jotb-card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #52682d;
  }

  .jotb-card-helper {
    font-size: 0.8rem;
    color: #6b7a58;
    font-style: italic;
  }

  /* Practice Project Card (Section 3) */
  .jotb-practice-card {
    background: #f9faf7;
    border: 1px solid #d8e2cc;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.5rem;
  }

  .jotb-practice-heading {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .jotb-practice-leadin {
    font-size: 0.95rem;
    color: #6b7a58;
    margin: 0;
    font-weight: 500;
  }

  .jotb-practice-card .jotb-heading-row h2 {
    font-size: 1.4rem;
  }

  .jotb-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.5rem;
  }

  .jotb-cta-wrap .jotb-helper-text {
    margin-bottom: 0;
  }

  .jotb-practice-card p {
    margin: 0 0 1.25rem 0;
    line-height: 1.6;
    color: #4a5739;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .jotb-btn-primary {
    display: inline-block;
    background: #6e8b3d;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .jotb-btn-primary:hover {
    background-color: #52682d;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(82, 104, 45, 0.3);
  }

  .jotb-helper-text {
    font-size: 0.9rem;
    color: #6b7a58;
    margin-top: 0.75rem;
    font-style: italic;
  }

  /* Text Section (Section 4) */
  .jotb-text-section {
    margin-bottom: 2rem;
  }

  .jotb-text-section h2 {
    margin: 0 0 0.75rem 0;
    color: var(--kbm-green, #52682d);
  }

  .jotb-text-section p {
    margin: 0 0 1rem 0;
    line-height: 1.6;
    color: #4a5739;
  }

  .jotb-community-link {
    color: var(--kbm-green, #52682d);
    font-weight: 500;
    word-break: break-all;
  }

  .jotb-community-link:hover {
    text-decoration: underline;
  }

  /* ============================================
     VIDEO MODAL STYLES
     ============================================ */

  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .video-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .video-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    cursor: pointer;
  }

  .video-modal__dialog {
    position: relative;
    background: #ffffff;
    border-radius: 12px;
    width: 90%;
    max-width: 900px;
    max-height: 90vh;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .video-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .video-modal__header h2 {
    margin: 0;
    font-size: 1.1rem;
    color: #333;
  }

  .video-modal__close {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: #666;
    padding: 0.25rem;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .video-modal__close:hover {
    color: #333;
  }

  .video-modal__close:focus {
    outline: 2px solid #52682d;
    outline-offset: 2px;
  }

  .video-modal__body {
    padding: 0;
  }

  .video-frame {
    position: relative;
    padding-top: 56.25%; /* 16:9 aspect ratio */
    background: #000;
  }

  .video-frame::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border: 3px solid rgba(255, 255, 255, 0.2);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spinner-spin 0.8s linear infinite;
    z-index: 1;
  }

  @keyframes spinner-spin {
    to { transform: rotate(360deg); }
  }

  .video-frame iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    z-index: 2;
  }

  /* Body scroll lock */
  :global(body.modal-open) {
    overflow: hidden;
  }

  /* ============================================
     RESPONSIVE STYLES
     ============================================ */

  @media (max-width: 768px) {
    .jotb-page {
      padding: 1.5rem 1rem 3rem;
    }

    .jotb-section-grid,
    .jotb-section-grid--mirrored {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    /* On mobile, always show content first, then video card */
    .jotb-section-grid--mirrored .jotb-section-action {
      order: 2;
    }

    .jotb-section-grid--mirrored .jotb-section-content {
      order: 1;
    }

    .jotb-bordered-section {
      padding: 1.5rem;
    }

    .jotb-header h1 {
      font-size: 1.75rem;
    }

    .jotb-start-here {
      margin-top: 0.4rem;
      font-size: 0.95rem;
    }

    .jotb-first-step {
      margin-bottom: 0.4rem;
      font-size: 0.92rem;
    }

    .jotb-optional-note {
      margin: 0.3rem 0 0.75rem;
      font-size: 0.92rem;
    }

    .jotb-practice-card .jotb-heading-row h2 {
      font-size: 1.25rem;
    }

    .video-modal__dialog {
      width: 95%;
      max-height: 85vh;
    }
  }

  @media (max-width: 480px) {
    .jotb-play-icon {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var modal = document.getElementById('video-modal');
    var modalTitle = document.getElementById('video-modal-title');
    var videoFrame = document.getElementById('video-frame');
    var videoCards = document.querySelectorAll('.jotb-video-card');
    var closeButtons = modal ? modal.querySelectorAll('[data-close]') : [];
    
    var triggerButton = null;

    var videoSources = {
      setup: '<iframe src="https://player.vimeo.com/video/1149537564?badge=0&autopause=0&player_id=0&app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="thread-the-tension-mast"></iframe>',
      caston: '<iframe src="https://player.vimeo.com/video/151860058?badge=0&autopause=0&player_id=0&app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="E-Wrap Cast On"></iframe>'
    };

    function openModal(videoKey, title, trigger) {
      if (!modal || !videoFrame || !modalTitle) return;
      
      triggerButton = trigger;
      
      // Set dynamic title
      modalTitle.textContent = title;
      
      // Inject iframe
      videoFrame.innerHTML = videoSources[videoKey] || '';
      
      // Show modal
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-open');
      
      // Focus the close button
      var closeBtn = modal.querySelector('.video-modal__close');
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      if (!modal || !videoFrame || !modalTitle) return;
      
      // Hide modal
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('modal-open');
      
      // Clear iframe to stop playback
      videoFrame.innerHTML = '';
      
      // Reset title
      modalTitle.textContent = 'Video';
      
      // Restore focus to trigger button
      if (triggerButton) triggerButton.focus();
      triggerButton = null;
    }

    // Video card click handlers
    videoCards.forEach(function(card) {
      card.addEventListener('click', function() {
        var videoKey = card.getAttribute('data-video') || '';
        var title = card.getAttribute('data-title') || 'Video';
        openModal(videoKey, title, card);
      });
    });

    // Close button and backdrop click handlers
    closeButtons.forEach(function(el) {
      el.addEventListener('click', closeModal);
    });

    // ESC key handler
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && modal.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }
    });
  });
</script>
