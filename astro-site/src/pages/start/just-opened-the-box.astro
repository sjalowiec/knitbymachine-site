---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Just Opened the Box | Knit by Machine';
const pageDescription = 'Your first steps after unboxing your knitting machine. Thread the mast, choose a machine-friendly yarn, and try an e-wrap cast on — your first step toward fabric.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="jotb-page">
    <!-- Breadcrumb -->
    <nav class="jotb-breadcrumb" aria-label="Breadcrumb" data-testid="nav-breadcrumb">
      <a href="/" data-testid="link-back-home">&larr; Back to Home</a>
    </nav>

    <div class="jotb-layout">
      <!-- Main Content Column -->
      <div class="jotb-main">
        <!-- Page Header -->
        <header class="jotb-header">
          <h1 data-testid="text-page-title">Just Opened the Box…</h1>
          <p class="jotb-promise" data-testid="text-promise">
            You're about to take your first real step with your knitting machine — no overwhelm, just clear next moves.
          </p>
        </header>

        <!-- SECTION 1: Get Your Machine Ready -->
        <section id="ready" class="jotb-section" data-testid="section-ready">
          <h2 data-testid="text-section-1-title">Machine mounted. Mast in place. Ready to thread.</h2>
          <p>
            Before you cast on, choose a machine-friendly yarn, thread the mast, and try an e-wrap cast on — your first step toward fabric.
          </p>

          <!-- Video Card -->
          <div class="jotb-card jotb-card--video" data-testid="card-video-ready">
            <h3 class="jotb-card-title">Watch: Setting Up Your Machine</h3>
            <div class="jotb-embed-placeholder" data-testid="embed-placeholder-ready">
             <div style="padding:56.25% 0 0 0;position:relative;"><iframe src="https://player.vimeo.com/video/1149537564?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="thread-the-tension-mast"></iframe></div>
            </div>
          </div>

          <!-- Quick Notes -->
          <div class="jotb-card jotb-card--notes" data-testid="card-quick-notes">
            <h3 class="jotb-card-title">Quick Notes</h3>
            <ul class="jotb-notes-list">
              <li data-testid="note-threading">Appropriate yarn for your machine</li>
              <li data-testid="note-yarn">Triangle Yarn Guide</li>
              <li data-testid="note-snag">Mast Tension Dial</li>
              <li data-testid="note-snag">Loop in front Yarn Feeder</li>
              <li data-testid="note-snag">Thread the Takeup Spring</li>
               <li data-testid="note-snag">Secure in the clip</li>

            </ul>
          </div>
        </section>

        <!-- SECTION 2: Try It Now - Your First Cast On -->
        <section id="caston" class="jotb-section" data-testid="section-caston">
          <h2 data-testid="text-section-2-title">Try It Now — Your First Cast On (Free Practice)</h2>
          <p>
            This is your hands-on moment. Follow along and you'll have stitches on your machine in minutes.
          </p>

          <!-- Skill Builder Lite Card -->
          <div class="jotb-card jotb-card--skillbuilder" data-testid="card-skillbuilder">
            <h3 class="jotb-card-title">Skill Builder Lite: First Cast On</h3>
            
            <!-- Video Embed Placeholder -->
            <div class="jotb-embed-placeholder" data-testid="embed-placeholder-caston">
             <div style="padding:75% 0 0 0;position:relative;"><iframe src="https://player.vimeo.com/video/151860058?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="E-Wrap Cast On"></iframe></div>
            </div>

            <!-- Numbered Steps -->
            <h4>Steps to Follow:</h4>
            <ol class="jotb-steps-list" data-testid="list-steps">
              <li>Set your carriage to the right</li>
              <li>Pull out a few needles</li>
              <li>Working left to right, e-wrap each needle (or every other needle)</li>
              <li>Thread the carriage</li>
              <li>Knit a few rows</li>
             </ol>

            <!-- You're Done When Checklist -->
            <h4>You're Done When…</h4>
            <ul class="jotb-checklist" data-testid="list-done-checklist">
              <li>
                <span class="jotb-check" aria-hidden="true">&#10003;</span>
                All needles have stitches on them
              </li>
              <li>
                <span class="jotb-check" aria-hidden="true">&#10003;</span>
                Your fabric hangs evenly with weights attached
              </li>
              <li>
                <span class="jotb-check" aria-hidden="true">&#10003;</span>
                You can knit 5+ rows without dropped stitches
              </li>
            </ul>
          </div>
        </section>

        <!-- SECTION 3: Optional - 5-Day Challenge -->
        <section id="challenge" class="jotb-section" data-testid="section-challenge">
          <h2 data-testid="text-section-3-title">Optional — 5-Day Cast On + Bind Off Challenge (Paid)</h2>
          <p>
            Want a little more structure? This optional challenge breaks down the cast on and bind off into short daily sessions — perfect if you like a guided pace.
          </p>

          <a href="#" class="jotb-btn-primary" data-testid="button-challenge">
            See the 5-Day Challenge
          </a>
          <p class="jotb-helper-text" data-testid="text-helper">
            Short daily practice. Clear steps. No overwhelm.
          </p>
        </section>
      </div>

      <!-- Sticky Mini-Nav (Desktop) -->
      <aside class="jotb-sidebar" data-testid="nav-sidebar">
        <nav class="jotb-mini-nav" aria-label="On this page">
          <h3 class="jotb-mini-nav-title">On This Page</h3>
          <ul>
            <li><a href="#ready" data-testid="nav-link-ready">Get Your Machine Ready</a></li>
            <li><a href="#caston" data-testid="nav-link-caston">Your First Cast On</a></li>
            <li><a href="#challenge" data-testid="nav-link-challenge">5-Day Challenge</a></li>
          </ul>
        </nav>
      </aside>
    </div>

    <!-- Mobile Mini-Nav (shown at top on mobile) -->
    <nav class="jotb-mobile-nav" aria-label="On this page" data-testid="nav-mobile">
      <span class="jotb-mobile-nav-label">Jump to:</span>
      <a href="#ready">Ready</a>
      <a href="#caston">Cast On</a>
      <a href="#challenge">Challenge</a>
    </nav>
  </div>
</BaseLayout>

<style>
  /* ============================================
     Just Opened the Box - Scoped Page Styles
     ============================================ */

  .jotb-page {
    max-width: var(--max-content-width, 1100px);
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  /* Breadcrumb */
  .jotb-breadcrumb {
    margin-bottom: 1.5rem;
  }

  .jotb-breadcrumb a {
    color: var(--kbm-green, #52682d);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .jotb-breadcrumb a:hover {
    text-decoration: underline;
  }

  /* Two-column Layout */
  .jotb-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 3rem;
    align-items: flex-start;
  }

  .jotb-main {
    min-width: 0;
  }

  /* Page Header */
  .jotb-header {
    margin-bottom: 2.5rem;
  }

  .jotb-header h1 {
    margin-bottom: 0.75rem;
  }

  .jotb-promise {
    font-size: 1.1rem;
    color: #5a6b40;
    margin: 0;
    line-height: 1.6;
  }

  /* Sections */
  .jotb-section {
    margin-bottom: 3rem;
    scroll-margin-top: calc(var(--header-height, 6rem) + 1rem);
  }

  .jotb-section h2 {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #c7d8a4;
  }

  /* Cards */
  .jotb-card {
    background: #ffffff;
    border: 1px solid #c7d8a4;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 1.25rem 0;
  }

  .jotb-card-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--kbm-green, #52682d);
    margin: 0 0 1rem 0;
  }

  /* Embed Placeholder */
  .jotb-embed-placeholder {
    padding: 1rem 0;
    text-align: center;
    color: #6b7a58;
    font-size: 0.95rem;
    font-style: italic;
    margin-bottom: 1rem;
  }

  /* Quick Notes List */
  .jotb-notes-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0;
    color: #4a5739;
  }

  .jotb-notes-list li {
    margin: 0.5rem 0;
    line-height: 1.5;
  }

  /* Steps List */
  .jotb-steps-list {
    padding-left: 1.5rem;
    margin: 1rem 0 1.5rem;
    color: #4a5739;
  }

  .jotb-steps-list li {
    margin: 0.6rem 0;
    line-height: 1.5;
  }

  /* Checklist */
  .jotb-checklist {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .jotb-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0.5rem 0;
    line-height: 1.5;
    color: #4a5739;
  }

  .jotb-check {
    color: #6e8b3d;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Primary Button */
  .jotb-btn-primary {
    display: inline-block;
    background: #6e8b3d;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .jotb-btn-primary:hover {
    background-color: #52682d;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(82, 104, 45, 0.3);
  }

  /* Helper Text */
  .jotb-helper-text {
    font-size: 0.9rem;
    color: #6b7a58;
    margin-top: 0.75rem;
    font-style: italic;
  }

  /* Sidebar / Mini-Nav */
  .jotb-sidebar {
    position: sticky;
    top: calc(var(--header-height, 6rem) + 1.5rem);
  }

  .jotb-mini-nav {
    background: #f5f7f2;
    border: 1px solid #d8e2cc;
    border-radius: 10px;
    padding: 1.25rem;
  }

  .jotb-mini-nav-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7a58;
    margin: 0 0 0.75rem 0;
  }

  .jotb-mini-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .jotb-mini-nav li {
    margin: 0.5rem 0;
  }

  .jotb-mini-nav a {
    color: var(--kbm-green, #52682d);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    display: block;
    padding: 0.3rem 0;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .jotb-mini-nav a:hover {
    border-left-color: #6e8b3d;
    color: #6e8b3d;
  }

  /* Mobile Mini-Nav */
  .jotb-mobile-nav {
    display: none;
    background: #f5f7f2;
    border: 1px solid #d8e2cc;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .jotb-mobile-nav-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #6b7a58;
  }

  .jotb-mobile-nav a {
    color: var(--kbm-green, #52682d);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: #e9ece7;
  }

  .jotb-mobile-nav a:hover {
    background: #d8e2cc;
  }

  /* Responsive: Tablet and below */
  @media (max-width: 900px) {
    .jotb-layout {
      grid-template-columns: 1fr;
    }

    .jotb-sidebar {
      display: none;
    }

    .jotb-mobile-nav {
      display: flex;
    }
  }

  /* Responsive: Mobile */
  @media (max-width: 600px) {
    .jotb-page {
      padding: 1.5rem 1rem 3rem;
    }

    .jotb-header h1 {
      font-size: 1.75rem;
    }

    .jotb-card {
      padding: 1.25rem;
    }

    .jotb-embed-placeholder {
      padding: 2rem 1rem;
    }

    .jotb-section {
      margin-bottom: 2.5rem;
    }
  }
</style>
