---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/wizard.css';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const agents = await getCollection('ai-agents');
  
  return agents
    .filter(agent => !agent.data.isDraft)
    .map(agent => ({
      params: { slug: agent.data.slug },
      props: { agent }
    }));
}

// Use props.agent from getStaticPaths to guarantee alignment
const { agent } = Astro.props;
const url = Astro.url;
const data = agent.data;

// Mode logic
const fromParam = url.searchParams.get('from');
const forcedOnboarding = fromParam === 'home' || fromParam === 'onboarding';
const onboardingMode = forcedOnboarding || data.onboardingMode === true;

// Derived text values
const pageTitle = data.title;
const subheading = onboardingMode
  ? (data.onboardingIntroTitle ?? data.excerpt ?? '')
  : (data.toolSubheading ?? data.excerpt ?? '');
const metaTitle = data.metaTitle ?? pageTitle;
const metaDescription = data.metaDescription ?? data.excerpt ?? '';
const primaryCtaLabel = `Start ${pageTitle}`;
const hasVideo = Boolean(data.videoUrl);
const hasRelatedGuides = Array.isArray(data.relatedGuides) && data.relatedGuides.length > 0;

// Check if any overview panels should be shown
const hasWhoThisIsFor = data.whoThisIsFor && data.whoThisIsFor.length > 0;
const hasWhyItMatters = Boolean(data.whyItMatters);
const hasBenefits = data.benefits && data.benefits.length > 0;
const hasOverviewContent = hasWhoThisIsFor || hasWhyItMatters || hasBenefits;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <main class="kbm-page kbm-agent-landing">
    
    <!-- 1. Hero Section -->
    <section class="kbm-hero kbm-hero--agent">
      <div class="kbm-hero__content">
        <p class="kbm-eyebrow">Smart Guide · AI Agent</p>
        <h1 class="kbm-hero__title">{pageTitle}</h1>
        {subheading && <p class="kbm-hero__subtitle">{subheading}</p>}

        {onboardingMode && (
          <div class="kbm-hero__reassurance">
            <h2>You don't have to figure this out alone.</h2>
            <p>
              {data.onboardingIntroBody ?? "This Smart Guide will ask you simple questions and help you decide what to do next at the machine."}
            </p>
          </div>
        )}

        <div class="kbm-hero__ctas">
          <a href="#agent-engine" class="kbm-button kbm-button--primary">
            {primaryCtaLabel}
          </a>
          {data.showSecondaryCta !== false && (
            <a href="/wizards-catalog?category=smart%20guide" class="kbm-button kbm-button--ghost">
              See all Smart Guides
            </a>
          )}
        </div>

        {onboardingMode && (
          <p class="kbm-hero__small-note">
            When you're ready, click "Start" and I'll walk you through this one clear step at a time.
          </p>
        )}
      </div>

      {hasVideo && (
        <div class="kbm-hero__media">
          <div class="kbm-video-embed">
            <iframe
              src={data.videoUrl}
              title={`${pageTitle} overview video`}
              loading="lazy"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      )}
    </section>

    <!-- 2. Overview: who / why / what (only show if any panels have content) -->
    {hasOverviewContent && (
      <section class="kbm-section kbm-section--agent-overview">
        <div class="kbm-section__grid">
          {hasWhoThisIsFor && (
            <div class="kbm-panel">
              <h2>Who this is for</h2>
              <ul>
                {data.whoThisIsFor!.map((item: string) => <li>{item}</li>)}
              </ul>
            </div>
          )}

          {hasWhyItMatters && (
            <div class="kbm-panel">
              <h2>Why this Smart Guide matters</h2>
              <p>{data.whyItMatters}</p>
            </div>
          )}

          {hasBenefits && (
            <div class="kbm-panel">
              <h2>What this Smart Guide will walk you through</h2>
              <ul>
                {data.benefits!.map((benefit: string) => <li>{benefit}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 3. Optional related guides -->
    {hasRelatedGuides && (
      <section class="kbm-section kbm-section--related">
        <header class="kbm-section__header">
          <h2>Related Smart Guides</h2>
          <p>Keep building your confidence, one small win at a time.</p>
        </header>
        <ul class="kbm-related-list">
          {data.relatedGuides!.map((guideSlug: string) => (
            <li>
              <a href={`/ai-agents/${guideSlug}`}>{guideSlug.replace(/-/g, ' ')}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 4. Mid-page CTA -->
    <section class="kbm-section kbm-section--cta">
      <div class="kbm-section__inner">
        <h2>Ready to start?</h2>
        <p>Click the button below and follow the prompts. You can pause, take notes, or print your plan when you're done.</p>
        <a href="#agent-engine" class="kbm-button kbm-button--primary">
          {primaryCtaLabel}
        </a>
      </div>
    </section>

    <!-- 5. Agent engine / iframe -->
    <section id="agent-engine" class="kbm-section kbm-section--engine">
      <div class="kbm-section__inner">
        <h2 class="kbm-visually-hidden">Smart Guide</h2>

        {data.iframeUrl ? (
          <iframe
            src={data.iframeUrl}
            title={pageTitle}
            style={`width: 100%; border: 0; height: ${data.iframeHeight ?? '700'}px;`}
            loading="lazy"
          ></iframe>
        ) : data.htmlContent ? (
          <div class="kbm-agent-html" set:html={data.htmlContent}></div>
        ) : (
          <div class="kbm-engine-placeholder">
            This is where the interactive agent will appear.
          </div>
        )}
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* Agent Landing Page Styles */
  .kbm-agent-landing {
    padding-top: 100px;
    background: var(--page-bg, #fafaf8);
  }

  /* Hero Section */
  .kbm-hero--agent {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .kbm-hero--agent {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      padding: 3rem 2rem 4rem;
    }
  }

  .kbm-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kbm-hero__title {
    color: var(--kbm-green, #52682D);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .kbm-hero__subtitle {
    color: #6b7280;
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
    line-height: 1.6;
    margin: 0;
  }

  .kbm-hero__reassurance {
    background: rgba(82, 104, 45, 0.08);
    border-left: 4px solid var(--kbm-green, #52682D);
    padding: 1.25rem;
    border-radius: 0 8px 8px 0;
    margin: 0.5rem 0;
  }

  .kbm-hero__reassurance h2 {
    color: var(--kbm-green, #52682D);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .kbm-hero__reassurance p {
    color: #374151;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .kbm-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .kbm-hero__small-note {
    color: #6b7280;
    font-size: 0.9rem;
    font-style: italic;
    margin: 0.5rem 0 0 0;
  }

  .kbm-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Video Embed */
  .kbm-video-embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    border-radius: 12px;
    overflow: hidden;
    background: #1a1a1a;
  }

  .kbm-video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Agent Overview Section */
  .kbm-section--agent-overview {
    background: white;
    padding: 3rem 1.5rem;
  }

  .kbm-section__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .kbm-section__grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  .kbm-panel {
    background: #f9fdf5;
    border: 1px solid #e5e8e0;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .kbm-panel h2 {
    color: var(--kbm-green, #52682D);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
  }

  .kbm-panel p {
    color: #374151;
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  .kbm-panel ul {
    margin: 0;
    padding-left: 1.25rem;
    color: #374151;
  }

  .kbm-panel li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .kbm-panel li:last-child {
    margin-bottom: 0;
  }

  /* Related Guides Section */
  .kbm-section--related {
    padding: 3rem 1.5rem;
    background: var(--page-bg, #fafaf8);
  }

  .kbm-section__header {
    max-width: 1100px;
    margin: 0 auto 1.5rem;
    text-align: center;
  }

  .kbm-section__header h2 {
    color: var(--kbm-green, #52682D);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
  }

  .kbm-section__header p {
    color: #6b7280;
    font-size: 1rem;
    margin: 0;
  }

  .kbm-related-list {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    padding: 0;
    justify-content: center;
  }

  .kbm-related-list li a {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    background: white;
    border: 2px solid #e5e8e0;
    border-radius: 8px;
    color: var(--kbm-green, #52682D);
    text-decoration: none;
    font-weight: 500;
    text-transform: capitalize;
    transition: all 0.2s ease;
  }

  .kbm-related-list li a:hover {
    border-color: var(--kbm-green, #52682D);
    background: rgba(82, 104, 45, 0.05);
    transform: translateY(-2px);
  }

  /* Mid-page CTA Section */
  .kbm-section--cta {
    background: rgba(82, 104, 45, 0.08);
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .kbm-section--cta .kbm-section__inner {
    max-width: 700px;
  }

  .kbm-section--cta h2 {
    color: var(--kbm-green, #52682D);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.75rem 0;
  }

  .kbm-section--cta p {
    color: #374151;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  /* Engine Section */
  .kbm-section--engine {
    padding: 3rem 1.5rem 4rem;
    background: white;
  }

  .kbm-section--engine .kbm-section__inner {
    max-width: 900px;
  }

  .kbm-section--engine iframe {
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .kbm-agent-html {
    background: #f9fdf5;
    border: 1px solid #e5e8e0;
    border-radius: 12px;
    padding: 2rem;
    color: #374151;
    line-height: 1.7;
  }

  .kbm-engine-placeholder {
    background: #f3f4f6;
    border: 2px dashed #d1d5db;
    border-radius: 12px;
    padding: 4rem 2rem;
    text-align: center;
    color: #6b7280;
    font-size: 1.1rem;
  }

  /* Visually Hidden (for screen readers) */
  .kbm-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile Responsive */
  @media (max-width: 767px) {
    .kbm-agent-landing {
      padding-top: 80px;
    }

    .kbm-hero--agent {
      padding: 1.5rem 1rem 2rem;
    }

    .kbm-hero__ctas {
      flex-direction: column;
    }

    .kbm-hero__ctas .kbm-button {
      width: 100%;
      text-align: center;
      justify-content: center;
    }

    .kbm-section--agent-overview,
    .kbm-section--related,
    .kbm-section--cta,
    .kbm-section--engine {
      padding: 2rem 1rem;
    }

    .kbm-panel {
      padding: 1.25rem;
    }
  }
</style>
