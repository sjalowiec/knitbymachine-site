---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Project Inspiration Session · Knit by Machine';
const pageDescription = 'A calm space to walk through your Project Inspiration session and choose one small, do-able machine knitting project idea.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50">
    <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col gap-6 px-4 py-12 sm:py-16">
      <!-- Header -->
      <header class="space-y-3 text-center">
        <!-- Small overline -->
        <p class="text-xs font-semibold uppercase tracking-wide text-[#6E8B3D]" data-testid="text-overline">
          Ready ● Set ● Knit
        </p>
        <!-- Main title -->
        <h1 class="text-3xl font-semibold text-slate-900 sm:text-4xl" data-testid="text-page-title">
          Your Project Inspiration Session
        </h1>
        <!-- Short intro -->
        <p class="text-sm text-slate-600 sm:text-base" data-testid="text-intro">
          You're in the right place. This short session will help you choose one small, do-able project idea based on your machine and how you're feeling about getting started.
        </p>
      </header>

      <!-- Helper container -->
      <section
        aria-label="Project Inspiration helper"
        class="rounded-2xl bg-white p-5 shadow-md sm:p-6"
        data-testid="section-helper"
      >
        <h2 class="mb-2 text-base font-semibold text-slate-900">
          Start your Project Inspiration
        </h2>
        <p class="mb-4 text-sm text-slate-600">
          Answer a few simple questions below. At the end, you'll get a gentle, realistic project idea you can feel good about starting.
        </p>

        <!-- EMBED CONTAINER: I will paste my agent/wizard embed here -->
        <div
          id="project-inspiration-embed"
          class="min-h-[320px] rounded-xl border border-slate-200 bg-slate-50/60 p-3 sm:p-4"
          data-testid="container-project-inspiration-embed"
        >
          <p class="text-xs text-slate-400">
            The Project Inspiration experience will appear here once I paste the embed code.
          </p>
        </div>
      </section>

      <!-- Gentle footer note -->
      <section class="border-t border-slate-200 pt-4 text-center text-xs text-slate-500" data-testid="section-footer-note">
        <p>
          You can always return to this page using the link in your email.
        </p>
      </section>
    </section>
  </main>
</BaseLayout>
