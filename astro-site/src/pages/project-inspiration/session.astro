---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Project Inspiration Session · Knit by Machine';
const pageDescription = 'A calm space to walk through your Project Inspiration session and choose one small, do-able machine knitting project idea.';
---

<style>
  /* Session Page Layout */
  .pi-session {
    background: #f8faf6;
    min-height: 100vh;
    padding-top: 100px;
  }

  .pi-session-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
  }

  /* Header */
  .pi-session-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .pi-session-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6E8B3D;
    margin: 0 0 0.75rem 0;
  }

  .pi-session-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: #1e293b;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .pi-session-title {
      font-size: 2.25rem;
    }
  }

  .pi-session-intro {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 640px) {
    .pi-session-intro {
      font-size: 1rem;
    }
  }

  /* Agent Embed Wrapper - main card */
  .agent-embed-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    height: 75vh;
    min-height: 600px;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #e0e4ea;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    background: #fff;
  }

  .agent-embed-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Footer Note */
  .pi-session-footer {
    text-align: center;
    border-top: 1px solid #e2e8f0;
    padding-top: 1.25rem;
    margin-top: 2rem;
  }

  .pi-session-footer p {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .pi-session {
      padding-top: 80px;
    }

    .pi-session-inner {
      padding: 1.5rem 1rem 2rem;
    }

    .agent-embed-wrapper {
      height: 70vh;
      min-height: 500px;
      border-radius: 12px;
    }
  }
</style>

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="pi-session">
    <section class="pi-session-inner">
      
      <!-- Header -->
      <header class="pi-session-header">
        <p class="pi-session-eyebrow" data-testid="text-overline">
          Ready ● Set ● Knit
        </p>
        <h1 class="pi-session-title" data-testid="text-page-title">
          Your Project Inspiration Session
        </h1>
        <p class="pi-session-intro" data-testid="text-intro">
          You're in the right place. This short session will help you choose one small, do-able project idea based on your machine and how you're feeling about getting started.
        </p>
      </header>

      <!-- Agent Embed -->
      <div class="agent-embed-wrapper" data-testid="container-project-inspiration-embed">
        <iframe 
          src="https://chatbot.getmindpal.com/ready-set-knit-projects-zx1"
          allow="clipboard-read; clipboard-write; microphone"
          class="agent-embed-iframe"
          title="Ready Set Knit Project Inspiration"
        ></iframe>
      </div>

      <!-- Footer Note -->
      <footer class="pi-session-footer" data-testid="section-footer-note">
        <p>
          You can always return to this page using the link in your email.
        </p>
      </footer>

    </section>
  </main>
</BaseLayout>
