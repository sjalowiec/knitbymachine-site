---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/global.css";

const { slug } = Astro.params;

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
const REPO_OWNER = 'sjalowiec';
const REPO_NAME = 'knitbymachine-site';
const CONTENT_PATH = 'astro-site/src/content/workshops';

async function getWorkshopEntry(slug: string) {
  try {
    const response = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${CONTENT_PATH}/${slug}.json`,
      {
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'knitbymachine-astro'
        }
      }
    );

    if (!response.ok) {
      return null;
    }

    const data = await response.json();
    const binaryString = atob(data.content);
    const bytes = Uint8Array.from(binaryString, char => char.charCodeAt(0));
    const content = new TextDecoder('utf-8').decode(bytes);
    const jsonData = JSON.parse(content);

    if (jsonData.isDraft || jsonData.pendingPublish) {
      return null;
    }

    return {
      data: jsonData,
      slug: slug
    };
  } catch (error) {
    console.error('Error fetching workshop entry:', error);
    return null;
  }
}

const entry = await getWorkshopEntry(slug);

if (!entry) {
  return Astro.redirect('/404');
}

const workshop = entry.data;

const CATEGORY_LABELS = {
  learn: { label: 'Learn', color: '#4a90a4' },
  knit: { label: 'Knit', color: '#738c52' },
  other: { label: 'Other', color: '#8b7355' }
};

const categoryInfo = CATEGORY_LABELS[workshop.category] || CATEGORY_LABELS.other;

const title = workshop.metaTitle || `${workshop.title} | Knit by Machine Workshops`;
const description = workshop.metaDescription || workshop.tagline || workshop.shortDescription || workshop.description?.slice(0, 150);
const ctaLabel = workshop.ctaLabel || "Watch the Workshop";
---

<BaseLayout {title} {description}>
  <div class="workshop-sales-page">
    
    <!-- Hero Section -->
    <section class="workshop-hero">
      <div class="hero-content">
        <span class="category-label" style={`background-color: ${categoryInfo.color}`}>
          {categoryInfo.label}
        </span>
        
        <h1 class="workshop-title" data-testid="text-workshop-title">{workshop.title}</h1>
        
        {workshop.tagline && (
          <p class="workshop-tagline">{workshop.tagline}</p>
        )}
        
        {workshop.imageUrl && (
          <div class="hero-image-wrapper">
            <img 
              src={workshop.imageUrl} 
              alt={workshop.imageAlt || workshop.title} 
              class="hero-image"
              loading="eager"
            />
          </div>
        )}
        
        <div class="hero-cta">
          <a href={`/studio-sessions/${slug}/watch`} class="cta-button primary" data-testid="link-watch-workshop">
            {ctaLabel}
          </a>
          {workshop.ctaNote && (
            <p class="cta-note">{workshop.ctaNote}</p>
          )}
        </div>
      </div>
    </section>

    <!-- What This Workshop Is About -->
    <section class="workshop-section about-section">
      <div class="section-inner">
        <h2 class="section-heading">What This Workshop Is About</h2>
        <div class="description-content">
          <Fragment set:html={workshop.description} />
        </div>
      </div>
    </section>

    <!-- You'll Be Able To... -->
    {workshop.learningOutcomes && workshop.learningOutcomes.length > 0 && (
      <section class="workshop-section outcomes-section">
        <div class="section-inner">
          <h2 class="section-heading">You'll Be Able To...</h2>
          <ul class="outcomes-list">
            {workshop.learningOutcomes.map((outcome: string) => (
              <li>
                <span class="check-icon">✓</span>
                {outcome}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Who This Workshop Is For -->
    {workshop.whoFor && workshop.whoFor.length > 0 && (
      <section class="workshop-section who-for-section">
        <div class="section-inner">
          <h2 class="section-heading">Who This Workshop Is For</h2>
          <ul class="who-for-list">
            {workshop.whoFor.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- What You Need -->
    {workshop.materials && workshop.materials.length > 0 && (
      <section class="workshop-section materials-section">
        <div class="section-inner">
          <h2 class="section-heading">What You Need</h2>
          <ul class="materials-list">
            {workshop.materials.map((material: string) => (
              <li>{material}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Related Tools & Links -->
    {workshop.relatedLinks && workshop.relatedLinks.length > 0 && (
      <section class="workshop-section related-section">
        <div class="section-inner">
          <h2 class="section-heading">Related Tools & Links</h2>
          <ul class="related-links-list">
            {workshop.relatedLinks.map((link: { label: string; url: string }) => (
              <li>
                <a href={link.url} class="related-link">
                  <span class="arrow-icon">→</span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- About the Instructor -->
    <section class="workshop-section instructor-section">
      <div class="section-inner">
        <h2 class="section-heading">About the Instructor</h2>
        <p class="instructor-bio">
          Sue from Knit by Machine brings decades of machine knitting experience to every workshop. 
          Her teaching style combines clear step-by-step instruction with practical tips that help 
          you build confidence and expand your skills.
        </p>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="workshop-section bottom-cta-section">
      <div class="section-inner">
        <a href={`/studio-sessions/${slug}/watch`} class="cta-button primary large" data-testid="link-watch-bottom">
          {ctaLabel}
        </a>
        <a href="/studio-sessions" class="back-to-catalog">← Back to All Studio Sessions</a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .workshop-sales-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 140px 20px 60px;
  }

  /* Hero Section */
  .workshop-hero {
    text-align: center;
    padding: 40px 0 60px;
    border-bottom: 1px solid #e5e8e0;
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .category-label {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 20px;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .workshop-title {
    font-family: 'Poppins', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #52682d;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .workshop-tagline {
    font-size: 1.25rem;
    color: #5a5a5a;
    margin: 0 0 32px;
    line-height: 1.5;
  }

  .hero-image-wrapper {
    margin: 32px 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-cta {
    margin-top: 32px;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 40px;
    background: #52682d;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  .cta-button:hover {
    background: #738c52;
    transform: translateY(-2px);
  }

  .cta-button.large {
    padding: 18px 48px;
    font-size: 1.2rem;
  }

  .cta-note {
    font-size: 0.9rem;
    color: #888;
    margin-top: 12px;
  }

  /* Section Styling */
  .workshop-section {
    padding: 48px 0;
    border-bottom: 1px solid #e5e8e0;
  }

  .workshop-section:last-child {
    border-bottom: none;
  }

  .section-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .section-heading {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #52682d;
    margin: 0 0 24px;
  }

  .description-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #444;
  }

  .description-content p {
    margin-bottom: 16px;
  }

  /* Outcomes List */
  .outcomes-section {
    background: #f7f8f5;
  }

  .outcomes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .outcomes-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    font-size: 1.05rem;
    color: #444;
  }

  .check-icon {
    color: #738c52;
    font-weight: bold;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  /* Who For List */
  .who-for-list {
    list-style: disc;
    padding-left: 24px;
    margin: 0;
  }

  .who-for-list li {
    padding: 8px 0;
    font-size: 1.05rem;
    color: #444;
  }

  /* Materials List */
  .materials-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .materials-list li {
    padding: 10px 16px;
    background: #f7f8f5;
    border-radius: 8px;
    margin-bottom: 8px;
    font-size: 1rem;
    color: #444;
  }

  /* Related Links */
  .related-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .related-links-list li {
    margin-bottom: 8px;
  }

  .related-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #52682d;
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .related-link:hover {
    color: #738c52;
  }

  .arrow-icon {
    font-size: 1.1rem;
  }

  /* Instructor Section */
  .instructor-bio {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #5a5a5a;
    margin: 0;
  }

  /* Bottom CTA */
  .bottom-cta-section {
    text-align: center;
    padding: 60px 0;
    background: #f7f8f5;
    border-radius: 12px;
    margin-top: 40px;
  }

  .back-to-catalog {
    display: block;
    margin-top: 20px;
    color: #52682d;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .back-to-catalog:hover {
    color: #738c52;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .workshop-sales-page {
      padding: 120px 16px 40px;
    }

    .workshop-title {
      font-size: 1.8rem;
    }

    .workshop-tagline {
      font-size: 1.1rem;
    }

    .cta-button {
      padding: 14px 32px;
      font-size: 1rem;
    }

    .cta-button.large {
      padding: 16px 36px;
      font-size: 1.1rem;
    }

    .section-heading {
      font-size: 1.3rem;
    }

    .workshop-section {
      padding: 36px 0;
    }
  }
</style>
