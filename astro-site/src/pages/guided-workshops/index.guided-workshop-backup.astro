---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Guided Workshop with Sue | Knit by Machine";
const description = "A hands-on, personal workshop designed to help you make real progress on a project you’re excited about—at a pace that feels calm and doable.";
---

<BaseLayout {title} {description}>
  <main class="page page--guided-workshop">
    
    <!-- Hero Section -->
    <section class="section section--hero">
      <div class="section-inner">
        <div class="grid grid--two hero-grid">
          <div class="hero-left">
            <div class="hero-header">
              <div class="hero-title-row">
                <img
                  src="/images/guided_workshops.svg"
                  alt="Guided Workshops logo"
                  class="hero-logo"
                />
                <h1 data-testid="text-page-title">Guided Workshop with Sue</h1>
              </div>
              <p class="hero-subtitle">
                A hands-on, personal workshop designed to help you make real progress on a project you're excited about—at a pace that feels calm and doable.
              </p>
            </div>

          </div>
          <div class="hero-right">
            <!-- HERO IMAGE PLACEHOLDER -->
            <!-- TODO: Replace the placeholder image below with a real photo:
                - Sue at a knitting machine, or
                - a clean, inviting machine setup
            -->
            <div class="hero-media">
              <div class="placeholder-image">
                <span>Hero Image Placeholder</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-cta">
          <a 
            class="button button--primary" 
            href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
            data-testid="button-cta-hero"
          >
            Start Your Guided Workshop
          </a>

          <div class="how-it-works-link">
            <a href="#" data-modal-open="how-it-works">How does this workshop work?</a>
          </div>
        </div>

        <p class="hero-note">
          Your 10 days start when you submit your Project Planner—no calls, no time zones, just clear written guidance.
        </p>
      </div>
    </section>
    <hr class="kbm-divider" />

    <!-- Problem / Fit Section -->
    <section class="section section--problem">
      <div class="section-inner">
        <h2>If your machine has been sitting quietly…</h2>
        <p>
          …and you're not sure what to knit next — or how to start without messing
          things up — this is for you.
        </p>
        <div class="grid grid--two">
          <div>
            <h3>
              <i class="fa-solid fa-xmark fa-lg fit-icon"></i>
              You don't need:
            </h3>
            <ul>
              <li>Another giant course</li>
              <li>Endless YouTube rabbit holes</li>
              <li>Weekly Zoom calls</li>
              <li>A basket of half-finished projects</li>
            </ul>
          </div>
          <div>
            <h3>
              <i class="fa-solid fa-check fa-lg fit-icon"></i>
              You do need:
            </h3>
            <ul>
              <li>A clear project choice</li>
              <li>A simple, realistic plan</li>
              <li>One small step at a time</li>
              <li>Expert eyes when it matters</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Overview Cards Section -->
    <section class="section section--overview-cards">
      <div class="section-inner">
        <h2>How this workshop works at a glance</h2>

        <div class="workshop-overview-grid">
          <!-- Card 1 -->
          <div class="workshop-card">
            <h3>What this is</h3>
            <ul>
              <li>A 10-day, call-free, 1-1 workshop focused on one real project.</li>
              <li>No Zoom calls or scheduling — everything happens through simple written check-ins.</li>
              <li>You choose the project you want to work on.</li>
              <li>A calm, steady plan tailored to your machine, yarn, and time.</li>
            </ul>
          </div>

          <!-- Card 2 -->
          <div class="workshop-card">
            <h3>How it works</h3>
            <ul>
              <li>Start by filling out the Ready • Set • Knit Project Planner.</li>
              <li>I send your personalized 10-day plan with clear, realistic steps.</li>
              <li>You check in with quick notes or photos when you're ready.</li>
              <li>I reply with corrections, encouragement, and your next step.</li>
              <li>No calls. No camera. No time zone issues.</li>
            </ul>
          </div>

          <!-- Card 3 -->
          <div class="workshop-card">
            <h3>What you'll practice</h3>
            <ul>
              <li>Choosing a project that fits your current skills and time.</li>
              <li>Getting your machine behaving (sponge bar, tension, weights).</li>
              <li>Working clean cast-ons, edges, and bind-offs that match your fabric.</li>
              <li>Taking small, confident steps instead of getting stuck or overwhelmed.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Pricing / Levels -->
    <section class="section section--pricing" id="pricing">
      <div class="section-inner">
        <h2>Choose Your Workshop Level</h2>
        <p>
          Both options are 10-day, call-free workshops. Workshop Core is best for smaller, simpler projects; Workshop Plus is ideal for sweaters and more complex makes.
        </p>
        <p>
          Every Guided Workshop includes a personalized 10-day plan, calm written guidance, and simple machine checklists so your setup behaves.
        </p>
        <div class="grid grid--two pricing-grid">
          <div class="card card--pricing" data-testid="card-pricing-core">
            <h3>Workshop Core — $297</h3>
            <p>
              Perfect for smaller, simpler projects—like scarves, hats, blankets
            </p>
            <ul>
              <li>Personalized 10-Day Finish Plan</li>
              <li>Step-by-step guidance</li>
              <li>Machine Quick Cards</li>
              <li>Diagnostics + checklists</li>
              <li><strong>Private written feedback during your 10 days</strong><br>
              Check in with notes or photos and get calm, personalized guidance.
              </li>
              <li><strong>Call-free guidance</strong><br>
              Works in any time zone — no meetings or scheduling needed.
              </li>
            </ul>
           <a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Workshop Core
</a>
          <div class="pricing-helper">
            <a href="#" data-modal-open="is-this-for-you">
              Is this guided workshop right for you?
            </a>
          </div>

          </div>
          <div class="card card--pricing card--featured" data-testid="card-pricing-plus">
            <div class="featured-badge">Most Popular</div>
            <h3>Workshop Plus — $497</h3>
            <p>
              Best for sweaters, multi-piece garments, or more complex projects where extra support and shaping decisions really matter.
            </p>
            <ul>
              <li>Everything in Workshop Core</li>
              <li><strong>More feedback when you need it</strong><br>
              Extra written support throughout your 10 days.
              </li>
              <li><strong>Extra support for bigger projects</strong><br>
              Space for shaping decisions, fit questions, and more moving pieces.
              </li>
              <li><strong>Call-free guidance</strong><br>
              Works in any time zone — no meetings or scheduling needed.
              </li>
            </ul>
<a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Workshop Plus
</a>
          <div class="pricing-helper">
            <a href="#" data-modal-open="is-this-for-you">
              Is this guided workshop right for you?
            </a>
          </div>

          </div>
        </div>

        <!-- COMPARISON CHART PLACEHOLDER -->
        <!-- TODO: If you prefer, replace the two cards above with a simple comparison table -->
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Guarantee -->
    <section class="section section--guarantee">
      <div class="section-inner">
        <h2>The First Steps Guarantee</h2>
        <p>
          Follow the first steps in your plan and send your initial progress. If you feel the workshop isn't a good fit during your 10-day window, email me and I'll refund your registration.
        </p>
        <p class="guarantee-note">No drama. No hoops.</p>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- About Sue -->
    <section class="section section--about">
      <div class="section-inner">
        <div class="grid grid--two about-grid">
          <div class="about-image">
            <!-- SUE PHOTO PLACEHOLDER -->
            <!-- TODO: Replace with a real photo of Sue (ideally with a knitting machine) -->
            <div class="placeholder-image placeholder-image--portrait">
              <span>Sue Portrait</span>
            </div>
          </div>
          <div class="about-content">
            <h2>About Sue</h2>
            <p>
              I've spent decades helping machine knitters move from confusion to
              confidence — not through pressure, but through clarity.
            </p>
            <p>
              This Guided Workshop is built the same way I teach: small wins, real
              progress, and steady encouragement. You don't need to "keep up." You
              just need the right next step.
            </p>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Final CTA -->
    <section class="section section--cta">
      <div class="section-inner section-inner--center">
        <h2>Ready to Begin?</h2>
        <p>
          Start with the Project Planner. Tell me what you want to knit — and I'll
          create a calm, finishable path forward.
        </p>
        <!-- TODO: Update href to the actual intake / sign-up page -->
<a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Start Your Guided Workshop
</a>

        <div class="how-it-works-link">
          <a href="#" data-modal-open="how-it-works">How does this workshop work?</a>
        </div>
      </div>
    </section>

  </main>

  <!-- Is This For You Modal -->
  <div id="is-this-for-you-modal" class="modal hidden">
    <div class="modal-overlay" data-modal-close="is-this-for-you"></div>
    <div class="modal-content">
      <button class="modal-close" data-modal-close="is-this-for-you">×</button>
      <h2>Is a guided workshop right for you?</h2>
      <div class="modal-fit-grid">
        <div>
          <h3>This is for you if…</h3>
          <ul>
            <li>Your machine has been sitting quietly and you're ready to use it again.</li>
            <li>You want a realistic 10-day container with calm, written guidance.</li>
            <li>You prefer clear steps and check-ins over long live calls.</li>
            <li>You're willing to take small actions and send quick updates.</li>
            <li>You want knitting to feel doable and encouraging, not overwhelming.</li>
          </ul>
        </div>
        <div>
          <h3>This is not for you if…</h3>
          <ul>
            <li>You want weekly group calls or live Zoom coaching.</li>
            <li>You're looking for a big video course you can binge.</li>
            <li>You don't want to work within a 10-day window.</li>
            <li>You're not able to send occasional notes or photos of your progress.</li>
            <li>You'd rather collect information than focus on one finishable project.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- How It Works Modal -->
  <div id="how-it-works-modal" class="modal hidden">
    <div class="modal-overlay" data-modal-close="how-it-works"></div>
    <div class="modal-content">
      <button class="modal-close" data-modal-close="how-it-works">×</button>
      <h2>How Your Guided Workshop Works</h2>

      <ol class="modal-steps">
        <li><strong>Join the workshop.</strong> You'll complete checkout and get immediate access to your Project Planner (intake form).</li>
        <li><strong>Choose when to begin.</strong> Your 10 days do NOT start at payment. They begin when you submit your Project Planner—so you can start today, tomorrow, or whenever you're ready.</li>
        <li><strong>Tell Sue about your project.</strong> Use the Project Planner to share what you want to finish (or begin) and where you need support.</li>
        <li><strong>Get your first step.</strong> Sue reviews your intake and sends your personalized starting point.</li>
        <li><strong>Move forward at your pace.</strong> Check in when you're ready. Sue responds with your next steps—no calls, no pressure, no overwhelm.</li>
      </ol>
      <p class="modal-note">
  I typically reply within one business day, Monday–Friday (Pacific time).
</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page--guided-workshop {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .section {
    padding: 1.5rem 0;
  }

  .section-inner {
    max-width: 100%;
  }

  .section-inner--center {
    text-align: center;
  }

  /* Hero Section */
  .section--hero {
    text-align: center;
  }

  .hero-header {
    margin-bottom: 2rem;
  }

  .hero-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .hero-logo {
      width: 80px;
      height: 80px;
    }
  }

  .section--hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--kbm-green);
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--kbm-green-2);
    font-weight: 500;
    margin: 0 0 1.5rem;
    line-height: 1.5;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-media {
    margin: 2rem 0;
  }

  .hero-cta {
    margin-top: 2rem;
    text-align: center;
  }

  .hero-note {
    text-align: center;
    max-width: 44rem;
    margin: 1.5rem auto 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #5a6b47;
    font-style: italic;
  }

  /* Section CTA */
  .section-cta {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1rem;
  }

  /* Placeholder Images */
  .placeholder-image {
    background: linear-gradient(135deg, #e9ece7 0%, #d4dbc8 100%);
    border: 2px dashed var(--kbm-green-2);
    border-radius: 12px;
    padding: 3rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .placeholder-image span {
    color: var(--kbm-green);
    font-weight: 500;
    font-size: 1rem;
  }

  .placeholder-image--portrait {
    min-height: 300px;
  }

  /* Buttons */
  .button {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 999px;
    font-size: 1rem;
    text-decoration: none;
    font-weight: 600;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
    text-align: center;
  }

  .button--primary {
    background-color: var(--kbm-green);
    color: #ffffff;
    border-color: var(--kbm-green);
  }

  .button--primary:hover {
    background-color: var(--kbm-green-hover, #445626);
    border-color: var(--kbm-green-hover, #445626);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--kbm-green);
    border-color: var(--kbm-green);
  }

  .button--secondary:hover {
    background-color: var(--kbm-green);
    color: #ffffff;
  }

  .button--large {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
  }

  /* Section Headings */
  .section h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 1rem;
  }

  .section h3 {
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.75rem;
  }

  .section p {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    color: #5a6b47;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Lists */
  .section ul,
  .section ol {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  .section li {
    font-size: clamp(1rem, 1.5vw, 1.05rem);
    color: #5a6b47;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  /* Grid Layout */
  .grid {
    display: grid;
    gap: 2rem;
  }

  .grid--two {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .grid--two {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Callout Box */
  .callout {
    background: #f9fdf5;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .callout--contrast {
    border-left: 4px solid var(--kbm-green-2);
  }

  .callout p:last-child {
    margin-bottom: 0;
  }

  /* Steps List */
  .steps-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .steps-list li {
    background: #f9fdf5;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid var(--kbm-green-2);
  }

  .steps-list h3 {
    margin-bottom: 0.5rem;
  }

  .steps-list p {
    margin: 0;
  }

  /* Included List */
  .included-list {
    list-style: none;
    padding: 0;
  }

  .included-list li {
    padding: 1rem 0;
    border-bottom: 1px solid #e5e8e0;
  }

  .included-list li:last-child {
    border-bottom: none;
  }

  /* Pricing Cards */
  .pricing-grid {
    margin-top: 1.5rem;
  }

  .card--pricing {
    background: #ffffff;
    border: 1px solid #e5e8e0;
    border-radius: 16px;
    padding: 2rem;
    position: relative;
  }

  .card--featured {
    border: 2px solid var(--kbm-green);
    box-shadow: 0 4px 20px rgba(82, 104, 45, 0.15);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--kbm-green);
    color: #ffffff;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .card--pricing h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .card--pricing .button {
    display: block;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    box-sizing: border-box;
  }

  /* Guarantee Section */
  .section--guarantee {
    text-align: center;
  }

  .section--guarantee .section-inner {
    max-width: 650px;
    margin: 0 auto;
  }

  .guarantee-note {
    font-weight: 600;
    color: var(--kbm-green);
    font-style: italic;
  }

  /* About Section */
  .about-grid {
    align-items: center;
  }

  .about-content {
    text-align: left;
  }

  /* Media Elements */
  .media {
    margin: 2rem 0;
  }

  /* Divider */
  .kbm-divider {
    border: none;
    border-top: 1px solid #e5e8e0;
    margin: 3rem auto;
  }

  /* Problem Section Styling */
  .section--problem {
    background-color: #F7F9F3;
    padding: 2.5rem 1.5rem;
    border-radius: 12px;
  }

  .fit-icon {
    margin-right: 6px;
    color: #C2614E;
  }

  .section--problem h3 .fa-check {
    color: #6E8B3D;
  }

  /* Overview Cards */
  .workshop-overview-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .workshop-overview-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .workshop-card {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .workshop-card h3 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .workshop-card ul {
    padding-left: 1.25rem;
    margin: 0;
  }

  .workshop-card li + li {
    margin-top: 0.4rem;
  }

  /* Final CTA */
  .section--cta {
    background: linear-gradient(135deg, #f9fdf5 0%, #e9ece7 100%);
    border-radius: 16px;
    padding: 3rem 2rem;
    margin-top: 1rem;
  }

  .section--cta h2 {
    margin-bottom: 1rem;
  }

  .section--cta p {
    max-width: 550px;
    margin: 0 auto 1.5rem;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .page--guided-workshop {
      padding: 1.5rem 1rem 3rem;
    }

    .hero-logo {
      width: 60px;
      height: 60px;
    }

    .card--pricing {
      padding: 1.5rem;
    }

    .section--cta {
      padding: 2rem 1.5rem;
    }
  }

  /* How It Works Modal Link */
  .how-it-works-link {
    text-align: center;
    margin-top: 0.5rem;
  }
  .how-it-works-link a {
    font-size: 0.95rem;
    text-decoration: underline;
    color: #2C3A57;
    cursor: pointer;
  }

  /* Modal Styles */
  .modal.hidden {
    display: none;
  }

  .modal {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
  }

  .modal-content {
    position: relative;
    background: white;
    padding: 2rem;
    max-width: 500px;
    border-radius: 12px;
    z-index: 10000;
    margin: 1rem;
  }

  .modal-close {
    position: absolute;
    right: 1rem;
    top: 1rem;
    font-size: 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  .modal-steps {
    margin-top: 1rem;
    padding-left: 1.25rem;
    line-height: 1.6;
  }

  .modal-steps li {
    margin-bottom: 0.75rem;
  }

  .pricing-helper {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }

  .pricing-helper a {
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    color: #52682d;
  }

  .card--pricing {
    display: flex;
    flex-direction: column;
  }

  .card--pricing ul {
    flex-grow: 1;
  }

  .card--pricing .button {
    align-self: center;
  }

  .modal-fit-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .modal-fit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  document.querySelectorAll('[data-modal-open="how-it-works"]').forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();
      document.getElementById("how-it-works-modal").classList.remove("hidden");
    });
  });

  document.querySelectorAll('[data-modal-close="how-it-works"]').forEach(btn => {
    btn.addEventListener("click", () => {
      document.getElementById("how-it-works-modal").classList.add("hidden");
    });
  });

  document.querySelectorAll('[data-modal-open="is-this-for-you"]').forEach(el => {
    el.addEventListener("click", (event) => {
      event.preventDefault();
      const modal = document.getElementById("is-this-for-you-modal");
      if (modal) {
        modal.classList.remove("hidden");
      }
    });
  });

  document.querySelectorAll('[data-modal-close="is-this-for-you"]').forEach(el => {
    el.addEventListener("click", () => {
      const modal = document.getElementById("is-this-for-you-modal");
      if (modal) {
        modal.classList.add("hidden");
      }
    });
  });
</script>
