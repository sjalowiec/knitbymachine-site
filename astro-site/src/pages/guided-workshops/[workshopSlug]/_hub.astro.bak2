---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getWorkshopSlugs, getWorkshopBySlug } from '../../../lib/workshops';

export const prerender = true;

export async function getStaticPaths() {
  const slugs = getWorkshopSlugs();
  return slugs.map(slug => ({
    params: { workshopSlug: slug }
  }));
}

const { workshopSlug } = Astro.params;
const workshop = getWorkshopBySlug(workshopSlug as string);

if (!workshop) {
  return Astro.redirect('/404');
}

const { client, workshop: workshopInfo, outline, hub, hyvor, curriculum } = workshop;
const title = workshopInfo.title;
const description = hub.welcomeBody;

// Build unified day list from outline (authoritative schedule), enriched with curriculum content
const dayList = outline.days.map(od => {
  const curriculumDay = curriculum?.days.find(cd => cd.day === od.day);
  return {
    day: od.day,
    title: curriculumDay?.title || od.title,
    released: od.released,
    isBonus: od.isBonus || od.day === 99,
    href: `/guided-workshops/${workshopSlug}/day/${od.day}`
  };
});

// Total days counts only regular days (excludes bonus days like Day 99)
const totalDays = outline.days.filter(d => !d.isBonus && d.day !== 99).length;
---

<BaseLayout {title} {description} skipGlobalHyvor={true}>
  <div class="gw-hub" data-workshop-slug={workshopSlug}>
    
    <!-- Mobile Dropdown Menu -->
    <details class="gw-map-mobile">
      <summary>Workshop Menu</summary>
      <nav class="gw-map-mobile-nav">
        {dayList.map(d => (
          <a href={d.href} class={d.released ? '' : 'gw-map-link--locked'}>
            {d.isBonus ? 'Bonus' : `Day ${d.day}`}{d.title ? ` — ${d.title}` : ''}
          </a>
        ))}
      </nav>
    </details>

    <!-- Two-Column Layout -->
    <div class="gw-layout">
      
      <!-- Left Column: Sticky Map -->
      <aside class="gw-map">
        <h2 class="gw-map-heading">Your {totalDays}-Day Plan</h2>
        <nav class="gw-map-nav">
          {dayList.map(d => (
            <a 
              href={d.href} 
              class={`gw-map-link ${d.released ? '' : 'gw-map-link--locked'}`}
            >
              {d.isBonus ? 'Bonus' : `Day ${d.day}`}{d.title ? ` — ${d.title}` : ''}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Right Column: Hyvor Conversation -->
      <main class="gw-action">
        <h2 class="gw-action-heading">Workshop Conversation</h2>
        <p class="gw-action-intro">
          Post a quick update after you work on a step — I'll reply with what to check or do next.
        </p>

        <div class="gw-conversation">
          <div id="hyvor-talk-view" data-website-id={hyvor.websiteId} data-page-id={hyvor.pageId}></div>
        </div>
      </main>

    </div>
  </div>

  <!-- 
    DEV TEST INSTRUCTIONS:
    To simulate a paid user during development, open DevTools and run:
    
    localStorage.setItem("kbm_user", JSON.stringify({
      id: "dev-1",
      name: "Betty",
      email: "betty@example.com"
    }));
    location.reload();
  -->

  <!-- Hyvor Talk Auth-Aware Loader -->
  <script type="module">
    import { waitForAuth, setHyvorIdentity, loadHyvorScript } from '/src/lib/hyvorLoader.js';

    const mount = document.getElementById('hyvor-talk-view');
    if (mount) {
      const websiteId = mount.dataset.websiteId || '14706';
      const pageId = mount.dataset.pageId || 'workshop-hub';

      // Show loading state
      mount.insertAdjacentHTML('beforebegin', `
        <div class="kbm-hyvor-wait" id="kbm-hyvor-wait">
          Loading your workshop conversation…
        </div>
      `);

      const result = await waitForAuth({ timeoutMs: 8000 });

      if (result.ok && result.user) {
        const waitEl = document.getElementById('kbm-hyvor-wait');
        if (waitEl) waitEl.remove();

        setHyvorIdentity({ websiteId, user: result.user });
        
        // Create the Hyvor Talk element
        const hyvorEl = document.createElement('hyvor-talk-comments');
        hyvorEl.setAttribute('website-id', websiteId);
        hyvorEl.setAttribute('page-id', pageId);
        mount.appendChild(hyvorEl);
        
        loadHyvorScript();
      } else {
        // No auth - show timeout message
        const waitEl = document.getElementById('kbm-hyvor-wait');
        if (waitEl) {
          waitEl.innerHTML = 'Loading is taking longer than expected. Refresh this page if needed.';
        }
      }
    }
  </script>

  <style>
    /* Hub Container */
    .gw-hub {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.5rem 1rem 3rem;
    }

    /* Two-Column Grid Layout */
    .gw-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    @media (min-width: 900px) {
      .gw-layout {
        grid-template-columns: 1fr 2fr;
        gap: 2.5rem;
      }
    }

    /* Left Column: Map (hidden on mobile) */
    .gw-map {
      display: none;
    }

    @media (min-width: 900px) {
      .gw-map {
        display: block;
        position: sticky;
        top: 1rem;
        align-self: start;
      }
    }

    .gw-map-heading {
      margin: 0 0 1rem;
      font-size: 1.1rem;
      font-weight: 700;
      color: #2b2b2b;
    }

    .gw-map-nav {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .gw-map-link {
      display: block;
      padding: 0.5rem 0;
      font-size: 0.95rem;
      color: #52682d;
      text-decoration: none;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      transition: color 0.15s ease;
    }

    .gw-map-link:hover {
      color: #3d4f22;
    }

    .gw-map-link:last-child {
      border-bottom: none;
    }

    .gw-map-link--locked {
      color: rgba(0, 0, 0, 0.4);
      pointer-events: none;
    }

    /* Mobile Dropdown Menu */
    .gw-map-mobile {
      display: block;
      margin-bottom: 1.5rem;
    }

    @media (min-width: 900px) {
      .gw-map-mobile {
        display: none;
      }
    }

    .gw-map-mobile summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      font-size: 1rem;
      font-weight: 600;
      color: #2b2b2b;
      background: rgba(248, 250, 245, 0.95);
      border: 1px solid rgba(82, 104, 45, 0.2);
      border-radius: 10px;
      cursor: pointer;
      list-style: none;
      transition: background 0.15s ease, border-color 0.15s ease;
    }

    .gw-map-mobile summary::-webkit-details-marker {
      display: none;
    }

    .gw-map-mobile summary::after {
      content: '▼';
      font-size: 0.7rem;
      color: rgba(0, 0, 0, 0.5);
      transition: transform 0.2s ease;
    }

    .gw-map-mobile[open] summary::after {
      transform: rotate(180deg);
    }

    .gw-map-mobile summary:hover {
      background: rgba(199, 216, 164, 0.25);
      border-color: rgba(82, 104, 45, 0.35);
    }

    .gw-map-mobile-nav {
      display: flex;
      flex-direction: column;
      margin-top: 0.5rem;
      padding: 0.75rem 1rem;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(82, 104, 45, 0.15);
      border-radius: 10px;
    }

    .gw-map-mobile-nav a {
      display: block;
      padding: 0.6rem 0;
      font-size: 0.95rem;
      color: #52682d;
      text-decoration: none;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .gw-map-mobile-nav a:last-child {
      border-bottom: none;
    }

    .gw-map-mobile-nav a:hover {
      color: #3d4f22;
    }

    .gw-map-mobile-nav a.gw-map-link--locked {
      color: rgba(0, 0, 0, 0.4);
      pointer-events: none;
    }

    /* Right Column: Action/Conversation */
    .gw-action {
      min-width: 0;
    }

    .gw-action-heading {
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: #2b2b2b;
    }

    .gw-action-intro {
      margin: 0 0 1.25rem;
      font-size: 1rem;
      line-height: 1.5;
      color: rgba(0, 0, 0, 0.7);
    }

    /* Conversation Container */
    .gw-conversation {
      padding: 1.25rem;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(82, 104, 45, 0.15);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    /* Hyvor loading state */
    .kbm-hyvor-wait {
      margin: 0.75rem 0;
      padding: 0.75rem 1rem;
      border: 1px solid rgba(82, 104, 45, 0.22);
      border-radius: 10px;
      background: rgba(199, 216, 164, 0.18);
      color: #2b2b2b;
      font-size: 0.95rem;
    }
  </style>
</BaseLayout>
