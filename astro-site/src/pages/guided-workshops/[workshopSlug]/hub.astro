---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VideoReplySection from '../../../components/workshops/VideoReplySection.astro';
import { getWorkshopSlugs, getWorkshopBySlug } from '../../../lib/workshops';

export async function getStaticPaths() {
  const slugs = getWorkshopSlugs();
  return slugs.map(slug => ({
    params: { workshopSlug: slug }
  }));
}

const { workshopSlug } = Astro.params;
const workshop = getWorkshopBySlug(workshopSlug as string);

if (!workshop) {
  return Astro.redirect('/404');
}

const { client, workshop: workshopInfo, outline, hub, hyvor, curriculum } = workshop;
const title = workshopInfo.title;
const description = hub.welcomeBody;

// Build unified day list from outline (authoritative schedule), enriched with curriculum content
const dayList = outline.days.map(od => {
  const curriculumDay = curriculum?.days.find(cd => cd.day === od.day);
  return {
    day: od.day,
    title: curriculumDay?.title || od.title,
    description: curriculumDay?.shortDescription || od.goal,
    released: od.released,
    href: `/guided-workshops/${workshopSlug}/day/${od.day}`
  };
});

// Total days always comes from outline (the authoritative schedule)
const totalDays = outline.days.length;
---

<BaseLayout {title} {description}>
  <main class="page page--guided-workshop-hub" data-workshop-slug={workshopSlug}>

    <header class="hub-hero">
      <h1>{hub.welcomeTitle}</h1>
      <p class="hub-subtitle">
        {hub.welcomeBody}
      </p>
      <div class="hub-status">
        <strong>{hub.todayLabel}</strong>
      </div>
    </header>

    <section class="hub-card">
      <h2>How this works</h2>
      <ul class="hub-list">
        <li><strong>Post updates here:</strong> scroll down and add your note under "Workshop Conversation."</li>
        <li><strong>What to include:</strong> a photo + 1–2 sentences (what you did, or what feels stuck).</li>
        <li><strong>My reply rhythm:</strong> I'll respond in writing with the next step and what to check.</li>
        <li><strong>Done for today:</strong> once you've posted, you're done — no extra homework.</li>
      </ul>
      <p class="hub-note">
        Photos work best. If a short video helps, share a Loom link in your comment.
      </p>
    </section>

    <section class="hub-card hub-card--plan">
      <h2>Your {totalDays}-Day Plan</h2>
      <ul class="plan-grid" aria-label="Workshop plan">
        {dayList.map((d, index) => (
          <li class="plan-item">
            <a 
              class={`plan-card ${d.released ? '' : 'plan-card--locked'} ${index === 0 ? 'plan-card--start' : ''}`} 
              href={d.href}
              data-day={d.day}
            >
              <div class="plan-card-top">
                <span class="plan-day">Day {d.day}</span>
                {index === 0 && <span class="plan-badge plan-badge--start">Start here</span>}
                {!d.released && <span class="plan-badge plan-badge--coming">Coming</span>}
              </div>

              <h3 class="plan-title">{d.title}</h3>

              {d.description && <p class="plan-desc">{d.description}</p>}

              <div class="plan-meta">
                <span class="plan-arrow" aria-hidden="true">→</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {hub.showVideoReplyPlaceholder && <VideoReplySection />}

    <section class="hub-card hub-card--conversation">
      <h2>Workshop Conversation</h2>
      <p class="hub-note">
        Post your update below. If you're stuck, describe what you expected vs. what happened.
      </p>

      <div class="conversation-bubble">
        {hyvor.enabled && hyvor.websiteId ? (
          <hyvor-talk-comments
            website-id={hyvor.websiteId}
            page-id={hyvor.pageId}
          ></hyvor-talk-comments>
        ) : (
          <div class="hub-comments-placeholder">
            <p>Comments will appear here once Hyvor is connected.</p>
          </div>
        )}
      </div>
    </section>

  </main>

  <script>
    // Workshop started tracking via localStorage
    (function() {
      const main = document.querySelector('.page--guided-workshop-hub');
      const slug = main?.getAttribute('data-workshop-slug') || window.location.pathname;
      const storageKey = `kbm_ws_started_${slug}`;
      
      // Check if workshop has been started
      if (localStorage.getItem(storageKey) === 'true') {
        document.documentElement.classList.add('ws-started');
      }
      
      // Mark as started when Day 1 is clicked
      const day1Link = document.querySelector('[data-day="1"]');
      if (day1Link) {
        day1Link.addEventListener('click', function() {
          localStorage.setItem(storageKey, 'true');
        });
      }
    })();
  </script>

  <style>
    .page--guided-workshop-hub { max-width: 880px; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
    .hub-hero { margin-bottom: 1.25rem; }
    .hub-subtitle { margin-top: 0.5rem; }
    .hub-status { margin-top: 0.75rem; padding: 0.85rem 1rem; border-radius: 16px; border: 1px solid rgba(44,58,87,0.12); background: rgba(255,255,255,0.65); }
    .hub-card { margin-top: 1rem; padding: 1rem; border-radius: 18px; border: 1px solid rgba(44,58,87,0.12); background: rgba(255,255,255,0.65); }
    .hub-card--plan { padding: 1.25rem; }
    .hub-list { margin: 0.75rem 0 0; padding-left: 1.2rem; }
    .hub-list li { margin: 0.4rem 0; }
    .hub-note { margin-top: 0.75rem; opacity: 0.9; }
    .hub-focus p { margin: 0.5rem 0; }

    /* Plan Grid - Day Cards */
    .plan-grid {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0;
      display: grid;
      gap: 12px;
      grid-template-columns: 1fr;
    }

    @media (min-width: 640px) {
      .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (min-width: 900px) {
      .plan-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (min-width: 1200px) {
      .plan-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    }

    .plan-item {
      display: flex;
    }

    .plan-card {
      display: flex;
      flex-direction: column;
      width: 100%;
      text-decoration: none;
      border: 1px solid rgba(0,0,0,0.10);
      border-radius: 14px;
      padding: 14px 14px 12px;
      background: #fff;
      transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
    }

    .plan-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(0,0,0,0.08);
      border-color: rgba(82, 104, 45, 0.3);
    }

    .plan-card:focus-visible {
      outline: 3px solid rgba(82, 104, 45, 0.35);
      outline-offset: 2px;
    }

    /* Day 1 highlight - only when NOT started */
    .plan-card--start {
      border: 2px solid rgba(82, 104, 45, 0.5);
      box-shadow: 0 4px 16px rgba(82, 104, 45, 0.15);
      background: linear-gradient(135deg, rgba(199, 216, 164, 0.15) 0%, #fff 100%);
    }

    .plan-card--start:hover {
      border-color: rgba(82, 104, 45, 0.7);
      box-shadow: 0 8px 24px rgba(82, 104, 45, 0.2);
    }

    /* Hide Day 1 special styling when workshop is started */
    :global(.ws-started) .plan-card--start {
      border: 1px solid rgba(0,0,0,0.10);
      box-shadow: none;
      background: #fff;
    }

    :global(.ws-started) .plan-card--start:hover {
      box-shadow: 0 8px 22px rgba(0,0,0,0.08);
      border-color: rgba(82, 104, 45, 0.3);
    }

    :global(.ws-started) .plan-badge--start {
      display: none;
    }

    .plan-card--locked {
      opacity: 0.65;
      background: rgba(250, 250, 250, 0.9);
    }

    .plan-card--locked:hover {
      transform: none;
      box-shadow: none;
      border-color: rgba(0,0,0,0.10);
    }

    .plan-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
      flex-wrap: wrap;
    }

    .plan-day {
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      color: #52682d;
    }

    .plan-badge {
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.25rem 0.5rem;
      border-radius: 999px;
      white-space: nowrap;
    }

    .plan-badge--start {
      border: 1px solid rgba(82, 104, 45, 0.4);
      background: rgba(199, 216, 164, 0.6);
      color: #3d4f22;
    }

    .plan-badge--coming {
      background: rgba(44, 58, 87, 0.08);
      border: 1px solid rgba(44, 58, 87, 0.15);
      color: rgba(44, 58, 87, 0.6);
    }

    .plan-title {
      margin: 0 0 6px;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.25;
      color: #2b2b2b;
    }

    .plan-desc {
      margin: 0 0 10px;
      font-size: 0.88rem;
      line-height: 1.35;
      color: rgba(0,0,0,0.65);
      flex-grow: 1;
    }

    .plan-meta {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      margin-top: auto;
    }

    /* Enhanced arrow visibility */
    .plan-arrow {
      font-size: 1.25rem;
      font-weight: 600;
      color: #52682d;
      opacity: 0.7;
      background: rgba(199, 216, 164, 0.35);
      padding: 0.2rem 0.5rem;
      border-radius: 8px;
      transition: transform 140ms ease, opacity 140ms ease, background 140ms ease;
    }

    .plan-card:hover .plan-arrow {
      transform: translateX(4px);
      opacity: 1;
      background: rgba(199, 216, 164, 0.55);
    }

    .plan-card--locked .plan-arrow {
      opacity: 0.35;
      background: rgba(44, 58, 87, 0.08);
      color: rgba(44, 58, 87, 0.5);
    }

    /* Workshop Conversation - Speech Bubble Styling */
    .hub-card--conversation {
      position: relative;
    }

    .conversation-bubble {
      margin-top: 1rem;
      padding: 1.25rem;
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(248,250,245,0.95) 100%);
      border: 1px solid rgba(82, 104, 45, 0.18);
      box-shadow: 0 2px 12px rgba(82, 104, 45, 0.06);
      position: relative;
    }

    .conversation-bubble::before {
      content: '';
      position: absolute;
      top: -10px;
      left: 28px;
      width: 20px;
      height: 20px;
      background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(248,250,245,0.95) 100%);
      border-left: 1px solid rgba(82, 104, 45, 0.18);
      border-top: 1px solid rgba(82, 104, 45, 0.18);
      transform: rotate(45deg);
    }

    .hub-comments-placeholder {
      padding: 1.5rem;
      border-radius: 12px;
      border: 1px dashed rgba(44, 58, 87, 0.25);
      background: rgba(255, 255, 255, 0.55);
      text-align: center;
      color: rgba(44, 58, 87, 0.7);
    }
  </style>
</BaseLayout>
