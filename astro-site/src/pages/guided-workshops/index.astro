---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Guided Workshop with Sue | Knit by Machine";
const description = "A hands-on, personal workshop designed to help you make real progress on a project you’re excited about—at a pace that feels calm and doable.";
---

<BaseLayout {title} {description}>
  <main class="page page--guided-workshop">
    
    <!-- Hero Section -->
    <section class="section section--hero">
      <div class="section-inner">
        <div class="grid grid--two hero-grid">
          <div class="hero-left">
            <div class="hero-header">
              <div class="hero-title-row">
                <img
                  src="/images/guided_workshops.svg"
                  alt="Guided Workshops logo"
                  class="hero-logo"
                />
                <h1 data-testid="text-page-title">Guided Workshop with Sue</h1>
              </div>
              <p class="hero-subtitle">
                A hands-on, personal workshop designed to help you make real progress on a project you're excited about—at a pace that feels calm and doable.
              </p>
            </div>

            <div class="hero-cta">
              <a 
                class="button button--primary" 
                href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
                data-testid="button-cta-hero"
              >
                Start Your Guided Workshop
              </a>

              <div class="how-it-works-link">
                <a href="#" data-modal-open="how-it-works">How does this workshop work?</a>
              </div>
              <p class="hero-note">
                You'll start by filling out a simple Project Planner so we can choose the right project and build your personal plan — your 10 days don't begin until you submit it.
              </p>
            </div>
          </div>
          <div class="hero-right">
            <!-- HERO IMAGE PLACEHOLDER -->
            <!-- TODO: Replace the placeholder image below with a real photo:
                - Sue at a knitting machine, or
                - a clean, inviting machine setup
            -->
            <div class="hero-media">
              <div class="placeholder-image">
                <span>Hero Image Placeholder</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <hr class="kbm-divider" />

    <!-- Problem / Fit Section -->
    <section class="section section--problem">
      <div class="section-inner">
        <h2>If your machine has been sitting quietly…</h2>
        <p>
          …and you're not sure what to knit next — or how to start without messing
          things up — this is for you.
        </p>
        <div class="grid grid--two">
          <div>
            <h3>You don't need:</h3>
            <ul>
              <li>Another giant course</li>
              <li>Endless YouTube rabbit holes</li>
              <li>Weekly Zoom calls</li>
              <li>A basket of half-finished projects</li>
            </ul>
          </div>
          <div>
            <h3>You do need:</h3>
            <ul>
              <li>A clear project choice</li>
              <li>A simple, realistic plan</li>
              <li>One small step at a time</li>
              <li>Expert eyes when it matters</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- What This Is (merged) -->
    <section class="section section--what-it-is-merged">
      <div class="section-inner">
        <h2>What this workshop is (and what you'll practice)</h2>
        <div class="grid grid--two">
          <div>
            <h3>What this is</h3>
            <ul>
              <li>A 10-day, call-free, 1-1 workshop focused on one real project.</li>
              <li>Guided, realistic steps based on your machine, yarn, and goal.</li>
              <li>A calm container where you can ask questions as you go.</li>
            </ul>
            <h3>What it's not</h3>
            <ul>
              <li>Not a big course or video library to work through alone.</li>
              <li>Not a weekly group call or camera-on commitment.</li>
              <li>Not an endless coaching relationship with no clear focus.</li>
            </ul>
          </div>
          <div>
            <h3>What you'll practice</h3>
            <ul>
              <li>Choosing a project that fits your current skills and time.</li>
              <li>Setting up your machine so it behaves (sponge bar, tension, weights).</li>
              <li>Working clean cast-ons, edges, and bind-offs that match your fabric.</li>
              <li>Taking small, confident steps instead of getting stuck or overwhelmed.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- You Choose the Project -->
    <section class="section section--choose-project">
      <div class="section-inner">
        <h2>You Choose What You Want to Knit</h2>
        <p>
          You're not handed a random project. You begin with the
          <strong> Ready • Set • Knit Project Planner</strong> — a quick, simple
          way to tell me:
        </p>
        <ul>
          <li>What machine you're using (LK150, Silver Reed, Brother, etc.)</li>
          <li>What yarn you have (or want to use)</li>
          <li>What you'd love to knit next</li>
          <li>Where you feel unsure or stuck</li>
        </ul>

        <!-- PROJECT PLANNER IMAGE PLACEHOLDER -->
        <!-- TODO: Replace the placeholder image with a mockup or screenshot of the planner -->
        <div class="media media--planner">
          <div class="placeholder-image">
            <span>Project Planner Preview</span>
          </div>
        </div>

        <p>
          From there, I map out a <strong>custom 10-day plan</strong> built around
          your project — not a generic one.
        </p>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- How It Works -->
    <section class="section section--how-it-works">
      <div class="section-inner">
        <h2>How It Works (Simple + Calm)</h2>
        <ol class="steps-list">
          <li>
            <h3>1. Start with the Project Planner</h3>
            <p>
              Your private intake helps me understand your machine, your yarn, and
              what you want to knit.
            </p>
          </li>
          <li>
            <h3>2. Receive Your Personalized 10-Day Finish Plan</h3>
            <p>
              I translate your project into small, realistic steps designed for
              success. No overwhelm. No guessing.
            </p>
          </li>
          <li>
            <h3>3. Work Through One Step at a Time</h3>
            <p>
              You focus on just one thing: <em>"What's my next small win?"</em>
              When you finish a step, you send a quick photo or note.
            </p>
          </li>
          <li>
            <h3>4. Get Private Feedback — On Your Schedule</h3>
            <p>
  I review your work and send you clear corrections (if needed), gentle adjustments, encouragement, and your next step. No meetings. No camera. No pressure. I typically reply within one business day, Monday–Friday (Pacific time).
</p>
          </li>
          <li>
            <h3>5. Finish Your 10 Days With Real Momentum</h3>
            <p>
              By the end of your 10 days, you'll have clear forward momentum
              on a project you care about, understand your machine setup with more
              confidence, and know exactly what to do next — without guessing.
            </p>
          </li>
        </ol>

        <!-- FINISHED PROJECT IMAGE PLACEHOLDER -->
        <!-- TODO: Replace with a photo of a simple finished project or a tidy close-up of stitches -->
        <div class="media media--finished-project">
          <div class="placeholder-image">
            <span>Finished Project Image</span>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- What's Included -->
    <section class="section section--included">
      <div class="section-inner">
        <h2>What's Included</h2>
        <ul class="included-list">
          <li>
            <strong>Personalized 10-Day Finish Plan</strong><br />
            Built from your Project Planner intake.
          </li>
          <li>
            <strong>One-step-at-a-time guidance</strong><br />
            You always know your next small step.
          </li>
          <li>
            <strong>Private written/video feedback</strong><br />
            You choose your level of support.
          </li>
          <li>
            <strong>Machine Quick Cards</strong><br />
            LK150, Silver Reed, and Brother reference notes at a glance.
          </li>
          <li>
            <strong>Fix-It-First diagnostics</strong><br />
            Simple checks for sponge bar, tension mast, weights, and setup.
          </li>
          <li>
            <strong>A project chosen with success in mind</strong><br />
            We choose something realistic and meaningful — not overwhelming.
          </li>
        </ul>

        <!-- ICONS PLACEHOLDER -->
        <!-- TODO: Optionally add small icons for plan, steps, feedback, quick cards, diagnostics -->

        <div class="section-cta">
    <a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Start Your Guided Workshop
</a>

          <div class="how-it-works-link">
            <a href="#" data-modal-open="how-it-works">How does this workshop work?</a>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Pricing / Levels -->
    <section class="section section--pricing" id="pricing">
      <div class="section-inner">
        <h2>Choose Your Workshop Level</h2>
        <p>
          Both options are 10-day, call-free workshops. Workshop Core is best for smaller, simpler projects; Workshop Plus is ideal for sweaters and more complex makes.
        </p>
        <div class="grid grid--two pricing-grid">
          <div class="card card--pricing" data-testid="card-pricing-core">
            <h3>Workshop Core — $297</h3>
            <p>
              Perfect for smaller, simpler projects—like scarves, hats, blankets
            </p>
            <ul>
              <li>Personalized 10-Day Finish Plan</li>
              <li>Step-by-step guidance</li>
              <li>Machine Quick Cards</li>
              <li>Diagnostics + checklists</li>
            </ul>
           <a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Workshop Core
</a>

          </div>
          <div class="card card--pricing card--featured" data-testid="card-pricing-plus">
            <div class="featured-badge">Most Popular</div>
            <h3>Workshop Plus — $497</h3>
            <p>
              Best for sweaters, multi-piece garments, or more complex projects where extra support and shaping decisions really matter.
            </p>
            <ul>
              <li>Everything in Workshop Core</li>
              <li><strong>Extra support for bigger projects</strong><br>
              Space for shaping decisions, fit questions, and more moving pieces.
              </li>
            </ul>
<a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Workshop Plus
</a>

          </div>
        </div>

        <!-- COMPARISON CHART PLACEHOLDER -->
        <!-- TODO: If you prefer, replace the two cards above with a simple comparison table -->
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Guarantee -->
    <section class="section section--guarantee">
      <div class="section-inner">
        <h2>The First Steps Guarantee</h2>
        <p>
          Follow the first steps in your plan and send your initial progress. If you feel the workshop isn't a good fit during your 10-day window, email me and I'll refund your registration.
        </p>
        <p class="guarantee-note">No drama. No hoops.</p>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Fit / Not Fit -->
    <section class="section section--fit">
      <div class="section-inner">
        <div class="grid grid--two">
          <div>
            <h2>This Is for You If…</h2>
            <ul>
              <li>Your machine has been sitting quietly and you're ready to use it again.</li>
              <li>You want a realistic 10-day container with calm, written guidance.</li>
              <li>You prefer clear steps and check-ins over long live calls.</li>
              <li>You're willing to take small actions and send quick updates.</li>
              <li>You want knitting to feel doable and encouraging, not overwhelming.</li>
            </ul>
          </div>
          <div>
            <h2>This Is Not for You If…</h2>
            <ul>
              <li>You want weekly group calls or live Zoom coaching.</li>
              <li>You're looking for a big video course you can binge.</li>
              <li>You don't want to work within a 10-day window.</li>
              <li>You're not able to send occasional notes or photos of your progress.</li>
              <li>You'd rather collect information than focus on one finishable project.</li>
            </ul>
          </div>
        </div>

        <div class="section-cta">
<a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Start Your Guided Workshop
</a>

          <div class="how-it-works-link">
            <a href="#" data-modal-open="how-it-works">How does this workshop work?</a>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- About Sue -->
    <section class="section section--about">
      <div class="section-inner">
        <div class="grid grid--two about-grid">
          <div class="about-image">
            <!-- SUE PHOTO PLACEHOLDER -->
            <!-- TODO: Replace with a real photo of Sue (ideally with a knitting machine) -->
            <div class="placeholder-image placeholder-image--portrait">
              <span>Sue Portrait</span>
            </div>
          </div>
          <div class="about-content">
            <h2>About Sue</h2>
            <p>
              I've spent decades helping machine knitters move from confusion to
              confidence — not through pressure, but through clarity.
            </p>
            <p>
              This Studio Edition is built the same way I teach: small wins, real
              progress, and steady encouragement. You don't need to "keep up." You
              just need the right next step.
            </p>
          </div>
        </div>
      </div>
    </section>

    <hr class="kbm-divider" />

    <!-- Final CTA -->
    <section class="section section--cta">
      <div class="section-inner section-inner--center">
        <h2>Ready to Begin?</h2>
        <p>
          Start with the Project Planner. Tell me what you want to knit — and I'll
          create a calm, finishable path forward.
        </p>
        <!-- TODO: Update href to the actual intake / sign-up page -->
<a 
  class="button button--primary" 
  href="https://knitbymachinecom.outseta.com/auth?widgetMode=register&planUid=ZmNe52W2&planPaymentTerm=oneTime&skipPlanOptions=true#o-anonymous"
  data-testid="button-cta-hero"
>
  Start Your Guided Workshop
</a>

        <div class="how-it-works-link">
          <a href="#" data-modal-open="how-it-works">How does this workshop work?</a>
        </div>
      </div>
    </section>

  </main>

  <!-- How It Works Modal -->
  <div id="how-it-works-modal" class="modal hidden">
    <div class="modal-overlay" data-modal-close="how-it-works"></div>
    <div class="modal-content">
      <button class="modal-close" data-modal-close="how-it-works">×</button>
      <h2>How Your Guided Workshop Works</h2>

      <ol class="modal-steps">
        <li><strong>Join the workshop.</strong> You'll complete checkout and get immediate access to your Project Planner (intake form).</li>
        <li><strong>Choose when to begin.</strong> Your 10 days do NOT start at payment. They begin when you submit your Project Planner—so you can start today, tomorrow, or whenever you're ready.</li>
        <li><strong>Tell Sue about your project.</strong> Use the Project Planner to share what you want to finish (or begin) and where you need support.</li>
        <li><strong>Get your first step.</strong> Sue reviews your intake and sends your personalized starting point.</li>
        <li><strong>Move forward at your pace.</strong> Check in when you're ready. Sue responds with your next steps—no calls, no pressure, no overwhelm.</li>
      </ol>
      <p class="modal-note">
  I typically reply within one business day, Monday–Friday (Pacific time).
</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page--guided-workshop {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .section {
    padding: 1.5rem 0;
  }

  .section-inner {
    max-width: 100%;
  }

  .section-inner--center {
    text-align: center;
  }

  /* Hero Section */
  .section--hero {
    text-align: center;
  }

  .hero-header {
    margin-bottom: 2rem;
  }

  .hero-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .hero-logo {
      width: 80px;
      height: 80px;
    }
  }

  .section--hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--kbm-green);
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--kbm-green-2);
    font-weight: 500;
    margin: 0 0 1.5rem;
    line-height: 1.5;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-media {
    margin: 2rem 0;
  }

  .hero-cta {
    margin-top: 2rem;
  }

  .hero-note {
    font-size: 0.95rem;
    color: #5a6b47;
    margin-top: 1rem;
    font-style: italic;
  }

  /* Section CTA */
  .section-cta {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1rem;
  }

  /* Placeholder Images */
  .placeholder-image {
    background: linear-gradient(135deg, #e9ece7 0%, #d4dbc8 100%);
    border: 2px dashed var(--kbm-green-2);
    border-radius: 12px;
    padding: 3rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .placeholder-image span {
    color: var(--kbm-green);
    font-weight: 500;
    font-size: 1rem;
  }

  .placeholder-image--portrait {
    min-height: 300px;
  }

  /* Buttons */
  .button {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 999px;
    font-size: 1rem;
    text-decoration: none;
    font-weight: 600;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
    text-align: center;
  }

  .button--primary {
    background-color: var(--kbm-green);
    color: #ffffff;
    border-color: var(--kbm-green);
  }

  .button--primary:hover {
    background-color: var(--kbm-green-hover, #445626);
    border-color: var(--kbm-green-hover, #445626);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--kbm-green);
    border-color: var(--kbm-green);
  }

  .button--secondary:hover {
    background-color: var(--kbm-green);
    color: #ffffff;
  }

  .button--large {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
  }

  /* Section Headings */
  .section h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 1rem;
  }

  .section h3 {
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.75rem;
  }

  .section p {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    color: #5a6b47;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Lists */
  .section ul,
  .section ol {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  .section li {
    font-size: clamp(1rem, 1.5vw, 1.05rem);
    color: #5a6b47;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  /* Grid Layout */
  .grid {
    display: grid;
    gap: 2rem;
  }

  .grid--two {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .grid--two {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Callout Box */
  .callout {
    background: #f9fdf5;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .callout--contrast {
    border-left: 4px solid var(--kbm-green-2);
  }

  .callout p:last-child {
    margin-bottom: 0;
  }

  /* Steps List */
  .steps-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .steps-list li {
    background: #f9fdf5;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid var(--kbm-green-2);
  }

  .steps-list h3 {
    margin-bottom: 0.5rem;
  }

  .steps-list p {
    margin: 0;
  }

  /* Included List */
  .included-list {
    list-style: none;
    padding: 0;
  }

  .included-list li {
    padding: 1rem 0;
    border-bottom: 1px solid #e5e8e0;
  }

  .included-list li:last-child {
    border-bottom: none;
  }

  /* Pricing Cards */
  .pricing-grid {
    margin-top: 1.5rem;
  }

  .card--pricing {
    background: #ffffff;
    border: 1px solid #e5e8e0;
    border-radius: 16px;
    padding: 2rem;
    position: relative;
  }

  .card--featured {
    border: 2px solid var(--kbm-green);
    box-shadow: 0 4px 20px rgba(82, 104, 45, 0.15);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--kbm-green);
    color: #ffffff;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .card--pricing h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .card--pricing .button {
    display: block;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    box-sizing: border-box;
  }

  /* Guarantee Section */
  .section--guarantee {
    text-align: center;
  }

  .section--guarantee .section-inner {
    max-width: 650px;
    margin: 0 auto;
  }

  .guarantee-note {
    font-weight: 600;
    color: var(--kbm-green);
    font-style: italic;
  }

  /* About Section */
  .about-grid {
    align-items: center;
  }

  .about-content {
    text-align: left;
  }

  /* Media Elements */
  .media {
    margin: 2rem 0;
  }

  /* Divider */
  .kbm-divider {
    border: none;
    border-top: 1px solid #e5e8e0;
    margin: 2rem 0;
  }

  /* Final CTA */
  .section--cta {
    background: linear-gradient(135deg, #f9fdf5 0%, #e9ece7 100%);
    border-radius: 16px;
    padding: 3rem 2rem;
    margin-top: 1rem;
  }

  .section--cta h2 {
    margin-bottom: 1rem;
  }

  .section--cta p {
    max-width: 550px;
    margin: 0 auto 1.5rem;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .page--guided-workshop {
      padding: 1.5rem 1rem 3rem;
    }

    .hero-logo {
      width: 60px;
      height: 60px;
    }

    .card--pricing {
