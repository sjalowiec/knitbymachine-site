---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';

const title = "Guided Workshops";
const description = "Premium, guided, no-call workshops where Sue supports you through your project.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <SectionHero 
      title="Guided Workshops" 
      iconPath="/images/one-on-one_icon.png"
      iconAlt="Guided Workshops icon"
    />

    <div class="coming-soon-section">
      <div class="coming-soon-badge">Coming Soon</div>
      <h2 class="coming-soon-headline">Premium, guided support for your machine knitting projects</h2>
      <p class="coming-soon-text">
        Premium, guided, no-call workshops where Sue supports you through your project. Get personalized advice, troubleshooting help, and step-by-step guidance without scheduling calls.
      </p>
      <p class="coming-soon-text">
        Whether you're working through a challenging pattern or starting a new project, guided workshops give you the support you need at your own pace.
      </p>
      <p class="coming-soon-note">
        Check back soon for booking information and availability.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .coming-soon-section {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    background-color: #f9fdf5;
    border-radius: 16px;
    padding: 3rem 2.5rem;
  }

  .coming-soon-badge {
    display: inline-block;
    background-color: #52682D;
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    margin-bottom: 1.5rem;
  }

  .coming-soon-headline {
    font-size: clamp(1.5rem, 3vw, 1.8rem);
    font-weight: 700;
    color: #52682D;
    line-height: 1.3;
    margin: 0 0 1.5rem 0;
  }

  .coming-soon-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }

  .coming-soon-note {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    color: #738c52;
    font-style: italic;
    margin: 2rem 0 0 0;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 1.5rem 1rem 3rem;
    }

    .coming-soon-section {
      padding: 2rem 1.5rem;
    }
  }
</style>
