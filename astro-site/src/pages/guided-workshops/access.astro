---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const reason = Astro.url.searchParams.get('reason') || '';
const returnTo = Astro.url.searchParams.get('returnTo') || '';
const defaultDestination = '/guided-workshops/';

// Server-side auth check (same helper as hub.astro)
const cookies = Astro.cookies;
const accessToken = cookies.get('Outseta.accessToken')?.value || 
                    cookies.get('outseta-access-token')?.value ||
                    cookies.get('o_accessToken')?.value;

const isAuthenticated = !!accessToken;

// If authenticated and returnTo is in query string, redirect immediately (server-side)
if (isAuthenticated && returnTo) {
  return Astro.redirect(returnTo);
}

// Outseta login widget URL
const loginUrl = 'https://knitbymachinecom.outseta.com/widgets/auth?widgetMode=login';
---

<BaseLayout title="Workshop Access" description="Log in to access your guided workshop">
  <div class="access-container">
    <div class="access-card" id="access-card">
      {isAuthenticated ? (
        <!-- Authenticated but no returnTo in URL - client-side redirect via localStorage -->
        <p class="access-message">Redirecting you to your workshop...</p>
      ) : (
        <!-- Not authenticated - show login UI -->
        <>
          <h1 class="access-title">Workshop Access</h1>
          <p class="access-message">
            This workshop is private. Please log in to continue.
          </p>
          <a href={loginUrl} class="access-btn" data-testid="button-login">
            Log in
          </a>
          <p class="access-help">
            Need help? Contact <a href="mailto:sue@knitbymachine.com">sue@knitbymachine.com</a>
          </p>
        </>
      )}
    </div>
  </div>
  
  <script define:vars={{ returnTo, isAuthenticated, defaultDestination }}>
    // Store returnTo in localStorage when present (for post-login redirect)
    if (returnTo) {
      localStorage.setItem('kbm:returnTo', returnTo);
    }

    // Client-side redirect fallback for authenticated users without returnTo in URL
    if (isAuthenticated) {
      const storedReturnTo = localStorage.getItem('kbm:returnTo');
      const destination = storedReturnTo || defaultDestination;
      localStorage.removeItem('kbm:returnTo');
      window.location.assign(destination);
    }
  </script>
  
  <style>
    .access-container {
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }
    
    .access-card {
      max-width: 420px;
      text-align: center;
      padding: 2.5rem 2rem;
      border: 1px solid rgba(82, 104, 45, 0.15);
      border-radius: 16px;
      background: rgba(248, 250, 245, 0.5);
    }
    
    .access-title {
      margin: 0 0 1rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a1a1a;
    }
    
    .access-message {
      margin: 0 0 1.5rem;
      font-size: 1rem;
      color: #555;
      line-height: 1.5;
    }
    
    .access-btn {
      display: inline-block;
      padding: 0.85rem 2rem;
      font-size: 1rem;
      font-weight: 600;
      color: #fff;
      background: #52682d;
      border: none;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s ease, transform 0.1s ease;
    }
    
    .access-btn:hover {
      background: #3d4f22;
    }
    
    .access-btn:active {
      transform: scale(0.98);
    }
    
    .access-help {
      margin: 1.5rem 0 0;
      font-size: 0.875rem;
      color: #888;
    }
    
    .access-help a {
      color: #52682d;
    }
  </style>
</BaseLayout>
