---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const returnTo = Astro.url.searchParams.get('returnTo') || '';
const hasReturnToParam = !!returnTo;
---

<BaseLayout title="Workshop Access" description="Log in to access your guided workshop">
  <div class="access-container">
    <div class="access-card" id="access-card">
      <h1 class="access-title">Workshop Access</h1>
      
      {hasReturnToParam ? (
        <!-- User arrived from hub gate - show login UI -->
        <p class="access-message" id="access-message">
          This workshop is private. Please log in to continue.
        </p>
      ) : (
        <!-- User arrived after login (no returnTo param) - check auth -->
        <p class="access-message" id="access-message">
          If you just logged in, sending you to your workshop...
        </p>
      )}
      
      <button class="access-btn" id="login-btn" data-testid="button-login" data-outseta-auth="login">
        Log in
      </button>
      <p class="access-help">
        Need help? Contact <a href="mailto:sue@knitbymachine.com">sue@knitbymachine.com</a>
      </p>
    </div>
  </div>
  
  <script define:vars={{ returnTo, hasReturnToParam }}>
    // A) If returnTo param exists, store it and wait for user to click login
    if (hasReturnToParam && returnTo) {
      localStorage.setItem('kbm:returnTo', returnTo);
    }

    // B) If NO returnTo param, this is likely a post-login redirect from Outseta
    // Attempt to redirect to stored returnTo after confirming auth
    if (!hasReturnToParam) {
      const storedReturnTo = localStorage.getItem('kbm:returnTo');
      
      // Safety: only redirect to /guided-workshops/ paths
      const isValidPath = storedReturnTo && storedReturnTo.startsWith('/guided-workshops/');
      
      // Loop guard: don't redirect if we're already in a redirect attempt
      const isRedirecting = sessionStorage.getItem('kbm:redirecting') === '1';
      
      if (isValidPath && !isRedirecting) {
        // Retry delays: 250ms, 750ms, 1500ms
        const delays = [250, 750, 1500];
        let attempt = 0;

        function attemptRedirect() {
          if (typeof window.Outseta === 'undefined') {
            // Outseta not loaded yet, retry
            if (attempt < delays.length) {
              setTimeout(attemptRedirect, delays[attempt]);
              attempt++;
            }
            return;
          }

          window.Outseta.getUser()
            .then(function(user) {
              if (user) {
                // User confirmed - set loop guard and redirect
                sessionStorage.setItem('kbm:redirecting', '1');
                
                // Update UI
                const msgEl = document.getElementById('access-message');
                const btnEl = document.getElementById('login-btn');
                if (msgEl) msgEl.textContent = 'Redirecting you to your workshop...';
                if (btnEl) btnEl.style.display = 'none';
                
                // Redirect (don't clear localStorage yet - hub will clear it)
                window.location.assign(storedReturnTo);
              } else {
                // No user - retry if attempts remain
                if (attempt < delays.length) {
                  setTimeout(attemptRedirect, delays[attempt]);
                  attempt++;
                } else {
                  // All retries exhausted, show login button
                  const msgEl = document.getElementById('access-message');
                  if (msgEl) msgEl.textContent = 'Please log in to access your workshop.';
                }
              }
            })
            .catch(function(err) {
              // Error checking auth - retry or show login
              if (attempt < delays.length) {
                setTimeout(attemptRedirect, delays[attempt]);
                attempt++;
              } else {
                const msgEl = document.getElementById('access-message');
                if (msgEl) msgEl.textContent = 'Please log in to access your workshop.';
              }
            });
        }

        // Start first attempt after initial delay
        setTimeout(attemptRedirect, delays[0]);
        attempt++;
      } else if (!isValidPath && !isRedirecting) {
        // No valid returnTo stored, show login message
        const msgEl = document.getElementById('access-message');
        if (msgEl) msgEl.textContent = 'Please log in to access your workshop.';
      }
    }
  </script>
  
  <style>
    .access-container {
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }
    
    .access-card {
      max-width: 420px;
      text-align: center;
      padding: 2.5rem 2rem;
      border: 1px solid rgba(82, 104, 45, 0.15);
      border-radius: 16px;
      background: rgba(248, 250, 245, 0.5);
    }
    
    .access-title {
      margin: 0 0 1rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a1a1a;
    }
    
    .access-message {
      margin: 0 0 1.5rem;
      font-size: 1rem;
      color: #555;
      line-height: 1.5;
    }
    
    .access-btn {
      display: inline-block;
      padding: 0.85rem 2rem;
      font-size: 1rem;
      font-weight: 600;
      color: #fff;
      background: #52682d;
      border: none;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s ease, transform 0.1s ease;
    }
    
    .access-btn:hover {
      background: #3d4f22;
    }
    
    .access-btn:active {
      transform: scale(0.98);
    }
    
    .access-help {
      margin: 1.5rem 0 0;
      font-size: 0.875rem;
      color: #888;
    }
    
    .access-help a {
      color: #52682d;
    }
  </style>
</BaseLayout>
