---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const returnTo = Astro.url.searchParams.get('returnTo') || '';

// Outseta login widget URL
const loginUrl = 'https://knitbymachinecom.outseta.com/widgets/auth?widgetMode=login';
---

<BaseLayout title="Workshop Access" description="Log in to access your guided workshop">
  <div class="access-container">
    <div class="access-card" id="access-card">
      <h1 class="access-title">Workshop Access</h1>
      <p class="access-message" id="access-message">
        This workshop is private. Please log in to continue.
      </p>
      <a href={loginUrl} class="access-btn" id="login-btn" data-testid="button-login">
        Log in
      </a>
      <p class="access-help">
        Need help? Contact <a href="mailto:sue@knitbymachine.com">sue@knitbymachine.com</a>
      </p>
    </div>
  </div>
  
  <script define:vars={{ returnTo }}>
    // Step 1: If returnTo is in the URL, store it in localStorage with timestamp
    if (returnTo) {
      localStorage.setItem('kbm:returnTo', returnTo);
      localStorage.setItem('kbm:returnToSetAt', Date.now().toString());
    }

    // Step 2: Check if user is logged in via Outseta (client-side)
    // This runs after login when Outseta redirects back to /guided-workshops/access
    function checkAuthAndRedirect() {
      if (typeof window.Outseta === 'undefined') {
        // Outseta not loaded yet, retry in 200ms
        setTimeout(checkAuthAndRedirect, 200);
        return;
      }

      window.Outseta.getUser()
        .then(function(user) {
          if (user) {
            // User is logged in - check for stored returnTo
            const storedReturnTo = localStorage.getItem('kbm:returnTo');
            
            if (storedReturnTo && storedReturnTo.startsWith('/guided-workshops/')) {
              // Clear localStorage BEFORE redirect to prevent loops
              localStorage.removeItem('kbm:returnTo');
              localStorage.removeItem('kbm:returnToSetAt');
              
              // Update UI to show redirecting message
              const msgEl = document.getElementById('access-message');
              const btnEl = document.getElementById('login-btn');
              if (msgEl) msgEl.textContent = 'Redirecting you to your workshop...';
              if (btnEl) btnEl.style.display = 'none';
              
              // Redirect to the stored path
              window.location.assign(storedReturnTo);
            }
          }
        })
        .catch(function(err) {
          // Not logged in or error - do nothing, show login UI
          console.log('Outseta auth check:', err);
        });
    }

    // Start the auth check
    checkAuthAndRedirect();
  </script>
  
  <style>
    .access-container {
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }
    
    .access-card {
      max-width: 420px;
      text-align: center;
      padding: 2.5rem 2rem;
      border: 1px solid rgba(82, 104, 45, 0.15);
      border-radius: 16px;
      background: rgba(248, 250, 245, 0.5);
    }
    
    .access-title {
      margin: 0 0 1rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a1a1a;
    }
    
    .access-message {
      margin: 0 0 1.5rem;
      font-size: 1rem;
      color: #555;
      line-height: 1.5;
    }
    
    .access-btn {
      display: inline-block;
      padding: 0.85rem 2rem;
      font-size: 1rem;
      font-weight: 600;
      color: #fff;
      background: #52682d;
      border: none;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s ease, transform 0.1s ease;
    }
    
    .access-btn:hover {
      background: #3d4f22;
    }
    
    .access-btn:active {
      transform: scale(0.98);
    }
    
    .access-help {
      margin: 1.5rem 0 0;
      font-size: 0.875rem;
      color: #888;
    }
    
    .access-help a {
      color: #52682d;
    }
  </style>
</BaseLayout>
