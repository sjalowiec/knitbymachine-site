---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Machine Knitting Talk | Knit by Machine" 
  description="Ask questions, share progress, and connect with other machine knitters in our MK Talk forum."
>
  <section class="community-page">
    <div class="community-content">
      <!-- Hero section (always visible) -->
      <div class="hero-section">
        <h1>Come talk with us</h1>
        <p class="intro">
          A friendly space for machine knitters to ask questions, share progress, 
          and get unstuck — without digging through scattered resources.
        </p>
      </div>

      <!-- Feature cards (always visible, clickable) -->
      <div class="features-grid">
        <div class="feature-card community-card" data-topic="help" data-testid="card-help">
          <img src="/images/community_talk.svg" alt="" class="feature-icon" />
          <h3>Ask for help</h3>
          <p>Post your question and get practical replies.</p>
        </div>
        <div class="feature-card community-card" data-topic="show-and-tell" data-testid="card-show-and-tell">
          <img src="/images/community_talk.svg" alt="" class="feature-icon" />
          <h3>Show & Tell</h3>
          <p>Share a photo, a swatch, or a finished piece.</p>
        </div>
        <div class="feature-card community-card" data-topic="introductions" data-testid="card-introductions">
          <img src="/images/community_talk.svg" alt="" class="feature-icon" />
          <h3>Introductions</h3>
          <p>Say hi and tell us what you're knitting.</p>
        </div>
        <div class="feature-card community-card" data-topic="wins" data-testid="card-wins">
          <img src="/images/community_talk.svg" alt="" class="feature-icon" />
          <h3>Small wins</h3>
          <p>First cast-on counts. Really.</p>
        </div>
      </div>

      <!-- Sticky topic switcher (appears when cards scroll out of view) -->
      <div id="topic-switcher" hidden>
        <button data-topic="introductions" data-testid="switcher-introductions">Introductions</button>
        <button data-topic="help" data-testid="switcher-help">Ask for Help</button>
        <button data-topic="show-and-tell" data-testid="switcher-show-and-tell">Show & Tell</button>
        <button data-topic="wins" data-testid="switcher-wins">Wins</button>
      </div>

      <!-- Step 1: Gate form (hidden after unlock) -->
      <section id="gate-block">
        <div class="gate-form-container">
          <h2>Enter your details to join the conversation</h2>
          <p class="gate-description">We just need your name and email to get you started.</p>
          
          <form id="community-gate-form" class="gate-form kbm-gate-form">
            <div class="form-group">
              <label for="firstName">First Name <span class="required">*</span></label>
              <input 
                type="text" 
                id="firstName" 
                name="firstName" 
                required 
                placeholder="Your first name"
                data-testid="input-firstName"
              />
            </div>
            
            <div class="form-group">
              <label for="email">Email <span class="required">*</span></label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="your@email.com"
                data-testid="input-email"
              />
            </div>
            
            <button type="submit" class="submit-button kbm-button" data-testid="button-submit">
              Join the conversation
            </button>
            
            <p id="form-error" class="form-error" hidden></p>
          </form>
        </div>
      </section>

      <!-- Topic thread (shown after topic selection) -->
      <section id="topic-thread" hidden>
        <div class="thread-header">
          <h2 id="thread-title"></h2>
          <p class="thread-hint">Click a different card above to switch topics</p>
        </div>
        
        <div class="hyvor-talk-container">
          <hyvor-talk-comments 
            id="hyvor-comments"
            website-id="14706"
            data-testid="hyvor-talk-comments"
          ></hyvor-talk-comments>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script async src="https://talk.hyvor.com/embed/embed.js" type="module"></script>

<script>
  (function() {
    function initCommunity() {
      var unlocked = false;
      var topic = null;
      
      try {
        unlocked = localStorage.getItem("kbm:community-unlocked") === "1";
        topic = localStorage.getItem("kbm:community-topic");
      } catch (e) {}

      var gate = document.getElementById("gate-block");
      var thread = document.getElementById("topic-thread");

      if (!unlocked) {
        if (gate) gate.hidden = false;
        if (thread) thread.hidden = true;
        setupGateForm();
      } else {
        if (gate) gate.hidden = true;
        if (topic) {
          if (thread) thread.hidden = false;
          loadHyvor(topic);
          highlightSelectedCard(topic);
        } else {
          if (thread) thread.hidden = true;
        }
      }

      setupCardListeners(unlocked);
    }

    function setupGateForm() {
      var form = document.getElementById("community-gate-form");
      var errorEl = document.getElementById("form-error");

      if (form) {
        form.addEventListener("submit", function(e) {
          e.preventDefault();
          
          var firstNameInput = document.getElementById("firstName");
          var emailInput = document.getElementById("email");
          var firstName = firstNameInput ? firstNameInput.value.trim() : "";
          var email = emailInput ? emailInput.value.trim() : "";
          
          if (!firstName) {
            if (errorEl) {
              errorEl.textContent = "First name is required.";
              errorEl.removeAttribute("hidden");
            }
            return;
          }
          
          if (!email) {
            if (errorEl) {
              errorEl.textContent = "Email is required.";
              errorEl.removeAttribute("hidden");
            }
            return;
          }
          
          var submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Processing...";
          }
          
          fetch("/.netlify/functions/pp-unlock", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              firstName: firstName,
              email: email,
              projectId: "community",
            }),
          })
          .then(function(response) {
            return response.json();
          })
          .then(function(result) {
            if (result.ok) {
              localStorage.setItem("kbm:community-unlocked", "1");
              location.reload();
            } else {
              if (errorEl) {
                errorEl.textContent = result.message || "Something went wrong. Please try again.";
                errorEl.removeAttribute("hidden");
              }
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Join the conversation";
              }
            }
          })
          .catch(function(err) {
            if (errorEl) {
              errorEl.textContent = "Network error. Please check your connection and try again.";
              errorEl.removeAttribute("hidden");
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Join the conversation";
            }
          });
        });
      }
    }

    function setupCardListeners(unlocked) {
      var elements = document.querySelectorAll("[data-topic]");
      
      elements.forEach(function(el) {
        el.style.cursor = "pointer";
        
        el.addEventListener("click", function() {
          var topic = el.dataset.topic;
          
          if (!unlocked) {
            var gateBlock = document.getElementById("gate-block");
            if (gateBlock) {
              gateBlock.scrollIntoView({
                behavior: "smooth",
                block: "center"
              });
            }
            return;
          }
          
          localStorage.setItem("kbm:community-topic", topic);
          location.reload();
        });
      });
    }

    function highlightSelectedCard(topic) {
      document.querySelectorAll("[data-topic]").forEach(function(el) {
        if (el.dataset.topic === topic) {
          el.classList.add("selected");
        } else {
          el.classList.remove("selected");
        }
      });
    }

    function loadHyvor(topic) {
      var map = {
        "introductions": "community-introductions",
        "help": "community-help",
        "show-and-tell": "community-show-and-tell",
        "wins": "community-wins"
      };

      var titleMap = {
        "introductions": "Introductions",
        "help": "Ask for Help",
        "show-and-tell": "Show & Tell",
        "wins": "Wins This Week"
      };

      var hyvorEl = document.getElementById("hyvor-comments");
      var titleEl = document.getElementById("thread-title");

      if (titleEl) {
        titleEl.textContent = titleMap[topic] || "Community";
      }

      if (hyvorEl) {
        hyvorEl.setAttribute("page-id", map[topic] || "community");
      }
    }

    function setupStickyTopicSwitcher(unlocked) {
      var cards = document.querySelector(".features-grid");
      var switcher = document.getElementById("topic-switcher");

      if (!cards || !switcher || !unlocked) return;

      var observer = new IntersectionObserver(
        function(entries) {
          entries.forEach(function(entry) {
            switcher.hidden = entry.isIntersecting;
          });
        },
        { threshold: 0 }
      );

      observer.observe(cards);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initCommunity();
        var unlocked = false;
        try { unlocked = localStorage.getItem("kbm:community-unlocked") === "1"; } catch(e) {}
        setupStickyTopicSwitcher(unlocked);
      });
    } else {
      initCommunity();
      var unlocked = false;
      try { unlocked = localStorage.getItem("kbm:community-unlocked") === "1"; } catch(e) {}
      setupStickyTopicSwitcher(unlocked);
    }
  })();
</script>

<style>
  .community-page {
    padding: 3rem 1rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .community-content {
    text-align: center;
  }

  /* Hero section */
  .hero-section {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: var(--text-xxl);
    color: var(--kbm-green);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: var(--text-lg);
    color: #555;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Feature cards grid (always visible) */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .feature-card {
    background: #f9f9f9;
    border: 1px solid #e8e8e8;
    border-radius: 10px;
    padding: 1.25rem 1rem;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .feature-card.community-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.06);
  }

  .feature-card.community-card.selected {
    border-color: var(--kbm-green);
    background: #f0f8f0;
  }

  /* Sticky topic switcher */
  #topic-switcher {
    position: sticky;
    top: 0;
    z-index: 20;
    background: white;
    padding: 0.5rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    border-bottom: 1px solid #eee;
    margin-bottom: 1rem;
  }

  #topic-switcher button {
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    color: #444;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #topic-switcher button:hover {
    background: #e8f4e8;
    border-color: var(--kbm-green);
    color: var(--kbm-green);
  }

  #topic-switcher button.selected {
    background: var(--kbm-green);
    border-color: var(--kbm-green);
    color: white;
  }

  .feature-card .feature-icon {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0 auto 0.5rem;
  }

  .feature-card h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.4rem;
  }

  .feature-card p {
    font-size: var(--text-xs, 0.8rem);
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  /* Gate form container */
  .gate-form-container {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.5rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .gate-form-container h2 {
    font-size: var(--text-lg);
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .gate-description {
    font-size: var(--text-sm);
    color: #666;
    margin: 0 0 1.5rem;
  }

  /* Form styles */
  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kbm-gate-form {
    position: relative;
    z-index: 1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .form-group .required {
    color: #e74c3c;
  }

  .form-group input {
    padding: 0.75rem 1rem;
    font-size: var(--text-base);
    border: 1px solid #ccc;
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--kbm-green);
  }

  /* Submit button */
  .submit-button,
  .kbm-button {
    display: block !important;
    position: relative;
    z-index: 10;
    opacity: 1 !important;
    visibility: visible !important;
    background: var(--kbm-green) !important;
    color: white !important;
    padding: 1rem;
    border: none;
    border-radius: 8px;
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
    margin-top: 0.5rem;
    width: 100%;
  }

  .submit-button:hover,
  .submit-button:focus,
  .submit-button:focus-visible,
  .kbm-button:hover,
  .kbm-button:focus,
  .kbm-button:focus-visible {
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
    filter: none !important;
    mix-blend-mode: normal !important;
    background: var(--kbm-dark-green) !important;
    color: white !important;
    transform: translateY(-2px);
  }

  .submit-button:active,
  .kbm-button:active {
    transform: translateY(0);
  }

  .submit-button:disabled,
  .kbm-button:disabled {
    background: #999;
    color: white;
    cursor: not-allowed;
    transform: none;
  }

  .form-error {
    color: #e74c3c;
    font-size: var(--text-sm);
    margin: 0.5rem 0 0;
  }

  /* Thread section */
  .thread-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .thread-header h2 {
    font-size: var(--text-xl);
    color: var(--kbm-green);
    margin: 0;
  }

  .thread-hint {
    font-size: var(--text-sm);
    color: #888;
    margin: 0;
  }

  /* Hyvor Talk container */
  .hyvor-talk-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .community-page {
      padding: 2rem 1rem 3rem;
    }

    h1 {
      font-size: var(--text-xl);
    }

    .intro {
      font-size: var(--text-base);
    }

    .hero-section {
      margin-bottom: 2rem;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .feature-card {
      padding: 1rem 0.75rem;
    }

    .gate-form-container {
      padding: 1.5rem;
    }

    #topic-switcher {
      flex-wrap: wrap;
      padding: 0.4rem;
    }

    #topic-switcher button {
      font-size: 0.8rem;
      padding: 0.3rem 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
