---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Community | Knit by Machine" 
  description="Ask questions, share progress, and connect with other machine knitters in our community forum."
>
  <section class="community-page">
    <div class="community-content">
      <!-- Hero section (always visible) -->
      <div class="hero-section">
        <h1>Come knit with us</h1>
        <p class="intro">
          A friendly space for machine knitters to ask questions, share progress, 
          and get unstuck — without digging through scattered resources.
        </p>
      </div>

      <!-- Feature cards (always visible) -->
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">?</span>
          <h3>Ask for help</h3>
          <p>Post your question and get practical replies.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">&#9733;</span>
          <h3>Show & Tell</h3>
          <p>Share a photo, a swatch, or a finished piece.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">&#128161;</span>
          <h3>Learn from real situations</h3>
          <p>See how others solved the same issues.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">&#10003;</span>
          <h3>Small wins encouraged</h3>
          <p>First cast-on counts. Really.</p>
        </div>
      </div>
      
      <!-- Gate form (hidden after unlock) -->
      <div id="gate-block" class="gate-visible" style="display: block;">
        <div class="gate-form-container">
          <h2>Enter your details to access the community</h2>
          <p class="gate-description">We just need your name and email to get you started.</p>
          
          <form id="community-gate-form" class="gate-form kbm-gate-form">
            <div class="form-group">
              <label for="firstName">First Name <span class="required">*</span></label>
              <input 
                type="text" 
                id="firstName" 
                name="firstName" 
                required 
                placeholder="Your first name"
                data-testid="input-firstName"
              />
            </div>
            
            <div class="form-group">
              <label for="email">Email <span class="required">*</span></label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="your@email.com"
                data-testid="input-email"
              />
            </div>
            
            <button type="submit" class="submit-button kbm-button" data-testid="button-submit">
              Access the Community
            </button>
            
            <p id="form-error" class="form-error" hidden></p>
          </form>
        </div>
      </div>

      <!-- Unlocked content (shown after unlock) -->
      <div id="open-content" class="content-hidden" style="display: none;">
        <!-- Welcome panel -->
        <div class="welcome-panel">
          <h2>Welcome! Start here</h2>
          <div class="welcome-links">
            <a href="#introductions" class="welcome-link" data-testid="link-introductions">
              <span class="link-arrow">&#8594;</span> Say hello
            </a>
            <a href="#help" class="welcome-link" data-testid="link-help">
              <span class="link-arrow">&#8594;</span> Ask a question
            </a>
            <a href="#showandtell" class="welcome-link" data-testid="link-showandtell">
              <span class="link-arrow">&#8594;</span> Browse Show & Tell
            </a>
          </div>
          <p class="welcome-note">"I'm in there too — answering questions and cheering wins." — Sue</p>
        </div>

        <!-- Hyvor Talk comments -->
        <div class="hyvor-talk-container">
          <script async src="https://talk.hyvor.com/embed/embed.js" type="module"></script>
          <hyvor-talk-comments 
            website-id="14706" 
            page-id="community"
            data-testid="hyvor-talk-comments"
          ></hyvor-talk-comments>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  (function() {
    function initGate() {
      var gate = document.getElementById("gate-block");
      var open = document.getElementById("open-content");

      var unlocked = false;
      try {
        unlocked = localStorage.getItem("kbm:community-unlocked") === "1";
      } catch (e) {}

      if (unlocked) {
        if (gate) {
          gate.style.display = "none";
        }
        if (open) {
          open.style.display = "block";
        }
      } else {
        if (gate) {
          gate.style.display = "block";
        }
        if (open) {
          open.style.display = "none";
        }
      }

      var form = document.getElementById("community-gate-form");
      var errorEl = document.getElementById("form-error");

    if (form) {
      form.addEventListener("submit", function(e) {
        e.preventDefault();
        
        var firstNameInput = document.getElementById("firstName");
        var emailInput = document.getElementById("email");
        var firstName = firstNameInput ? firstNameInput.value.trim() : "";
        var email = emailInput ? emailInput.value.trim() : "";
        
        if (!firstName) {
          if (errorEl) {
            errorEl.textContent = "First name is required.";
            errorEl.removeAttribute("hidden");
          }
          return;
        }
        
        if (!email) {
          if (errorEl) {
            errorEl.textContent = "Email is required.";
            errorEl.removeAttribute("hidden");
          }
          return;
        }
        
        var submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Processing...";
        }
        
        fetch("/.netlify/functions/pp-unlock", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            firstName: firstName,
            email: email,
            projectId: "community",
          }),
        })
        .then(function(response) {
          return response.json();
        })
        .then(function(result) {
          if (result.ok) {
            localStorage.setItem("kbm:community-unlocked", "1");
            location.reload();
          } else {
            if (errorEl) {
              errorEl.textContent = result.message || "Something went wrong. Please try again.";
              errorEl.removeAttribute("hidden");
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Access the Community";
            }
          }
        })
        .catch(function(err) {
          if (errorEl) {
            errorEl.textContent = "Network error. Please check your connection and try again.";
            errorEl.removeAttribute("hidden");
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Access the Community";
          }
        });
      });
    }
    }

    // Run immediately if DOM is ready, otherwise wait
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGate);
    } else {
      initGate();
    }
  })();
</script>

<style>
  /* Gate visibility - CSS fallback ensures gate shows by default */
  #gate-block.gate-visible {
    display: block !important;
  }
  #gate-block.gate-hidden {
    display: none !important;
  }
  #open-content.content-hidden {
    display: none !important;
  }
  #open-content.content-visible {
    display: block !important;
  }

  .community-page {
    padding: 3rem 1rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .community-content {
    text-align: center;
  }

  /* Hero section */
  .hero-section {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: var(--text-xxl);
    color: var(--kbm-green);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: var(--text-lg);
    color: #555;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Feature cards grid (always visible) */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .feature-card {
    background: #f9f9f9;
    border: 1px solid #e8e8e8;
    border-radius: 10px;
    padding: 1.25rem 1rem;
    text-align: center;
  }

  .feature-card .feature-icon {
    display: block;
    font-size: 1.5rem;
    color: var(--kbm-green);
    margin-bottom: 0.5rem;
  }

  .feature-card h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.4rem;
  }

  .feature-card p {
    font-size: var(--text-xs, 0.8rem);
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  /* Gate form container */
  .gate-form-container {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.5rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .gate-form-container h2 {
    font-size: var(--text-lg);
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .gate-description {
    font-size: var(--text-sm);
    color: #666;
    margin: 0 0 1.5rem;
  }

  /* Form styles */
  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kbm-gate-form {
    position: relative;
    z-index: 1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .form-group .required {
    color: #e74c3c;
  }

  .form-group input {
    padding: 0.75rem 1rem;
    font-size: var(--text-base);
    border: 1px solid #ccc;
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--kbm-green);
  }

  /* Submit button - with defensive hover/focus fixes */
  .submit-button,
  .kbm-button {
    position: relative;
    z-index: 1;
    opacity: 1;
    visibility: visible;
    background: var(--kbm-green);
    color: white;
    padding: 1rem;
    border: none;
    border-radius: 8px;
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
    margin-top: 0.5rem;
  }

  .submit-button:hover,
  .submit-button:focus,
  .submit-button:focus-visible,
  .kbm-button:hover,
  .kbm-button:focus,
  .kbm-button:focus-visible {
    opacity: 1;
    visibility: visible;
    filter: none;
    mix-blend-mode: normal;
    background: var(--kbm-dark-green);
    color: white;
    transform: translateY(-2px);
  }

  .submit-button:active,
  .kbm-button:active {
    transform: translateY(0);
  }

  .submit-button:disabled,
  .kbm-button:disabled {
    background: #999;
    color: white;
    cursor: not-allowed;
    transform: none;
  }

  .form-error {
    color: #e74c3c;
    font-size: var(--text-sm);
    margin: 0.5rem 0 0;
  }

  /* Welcome panel (shown after unlock) */
  .welcome-panel {
    background: linear-gradient(135deg, #f0f8f0 0%, #e8f4e8 100%);
    border: 2px solid var(--kbm-green);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .welcome-panel h2 {
    font-size: var(--text-xl);
    color: var(--kbm-green);
    margin: 0 0 1.25rem;
  }

  .welcome-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .welcome-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: white;
    border: 1px solid var(--kbm-green);
    border-radius: 8px;
    color: var(--kbm-green);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .welcome-link:hover {
    background: var(--kbm-green);
    color: white;
  }

  .link-arrow {
    font-size: 1.1em;
  }

  .welcome-note {
    font-size: var(--text-sm);
    color: #555;
    font-style: italic;
    margin: 0;
  }

  /* Hyvor Talk container */
  .hyvor-talk-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .community-page {
      padding: 2rem 1rem 3rem;
    }

    h1 {
      font-size: var(--text-xl);
    }

    .intro {
      font-size: var(--text-base);
    }

    .hero-section {
      margin-bottom: 2rem;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .feature-card {
      padding: 1rem 0.75rem;
    }

    .gate-form-container {
      padding: 1.5rem;
    }

    .welcome-panel {
      padding: 1.5rem;
    }

    .welcome-links {
      flex-direction: column;
      align-items: stretch;
    }

    .welcome-link {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
