---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Machine Knitting Talk | Knit by Machine" 
  description="Ask questions, share progress, and connect with other machine knitters in our MK Talk forum."
>
  <section class="community-page">
    <div class="community-content">
      <!-- Hero section (always visible) -->
      <div class="hero-section">
        <h1>Come talk with us</h1>
        <p class="intro">
          A friendly space for machine knitters to ask questions, share progress, 
          and get unstuck — without digging through scattered resources.
        </p>
      </div>

      <!-- Feature cards (always visible) -->
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">?</span>
          <h3>Ask for help</h3>
          <p>Post your question and get practical replies.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">&#9733;</span>
          <h3>Show & Tell</h3>
          <p>Share a photo, a swatch, or a finished piece.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">&#128161;</span>
          <h3>Learn from real situations</h3>
          <p>See how others solved the same issues.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">&#10003;</span>
          <h3>Small wins encouraged</h3>
          <p>First cast-on counts. Really.</p>
        </div>
      </div>

      <!-- Step 1: Gate form (hidden after unlock) -->
      <section id="gate-block">
        <div class="gate-form-container">
          <h2>Enter your details to join the conversation</h2>
          <p class="gate-description">We just need your name and email to get you started.</p>
          
          <form id="community-gate-form" class="gate-form kbm-gate-form">
            <div class="form-group">
              <label for="firstName">First Name <span class="required">*</span></label>
              <input 
                type="text" 
                id="firstName" 
                name="firstName" 
                required 
                placeholder="Your first name"
                data-testid="input-firstName"
              />
            </div>
            
            <div class="form-group">
              <label for="email">Email <span class="required">*</span></label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="your@email.com"
                data-testid="input-email"
              />
            </div>
            
            <button type="submit" class="submit-button kbm-button" data-testid="button-submit">
              Join the conversation
            </button>
            
            <p id="form-error" class="form-error" hidden></p>
          </form>
        </div>
      </section>

      <!-- Step 2: Topic chooser (shown after unlock, before topic selection) -->
      <section id="topic-chooser" hidden>
        <div class="topic-chooser-container">
          <h2>What would you like to do?</h2>
          <p class="chooser-description">Pick a topic to join the conversation.</p>
          
          <div class="topic-chips">
            <button class="topic-chip" data-topic="introductions" data-testid="chip-introductions">
              <span class="chip-icon">&#128075;</span>
              Introductions
            </button>
            <button class="topic-chip" data-topic="help" data-testid="chip-help">
              <span class="chip-icon">?</span>
              Ask for Help
            </button>
            <button class="topic-chip" data-topic="show-and-tell" data-testid="chip-show-and-tell">
              <span class="chip-icon">&#9733;</span>
              Show & Tell
            </button>
            <button class="topic-chip" data-topic="wins" data-testid="chip-wins">
              <span class="chip-icon">&#127942;</span>
              Wins This Week
            </button>
          </div>
        </div>
      </section>

      <!-- Step 3: Topic thread (shown after topic selection) -->
      <section id="topic-thread" hidden>
        <div class="thread-header">
          <h2 id="thread-title"></h2>
          <button id="change-topic-btn" class="change-topic-link" data-testid="button-change-topic">
            &#8592; Choose a different topic
          </button>
        </div>
        
        <div class="hyvor-talk-container">
          <hyvor-talk-comments 
            id="hyvor-comments"
            website-id="14706"
            data-testid="hyvor-talk-comments"
          ></hyvor-talk-comments>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script async src="https://talk.hyvor.com/embed/embed.js" type="module"></script>

<script>
  (function() {
    function initCommunity() {
      var unlocked = false;
      var topic = null;
      
      try {
        unlocked = localStorage.getItem("kbm:community-unlocked") === "1";
        topic = localStorage.getItem("kbm:community-topic");
      } catch (e) {}

      var gate = document.getElementById("gate-block");
      var chooser = document.getElementById("topic-chooser");
      var thread = document.getElementById("topic-thread");

      if (!unlocked) {
        if (gate) gate.hidden = false;
        if (chooser) chooser.hidden = true;
        if (thread) thread.hidden = true;
        setupGateForm();
        return;
      }

      if (gate) gate.hidden = true;

      if (!topic) {
        if (chooser) chooser.hidden = false;
        if (thread) thread.hidden = true;
      } else {
        if (chooser) chooser.hidden = false;
        if (thread) thread.hidden = false;
        loadHyvor(topic);
        highlightSelectedChip(topic);
      }

      setupChipListeners();
      setupChangeTopicButton();
    }

    function setupGateForm() {
      var form = document.getElementById("community-gate-form");
      var errorEl = document.getElementById("form-error");

      if (form) {
        form.addEventListener("submit", function(e) {
          e.preventDefault();
          
          var firstNameInput = document.getElementById("firstName");
          var emailInput = document.getElementById("email");
          var firstName = firstNameInput ? firstNameInput.value.trim() : "";
          var email = emailInput ? emailInput.value.trim() : "";
          
          if (!firstName) {
            if (errorEl) {
              errorEl.textContent = "First name is required.";
              errorEl.removeAttribute("hidden");
            }
            return;
          }
          
          if (!email) {
            if (errorEl) {
              errorEl.textContent = "Email is required.";
              errorEl.removeAttribute("hidden");
            }
            return;
          }
          
          var submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Processing...";
          }
          
          fetch("/.netlify/functions/pp-unlock", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              firstName: firstName,
              email: email,
              projectId: "community",
            }),
          })
          .then(function(response) {
            return response.json();
          })
          .then(function(result) {
            if (result.ok) {
              localStorage.setItem("kbm:community-unlocked", "1");
              location.reload();
            } else {
              if (errorEl) {
                errorEl.textContent = result.message || "Something went wrong. Please try again.";
                errorEl.removeAttribute("hidden");
              }
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Access the Community";
              }
            }
          })
          .catch(function(err) {
            if (errorEl) {
              errorEl.textContent = "Network error. Please check your connection and try again.";
              errorEl.removeAttribute("hidden");
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Access the Community";
            }
          });
        });
      }
    }

    function setupChipListeners() {
      document.querySelectorAll("[data-topic]").forEach(function(btn) {
        btn.addEventListener("click", function() {
          localStorage.setItem("kbm:community-topic", btn.dataset.topic);
          location.reload();
        });
      });
    }

    function setupChangeTopicButton() {
      var changeBtn = document.getElementById("change-topic-btn");
      if (changeBtn) {
        changeBtn.addEventListener("click", function() {
          localStorage.removeItem("kbm:community-topic");
          location.reload();
        });
      }
    }

    function highlightSelectedChip(topic) {
      document.querySelectorAll("[data-topic]").forEach(function(btn) {
        if (btn.dataset.topic === topic) {
          btn.classList.add("selected");
        } else {
          btn.classList.remove("selected");
        }
      });
    }

    function loadHyvor(topic) {
      var map = {
        "introductions": "community-introductions",
        "help": "community-help",
        "show-and-tell": "community-show-and-tell",
        "wins": "community-wins"
      };

      var titleMap = {
        "introductions": "Introductions",
        "help": "Ask for Help",
        "show-and-tell": "Show & Tell",
        "wins": "Wins This Week"
      };

      var hyvorEl = document.getElementById("hyvor-comments");
      var titleEl = document.getElementById("thread-title");

      if (titleEl) {
        titleEl.textContent = titleMap[topic] || "Community";
      }

      if (hyvorEl) {
        hyvorEl.setAttribute("page-id", map[topic] || "community");
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCommunity);
    } else {
      initCommunity();
    }
  })();
</script>

<style>
  .community-page {
    padding: 3rem 1rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .community-content {
    text-align: center;
  }

  /* Hero section */
  .hero-section {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: var(--text-xxl);
    color: var(--kbm-green);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: var(--text-lg);
    color: #555;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Feature cards grid (always visible) */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .feature-card {
    background: #f9f9f9;
    border: 1px solid #e8e8e8;
    border-radius: 10px;
    padding: 1.25rem 1rem;
    text-align: center;
  }

  .feature-card .feature-icon {
    display: block;
    font-size: 1.5rem;
    color: var(--kbm-green);
    margin-bottom: 0.5rem;
  }

  .feature-card h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--kbm-green);
    margin: 0 0 0.4rem;
  }

  .feature-card p {
    font-size: var(--text-xs, 0.8rem);
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  /* Gate form container */
  .gate-form-container {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.5rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .gate-form-container h2 {
    font-size: var(--text-lg);
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .gate-description {
    font-size: var(--text-sm);
    color: #666;
    margin: 0 0 1.5rem;
  }

  /* Form styles */
  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kbm-gate-form {
    position: relative;
    z-index: 1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .form-group .required {
    color: #e74c3c;
  }

  .form-group input {
    padding: 0.75rem 1rem;
    font-size: var(--text-base);
    border: 1px solid #ccc;
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--kbm-green);
  }

  /* Submit button */
  .submit-button,
  .kbm-button {
    position: relative;
    z-index: 1;
    opacity: 1;
    visibility: visible;
    background: var(--kbm-green);
    color: white;
    padding: 1rem;
    border: none;
    border-radius: 8px;
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
    margin-top: 0.5rem;
  }

  .submit-button:hover,
  .submit-button:focus,
  .submit-button:focus-visible,
  .kbm-button:hover,
  .kbm-button:focus,
  .kbm-button:focus-visible {
    opacity: 1;
    visibility: visible;
    filter: none;
    mix-blend-mode: normal;
    background: var(--kbm-dark-green);
    color: white;
    transform: translateY(-2px);
  }

  .submit-button:active,
  .kbm-button:active {
    transform: translateY(0);
  }

  .submit-button:disabled,
  .kbm-button:disabled {
    background: #999;
    color: white;
    cursor: not-allowed;
    transform: none;
  }

  .form-error {
    color: #e74c3c;
    font-size: var(--text-sm);
    margin: 0.5rem 0 0;
  }

  /* Topic chooser */
  .topic-chooser-container {
    margin-bottom: 2rem;
  }

  .topic-chooser-container h2 {
    font-size: var(--text-xl);
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .chooser-description {
    font-size: var(--text-base);
    color: #666;
    margin: 0 0 1.5rem;
  }

  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: #f5f5f5;
    border: 2px solid #e0e0e0;
    border-radius: 50px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: #444;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .topic-chip:hover {
    background: #e8f4e8;
    border-color: var(--kbm-green);
    color: var(--kbm-green);
  }

  .topic-chip.selected {
    background: var(--kbm-green);
    border-color: var(--kbm-green);
    color: white;
  }

  .topic-chip.selected:hover {
    background: var(--kbm-dark-green);
    border-color: var(--kbm-dark-green);
    color: white;
  }

  .chip-icon {
    font-size: 1rem;
  }

  /* Thread section */
  .thread-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .thread-header h2 {
    font-size: var(--text-xl);
    color: var(--kbm-green);
    margin: 0;
  }

  .change-topic-link {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: transparent;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: var(--text-xs);
    color: #666;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .change-topic-link:hover {
    border-color: var(--kbm-green);
    color: var(--kbm-green);
  }

  /* Hyvor Talk container */
  .hyvor-talk-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .community-page {
      padding: 2rem 1rem 3rem;
    }

    h1 {
      font-size: var(--text-xl);
    }

    .intro {
      font-size: var(--text-base);
    }

    .hero-section {
      margin-bottom: 2rem;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .feature-card {
      padding: 1rem 0.75rem;
    }

    .gate-form-container {
      padding: 1.5rem;
    }

    .topic-chips {
      flex-direction: column;
      align-items: center;
    }

    .topic-chip {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
