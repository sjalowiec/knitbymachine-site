---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Community | Knit by Machine" 
  description="Ask questions, share progress, and connect with other machine knitters in our community forum."
>
  <section class="community-page">
    <div class="community-content">
      <h1>Join the Conversation</h1>
      <p class="intro">
        Connect with fellow machine knitters, ask questions, share your projects, 
        and learn from a friendly community of makers just like you.
      </p>
      
      <div id="gate-block" class="gate-visible">
        <div class="gate-form-container">
          <h2>Enter your details to access the community</h2>
          <p class="gate-description">We just need your name and email to get you started.</p>
          
          <form id="community-gate-form" class="gate-form">
            <div class="form-group">
              <label for="firstName">First Name <span class="required">*</span></label>
              <input 
                type="text" 
                id="firstName" 
                name="firstName" 
                required 
                placeholder="Your first name"
                data-testid="input-firstName"
              />
            </div>
            
            <div class="form-group">
              <label for="email">Email <span class="required">*</span></label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="your@email.com"
                data-testid="input-email"
              />
            </div>
            
            <button type="submit" class="submit-button" data-testid="button-submit">
              Access the Community
            </button>
            
            <p id="form-error" class="form-error" hidden></p>
          </form>
        </div>
        
        <div class="features">
          <div class="feature">
            <span class="feature-icon">?</span>
            <h3>Ask Questions</h3>
            <p>Get help with techniques, troubleshooting, and pattern questions from experienced knitters.</p>
          </div>
          <div class="feature">
            <span class="feature-icon">&#9733;</span>
            <h3>Share Your Work</h3>
            <p>Show off your finished projects and works in progress to an appreciative audience.</p>
          </div>
          <div class="feature">
            <span class="feature-icon">&#9825;</span>
            <h3>Learn Together</h3>
            <p>Discover tips, tricks, and resources shared by the community.</p>
          </div>
        </div>
      </div>

      <div id="open-content" class="content-hidden">
        <div class="discourse-embed-container">
          <iframe 
            src="https://knitbymachine.discourse.group/" 
            class="discourse-iframe"
            title="Knit by Machine Community Forum"
            data-testid="iframe-discourse"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var gate = document.getElementById("gate-block");
    var open = document.getElementById("open-content");

    var unlocked = false;
    try {
      unlocked = localStorage.getItem("kbm:community-unlocked") === "1";
    } catch (e) {}

    if (unlocked) {
      if (gate) {
        gate.classList.remove("gate-visible");
        gate.classList.add("gate-hidden");
      }
      if (open) {
        open.classList.remove("content-hidden");
        open.classList.add("content-visible");
      }
    } else {
      if (gate) {
        gate.classList.remove("gate-hidden");
        gate.classList.add("gate-visible");
      }
      if (open) {
        open.classList.remove("content-visible");
        open.classList.add("content-hidden");
      }
    }

    var form = document.getElementById("community-gate-form");
    var errorEl = document.getElementById("form-error");

    if (form) {
      form.addEventListener("submit", function(e) {
        e.preventDefault();
        
        var firstNameInput = document.getElementById("firstName");
        var emailInput = document.getElementById("email");
        var firstName = firstNameInput ? firstNameInput.value.trim() : "";
        var email = emailInput ? emailInput.value.trim() : "";
        
        if (!firstName) {
          if (errorEl) {
            errorEl.textContent = "First name is required.";
            errorEl.removeAttribute("hidden");
          }
          return;
        }
        
        if (!email) {
          if (errorEl) {
            errorEl.textContent = "Email is required.";
            errorEl.removeAttribute("hidden");
          }
          return;
        }
        
        var submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Processing...";
        }
        
        fetch("/.netlify/functions/pp-unlock", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            firstName: firstName,
            email: email,
            projectId: "community",
          }),
        })
        .then(function(response) {
          return response.json();
        })
        .then(function(result) {
          if (result.ok) {
            localStorage.setItem("kbm:community-unlocked", "1");
            location.reload();
          } else {
            if (errorEl) {
              errorEl.textContent = result.message || "Something went wrong. Please try again.";
              errorEl.removeAttribute("hidden");
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Access the Community";
            }
          }
        })
        .catch(function(err) {
          if (errorEl) {
            errorEl.textContent = "Network error. Please check your connection and try again.";
            errorEl.removeAttribute("hidden");
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Access the Community";
          }
        });
      });
    }
  });
</script>

<style>
  /* Gate visibility - CSS fallback ensures gate shows by default */
  #gate-block.gate-visible {
    display: block !important;
  }
  #gate-block.gate-hidden {
    display: none !important;
  }
  #open-content.content-hidden {
    display: none !important;
  }
  #open-content.content-visible {
    display: block !important;
  }

  .community-page {
    padding: 3rem 1rem 4rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .community-content {
    text-align: center;
  }

  h1 {
    font-size: var(--text-xxl);
    color: var(--kbm-green);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: var(--text-lg);
    color: #555;
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .gate-form-container {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.5rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .gate-form-container h2 {
    font-size: var(--text-lg);
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .gate-description {
    font-size: var(--text-sm);
    color: #666;
    margin: 0 0 1.5rem;
  }

  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .form-group .required {
    color: #e74c3c;
  }

  .form-group input {
    padding: 0.75rem 1rem;
    font-size: var(--text-base);
    border: 1px solid #ccc;
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--kbm-green);
  }

  .submit-button {
    background: var(--kbm-green);
    color: white;
    padding: 1rem;
    border: none;
    border-radius: 8px;
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
    margin-top: 0.5rem;
  }

  .submit-button:hover {
    background: var(--kbm-dark-green);
    transform: translateY(-2px);
  }

  .submit-button:active {
    transform: translateY(0);
  }

  .submit-button:disabled {
    background: #999;
    cursor: not-allowed;
    transform: none;
  }

  .form-error {
    color: #e74c3c;
    font-size: var(--text-sm);
    margin: 0.5rem 0 0;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .feature {
    background: #f9f9f9;
    border-radius: 8px;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .feature-icon {
    display: block;
    font-size: 1.75rem;
    color: var(--kbm-green);
    margin-bottom: 0.75rem;
  }

  .feature h3 {
    font-size: var(--text-base);
    color: var(--kbm-green);
    margin: 0 0 0.5rem;
  }

  .feature p {
    font-size: var(--text-sm);
    color: #666;
    margin: 0;
    line-height: 1.5;
  }

  .discourse-embed-container {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  .discourse-iframe {
    width: 100%;
    height: 80vh;
    min-height: 600px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .community-page {
      padding: 2rem 1rem 3rem;
    }

    h1 {
      font-size: var(--text-xl);
    }

    .intro {
      font-size: var(--text-base);
      margin-bottom: 2rem;
    }

    .gate-form-container {
      padding: 1.5rem;
    }

    .features {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .feature {
      padding: 1.25rem 1rem;
    }

    .discourse-iframe {
      height: 70vh;
      min-height: 500px;
    }
  }
</style>
