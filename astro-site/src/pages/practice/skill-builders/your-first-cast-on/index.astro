<script>
document.addEventListener('DOMContentLoaded', function() {
  // ============================================
  // GATE UNLOCK SYSTEM
  // ============================================
  var PROJECT_ID = 'pp-caston';
  var UNLOCK_KEY = 'kbm:pp-unlocked:' + PROJECT_ID;
  
  var gateBlock = document.getElementById('gate-block');
  var openContent = document.getElementById('open-content');
  var gateForm = document.getElementById('gate-form');
  var gateSubmit = document.getElementById('gate-submit');
  var gateEmail = document.getElementById('gate-email');
  var gateError = document.getElementById('gate-error');
  
  function isUnlocked() {
    try {
      return localStorage.getItem(UNLOCK_KEY) === '1';
    } catch (e) {
      return false;
    }
  }
  
  function setUnlocked() {
    try {
      localStorage.setItem(UNLOCK_KEY, '1');
    } catch (e) {
      // localStorage not available, continue anyway
    }
  }
  
  function showOpenContent() {
    if (gateBlock) gateBlock.setAttribute('hidden', '');
    if (openContent) {
      openContent.removeAttribute('hidden');
      openContent.classList.add('kbm-revealed');
      
      // Scroll to first section
      var firstSection = openContent.querySelector('.sb-section');
      if (firstSection) {
        setTimeout(function() {
          firstSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }
    }
  }
  
  function showGate() {
    if (gateBlock) gateBlock.removeAttribute('hidden');
    if (openContent) openContent.setAttribute('hidden', '');
  }
  
  // Check initial state
  if (isUnlocked()) {
    showOpenContent();
  } else {
    showGate();
  }
  
  // Form submission
  if (gateForm) {
    gateForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      var email = gateEmail ? gateEmail.value.trim() : '';
      if (!email) return;
      
      var btnLabel = gateSubmit ? gateSubmit.querySelector('.sb-btn-label') : null;
      var originalLabel = btnLabel ? btnLabel.textContent : 'Start the practice';
      
      // Disable and show loading
      if (gateSubmit) {
        gateSubmit.disabled = true;
        gateSubmit.setAttribute('aria-busy', 'true');
      }
      if (btnLabel) btnLabel.textContent = 'Starting…';
      if (gateError) gateError.textContent = '';
      
      fetch('/.netlify/functions/pp-unlock', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, projectId: PROJECT_ID })
      })
      .then(function(response) {
        return response.json().then(function(data) {
          return { ok: response.ok, data: data };
        });
      })
      .then(function(result) {
        if (result.ok && result.data.ok) {
          setUnlocked();
          showOpenContent();
        } else {
          throw new Error(result.data.message || 'Something went wrong. Please try again.');
        }
      })
      .catch(function(err) {
        if (gateError) gateError.textContent = err.message || 'Something went wrong. Please try again.';
        if (gateSubmit) {
          gateSubmit.disabled = false;
          gateSubmit.removeAttribute('aria-busy');
        }
        if (btnLabel) btnLabel.textContent = originalLabel;
      });
    });
  }

  // ============================================
  // TRANSCRIPT TOGGLE BUTTONS
  // ============================================
  var transcriptTriggers = document.querySelectorAll('[data-transcript-toggle]');
  
  transcriptTriggers.forEach(function(trigger) {
    var targetId = trigger.getAttribute('data-transcript-toggle');
    var details = document.getElementById('transcript-' + targetId);
    var label = trigger.querySelector('.sb-trigger-label');
    
    if (!details || !label) return;
    
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-controls', 'transcript-' + targetId);
    
    trigger.addEventListener('click', function() {
      var isOpen = details.hasAttribute('open');
      
      if (isOpen) {
        details.removeAttribute('open');
        trigger.setAttribute('aria-expanded', 'false');
        label.textContent = 'Show transcript';
      } else {
        details.setAttribute('open', '');
        trigger.setAttribute('aria-expanded', 'true');
        label.textContent = 'Hide transcript';
      }
    });
    
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.attributeName === 'open') {
          var isNowOpen = details.hasAttribute('open');
          trigger.setAttribute('aria-expanded', isNowOpen ? 'true' : 'false');
          label.textContent = isNowOpen ? 'Hide transcript' : 'Show transcript';
        }
      });
    });
    observer.observe(details, { attributes: true });
  });

  // ============================================
  // TRANSCRIPT CLOSE BUTTONS
  // ============================================
  var transcriptCloseButtons = document.querySelectorAll('[data-close-transcript]');
  
  transcriptCloseButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var details = btn.closest('details');
      if (details) {
        details.removeAttribute('open');
      }
    });
  });

  // ============================================
  // FAQ ACCORDION
  // ============================================
  var faqItems = document.querySelectorAll('.sb-faq-item');
  
  faqItems.forEach(function(item, index) {
    var question = item.querySelector('.sb-faq-question');
    var answer = item.querySelector('.sb-faq-answer');
    
    if (question && answer) {
      var answerId = 'sb-faq-answer-' + index;
      answer.id = answerId;
      question.setAttribute('aria-controls', answerId);
      question.setAttribute('aria-expanded', 'false');
      
      question.addEventListener('click', function() {
        var isOpen = item.classList.contains('open');
        
        faqItems.forEach(function(other) {
          if (other !== item) {
            other.classList.remove('open');
            var otherQuestion = other.querySelector('.sb-faq-question');
            if (otherQuestion) {
              otherQuestion.setAttribute('aria-expanded', 'false');
            }
          }
        });
        
        item.classList.toggle('open');
        question.setAttribute('aria-expanded', String(!isOpen));
      });
    }
  });

  // ============================================
  // VIDEO MODAL
  // ============================================
  var modal = document.getElementById('video-modal');
  var modalTitle = document.getElementById('video-modal-title');
  var videoFrame = document.getElementById('video-frame');
  var videoCards = document.querySelectorAll('.sb-video-card');
  var closeButtons = modal ? modal.querySelectorAll('[data-close]') : [];
  
  var triggerButton = null;

  function openModal(embedSrc, title, trigger) {
    if (!modal || !videoFrame || !modalTitle) return;
    
    triggerButton = trigger;
    
    modalTitle.textContent = title;
    
    videoFrame.classList.remove('loaded');
    videoFrame.innerHTML = '';
    
    if (embedSrc) {
      var iframe = document.createElement('iframe');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.setAttribute('title', title);
      iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;';
      
      iframe.onload = function() {
        videoFrame.classList.add('loaded');
      };
      
      videoFrame.appendChild(iframe);
      iframe.src = embedSrc;
    }
    
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('modal-open');
    
    var closeBtn = modal.querySelector('.video-modal__close');
    if (closeBtn) closeBtn.focus();
  }

  function closeModal() {
    if (!modal || !videoFrame || !modalTitle) return;
    
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('modal-open');
    
    videoFrame.innerHTML = '';
    videoFrame.classList.remove('loaded');
    
    modalTitle.textContent = 'Video';
    
    if (triggerButton) triggerButton.focus();
    triggerButton = null;
  }

  videoCards.forEach(function(card) {
    card.addEventListener('click', function() {
      var embedSrc = card.getAttribute('data-embed-src') || '';
      var title = card.getAttribute('data-title') || 'Video';
      openModal(embedSrc, title, card);
    });
  });

  closeButtons.forEach(function(el) {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal && modal.getAttribute('aria-hidden') === 'false') {
      closeModal();
    }
  });
});
</script>
