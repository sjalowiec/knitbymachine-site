<style>
/* ========== VIDEO MODAL SCOPED STYLES ========== */

.kbm-modal-trigger {
  display: inline-block;
  background: transparent;
  border: none;
  color: var(--kbm-green, #52682d);
  font-size: 0.9rem;
  font-style: italic;
  cursor: pointer;
  padding: 0.5rem 0;
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.2s ease;
}

.kbm-modal-trigger:hover,
.kbm-modal-trigger:focus {
  color: var(--kbm-green-hover, #445626);
  outline: 2px solid var(--kbm-green-2, #738c52);
  outline-offset: 2px;
  border-radius: 4px;
}

.kbm-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.kbm-modal[hidden] {
  display: none;
}

.kbm-modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
}

.kbm-modal-content {
  position: relative;
  background: #fff;
  border-radius: 12px;
  max-width: 900px;
  width: 100%;
  max-height: 90vh;
  overflow: auto;
  padding: 1.5rem;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.kbm-modal-close {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: transparent;
  border: none;
  font-size: 2rem;
  line-height: 1;
  color: #666;
  cursor: pointer;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.2s ease, color 0.2s ease;
}

.kbm-modal-close:hover,
.kbm-modal-close:focus {
  background: #f0f0f0;
  color: #333;
  outline: 2px solid var(--kbm-green-2, #738c52);
  outline-offset: 2px;
}

.kbm-modal-title {
  font-size: 1.25rem;
  color: var(--kbm-green, #52682d);
  margin: 0 0 1rem 0;
  padding-right: 2.5rem;
}

.kbm-video-wrapper {
  position: relative;
  padding-top: 56.25%; /* 16:9 aspect ratio */
  background: #000;
  border-radius: 8px;
  overflow: hidden;
}

.kbm-video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* Prevent body scroll when modal is open */
:global(body.kbm-modal-open) {
  overflow: hidden;
}

@media (max-width: 600px) {
  .kbm-modal-content {
    padding: 1rem;
    border-radius: 8px;
  }
  
  .kbm-modal-title {
    font-size: 1.1rem;
  }
}
</style>

<script>
// Video Modal - Accessible Implementation
document.addEventListener('DOMContentLoaded', () => {
  const trigger = document.getElementById('optionalVideoTrigger');
  const modal = document.getElementById('optionalVideoModal');
  const closeBtn = modal?.querySelector('.kbm-modal-close');
  const overlay = modal?.querySelector('.kbm-modal-overlay');
  const videoFrame = document.getElementById('modalVideoFrame');
  
  const VIDEO_URL = 'https://player.vimeo.com/video/312574558?badge=0&autopause=1';
  
  let previouslyFocused = null;
  
  function openModal() {
    if (!modal) return;
    
    // Save current focus
    previouslyFocused = document.activeElement;
    
    // Load video
    if (videoFrame) {
      videoFrame.src = VIDEO_URL;
    }
    
    // Show modal
    modal.hidden = false;
    document.body.classList.add('kbm-modal-open');
    
    // Focus close button
    closeBtn?.focus();
    
    // Add ESC listener
    document.addEventListener('keydown', handleEscape);
  }
  
  function closeModal() {
    if (!modal) return;
    
    // Hide modal
    modal.hidden = true;
    document.body.classList.remove('kbm-modal-open');
    
    // Stop video
    if (videoFrame) {
      videoFrame.src = '';
    }
    
    // Restore focus
    if (previouslyFocused && previouslyFocused.focus) {
      previouslyFocused.focus();
    }
    
    // Remove ESC listener
    document.removeEventListener('keydown', handleEscape);
  }
  
  function handleEscape(e) {
    if (e.key === 'Escape') {
      closeModal();
    }
  }
  
  // Event listeners
  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', closeModal);
});
</script>
