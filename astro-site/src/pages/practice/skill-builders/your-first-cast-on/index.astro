---
/**
 * Your First Cast-On (E-wrap) - Skill Builder Page
 * Slug: /practice/skill-builders/your-first-cast-on/
 */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { marked } from "marked";

// =============================================
// LOAD VIDEO DATA FROM CONTENT COLLECTION
// =============================================
const allVideos = await getCollection("videos");

// Video slugs used on this page
const videoSlugs = ["e-wrap-cast-on", "open-vs-closed-cast-on", "stitch-through-stitch-bind-off"];

// Build lookup object keyed by slug
const videoLookup: Record<string, {
  title: string;
  embedSrc: string;
  transcriptHtml: string;
  durationSeconds?: number;
}> = {};

for (const slug of videoSlugs) {
  const video = allVideos.find(v => v.slug === slug);
  if (video) {
    const vimeoId = video.data.vimeoId;
    const embedSrc = `https://player.vimeo.com/video/${vimeoId}?badge=0&autopause=0&player_id=0&app_id=58479`;
    const transcriptHtml = video.body ? await marked.parse(video.body) : "";
    
    videoLookup[slug] = {
      title: video.data.title,
      embedSrc,
      transcriptHtml,
      durationSeconds: video.data.durationSeconds
    };
  }
}

// Helper to format duration
function formatDuration(seconds?: number): string {
  if (!seconds) return "";
  const mins = Math.floor(seconds / 60);
  const secs = seconds % 60;
  return `${mins}:${secs.toString().padStart(2, "0")}`;
}

// =============================================
// FAQ DATA - Single source of truth
// =============================================
const faqs = [
  {
    question: "My yarn keeps falling off the needles during cast-on",
    answer: "Make sure each wrap is snug but not too tight. The yarn should sit securely in the needle hook. Try wrapping slightly further back on the needle. Use the fingers of your opposite hand or a transfer tool to guide the loops."
  },
  {
    question: "The first row is too tight and hard to knit",
    answer: "This is common! Try loosening your tension dial by 1–2 numbers for just the first row, then adjust back to your normal setting."
  },
  {
    question: "I'm getting dropped stitches on the edges",
    answer: "Check that your end needles are properly wrapped. Edge stitches often need a slightly firmer wrap. Also ensure your weights are evenly distributed."
  },
  {
    question: "The carriage won't move smoothly after cast-on",
    answer: "Your cast-on may be too tight. Gently tug down on the cast-on comb to give the needles room to move. If it persists, you may need to restart with a looser wrap. Try wrapping every other needle. Knit 1 row and put all needles in work and continue to knit"
  },
  {
    question: "How do I know if I'm wrapping in the right direction?",
    answer: "For E-wrap, wrap counter-clockwise around each needle when viewed from above. The yarn should form an \"e\" shape. Consistent direction matters more than which direction you choose."
  }
];

// Generate FAQPage JSON-LD schema
const faqSchema = faqs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}) : null;

const pageTitle = "Your Start & Finish | Skill Builder | Knit by Machine";
const pageDescription = "A clear demonstration of one cast on and one bind off, showing how the edge forms at the start and finish of your knitting.";

// =============================================
// GATE CONSTANTS
// =============================================
const PROJECT_ID = "pp-caston";
const UNLOCK_KEY = `kbm:pp-unlocked:${PROJECT_ID}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  {faqSchema && (
    <script type="application/ld+json" set:html={faqSchema} slot="head" />
  )}

  <div class="skill-builder-page">
    
    <!-- A) HERO SECTION - Compact with icon -->
    <section class="sb-hero">
      <div class="sb-hero-title-row">
        <img src="/images/practice-icon.png" alt="" aria-hidden="true" class="sb-hero-icon" />
        <div class="sb-hero-text">
          <h1>Your Start & Finish</h1>
          <p class="sb-subtitle">Cast On & Bind Off</p>
        </div>
      </div>
      <div class="sb-meta">
        <span class="sb-badge sb-price">$19</span>
        <span class="sb-badge sb-level">Beginner</span>
      </div>
    </section>

    <!-- GATE BLOCK - shown until email submitted -->
    <section class="sb-gate" id="gate-block" data-testid="gate-block">
      <div class="sb-gate-card">
        <h2 class="sb-gate-title">Your First Cast-On</h2>
        <p class="sb-gate-intro">This guided practice walks you through a simple cast on and bind off — the way every project starts and ends on a knitting machine. By the end, you'll have completed a small practice swatch and know what to expect when you begin a real project.</p>
        
        <div class="sb-gate-includes">
          <h3>What's included:</h3>
          <ul>
            <li>Step-by-step video demonstration</li>
            <li>Printable practice checklist</li>
            <li>Troubleshooting tips for common issues</li>
            <li>Terms and technique explanations</li>
          </ul>
        </div>
        
        <p class="sb-gate-price">Normally $19 — currently included at no cost while you're getting started.</p>
        
        <form id="gate-form" class="sb-gate-form" data-testid="form-gate">
          <div class="sb-gate-input-row">
            <label for="gate-email" class="sr-only">Email address</label>
            <input 
              type="email" 
              id="gate-email" 
              name="email" 
              placeholder="you@example.com" 
              required 
              autocomplete="email"
              class="sb-gate-input"
              data-testid="input-email"
            />
            <button type="submit" class="sb-gate-button" id="gate-submit" data-testid="button-submit">
              <span class="sb-btn-label">Start the practice</span>
            </button>
          </div>
          <p class="sb-gate-helper">You'll also get updates when new practice projects are added.</p>
          <p class="sb-gate-error" id="gate-error" role="status" aria-live="polite" data-testid="text-error"></p>
        </form>
      </div>
    </section>

    <!-- OPEN CONTENT - hidden until unlocked -->
    <div id="open-content" data-open-content hidden>

    <!-- B) QUICK SCAN SECTION -->
    <section class="sb-section">
      <h2>Quick Scan</h2>
      <div class="sb-quick-scan">
        <div class="sb-scan-card">
          <h3><i class="fa-solid fa-user-check"></i> Best For</h3>
          <p>New machine knitters seeing a cast on and bind off for the first time, and knitters who want a quick refresher.</p>
        </div>
        
        <div class="sb-scan-card">
          <h3><i class="fa-solid fa-list-check"></i> You'll Need</h3>
          <ul>
            <li>Your knitting machine (any brand)</li>
            <li>Yarn appropriate for your machine (light color, medium weight recommended)</li>
            <li>Claw weight, Cast-on comb (optional)</li>
          </ul>
        </div>
        
        <div class="sb-scan-card">
          <h3><i class="fa-solid fa-triangle-exclamation"></i> Watch For</h3>
          <ul>
            <li>Tension too tight on first row</li>
            <li>Missing needles during wrap</li>
            <li>Yarn not seated in latches</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- C) WHAT YOU'LL DO SECTION -->
    <section class="sb-section">
      <h2>What You'll Do</h2>
      <p>You'll cast on, knit a short practice piece, and bind off to see how the edge forms at the start and finish. By the end of this Skill Builder, you'll have completed a sample swatch and know what to expect from these techniques when you begin a project.</p>
    </section>

    <!-- D) VIDEO SECTION -->
    <section class="sb-section">
      <h2>Watch in Order</h2>
      
      <!-- Cast On Video -->
      <div class="sb-video-block">
        <div class="sb-video-tips-box">
          <h3 class="sb-video-heading">Watch first</h3>
          <ul class="sb-video-tips">
            <li>This video demonstrates the complete E-wrap cast-on from start to finish</li>
            <li>Pay attention to how the yarn wraps around each needle</li>
            <li>Notice the tension and hand positioning</li>
          </ul>
        </div>
        
        {videoLookup["e-wrap-cast-on"] && (
          <button
            type="button"
            class="sb-video-card"
            data-video-slug="e-wrap-cast-on"
            data-embed-src={videoLookup["e-wrap-cast-on"].embedSrc}
            data-title={videoLookup["e-wrap-cast-on"].title}
            aria-label={`Watch: ${videoLookup["e-wrap-cast-on"].title}`}
            data-testid="button-watch-e-wrap"
          >
            <div class="sb-thumb-frame">
              <div class="sb-play-overlay" aria-hidden="true">
                <svg class="sb-play-icon" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div class="sb-card-label">
              <span class="sb-card-title">{videoLookup["e-wrap-cast-on"].title}</span>
              <span class="sb-card-helper">Opens in a large player{videoLookup["e-wrap-cast-on"].durationSeconds ? `. ${formatDuration(videoLookup["e-wrap-cast-on"].durationSeconds)}` : ""}</span>
            </div>
          </button>
        )}
        
        {videoLookup["e-wrap-cast-on"]?.transcriptHtml && (
          <>
            <button type="button" class="sb-transcript-trigger" data-transcript-toggle="e-wrap-cast-on" data-testid="button-transcript-e-wrap">
              <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
              <span class="sb-trigger-label">Show transcript</span>
            </button>
            <details class="sb-transcript-accordion" id="transcript-e-wrap-cast-on" data-testid="accordion-transcript-e-wrap">
              <summary class="sb-transcript-summary-hidden" aria-hidden="true">Transcript</summary>
              <div class="sb-transcript-panel">
                <div class="sb-transcript-header">
                  <button type="button" class="sb-transcript-back" data-close-transcript data-testid="button-close-transcript-e-wrap">
                    Back to video
                  </button>
                </div>
                <div class="sb-transcript-content" set:html={videoLookup["e-wrap-cast-on"].transcriptHtml} />
              </div>
            </details>
          </>
        )}

        <!-- Optional: Open vs Closed Cast-On -->
        {videoLookup["open-vs-closed-cast-on"] && (
          <details class="sb-optional-video">
            <summary><i class="fa-solid fa-play"></i> Optional: Open vs Closed — what edge did you just make?</summary>
            <div class="sb-optional-video-content">
              <button
                type="button"
                class="sb-video-card"
                data-video-slug="open-vs-closed-cast-on"
                data-embed-src={videoLookup["open-vs-closed-cast-on"].embedSrc}
                data-title={videoLookup["open-vs-closed-cast-on"].title}
                aria-label={`Watch: ${videoLookup["open-vs-closed-cast-on"].title}`}
                data-testid="button-watch-open-vs-closed"
              >
                <div class="sb-thumb-frame">
                  <div class="sb-play-overlay" aria-hidden="true">
                    <svg class="sb-play-icon" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5,3 19,12 5,21" />
                    </svg>
                  </div>
                </div>
                <div class="sb-card-label">
                  <span class="sb-card-title">{videoLookup["open-vs-closed-cast-on"].title}</span>
                  <span class="sb-card-helper">Opens in a large player{videoLookup["open-vs-closed-cast-on"].durationSeconds ? `. ${formatDuration(videoLookup["open-vs-closed-cast-on"].durationSeconds)}` : ""}</span>
                </div>
              </button>
              
              {videoLookup["open-vs-closed-cast-on"]?.transcriptHtml && (
                <>
                  <button type="button" class="sb-transcript-trigger" data-transcript-toggle="open-vs-closed-cast-on" data-testid="button-transcript-open-vs-closed">
                    <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
                    <span class="sb-trigger-label">Show transcript</span>
                  </button>
                  <details class="sb-transcript-accordion" id="transcript-open-vs-closed-cast-on" data-testid="accordion-transcript-open-vs-closed">
                    <summary class="sb-transcript-summary-hidden" aria-hidden="true">Transcript</summary>
                    <div class="sb-transcript-panel">
                      <div class="sb-transcript-header">
                        <button type="button" class="sb-transcript-back" data-close-transcript data-testid="button-close-transcript-open-vs-closed">
                          Back to video
                        </button>
                      </div>
                      <div class="sb-transcript-content" set:html={videoLookup["open-vs-closed-cast-on"].transcriptHtml} />
                    </div>
                  </details>
                </>
              )}
            </div>
          </details>
        )}
      </div>
      
      <!-- Bind Off Video -->
      <div class="sb-video-block" style="margin-top: 2.5rem;">
        <div class="sb-video-tips-box">
          <h3 class="sb-video-heading">Finish your swatch</h3>
          <ul class="sb-video-tips">
            <li>This video demonstrates a stitch-through-stitch bind off worked by hand</li>
            <li>Notice how stitch size affects the finished edge</li>
            <li>Watch how the yarn is controlled as stitches are worked off the machine</li>
          </ul>
        </div>
        
        {videoLookup["stitch-through-stitch-bind-off"] && (
          <button
            type="button"
            class="sb-video-card"
            data-video-slug="stitch-through-stitch-bind-off"
            data-embed-src={videoLookup["stitch-through-stitch-bind-off"].embedSrc}
            data-title={videoLookup["stitch-through-stitch-bind-off"].title}
            aria-label={`Watch: ${videoLookup["stitch-through-stitch-bind-off"].title}`}
            data-testid="button-watch-bind-off"
          >
            <div class="sb-thumb-frame">
              <div class="sb-play-overlay" aria-hidden="true">
                <svg class="sb-play-icon" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div class="sb-card-label">
              <span class="sb-card-title">{videoLookup["stitch-through-stitch-bind-off"].title}</span>
              <span class="sb-card-helper">Opens in a large player{videoLookup["stitch-through-stitch-bind-off"].durationSeconds ? `. ${formatDuration(videoLookup["stitch-through-stitch-bind-off"].durationSeconds)}` : ""}</span>
            </div>
          </button>
        )}
        
        {videoLookup["stitch-through-stitch-bind-off"]?.transcriptHtml && (
          <>
            <button type="button" class="sb-transcript-trigger" data-transcript-toggle="stitch-through-stitch-bind-off" data-testid="button-transcript-bind-off">
              <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
              <span class="sb-trigger-label">Show transcript</span>
            </button>
            <details class="sb-transcript-accordion" id="transcript-stitch-through-stitch-bind-off" data-testid="accordion-transcript-bind-off">
              <summary class="sb-transcript-summary-hidden" aria-hidden="true">Transcript</summary>
              <div class="sb-transcript-panel">
                <div class="sb-transcript-header">
                  <button type="button" class="sb-transcript-back" data-close-transcript data-testid="button-close-transcript-bind-off">
                    Back to video
                  </button>
                </div>
                <div class="sb-transcript-content" set:html={videoLookup["stitch-through-stitch-bind-off"].transcriptHtml} />
              </div>
            </details>
          </>
        )}
      </div>
    </section>

    <!-- E) STEPS SECTION -->
    <section class="sb-section">
      <h2>Steps</h2>
      
      <div class="sb-print-link">
        <a href="/downloads/skill-builders/your-first-cast-on-practice-checklist.pdf" target="_blank" rel="noopener">
          Download the practice checklist (PDF)
        </a>
        <span class="sb-print-helper">Print this for your machine-side notes.</span>
      </div>
      
      <ol class="sb-steps">
        <li>Set up your machine on a stable surface and thread your yarn through the tension mast.</li>
        <li>Bring out the needles you want to use to the working position (usually 20–40 needles for practice).</li>
        <li>Starting from the left, wrap the yarn around each needle in an E-wrap pattern.</li>
        <li>Hang your cast-on comb and weights on the wrapped stitches.</li>
        <li>Set your tension dial to the recommended setting and slowly push the carriage across.</li>
        <li>Knit 10–20 rows to create your practice swatch.</li>
        <li>Prepare to bind off by pulling all needles forward and removing the yarn from the carriage.</li>
        <li>Work the stitch-through-stitch bind off by hand, keeping the stitches even as you remove them from the needles.</li>
        <li>Secure the final stitch and leave a short tail.</li>
      </ol>
    </section>

    <!-- F) PRACTICE SECTION -->
    <section class="sb-section">
      <h2>Practice</h2>
      <ul class="sb-practice-list">
        <li>Try casting on 20 needles, then 40 needles to feel the difference</li>
        <li>Experiment with different tension settings (note which feels best)</li>
        <li>Practice the E-wrap motion until it feels natural</li>
        <li>Time yourself: aim to cast on 40 stitches in under 2 minutes</li>
        <li>As you bind off, adjust stitch size slightly and notice how it changes the feel of the edge</li>
      </ul>
      
      <div class="sb-practice-callout">
        <strong>Practice Swatch:</strong> Aim to create a small swatch (about 4" x 4") using your new cast-on skills. Keep this swatch! It's proof of your progress and helpful for comparing tension later.
      </div>
    </section>

    <!-- G) TROUBLESHOOTING SECTION -->
    <section class="sb-section">
      <h2>Troubleshooting</h2>
      <div class="sb-faq">
        {faqs.map((faq, index) => (
          <div class="sb-faq-item">
            <button 
              class="sb-faq-question" 
              type="button"
              aria-controls={`sb-faq-answer-${index}`}
              aria-expanded="false"
            >
              {faq.question}
            </button>
            <div class="sb-faq-answer" id={`sb-faq-answer-${index}`}>
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- H) TERMS USED SECTION -->
    <section class="sb-section">
      <h2>Terms Used</h2>
      <dl class="sb-terms-list">
        <div class="sb-term">
          <dt>Open Cast-On</dt>
          <dd>A cast-on method that creates an open, loopy edge. The bottom of your knitting isn't closed, allowing you to pick up stitches later or unravel from the bottom.</dd>
        </div>
        
        <div class="sb-term">
          <dt>Closed Cast-On</dt>
          <dd>A cast-on method that creates a finished, sealed edge. The bottom is closed and neat—you won't be able to unravel from this end.</dd>
        </div>
        
        <div class="sb-term">
          <dt>Stitch-Through-Stitch Bind Off</dt>
          <dd>A hand-worked bind off where each stitch is pulled through the next to form a chained edge with adjustable stretch.</dd>
        </div>
      </dl>
    </section>

    <!-- I) WHAT'S NEXT SECTION -->
    <section class="sb-section sb-whats-next">
      <h2>What's Next</h2>
      <div class="sb-next-buttons">
        <a href="#" class="sb-next-btn">
          Next: Basic Bind-Off
        </a>
        <a href="#" class="sb-next-btn secondary">
          Explore More Skill Builders
        </a>
        <a href="/" class="sb-next-btn secondary">
          Back to Home
        </a>
      </div>
    </section>

    </div><!-- /data-open-content -->

  </div>

  <!-- VIDEO MODAL -->
  <div class="video-modal" id="video-modal" aria-hidden="true" data-testid="modal-video">
    <div class="video-modal__backdrop" data-close></div>
    <div class="video-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="video-modal-title">
      <div class="video-modal__header">
        <h2 id="video-modal-title" data-testid="text-modal-title">Video</h2>
        <button type="button" class="video-modal__close" data-close aria-label="Close video" data-testid="button-modal-close">&#10005;</button>
      </div>
      <div class="video-modal__body">
        <div class="video-frame" id="video-frame"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
/* ========================================
   SKILL BUILDER PAGE - SCOPED STYLES
   ======================================== */

.skill-builder-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

/* A) Hero Section - Compact */
.sb-hero {
  text-align: center;
  padding: 1rem 1rem 1.25rem;
  margin-bottom: 2rem;
  background: linear-gradient(135deg, #f0f4eb 0%, #e9ece7 100%);
  border-radius: 12px;
  border: 1px solid var(--ring, #e5e8e0);
}

.sb-hero-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 0.5rem;
}

.sb-hero-icon {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
}

.sb-hero-text {
  text-align: left;
}

.sb-hero h1 {
  font-size: var(--text-xl, 1.5rem);
  color: var(--kbm-green, #52682d);
  margin: 0;
  line-height: 1.2;
}

.sb-subtitle {
  font-size: 1rem;
  color: #555;
  margin: 0.25rem 0 0 0;
}

.sb-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
}

.sb-badge {
  display: inline-block;
  padding: 0.3rem 0.75rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
}

.sb-price {
  background: var(--kbm-green, #52682d);
  color: #fff;
}

.sb-level {
  background: var(--kbm-green-2, #738c52);
  color: #fff;
}

/* Section styling */
.sb-section {
  margin-bottom: 2.5rem;
  padding: 1.5rem;
  background: #fff;
  border-radius: 8px;
  border: 1px solid var(--ring, #e5e8e0);
}

.sb-section h2 {
  font-size: var(--text-xl, 1.5rem);
  color: var(--kbm-green, #52682d);
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--kbm-green-2, #738c52);
}

/* B) Quick Scan Cards */
.sb-quick-scan {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.sb-scan-card {
  background: var(--page-bg, #f7f8f7);
  padding: 1.25rem;
  border-radius: 8px;
  border: 1px solid var(--ring, #e5e8e0);
}

.sb-scan-card h3 {
  font-size: 1rem;
  color: var(--kbm-green, #52682d);
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.sb-scan-card p,
.sb-scan-card ul {
  font-size: 0.95rem;
  color: #555;
  margin: 0;
}

.sb-scan-card ul {
  padding-left: 1.25rem;
  margin-top: 0.5rem;
}

.sb-scan-card li {
  margin-bottom: 0.25rem;
}

/* D) Video Section */
.sb-video-block {
  margin-bottom: 1rem;
}

.sb-video-tips-box {
  margin-bottom: 1rem;
}

.sb-video-heading {
  font-size: 1.1rem;
  color: var(--kbm-green, #52682d);
  margin: 0 0 0.5rem 0;
  font-weight: 600;
}

.sb-video-tips {
  margin: 0 0 0.75rem 0;
  padding-left: 1.25rem;
  color: #555;
  font-size: 0.95rem;
  line-height: 1.6;
}

.sb-video-tips li {
  margin-bottom: 0.5rem;
}

.sb-video-tips li:last-child {
  margin-bottom: 0;
}

/* Video Card Button */
.sb-video-card {
  display: block;
  width: 100%;
  max-width: 400px;
  background: #ffffff;
  border: 1px solid #c7d8a4;
  border-radius: 10px;
  padding: 0;
  cursor: pointer;
  text-align: left;
  overflow: hidden;
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
}

.sb-video-card:hover {
  border-color: #6e8b3d;
  box-shadow: 0 4px 12px rgba(82, 104, 45, 0.15);
}

