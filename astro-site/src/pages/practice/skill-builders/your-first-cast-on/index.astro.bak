</SkillBuilderLayout>

<style>
/* ========== VIDEO SECTION 2-COLUMN LAYOUT ========== */

.kbm-video-grid {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 2rem;
  align-items: start;
}

.kbm-video-text {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.kbm-video-heading {
  font-size: 1.1rem;
  color: var(--kbm-green, #52682d);
  margin: 0;
  font-weight: 600;
}

.kbm-video-tips {
  margin: 0;
  padding-left: 1.25rem;
  color: #555;
  font-size: 0.95rem;
  line-height: 1.6;
}

.kbm-video-tips li {
  margin-bottom: 0.5rem;
}

.kbm-video-embed {
  width: 100%;
}

.kbm-video-thumbnail {
  position: relative;
  display: block;
  width: 100%;
  padding: 0;
  border: none;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  background: #000;
  aspect-ratio: 16 / 9;
}

.kbm-video-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.2s ease;
}

.kbm-video-thumbnail:hover img,
.kbm-video-thumbnail:focus img {
  opacity: 0.85;
}

.kbm-video-thumbnail:focus {
  outline: 3px solid var(--kbm-green, #52682d);
  outline-offset: 2px;
}

.kbm-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.kbm-play-icon svg {
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  transition: transform 0.2s ease;
}

.kbm-video-thumbnail:hover .kbm-play-icon svg,
.kbm-video-thumbnail:focus .kbm-play-icon svg {
  transform: scale(1.1);
}

.kbm-video-wrapper-main {
  position: relative;
  padding-top: 56.25%; /* 16:9 aspect ratio */
  background: #000;
  border-radius: 8px;
  overflow: hidden;
}

.kbm-video-wrapper-main iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ========== PRINT LINK STYLES ========== */

.kbm-print-link {
  margin-bottom: 1.5rem;
  padding: 0.75rem 1rem;
  background: var(--page-bg, #f7f8f7);
  border-radius: 6px;
  border: 1px solid var(--ring, #e5e8e0);
}

.kbm-print-link a {
  color: var(--kbm-green, #52682d);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.kbm-print-link a:hover,
.kbm-print-link a:focus {
  color: var(--kbm-green-hover, #445626);
}

.kbm-print-helper {
  display: block;
  font-size: 0.85rem;
  color: #666;
  margin-top: 0.25rem;
  font-style: italic;
}

/* ========== VIDEO MODAL STYLES ========== */

.kbm-modal-trigger {
  display: inline-block;
  background: transparent;
  border: none;
  color: var(--kbm-green, #52682d);
  font-size: 0.9rem;
  font-style: italic;
  cursor: pointer;
  padding: 0.5rem 0;
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.2s ease;
}

.kbm-modal-trigger:hover,
.kbm-modal-trigger:focus {
  color: var(--kbm-green-hover, #445626);
  outline: 2px solid var(--kbm-green-2, #738c52);
  outline-offset: 2px;
  border-radius: 4px;
}

.kbm-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.kbm-modal[hidden] {
  display: none;
}

.kbm-modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
}

.kbm-modal-content {
  position: relative;
  background: #fff;
  border-radius: 12px;
  max-width: 900px;
  width: 100%;
  max-height: 90vh;
  overflow: auto;
  padding: 1.5rem;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.kbm-modal-close {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: transparent;
  border: none;
  font-size: 2rem;
  line-height: 1;
  color: #666;
  cursor: pointer;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.2s ease, color 0.2s ease;
}

.kbm-modal-close:hover,
.kbm-modal-close:focus {
  background: #f0f0f0;
  color: #333;
  outline: 2px solid var(--kbm-green-2, #738c52);
  outline-offset: 2px;
}

.kbm-modal-title {
  font-size: 1.25rem;
  color: var(--kbm-green, #52682d);
  margin: 0 0 1rem 0;
  padding-right: 2.5rem;
}

.kbm-video-wrapper {
  position: relative;
  padding-top: 56.25%; /* 16:9 aspect ratio */
  background: #000;
  border-radius: 8px;
  overflow: hidden;
}

.kbm-video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* Prevent body scroll when modal is open */
:global(body.kbm-modal-open) {
  overflow: hidden;
}

@media (max-width: 768px) {
  .kbm-video-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .kbm-video-text {
    order: 1;
  }
  
  .kbm-video-embed {
    order: 2;
  }
}

@media (max-width: 600px) {
  .kbm-modal-content {
    padding: 1rem;
    border-radius: 8px;
  }
  
  .kbm-modal-title {
    font-size: 1.1rem;
  }
  
  .kbm-print-link {
    padding: 0.5rem 0.75rem;
  }
}
</style>

<script>
// Video Modal - Accessible Implementation (supports multiple modals)
document.addEventListener('DOMContentLoaded', () => {
  // Modal configurations
  const modals = [
    {
      triggerId: 'mainVideoTrigger',
      modalId: 'mainVideoModal',
      frameId: 'mainVideoFrame',
      videoUrl: 'https://player.vimeo.com/video/151860058?badge=0&autopause=1&autoplay=1'
    },
    {
      triggerId: 'optionalVideoTrigger',
      modalId: 'optionalVideoModal',
      frameId: 'optionalVideoFrame',
      videoUrl: 'https://player.vimeo.com/video/312574558?badge=0&autopause=1&autoplay=1'
    },
    {
      triggerId: 'bindOffVideoTrigger',
      modalId: 'bindOffVideoModal',
      frameId: 'bindOffVideoFrame',
      videoUrl: 'https://player.vimeo.com/video/252258022?badge=0&autopause=1&autoplay=1'
    }
  ];
  
  let previouslyFocused = null;
  let activeModal = null;
  
  function openModal(config) {
    const modal = document.getElementById(config.modalId);
    const frame = document.getElementById(config.frameId);
    const closeBtn = modal?.querySelector('.kbm-modal-close');
    
    if (!modal) return;
    
    activeModal = { modal, frame, closeBtn };
    previouslyFocused = document.activeElement;
    
    // Load video
    if (frame) {
      frame.src = config.videoUrl;
    }
    
    // Show modal
    modal.hidden = false;
    document.body.classList.add('kbm-modal-open');
    
    // Focus close button
    closeBtn?.focus();
    
    // Add ESC listener
    document.addEventListener('keydown', handleEscape);
  }
  
  function closeModal() {
    if (!activeModal) return;
    
    const { modal, frame } = activeModal;
    
    // Hide modal
    modal.hidden = true;
    document.body.classList.remove('kbm-modal-open');
    
    // Stop video
    if (frame) {
      frame.src = '';
    }
    
    // Restore focus
    if (previouslyFocused && previouslyFocused.focus) {
      previouslyFocused.focus();
    }
    
    // Remove ESC listener
    document.removeEventListener('keydown', handleEscape);
    activeModal = null;
  }
  
  function handleEscape(e) {
    if (e.key === 'Escape') {
      closeModal();
    }
  }
  
  // Set up each modal
  modals.forEach(config => {
    const trigger = document.getElementById(config.triggerId);
    const modal = document.getElementById(config.modalId);
    const closeBtn = modal?.querySelector('.kbm-modal-close');
    const overlay = modal?.querySelector('.kbm-modal-overlay');
    
    trigger?.addEventListener('click', () => openModal(config));
    closeBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', closeModal);
  });
});
</script>
