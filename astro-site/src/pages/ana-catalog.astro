---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import "../styles/wizard.css";

// Define ANA categories (matching the admin categories)
const anaCategories = [
  { title: 'Getting started', slug: 'getting-started' },
  { title: 'Machines and Setup', slug: 'machines-and-setup' },
  { title: 'Yarn, Tension and Gauge', slug: 'yarn-tension-and-gauge' },
  { title: 'Stitch patterns and Techniques', slug: 'stitch-patterns-and-techniques' },
  { title: 'Shaping Fitting and Construction', slug: 'shaping-fitting-and-construction' },
  { title: 'Troubleshooting', slug: 'troubleshooting' },
  { title: 'Patterns and Projects', slug: 'patterns-and-projects' },
  { title: 'Tools and Accessories', slug: 'tools-and-accessories' },
  { title: 'Is this Normal?', slug: 'is-this-normal' },
  { title: 'Can my machine Do that?', slug: 'can-my-machine-do-that' },
  { title: 'Finishing and Care', slug: 'finishing-and-care' },
];

// Track unmapped categories for data migration telemetry
const unmappedCategories = new Set();

// Normalize legacy category names to new standardized categories
function normalizeCategory(rawCategory) {
  // Default to "Getting started" for missing/unknown categories (reasonable catch-all)
  if (!rawCategory) {
    console.warn('[ANA Catalog] Entry with missing category - mapped to "Getting started"');
    return 'Getting started';
  }
  
  // Comprehensive mapping of legacy categories to the 11 approved categories
  const categoryMap = {
    // Legacy general categories - map to Getting started as reasonable default
    'ask \'n answer (ana)': 'Getting started',
    'general': 'Getting started',
    'ana': 'Getting started',
    'uncategorized': 'Getting started',
    
    // Map slug variations to standardized categories
    'getting-started': 'Getting started',
    'machines-and-setup': 'Machines and Setup',
    'machine setup': 'Machines and Setup',
    'yarn-tension-and-gauge': 'Yarn, Tension and Gauge',
    'yarn tension gauge': 'Yarn, Tension and Gauge',
    'stitch-patterns-and-techniques': 'Stitch patterns and Techniques',
    'stitch patterns techniques': 'Stitch patterns and Techniques',
    'shaping-fitting-and-construction': 'Shaping Fitting and Construction',
    'shaping fitting construction': 'Shaping Fitting and Construction',
    'troubleshooting': 'Troubleshooting',
    'patterns-and-projects': 'Patterns and Projects',
    'patterns projects': 'Patterns and Projects',
    'tools-and-accessories': 'Tools and Accessories',
    'tools accessories': 'Tools and Accessories',
    'is-this-normal': 'Is this Normal?',
    'can-my-machine-do-that': 'Can my machine Do that?',
    'finishing-and-care': 'Finishing and Care',
    'finishing care': 'Finishing and Care',
  };
  
  const lowerCategory = rawCategory.toLowerCase().trim();
  
  // Check if it's a mapped legacy category
  if (categoryMap[lowerCategory]) {
    const mappedCat = categoryMap[lowerCategory];
    if (mappedCat !== rawCategory) {
      console.log(`[ANA Catalog] Mapped "${rawCategory}" → "${mappedCat}"`);
    }
    return mappedCat;
  }
  
  // Check if it matches one of our standardized categories (case-insensitive)
  const matchedCategory = anaCategories.find(
    cat => cat.title.toLowerCase() === lowerCategory
  );
  
  if (matchedCategory) {
    return matchedCategory.title;
  }
  
  // No match found - log for data migration review and default to "Getting started"
  unmappedCategories.add(rawCategory);
  console.warn(`[ANA Catalog] UNMAPPED category: "${rawCategory}" - defaulting to "Getting started" (needs review)`);
  return 'Getting started';
}

// Fetch ANA entries from GitHub at build time
let entries = [];
let errorMessage = '';

try {
  const response = await fetch('https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/src/content/ana');
  
  if (response.ok) {
    const files = await response.json();
    
    // Fetch each JSON file's content
    const entryPromises = files
      .filter(file => file.name.endsWith('.json'))
      .map(async (file) => {
        const fileResponse = await fetch(file.download_url);
        const data = await fileResponse.json();
        return {
          title: data.title,
          slug: data.slug,
          category: normalizeCategory(data.category),
          tags: data.tags || [],
          isDraft: data.isDraft,
          pendingPublish: data.pendingPublish,
          publishedDate: data.publishedDate,
          body: data.body || '',
        };
      });
    
    const allEntries = await Promise.all(entryPromises);
    // Filter out drafts and pending publish entries
    entries = allEntries.filter(entry => !entry.isDraft && !entry.pendingPublish);
  }
} catch (error) {
  console.error('Error fetching ANA entries:', error);
  errorMessage = error.message;
}

const title = "Ask 'n Answer";
const description = "Machine knitting questions and answers, organized by topic. Find solutions to troubleshooting, techniques, machines, and more.";
---

<BaseLayout {title} {description} bodyClass="has-catalog-search">
  <div class="page-container">
    <SectionHero 
      title="Ask 'n Answer" 
      iconPath="/images/ask-n-answer_logo.svg"
      iconAlt="Ask 'n Answer icon"
    />

    <div class="intro-section">
      <p class="intro-text">
        Clear answers, troubleshooting help, and next steps for machine knitters — one question at a time.
      </p>
      <p class="ask-link-wrapper">
        <a href="#" id="openAskModal" class="ask-link">
          Didn't find what you need? Ask Sue →
        </a>
      </p>
    </div>

    <!-- Search and Sort Controls Panel -->
    <div class="search-panel fade-in">
      <div class="controls-wrapper">
        <div class="search-wrapper">
          <input 
            type="text" 
            class="search-input" 
            id="searchInput" 
            placeholder="Search answers..."
            aria-label="Search questions"
          >
        </div>
        <div class="sort-wrapper">
          <span class="sort-label">Sort by:</span>
          <div class="custom-dropdown" id="sortDropdown">
            <button type="button" class="custom-dropdown__trigger" aria-haspopup="listbox" aria-expanded="false">
              <span class="custom-dropdown__value">Newest</span>
              <svg class="custom-dropdown__arrow" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
            </button>
            <ul class="custom-dropdown__menu" role="listbox">
              <li class="custom-dropdown__option selected" data-value="newest" role="option">Newest</li>
              <li class="custom-dropdown__option" data-value="oldest" role="option">Oldest</li>
              <li class="custom-dropdown__option" data-value="alphabetical" role="option">Alphabetical</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- ANA Topic Filter – Custom Dropdown Version -->
    <section class="ana-topic-filter">
      <div class="ana-topic-filter__inner">
        <span class="ana-topic-filter__label">Quick Answers</span>

        <div class="custom-dropdown custom-dropdown--wide" id="topicDropdown">
          <button type="button" class="custom-dropdown__trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="custom-dropdown__value">All topics</span>
            <svg class="custom-dropdown__arrow" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
          </button>
          <ul class="custom-dropdown__menu" role="listbox">
            <li class="custom-dropdown__option selected" data-value="all" role="option">All topics</li>
            <li class="custom-dropdown__option" data-value="getting-started" role="option">Getting started</li>
            <li class="custom-dropdown__option" data-value="machines-and-setup" role="option">Machines and Setup</li>
            <li class="custom-dropdown__option" data-value="yarn-tension-gauge" role="option">Yarn, Tension and Gauge</li>
            <li class="custom-dropdown__option" data-value="stitch-patterns-techniques" role="option">Stitch patterns and Techniques</li>
            <li class="custom-dropdown__option" data-value="shaping-fitting-construction" role="option">Shaping, Fitting and Construction</li>
            <li class="custom-dropdown__option" data-value="troubleshooting" role="option">Troubleshooting</li>
            <li class="custom-dropdown__option" data-value="patterns-projects" role="option">Patterns and Projects</li>
            <li class="custom-dropdown__option" data-value="tools-accessories" role="option">Tools and Accessories</li>
            <li class="custom-dropdown__option" data-value="is-this-normal" role="option">Is this Normal?</li>
            <li class="custom-dropdown__option" data-value="can-my-machine-do-that" role="option">Can my machine do that?</li>
            <li class="custom-dropdown__option" data-value="finishing-care" role="option">Finishing and Care</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ANA Cards Grid -->
    <div id="catalogueContent" class="catalogue-content" data-entries={JSON.stringify(entries)}>
      {errorMessage && (
        <div class="error">
          <p><strong>Error loading questions</strong></p>
          <p>Unable to fetch entries. Please try again later.</p>
          <p style="font-size: var(--text-base); margin-top: 1rem;">{errorMessage}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Scroll to Top Button -->
  <button id="scrollToTop" class="scroll-to-top" aria-label="Scroll to top">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
    </svg>
  </button>

  <!-- Ask Sue Modal -->
  <div id="askModal" class="ask-modal" hidden>
    <div class="ask-modal__overlay"></div>

    <div class="ask-modal__content">
      <button type="button" class="ask-modal__close" id="closeAskModal" aria-label="Close">
        &times;
      </button>

      <h2 class="ask-modal__title">Ask Sue a Question</h2>
      <p class="ask-modal__intro">
        I read every question and may add it to Answers so other machine knitters can benefit too.
      </p>

      <div class="ask-modal__form">

        <!-- Netlify-powered Ask Sue form -->
        <form
          id="askSueForm"
          name="ask-sue"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="ask-form"
        >
          <input type="hidden" name="form-name" value="ask-sue" />
          <input type="hidden" name="submitted-at" id="submittedAt" value="" />
          <p style="display:none;">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <label class="ask-form__field">
            <span>Name</span>
            <input type="text" name="name" required />
          </label>

          <label class="ask-form__field">
            <span>Email</span>
            <input type="email" name="email" required />
          </label>

          <label class="ask-form__field">
            <span>Machine (optional)</span>
            <input type="text" name="machine" />
          </label>

          <label class="ask-form__field">
            <span>Your question</span>
            <textarea name="question" rows="4" required></textarea>
          </label>

          <label class="ask-form__checkbox">
            <input type="checkbox" name="permission" value="yes" />
            <span>It's okay to use my question anonymously on the site</span>
          </label>

          <button type="submit" class="ask-form__submit">
            Send my question
          </button>
        </form>

        <script>
          document.getElementById('askSueForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const form = e.target;
            
            // Add submission timestamp
            const now = new Date();
            const timestamp = now.toLocaleString('en-US', { 
              dateStyle: 'medium', 
              timeStyle: 'short',
              timeZone: 'America/New_York'
            });
            document.getElementById('submittedAt').value = timestamp;
            
            const formData = new FormData(form);
            
            // POST to the blueprint page where Netlify detects the form
            fetch('/ask-sue-form.html', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams(formData).toString()
            })
            .then(response => {
              if (response.ok) {
                window.location.href = '/thank-you';
              } else {
                alert('Something went wrong. Please try again.');
              }
            })
            .catch(error => {
              console.error('Form submission error:', error);
              alert('Something went wrong. Please try again.');
            });
          });
        </script>

      </div>
    </div>
  </div>

  <script>
    (function () {
      const openBtn = document.getElementById("openAskModal");
      const modal = document.getElementById("askModal");
      const closeBtn = document.getElementById("closeAskModal");
      const overlay = modal?.querySelector(".ask-modal__overlay");

      if (!openBtn || !modal) return;

      function openModal(e) {
        if (e) e.preventDefault();
        modal.removeAttribute("hidden");
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        modal.setAttribute("hidden", "true");
        document.body.style.overflow = "";
      }

      openBtn.addEventListener("click", openModal);
      closeBtn?.addEventListener("click", closeModal);
      overlay?.addEventListener("click", closeModal);

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.hasAttribute("hidden")) {
          closeModal();
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* Intro Section (matches Patterns page) */
  .intro-section {
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .intro-text {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #5a6b47;
    line-height: 1.6;
    margin: 0 0 0.5rem 0;
  }

  .ask-link-wrapper {
    margin: 0;
  }

  .ask-link {
    color: var(--kbm-green, #52682D);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ask-link:hover {
    color: #3e5023;
    text-decoration: underline;
  }

  /* Search Panel */
  .search-panel {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(82, 104, 45, 0.08);
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  /* Search and Sort Controls */
  .controls-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    width: 100%;
    flex-wrap: nowrap;
  }

  .search-wrapper {
    flex: 1 1 auto;
    max-width: 350px;
    min-width: 250px;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1.25rem;
    border: 2px solid #c7d8a4;
    border-radius: 50px;
    font-size: var(--text-base);
    background-color: white;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .search-input:focus {
    outline: none;
    border-color: #52682D;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
  }

  .sort-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 0 auto;
    margin-left: auto;
  }

  .sort-label {
    color: #52682D;
    font-weight: 600;
    font-size: var(--text-base);
    white-space: nowrap;
    line-height: 1;
    display: flex;
    align-items: center;
  }


  /* ================================================
     ANA TOPIC DROPDOWN FILTER
     ================================================ */

  .ana-topic-filter {
    margin: 1.5rem 0 2rem;
  }

  .ana-topic-filter__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .ana-topic-filter__label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--kbm-green, #52682d);
  }

  /* ================================================
     CUSTOM DROPDOWN COMPONENT
     ================================================ */
  .custom-dropdown {
    position: relative;
    display: inline-block;
    min-width: 140px;
  }

  .custom-dropdown--wide {
    min-width: 260px;
  }

  .custom-dropdown__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.65rem 1rem;
    border: 2px solid #c7d8a4;
    border-radius: 50px;
    background-color: white;
    font-size: 0.95rem;
    color: #2c3a57;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
  }

  .custom-dropdown__trigger:hover {
    border-color: #52682d;
  }

  .custom-dropdown__trigger:focus {
    outline: none;
    border-color: #52682d;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
  }

  .custom-dropdown__trigger[aria-expanded="true"] {
    border-color: #52682d;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.15);
  }

  .custom-dropdown__trigger[aria-expanded="true"] .custom-dropdown__arrow {
    transform: rotate(180deg);
  }

  .custom-dropdown__value {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .custom-dropdown__arrow {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: #52682d;
    transition: transform 0.2s ease;
  }

  .custom-dropdown__menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 100;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: white;
    border: 1px solid #c7d8a4;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    max-height: 300px;
    overflow-y: auto;
    display: none;
  }

  .custom-dropdown__menu.open {
    display: block;
  }

  .custom-dropdown__option {
    padding: 0.6rem 1rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    color: #2c3a57;
  }

  .custom-dropdown__option:hover {
    background-color: #52682d;
    color: white;
  }

  .custom-dropdown__option.selected {
    background-color: #eef3e4;
    color: #52682d;
    font-weight: 600;
  }

  .custom-dropdown__option.selected:hover {
    background-color: #52682d;
    color: white;
  }

  .custom-dropdown__option.highlighted {
    background-color: #52682d;
    color: white;
  }

  /* Catalogue Content */
  .catalogue-content {
    position: relative;
  }

  /* ================================================
     ANA CARDS (Global styles for dynamically generated content)
     ================================================ */

  :global(.ana-list) {
    margin-top: 1.5rem;
  }

  /* ==== ANA CARD GRID (container) ==== */
  :global(.ana-card-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  /* ==== ANA CARD ==== */
  :global(.ana-card) {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #d1d9c2;
    padding: 1rem 1.2rem 1.1rem;
    text-decoration: none;
    color: #2c3a57;
    box-shadow: 0 2px 6px rgba(82, 104, 45, 0.08);
    transition: transform 0.12s ease, box-shadow 0.15s ease;
  }

  :global(.ana-card:hover) {
    transform: translateY(-4px);
    box-shadow: 0 4px 10px rgba(82, 104, 45, 0.16);
  }

  :global(.ana-card:hover .ana-card-arrow) {
    transform: translateX(3px);
  }

  /* top row in the card: category pill + optional meta */
  :global(.ana-card-meta) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  /* ==== CATEGORY PILL ==== */
  :global(.ana-category-pill) {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid #DDE4D1;
    background-color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #52682d;
  }

  /* optional: small grey meta next to pill */
  :global(.ana-card-date) {
    font-size: 0.75rem;
    color: #7a836f;
  }

  /* ==== QUESTION TEXT ==== */
  :global(.ana-card-question) {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: #52682D;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.ana-card-arrow) {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: #52682D;
    margin-left: auto;
    transition: transform 0.2s ease;
  }

  /* Scroll to Top Button */
  .scroll-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #52682D;
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1000;
  }

  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .scroll-to-top:hover {
    background-color: #3e5023;
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(82, 104, 45, 0.4);
  }

  .scroll-to-top svg {
    width: 24px;
    height: 24px;
  }

  /* Smooth Motion and Transitions */
  .fade-in {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error {
    text-align: center;
    padding: 3rem;
    color: #d64545;
    background-color: #ffe5e5;
    border-radius: 10px;
    margin: 2rem;
  }

  :global(.no-results) {
    text-align: center;
    padding: 3rem;
    color: #666;
    font-style: italic;
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .page-container {
      padding: 2rem 1rem;
    }

    .header-panel {
      flex-direction: column;
      text-align: center;
      padding: 0.75rem 1rem;
      gap: 1rem;
    }

    .intro-icon {
      width: 140px;
      height: 140px;
    }

    .header-right {
      width: 100%;
    }

    .intro-tagline {
      font-size: var(--text-base);
    }

    .controls-wrapper {
      flex-direction: column;
      gap: 0.75rem;
    }

    .search-wrapper {
      width: 100%;
      max-width: none;
      min-width: unset;
    }

    .sort-wrapper {
      width: 100%;
      justify-content: space-between;
      margin-left: 0;
    }

    .sort-select {
      flex: 1;
    }

    :global(.ana-card-grid) {
      grid-template-columns: 1fr;
    }

    .scroll-to-top {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 45px;
      height: 45px;
    }
  }

  /* Small Mobile Devices */
  @media (max-width: 640px) {
    .page-container {
      padding: 1.5rem 0.75rem;
    }

    .header-panel {
      padding: 0.625rem;
      gap: 0.75rem;
    }

    .intro-icon {
      width: 100px;
      height: 100px;
    }

    .intro-tagline {
      font-size: var(--text-sm);
    }

    .controls-wrapper {
      gap: 0.625rem;
    }

    .search-input {
      padding: 0.5rem 0.875rem;
      font-size: var(--text-sm);
    }

    .sort-label {
      font-size: var(--text-sm);
    }

    .sort-select {
      padding: 0.5rem 0.75rem;
      font-size: var(--text-sm);
      min-width: unset;
    }

    .ana-topic-filter__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .ana-topic-filter__select {
      width: 100%;
    }
  }

  /* ================================================
     ASK SUE MODAL
     ================================================ */

  .ask-modal {
    position: fixed;
    inset: 0;
    z-index: 5000;
    display: grid;
    place-items: center;
  }

  .ask-modal[hidden] {
    display: none;
  }

  .ask-modal__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  .ask-modal__content {
    position: relative;
    background: #fff;
    padding: 2rem;
    max-width: 540px;
    width: 90%;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .ask-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: transparent;
    border: none;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    color: #52682d;
  }

  .ask-modal__title {
    margin-top: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--kbm-green, #52682d);
  }

  .ask-modal__intro {
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: #2c3a57;
  }

  .ask-modal__form {
    margin-top: 1rem;
  }

  /* Basic form styling */
  .ask-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ask-form__field span {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
    color: #2c3a57;
  }

  .ask-form__field input,
  .ask-form__field textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    border: 1px solid #c7d8a4;
    font-size: 0.95rem;
    font-family: inherit;
  }

  .ask-form__checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #2c3a57;
  }

  .ask-form__checkbox input {
    margin-top: 0.2rem;
  }

  .ask-form__submit {
    margin-top: 0.5rem;
    padding: 0.65rem 1.5rem;
    border-radius: 999px;
    border: none;
    background-color: #52682d;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    align-self: flex-start;
  }

  .ask-form__submit:hover {
    background-color: #445626;
  }
</style>

<script>
  let allEntries = [];
  let currentSort = 'newest';
  let selectedTopic = 'all';

  // Map dropdown values to category names
  const topicToCategory = {
    'all': null,
    'getting-started': 'Getting started',
    'machines-and-setup': 'Machines and Setup',
    'yarn-tension-gauge': 'Yarn, Tension and Gauge',
    'stitch-patterns-techniques': 'Stitch patterns and Techniques',
    'shaping-fitting-construction': 'Shaping Fitting and Construction',
    'troubleshooting': 'Troubleshooting',
    'patterns-projects': 'Patterns and Projects',
    'tools-accessories': 'Tools and Accessories',
    'is-this-normal': 'Is this Normal?',
    'can-my-machine-do-that': 'Can my machine Do that?',
    'finishing-care': 'Finishing and Care',
  };

  function sortEntries(entries, sortBy) {
    const sorted = [...entries];
    
    switch(sortBy) {
      case 'newest':
        sorted.sort((a, b) => {
          const dateA = a.publishedDate ? new Date(a.publishedDate) : new Date(0);
          const dateB = b.publishedDate ? new Date(b.publishedDate) : new Date(0);
          return dateB - dateA;
        });
        break;
      case 'oldest':
        sorted.sort((a, b) => {
          const dateA = a.publishedDate ? new Date(a.publishedDate) : new Date(0);
          const dateB = b.publishedDate ? new Date(b.publishedDate) : new Date(0);
          return dateA - dateB;
        });
        break;
      case 'alphabetical':
        sorted.sort((a, b) => a.title.localeCompare(b.title));
        break;
    }
    
    return sorted;
  }

  function renderCards(entries) {
    const container = document.getElementById('catalogueContent');
    let filteredEntries = sortEntries(entries, currentSort);

    // Filter by selected topic if one is selected
    const selectedCategory = topicToCategory[selectedTopic];
    if (selectedCategory) {
      filteredEntries = filteredEntries.filter(entry => entry.category === selectedCategory);
    }

    // Apply search filter if search term exists
    const searchTerm = document.getElementById('searchInput')?.value?.toLowerCase().trim() || '';
    if (searchTerm) {
      filteredEntries = filteredEntries.filter(entry => {
        return entry.title.toLowerCase().includes(searchTerm) ||
               entry.tags.some(tag => tag.toLowerCase().includes(searchTerm)) ||
               entry.category.toLowerCase().includes(searchTerm);
      });
    }

    if (filteredEntries.length === 0) {
      container.innerHTML = '<div class="no-results">No questions found matching your criteria.</div>';
      return;
    }

    let html = '<div class="ana-card-grid">';
    
    filteredEntries.forEach(entry => {
      const categoryLabel = entry.category || 'General';
      // Convert to title case
      const titleCaseCategory = categoryLabel
        .toLowerCase()
        .split(' ')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
      
      html += `
        <a href="/ana/${entry.slug}" class="ana-card">
          <div class="ana-card-meta">
            <span class="ana-category-pill">${titleCaseCategory}</span>
          </div>
          <div class="ana-card-question">
            <span>${entry.title}</span>
            <svg class="ana-card-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </div>
        </a>
      `;
    });

    html += '</div>';
    container.innerHTML = html;
  }

  // Scroll to Top Button
  function initializeScrollToTop() {
    const scrollBtn = document.getElementById('scrollToTop');
    
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        scrollBtn.classList.add('visible');
      } else {
        scrollBtn.classList.remove('visible');
      }
    });

    scrollBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  function init() {
    const container = document.getElementById('catalogueContent');
    const entriesData = container.getAttribute('data-entries');
    
    if (entriesData) {
      allEntries = JSON.parse(entriesData);
      renderCards(allEntries);
    }

    initializeScrollToTop();
  }

  // Custom Dropdown Component Logic
  function initCustomDropdowns() {
    const dropdowns = document.querySelectorAll('.custom-dropdown');
    
    dropdowns.forEach(dropdown => {
      const trigger = dropdown.querySelector('.custom-dropdown__trigger');
      const menu = dropdown.querySelector('.custom-dropdown__menu');
      const valueDisplay = dropdown.querySelector('.custom-dropdown__value');
      const options = Array.from(dropdown.querySelectorAll('.custom-dropdown__option'));
      let activeIndex = options.findIndex(o => o.classList.contains('selected')) || 0;
      
      function openMenu() {
        // Close all other dropdowns first
        document.querySelectorAll('.custom-dropdown__menu.open').forEach(m => {
          m.classList.remove('open');
          m.closest('.custom-dropdown').querySelector('.custom-dropdown__trigger').setAttribute('aria-expanded', 'false');
        });
        
        menu.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
        updateActiveOption(activeIndex);
      }
      
      function closeMenu() {
        menu.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      }
      
      function updateActiveOption(index) {
        options.forEach((o, i) => {
          o.classList.toggle('highlighted', i === index);
        });
        activeIndex = index;
      }
      
      function selectOption(option) {
        const value = option.dataset.value;
        const text = option.textContent;
        
        // Update selected state
        options.forEach(o => o.classList.remove('selected'));
        option.classList.add('selected');
        
        // Update display text
        valueDisplay.textContent = text;
        
        // Close menu
        closeMenu();
        
        // Trigger change handlers based on dropdown ID
        if (dropdown.id === 'topicDropdown') {
          selectedTopic = value;
          renderCards(allEntries);
        } else if (dropdown.id === 'sortDropdown') {
          currentSort = value;
          renderCards(allEntries);
        }
      }
      
      // Toggle menu on trigger click
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = menu.classList.contains('open');
        
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });
      
      // Handle option selection via click
      options.forEach((option, index) => {
        option.addEventListener('click', (e) => {
          e.stopPropagation();
          selectOption(option);
        });
        
        option.addEventListener('mouseenter', () => {
          updateActiveOption(index);
        });
      });
      
      // Keyboard navigation
      trigger.addEventListener('keydown', (e) => {
        const isOpen = menu.classList.contains('open');
        
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (isOpen) {
            selectOption(options[activeIndex]);
          } else {
            openMenu();
          }
        } else if (e.key === 'Escape' && isOpen) {
          e.preventDefault();
          closeMenu();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (!isOpen) {
            openMenu();
          } else {
            updateActiveOption((activeIndex + 1) % options.length);
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (!isOpen) {
            openMenu();
          } else {
            updateActiveOption((activeIndex - 1 + options.length) % options.length);
          }
        } else if (e.key === 'Home' && isOpen) {
          e.preventDefault();
          updateActiveOption(0);
        } else if (e.key === 'End' && isOpen) {
          e.preventDefault();
          updateActiveOption(options.length - 1);
        }
      });
    });
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', () => {
      document.querySelectorAll('.custom-dropdown__menu.open').forEach(menu => {
        menu.classList.remove('open');
        menu.closest('.custom-dropdown').querySelector('.custom-dropdown__trigger').setAttribute('aria-expanded', 'false');
      });
    });
    
    // Close on Escape globally
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.custom-dropdown__menu.open').forEach(menu => {
          menu.classList.remove('open');
          const trigger = menu.closest('.custom-dropdown').querySelector('.custom-dropdown__trigger');
          trigger.setAttribute('aria-expanded', 'false');
          trigger.focus();
        });
      }
    });
  }

  // Search input handler
  document.getElementById('searchInput')?.addEventListener('input', () => {
    renderCards(allEntries);
  });

  init();
  initCustomDropdowns();
</script>
