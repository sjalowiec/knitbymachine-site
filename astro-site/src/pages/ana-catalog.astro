---
import BaseLayout from '../layouts/BaseLayout.astro';

// Define ANA categories (matching the admin categories)
const anaCategories = [
  { title: 'Getting started', slug: 'getting-started' },
  { title: 'Machines and Setup', slug: 'machines-and-setup' },
  { title: 'Yarn, Tension and Gauge', slug: 'yarn-tension-and-gauge' },
  { title: 'Stitch patterns and Techniques', slug: 'stitch-patterns-and-techniques' },
  { title: 'Shaping Fitting and Construction', slug: 'shaping-fitting-and-construction' },
  { title: 'Troubleshooting', slug: 'troubleshooting' },
  { title: 'Patterns and Projects', slug: 'patterns-and-projects' },
  { title: 'Tools and Accessories', slug: 'tools-and-accessories' },
  { title: 'Is this Normal?', slug: 'is-this-normal' },
  { title: 'Can my machine Do that?', slug: 'can-my-machine-do-that' },
  { title: 'Finishing and Care', slug: 'finishing-and-care' },
];

// Track unmapped categories for data migration telemetry
const unmappedCategories = new Set();

// Normalize legacy category names to new standardized categories
function normalizeCategory(rawCategory) {
  // Default to "Getting started" for missing/unknown categories (reasonable catch-all)
  if (!rawCategory) {
    console.warn('[ANA Catalog] Entry with missing category - mapped to "Getting started"');
    return 'Getting started';
  }
  
  // Comprehensive mapping of legacy categories to the 11 approved categories
  const categoryMap = {
    // Legacy general categories - map to Getting started as reasonable default
    'ask \'n answer (ana)': 'Getting started',
    'general': 'Getting started',
    'ana': 'Getting started',
    'uncategorized': 'Getting started',
    
    // Map slug variations to standardized categories
    'getting-started': 'Getting started',
    'machines-and-setup': 'Machines and Setup',
    'machine setup': 'Machines and Setup',
    'yarn-tension-and-gauge': 'Yarn, Tension and Gauge',
    'yarn tension gauge': 'Yarn, Tension and Gauge',
    'stitch-patterns-and-techniques': 'Stitch patterns and Techniques',
    'stitch patterns techniques': 'Stitch patterns and Techniques',
    'shaping-fitting-and-construction': 'Shaping Fitting and Construction',
    'shaping fitting construction': 'Shaping Fitting and Construction',
    'troubleshooting': 'Troubleshooting',
    'patterns-and-projects': 'Patterns and Projects',
    'patterns projects': 'Patterns and Projects',
    'tools-and-accessories': 'Tools and Accessories',
    'tools accessories': 'Tools and Accessories',
    'is-this-normal': 'Is this Normal?',
    'can-my-machine-do-that': 'Can my machine Do that?',
    'finishing-and-care': 'Finishing and Care',
    'finishing care': 'Finishing and Care',
  };
  
  const lowerCategory = rawCategory.toLowerCase().trim();
  
  // Check if it's a mapped legacy category
  if (categoryMap[lowerCategory]) {
    const mappedCat = categoryMap[lowerCategory];
    if (mappedCat !== rawCategory) {
      console.log(`[ANA Catalog] Mapped "${rawCategory}" → "${mappedCat}"`);
    }
    return mappedCat;
  }
  
  // Check if it matches one of our standardized categories (case-insensitive)
  const matchedCategory = anaCategories.find(
    cat => cat.title.toLowerCase() === lowerCategory
  );
  
  if (matchedCategory) {
    return matchedCategory.title;
  }
  
  // No match found - log for data migration review and default to "Getting started"
  unmappedCategories.add(rawCategory);
  console.warn(`[ANA Catalog] UNMAPPED category: "${rawCategory}" - defaulting to "Getting started" (needs review)`);
  return 'Getting started';
}

// Fetch ANA entries from GitHub at build time
let entries = [];
let errorMessage = '';

try {
  const response = await fetch('https://api.github.com/repos/sjalowiec/knitbymachine-site/contents/src/content/ana');
  
  if (response.ok) {
    const files = await response.json();
    
    // Fetch each JSON file's content
    const entryPromises = files
      .filter(file => file.name.endsWith('.json'))
      .map(async (file) => {
        const fileResponse = await fetch(file.download_url);
        const data = await fileResponse.json();
        return {
          title: data.title,
          slug: data.slug,
          category: normalizeCategory(data.category),
          tags: data.tags || [],
          isDraft: data.isDraft,
          pendingPublish: data.pendingPublish,
          publishedDate: data.publishedDate,
          body: data.body || '',
        };
      });
    
    const allEntries = await Promise.all(entryPromises);
    // Filter out drafts and pending publish entries
    entries = allEntries.filter(entry => !entry.isDraft && !entry.pendingPublish);
  }
} catch (error) {
  console.error('Error fetching ANA entries:', error);
  errorMessage = error.message;
}

const title = "Ask 'n Answer Catalogue";
const description = "Browse all our knitting machine questions and answers, organized by topic. Find solutions to troubleshooting, techniques, machines, and more.";
---

<BaseLayout {title} {description}>
  <div class="page-container">
    <!-- Compact Header: Icon + Text + Search/Sort -->
    <div class="header-panel fade-in">
      <img src="/images/ask-n-answer_logo.svg" alt="Ask 'n Answer" class="intro-icon">
      <div class="header-right">
        <p class="intro-tagline">Troubleshoot, learn, and master your knitting machine — one question at a time.</p>
        <div class="controls-wrapper">
          <div class="search-wrapper">
            <input 
              type="text" 
              class="search-input" 
              id="searchInput" 
              placeholder="Search ANA questions..."
              aria-label="Search questions"
            >
          </div>
          <div class="sort-wrapper">
            <label for="sortSelect" class="sort-label">Sort by:</label>
            <select id="sortSelect" class="sort-select" aria-label="Sort order">
              <option value="newest">Newest</option>
              <option value="oldest">Oldest</option>
              <option value="alphabetical">Alphabetical</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Category Topics Well -->
    <section class="ana-topics-well">
      <p class="ana-topics-label">Browse by topic:</p>
      <div class="ana-category-grid" id="categoryGrid">
        {anaCategories.map((cat) => (
          <button
            class="ana-category-bubble"
            data-category={cat.title}
            data-category-slug={cat.slug}
          >
            {cat.title}
          </button>
        ))}
      </div>
    </section>

    <!-- ANA Cards Grid -->
    <div id="catalogueContent" class="catalogue-content" data-entries={JSON.stringify(entries)}>
      {errorMessage && (
        <div class="error">
          <p><strong>Error loading questions</strong></p>
          <p>Unable to fetch ANA entries. Please try again later.</p>
          <p style="font-size: var(--text-base); margin-top: 1rem;">{errorMessage}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Scroll to Top Button -->
  <button id="scrollToTop" class="scroll-to-top" aria-label="Scroll to top">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
    </svg>
  </button>
</BaseLayout>

<style>
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 3rem;
  }

  /* Compact Header Panel */
  .header-panel {
    background-color: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(82, 104, 45, 0.1);
    padding: 1.25rem 2rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }

  .intro-icon {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }

  .header-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
  }

  .intro-tagline {
    color: #52682D;
    font-size: var(--text-lg);
    line-height: 1.5;
    margin: 0;
    opacity: 0.85;
    width: 100%;
  }

  /* Search and Sort Controls */
  .controls-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .search-wrapper {
    flex: 1;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1.25rem;
    border: 2px solid #c7d8a4;
    border-radius: 50px;
    font-size: var(--text-base);
    background-color: white;
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: #52682D;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
  }

  .sort-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .sort-label {
    color: #52682D;
    font-weight: 600;
    font-size: var(--text-base);
    white-space: nowrap;
  }

  .sort-select {
    padding: 0.75rem 1rem;
    border: 2px solid #c7d8a4;
    border-radius: 50px;
    font-size: var(--text-base);
    background-color: white;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 140px;
  }

  .sort-select:focus {
    outline: none;
    border-color: #52682D;
    box-shadow: 0 0 0 3px rgba(82, 104, 45, 0.1);
  }

  /* ================================================
     ANA TOPICS WELL
     ================================================ */

  .ana-topics-well {
    background-color: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 18px rgba(82, 104, 45, 0.10);
    padding: 1.5rem 2rem 1.75rem;
    margin: 1.5rem 0 2rem;
  }

  .ana-topics-label {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #52682d;
  }

  /* ================================================
     ANA CATEGORY BUBBLE GRID
     ================================================ */

  .ana-category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding-bottom: 0.25rem;
  }

  /* ================================================
     BASE CATEGORY BUBBLE
     ================================================ */
  .ana-category-bubble {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    position: relative;

    background-color: #ffffff;
    color: #2c3a57;
    padding: 0.85rem 1.4rem;
    border-radius: 20px;
    border: 2px solid #52682d;

    font-size: 1rem;
    font-weight: 500;
    text-align: center;

    cursor: pointer;

    box-shadow: 0 2px 6px rgba(82, 104, 45, 0.12);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.12s ease,
      opacity 0.3s ease,
      visibility 0.3s ease,
      max-height 0.3s ease,
      padding 0.3s ease,
      margin 0.3s ease;
  }
  
  /* Reset icon styling */
  .reset-icon {
    flex-shrink: 0;
    color: #52682d;
    animation: fadeIn 0.3s ease;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ================================================
     SPEECH BUBBLE TAIL — Bottom Right (Outer triangle)
     ================================================ */
  .ana-category-bubble::after {
    content: "";
    position: absolute;
    bottom: -14px;
    right: 26px;
    width: 0;
    height: 0;
    border-left: 18px solid transparent;
    border-right: 0;
    border-top: 14px solid #52682d;
    transition: border-top-color 0.15s ease;
  }

  /* ================================================
     SPEECH BUBBLE TAIL FILL (Inner triangle)
     ================================================ */
  .ana-category-bubble::before {
    content: "";
    position: absolute;
    bottom: -11px;
    right: 28px;
    width: 0;
    height: 0;
    border-left: 15px solid transparent;
    border-right: 0;
    border-top: 11px solid #ffffff;
    z-index: 1;
    transition: border-top-color 0.15s ease;
  }

  /* ================================================
     HOVER STATE
     ================================================ */
  .ana-category-bubble:hover {
    background-color: #f7f9f3;
    border-color: #6e8b3d;
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(82, 104, 45, 0.20);
  }

  .ana-category-bubble:hover::after {
    border-top-color: #6e8b3d;
  }

  .ana-category-bubble:hover::before {
    border-top-color: #f7f9f3;
  }

  /* ================================================
     ACTIVE / SELECTED STATE
     ================================================ */
  .ana-category-bubble.is-active {
    background-color: #eef3e4;
    border-color: #6e8b3d;
    font-weight: 600;
  }

  .ana-category-bubble.is-active::after {
    border-top-color: #6e8b3d;
  }

  .ana-category-bubble.is-active::before {
    border-top-color: #eef3e4;
  }

  /* ================================================
     HIDDEN STATE (for unselected bubbles)
     ================================================ */
  .ana-category-bubble.is-hidden {
    opacity: 0;
    visibility: hidden;
    transform: scale(0.95);
    pointer-events: none;
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
    overflow: hidden;
  }

  /* Catalogue Content */
  .catalogue-content {
    position: relative;
  }

  /* ================================================
     ANA CARDS
     ================================================ */

  .ana-list {
    margin-top: 1.5rem;
  }

  .ana-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .ana-card {
    display: block;
    background: #fff;
    border: 1px solid #d1d9c2;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 2px 6px rgba(82,104,45,0.08);
    text-decoration: none;
    color: #2c3a57;
    transition: transform .12s ease, box-shadow .15s ease;
  }

  .ana-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 12px rgba(82,104,45,0.15);
  }

  .ana-card h3 {
    margin-top: 0;
    margin-bottom: .5rem;
    color: #2c3a57;
    font-size: 1.1rem;
  }

  .ana-card p {
    margin: 0;
    color: #5a5a5a;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Scroll to Top Button */
  .scroll-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #52682D;
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(82, 104, 45, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1000;
  }

  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .scroll-to-top:hover {
    background-color: #3e5023;
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(82, 104, 45, 0.4);
  }

  .scroll-to-top svg {
    width: 24px;
    height: 24px;
  }

  /* Smooth Motion and Transitions */
  .fade-in {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error {
    text-align: center;
    padding: 3rem;
    color: #d64545;
    background-color: #ffe5e5;
    border-radius: 10px;
    margin: 2rem;
  }

  :global(.no-results) {
    text-align: center;
    padding: 3rem;
    color: #666;
    font-style: italic;
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .page-container {
      padding: 2rem 1rem;
    }

    .header-panel {
      flex-direction: column;
      text-align: center;
      padding: 1.25rem 1.5rem;
      gap: 1rem;
    }

    .intro-icon {
      width: 100px;
      height: 100px;
    }

    .header-right {
      width: 100%;
    }

    .intro-tagline {
      font-size: var(--text-base);
    }

    .controls-wrapper {
      flex-direction: column;
      gap: 0.75rem;
    }

    .search-wrapper {
      width: 100%;
    }

    .sort-wrapper {
      width: 100%;
      justify-content: space-between;
    }

    .sort-select {
      flex: 1;
    }

    .ana-category-grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
    }

    .ana-card-grid {
      grid-template-columns: 1fr;
    }

    .scroll-to-top {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 45px;
      height: 45px;
    }
  }

  /* Small Mobile Devices */
  @media (max-width: 640px) {
    .page-container {
      padding: 1.5rem 0.75rem;
    }

    .header-panel {
      padding: 1rem;
      gap: 0.875rem;
    }

    .intro-icon {
      width: 80px;
      height: 80px;
    }

    .intro-tagline {
      font-size: var(--text-sm);
    }

    .controls-wrapper {
      gap: 0.625rem;
    }

    .search-input {
      padding: 0.625rem 1rem;
      font-size: var(--text-sm);
    }

    .sort-label {
      font-size: var(--text-sm);
    }

    .sort-select {
      padding: 0.625rem 0.875rem;
      font-size: var(--text-sm);
      min-width: unset;
    }

    .ana-topics-well {
      padding: 1.25rem 1rem;
    }

    .ana-category-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .ana-category-bubble {
      padding: 0.75rem 1.2rem;
      font-size: 0.9rem;
    }
  }
</style>

<script>
  let allEntries = [];
  let currentSort = 'newest';
  let selectedCategory = null;
  let originalBubbleOrder = [];

  function sortEntries(entries, sortBy) {
    const sorted = [...entries];
    
    switch(sortBy) {
      case 'newest':
        sorted.sort((a, b) => {
          const dateA = a.publishedDate ? new Date(a.publishedDate) : new Date(0);
          const dateB = b.publishedDate ? new Date(b.publishedDate) : new Date(0);
          return dateB - dateA;
        });
        break;
      case 'oldest':
        sorted.sort((a, b) => {
          const dateA = a.publishedDate ? new Date(a.publishedDate) : new Date(0);
          const dateB = b.publishedDate ? new Date(b.publishedDate) : new Date(0);
          return dateA - dateB;
        });
        break;
      case 'alphabetical':
        sorted.sort((a, b) => a.title.localeCompare(b.title));
        break;
    }
    
    return sorted;
  }

  function getExcerpt(body, maxLength = 150) {
    if (!body) return '';
    
    // Strip HTML tags and get plain text
    const plainText = body.replace(/<[^>]*>/g, '');
    
    if (plainText.length <= maxLength) {
      return plainText;
    }
    
    return plainText.substring(0, maxLength).trim() + '...';
  }

  function renderCards(entries) {
    const container = document.getElementById('catalogueContent');
    let filteredEntries = sortEntries(entries, currentSort);

    // Filter by selected category if one is selected
    if (selectedCategory) {
      filteredEntries = filteredEntries.filter(entry => entry.category === selectedCategory);
    }

    // Apply search filter if search term exists
    const searchTerm = document.getElementById('searchInput')?.value?.toLowerCase().trim() || '';
    if (searchTerm) {
      filteredEntries = filteredEntries.filter(entry => {
        return entry.title.toLowerCase().includes(searchTerm) ||
               entry.tags.some(tag => tag.toLowerCase().includes(searchTerm)) ||
               entry.category.toLowerCase().includes(searchTerm);
      });
    }

    if (filteredEntries.length === 0) {
      container.innerHTML = '<div class="no-results">No questions found matching your criteria.</div>';
      return;
    }

    let html = '<div class="ana-card-grid">';
    
    filteredEntries.forEach(entry => {
      const excerpt = getExcerpt(entry.body);
      html += `
        <a href="/ana/${entry.slug}" class="ana-card">
          <h3>${entry.title}</h3>
          <p>${excerpt}</p>
        </a>
      `;
    });

    html += '</div>';
    container.innerHTML = html;
  }

  function handleCategoryClick(categoryTitle) {
    // Toggle category selection
    if (selectedCategory === categoryTitle) {
      selectedCategory = null;
    } else {
      selectedCategory = categoryTitle;
    }

    const categoryGrid = document.getElementById('categoryGrid');
    const categoryBubbles = document.querySelectorAll('.ana-category-bubble');
    let activeBubble = null;

    // Update active state and visibility on category bubbles
    categoryBubbles.forEach(bubble => {
      const bubbleCategory = bubble.dataset.category;
      
      // Remove any existing icon first
      const existingIcon = bubble.querySelector('.reset-icon');
      if (existingIcon) {
        existingIcon.remove();
      }
      
      if (bubbleCategory === selectedCategory) {
        bubble.classList.add('is-active');
        bubble.classList.remove('is-hidden');
        activeBubble = bubble;
        
        // Add grid icon to show it's clickable to reset
        const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        icon.setAttribute('class', 'reset-icon');
        icon.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
        icon.setAttribute('width', '22');
        icon.setAttribute('height', '22');
        icon.setAttribute('viewBox', '0 0 24 24');
        icon.setAttribute('fill', 'none');
        icon.setAttribute('stroke', 'currentColor');
        icon.setAttribute('stroke-width', '2');
        icon.setAttribute('stroke-linecap', 'round');
        icon.setAttribute('stroke-linejoin', 'round');
        icon.setAttribute('aria-hidden', 'true');
        icon.innerHTML = '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>';
        bubble.insertBefore(icon, bubble.firstChild);
      } else {
        bubble.classList.remove('is-active');
        // Hide non-selected bubbles only when a category is selected
        if (selectedCategory) {
          bubble.classList.add('is-hidden');
        } else {
          bubble.classList.remove('is-hidden');
        }
      }
    });

    // Move active bubble to first position in DOM or restore original order
    if (categoryGrid) {
      if (activeBubble) {
        // Move active bubble to first position
        categoryGrid.insertBefore(activeBubble, categoryGrid.firstChild);
      } else if (selectedCategory === null && originalBubbleOrder.length > 0) {
        // Restore original order when filter is cleared
        originalBubbleOrder.forEach(bubble => {
          categoryGrid.appendChild(bubble);
        });
      }
    }

    // Re-render cards with new filter
    renderCards(allEntries);
  }

  // Scroll to Top Button
  function initializeScrollToTop() {
    const scrollBtn = document.getElementById('scrollToTop');
    
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        scrollBtn.classList.add('visible');
      } else {
        scrollBtn.classList.remove('visible');
      }
    });

    scrollBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  function init() {
    const container = document.getElementById('catalogueContent');
    const entriesData = container.getAttribute('data-entries');
    
    if (entriesData) {
      allEntries = JSON.parse(entriesData);
      renderCards(allEntries);
    }

    // Store original bubble order for restoration
    const categoryGrid = document.getElementById('categoryGrid');
    if (categoryGrid) {
      originalBubbleOrder = Array.from(categoryGrid.children);
    }

    // Set up category bubble click handlers
    const categoryBubbles = document.querySelectorAll('.ana-category-bubble');
    categoryBubbles.forEach(bubble => {
      bubble.addEventListener('click', () => {
        const categoryTitle = bubble.dataset.category;
        handleCategoryClick(categoryTitle);
      });
    });

    initializeScrollToTop();
  }

  // Search input handler
  document.getElementById('searchInput')?.addEventListener('input', () => {
    renderCards(allEntries);
  });

  // Sort select handler
  document.getElementById('sortSelect')?.addEventListener('change', (e) => {
    currentSort = e.target.value;
    renderCards(allEntries);
  });

  init();
</script>
